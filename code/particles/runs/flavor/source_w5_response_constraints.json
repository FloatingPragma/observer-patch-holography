  "specification": {
    "D3_channel_interpretation": "The six unitary conjugation channels on W5 have positive Gram24I6+J6. A classical D3 group-walk probability therefore gives a faithful random-unitary channel without choosing a regular submodule. Its channel coefficients, its spectrum on End(W5), and its normalized heat trace are different observables; only the physical readout law can select one.",
    "D3_scope": "The normalizer of one supplied unoriented face axis is an additional background. Its three involutions are not native seam-transfer events.",
    "central_jump_law": {
      "assumptions": "A supplied D3 background and time-homogeneous class-uniform random-unitary jumps, with nonnegative rates c2 per involution and c3 per three-cycle",
      "class_probabilities": [
        "(1+4*r+s)/6",
        "(1-s)/6",
        "(1-2*r+s)/6"
      ],
      "heat_cone": "r=exp(-3*(c2+c3)*t), s=exp(-6*c2*t); r^2<=s<=1 for 0<r<=1",
      "lambda_sign": "6*c2",
