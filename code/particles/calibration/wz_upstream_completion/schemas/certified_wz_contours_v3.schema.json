        "V31": {
          "const": "0"
        },
        "V32": {
          "const": "0"
        },
        "V33": {
          "const": "1"
        }
      }
    },
    "dimensional_prefactor_finite_correction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "W",
        "Z"
      ],
      "properties": {
        "W": {
          "const": "(312000*p2 + 90163)/1944000"
        },
        "Z": {
          "const": "(292020000*p2 + 79268959)/1944000000"
        }
      }
    },
    "serialized_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precisions_bits",
        "initial_segments_per_edge",
        "max_subdivision_depth",
        "holomorphy_method",
        "boundary_method",
        "arg_width_gate",
        "winding_tolerance"
