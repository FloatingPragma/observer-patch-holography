          "$ref": "#/$defs/nesting_row"
        },
        "Z": {
          "$ref": "#/$defs/nesting_row"
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complex_ball_certified",
        "sheet_certified_on_declared_boxes",
        "principal_sheet_zero_exclusion_certified",
        "root_count_certified_on_declared_boxes",
        "pole_enclosure_certified",
        "second_sheet_certified",
        "laurent_residue_certified",
        "bmhv_restoration_certified",
        "physical_current_claim",
        "oph_native",
        "unit_claim"
      ],
      "properties": {
        "complex_ball_certified": {
          "type": "boolean"
        },
        "sheet_certified_on_declared_boxes": {
          "type": "boolean"
        },
        "principal_sheet_zero_exclusion_certified": {
          "type": "boolean"
        },
        "root_count_certified_on_declared_boxes": {
          "type": "boolean"
        },
        "pole_enclosure_certified": {
          "const": false
        },
        "second_sheet_certified": {
          "const": false
        },
        "laurent_residue_certified": {
          "const": false
        },
        "bmhv_restoration_certified": {
          "const": false
        },
        "physical_current_claim": {
          "const": false
        },
        "oph_native": {
          "const": false
        },
        "unit_claim": {
          "const": false
        }
      }
    },
    "artifact_finding": {
      "const": "the earlier sampled diagnostic reported winding one on boxes crossing the real axis; that value is a branch-gluing artifact of the discontinuous epsilon evaluation across the physical cut and is superseded by this certificate: the principal-sheet function has no zero in the declared off-axis boxes; pole location and continuation require a separate second-sheet receipt"
    },
    "status": {
      "enum": [
        "PRINCIPAL_SHEET_ZERO_EXCLUSION_CERTIFIED",
        "CERTIFICATION_INCOMPLETE"
      ]
    },
    "receipt_sha256": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rational": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$"
    },
    "rational_pair": {
      "type": "array",
      "items": false,
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/rational"
        },
        {
          "$ref": "#/$defs/rational"
        }
      ]
    },
    "real_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lo",
        "hi"
      ],
      "properties": {
        "lo": {
          "$ref": "#/$defs/rational"
        },
        "hi": {
          "$ref": "#/$defs/rational"
        }
      }
    },
    "complex_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "re",
        "im"
      ],
      "properties": {
        "re": {
          "$ref": "#/$defs/real_interval"
        },
        "im": {
          "$ref": "#/$defs/real_interval"
        }
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "re",
        "im",
        "half_plane"
      ],
      "properties": {
        "re": {
          "$ref": "#/$defs/rational_pair"
        },
        "im": {
          "$ref": "#/$defs/rational_pair"
        },
        "half_plane": {
          "const": "upper"
        }
      }
    },
    "base_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "box_in_open_upper_half_plane",
        "box_real_part_positive"
      ],
      "properties": {
        "box_in_open_upper_half_plane": {
          "type": "boolean"
        },
        "box_real_part_positive": {
          "type": "boolean"
        }
      }
    },
    "polynomial_term": {
      "type": "array",
      "items": false,
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "$ref": "#/$defs/rational"
        }
      ]
    },
    "coefficient_denominator_witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "denominator_id",
        "coefficients",
        "enclosure",
        "excludes_zero",
        "zero_exclusion_abs2_lower"
      ],
      "properties": {
        "denominator_id": {
          "type": "string",
          "minLength": 1
        },
        "coefficients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/polynomial_term"
          },
          "minItems": 1
        },
        "enclosure": {
          "$ref": "#/$defs/complex_interval"
        },
        "excludes_zero": {
          "type": "boolean"
        },
        "zero_exclusion_abs2_lower": {
          "$ref": "#/$defs/rational"
        }
      }
    },
    "loop_chart": {
      "oneOf": [
        {
          "$ref": "#/$defs/both_masses_zero_chart"
        },
        {
          "$ref": "#/$defs/one_mass_zero_chart"
        },
        {
          "$ref": "#/$defs/two_massive_chart"
        }
      ]
    },
    "both_masses_zero_chart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "m1",
        "m2",
        "chart",
        "certificate",
        "holomorphic"
      ],
      "properties": {
        "m1": {
          "const": "0"
        },
        "m2": {
          "const": "0"
        },
        "chart": {
          "const": "both_masses_zero"
        },
        "certificate": {
          "const": "log(s/mu2) only; box in open upper half plane"
        },
        "holomorphic": {
          "type": "boolean"
        }
      }
    },
    "one_mass_zero_chart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "m1",
        "m2",
        "chart",
        "root_chart_log_argument_imaginary_sign",
        "certificate",
        "holomorphic"
      ],
      "properties": {
        "m1": {
          "$ref": "#/$defs/rational"
        },
        "m2": {
          "$ref": "#/$defs/rational"
        },
        "chart": {
          "const": "one_mass_zero"
        },
        "root_chart_log_argument_imaginary_sign": {
          "const": "negative"
        },
        "certificate": {
          "const": "explicit root chart; both root-chart logarithm arguments have strictly negative imaginary part on the box"
        },
        "holomorphic": {
          "type": "boolean"
        }
      }
    },
    "two_massive_chart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "m1",
        "m2",
        "chart",
        "discriminant_symmetry_line",
        "discriminant_symmetry_line_outside_box_re_range",
        "certificate",
        "holomorphic"
      ],
      "properties": {
        "m1": {
          "$ref": "#/$defs/rational"
        },
        "m2": {
          "$ref": "#/$defs/rational"
        },
        "chart": {
          "const": "two_massive"
        },
        "discriminant_symmetry_line": {
          "$ref": "#/$defs/rational"
        },
        "discriminant_symmetry_line_outside_box_re_range": {
          "type": "boolean"
        },
        "certificate": {
          "const": "discriminant imaginary part nonvanishing off the discriminant-symmetry line Re(s)=m1+m2 (not the physical threshold); Feynman roots never real because the quadratic equals m1 at x=0 and m2 at x=1"
        },
        "holomorphic": {
          "type": "boolean"
        }
      }
    },
    "interior_holomorphy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "base_facts",
        "coefficient_denominators_exclude_zero_on_box",
        "coefficient_denominator_witnesses",
        "loop_charts",
        "holomorphic_on_box"
      ],
      "properties": {
        "method": {
          "const": "exact_rational_cut_exclusion"
        },
        "base_facts": {
          "$ref": "#/$defs/base_facts"
        },
        "coefficient_denominators_exclude_zero_on_box": {
          "type": "boolean"
        },
        "coefficient_denominator_witnesses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coefficient_denominator_witness"
          },
          "minItems": 1
        },
        "loop_charts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loop_chart"
          },
          "minItems": 1
        },
        "holomorphic_on_box": {
          "type": "boolean"
        }
      }
    },
    "segment_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "start",
        "end",
        "midpoint",
        "center_value",
        "derivative_hull",
        "offset",
        "image",
        "rotated_image",
        "image_zero_exclusion_abs2_lower",
        "rotated_zero_exclusion_abs2_lower",
        "rotated_argument",
        "rotated_argument_width",
        "argument_width_slack",
        "start_value",
        "end_value",
        "endpoint_ratio",
        "endpoint_increment",
        "endpoint_increment_slack"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "$ref": "#/$defs/rational_pair"
        },
        "end": {
          "$ref": "#/$defs/rational_pair"
        },
        "midpoint": {
          "$ref": "#/$defs/rational_pair"
        },
        "center_value": {
          "$ref": "#/$defs/complex_interval"
        },
        "derivative_hull": {
          "$ref": "#/$defs/complex_interval"
        },
        "offset": {
          "$ref": "#/$defs/complex_interval"
        },
        "image": {
          "$ref": "#/$defs/complex_interval"
        },
        "rotated_image": {
          "$ref": "#/$defs/complex_interval"
        },
        "image_zero_exclusion_abs2_lower": {
          "$ref": "#/$defs/rational"
        },
        "rotated_zero_exclusion_abs2_lower": {
          "$ref": "#/$defs/rational"
        },
        "rotated_argument": {
          "$ref": "#/$defs/real_interval"
        },
        "rotated_argument_width": {
          "$ref": "#/$defs/rational"
        },
        "argument_width_slack": {
          "$ref": "#/$defs/rational"
        },
        "start_value": {
          "$ref": "#/$defs/complex_interval"
        },
        "end_value": {
          "$ref": "#/$defs/complex_interval"
        },
        "endpoint_ratio": {
          "$ref": "#/$defs/complex_interval"
        },
        "endpoint_increment": {
          "$ref": "#/$defs/real_interval"
        },
        "endpoint_increment_slack": {
          "$ref": "#/$defs/rational"
        }
      }
    },
    "boundary_winding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certified",
        "method",
        "partition",
        "partition_sha256",
        "winding",
        "segments",
        "max_depth_used",
        "segment_evidence",
        "total_variation_interval",
        "winding_residual",
        "winding_tolerance_slack",
        "reason"
      ],
      "properties": {
        "certified": {
          "type": "boolean"
        },
        "method": {
          "const": "centered_form_segment_enclosure"
        },
        "partition": {
          "enum": [
            "adaptive",
            "replayed_base_partition"
          ]
        },
        "partition_sha256": {
          "$ref": "#/$defs/hash"
        },
        "winding": {
          "type": "integer"
        },
        "segments": {
          "type": "integer",
          "minimum": 1
        },
        "max_depth_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "segment_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment_evidence"
          },
          "minItems": 1
        },
        "total_variation_interval": {
          "$ref": "#/$defs/real_interval"
        },
        "winding_residual": {
          "$ref": "#/$defs/real_interval"
        },
        "winding_tolerance_slack": {
          "$ref": "#/$defs/rational"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "particle_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "particle",
        "precision_bits",
        "box",
        "tree_mass_sq",
        "interior_holomorphy",
        "boundary_winding",
        "quantity_enclosures",
        "zero_exclusion_certified",
        "reading"
      ],
      "properties": {
        "particle": {
          "enum": [
            "W",
            "Z"
          ]
        },
        "precision_bits": {
          "enum": [
            128,
            192,
            256
          ]
        },
        "box": {
          "$ref": "#/$defs/box"
        },
        "tree_mass_sq": {
          "$ref": "#/$defs/rational"
        },
        "interior_holomorphy": {
          "$ref": "#/$defs/interior_holomorphy"
        },
        "boundary_winding": {
          "$ref": "#/$defs/boundary_winding"
        },
        "quantity_enclosures": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/complex_interval"
          }
        },
        "zero_exclusion_certified": {
          "type": "boolean"
        },
        "reading": {
          "enum": [
            "the masked one-loop inverse propagator has no zero in the declared upper-half box on the principal sheet, consistent with first-sheet analyticity; this result does not locate a resonance pole or certify a second-sheet continuation",
            "not certified"
          ]
        }
      }
    },
    "particle_rows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "128",
        "192",
        "256"
      ],
      "properties": {
        "128": {
          "$ref": "#/$defs/particle_row"
        },
        "192": {
          "$ref": "#/$defs/particle_row"
        },
        "256": {
          "$ref": "#/$defs/particle_row"
        }
      }
    },
    "segment_nesting": {
