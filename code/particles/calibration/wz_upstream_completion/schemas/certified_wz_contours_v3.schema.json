        },
        "mfd1": {
          "const": "1/60"
        },
        "mfd2": {
          "const": "1/25"
        },
        "mfd3": {
          "const": "1/10"
        },
        "mfe1": {
          "const": "1/80"
        },
        "mfe2": {
          "const": "1/30"
        },
        "mfe3": {
          "const": "1/15"
        },
        "mu_ren2": {
          "const": "1"
        }
      }
