      "properties": {
        "precisions_bits": {
          "type": "array",
          "items": false,
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "const": 128
            },
            {
              "const": 192
            },
            {
              "const": 256
            }
          ]
        },
        "initial_segments_per_edge": {
          "const": 8
        },
        "max_subdivision_depth": {
          "const": 12
        },
        "holomorphy_method": {
          "const": "exact_rational_cut_exclusion"
        },
        "boundary_method": {
          "const": "centered_form_segment_enclosure"
        },
        "arg_width_gate": {
          "const": "157/100"
        },
        "winding_tolerance": {
          "const": "157/100"
        }
      }
    },
    "sheet_statement": {
      "const": "the boxes lie strictly in the upper half plane; the principal branch is the declared continuation and every logarithm and square root is cut-gated per evaluation; the second-sheet continuation through the physical cut is not constructed"
    },
    "acceptance_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auxiliary_principal_sheet_zero_exclusion_only",
        "independent_numerical_replay_certified",
        "engine_inverse_propagator_convention",
        "theorem_self_energy_sign_bridge_certified",
        "coefficient_denominator_witness_is_laurent_denominator",
        "root_enclosure_certified",
        "laurent_denominator_certified",
        "issue_593_precision_ladder_row_satisfied",
        "issue_593_independent_third_verifier_row_satisfied",
        "issue_593_root_laurent_row_satisfied",
        "issue_593_full_acceptance_satisfied"
      ],
      "properties": {
        "auxiliary_principal_sheet_zero_exclusion_only": {
          "const": true
        },
        "independent_numerical_replay_certified": {
          "const": false
        },
        "engine_inverse_propagator_convention": {
          "const": "G(s)=s-m_tree^2-Pi_engine(s)"
        },
        "theorem_self_energy_sign_bridge_certified": {
          "const": false
        },
        "coefficient_denominator_witness_is_laurent_denominator": {
          "const": false
        },
        "root_enclosure_certified": {
          "const": false
        },
        "laurent_denominator_certified": {
          "const": false
        },
        "issue_593_precision_ladder_row_satisfied": {
          "const": false
        },
        "issue_593_independent_third_verifier_row_satisfied": {
          "const": false
        },
        "issue_593_root_laurent_row_satisfied": {
          "const": false
        },
        "issue_593_full_acceptance_satisfied": {
          "const": false
        }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "W",
        "Z"
      ],
      "properties": {
        "W": {
          "$ref": "#/$defs/particle_rows"
        },
        "Z": {
          "$ref": "#/$defs/particle_rows"
        }
      }
    },
    "precision_nesting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "W",
        "Z"
      ],
      "properties": {
