{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Certified second-sheet W/Z pole receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "type",
    "pins",
    "fixture",
    "dimensional_prefactor_finite_correction",
    "declared_continuation",
    "serialized_gates",
    "sheet_statement",
    "results",
    "precision_nesting",
    "promotion",
    "status",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "oph.certified_second_sheet_poles.v1"},
    "type": {"const": "EXTERNAL_SM_EFT_VALIDATION"},
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vector_blocks_sha256",
        "diagnostic_module_sha256",
        "interval_module_sha256",
        "zero_exclusion_module_sha256",
        "verifier_module_sha256",
        "zero_exclusion_receipt_sha256"
      ],
      "properties": {
        "vector_blocks_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "diagnostic_module_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "interval_module_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "zero_exclusion_module_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "verifier_module_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "zero_exclusion_receipt_sha256": {
          "anyOf": [
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        }
      }
    },
    "fixture": {"type": "object", "additionalProperties": {"type": "string"}},
    "dimensional_prefactor_finite_correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["W", "Z"],
      "properties": {"W": {"type": "string"}, "Z": {"type": "string"}}
    },
    "declared_continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["W", "Z"],
      "properties": {
        "W": {"$ref": "#/$defs/continuation"},
        "Z": {"$ref": "#/$defs/continuation"}
      }
    },
    "serialized_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precisions_bits",
        "initial_segments_per_edge",
        "max_subdivision_depth",
        "holomorphy_method",
        "boundary_method",
        "arg_width_gate",
        "winding_tolerance",
        "newton_steps",
        "probe_residual_gate"
      ],
      "properties": {
        "precisions_bits": {"type": "array", "items": {"type": "integer"}},
        "initial_segments_per_edge": {"type": "integer"},
        "max_subdivision_depth": {"type": "integer"},
        "holomorphy_method": {"const": "exact_rational_cut_exclusion_lower_half_plane"},
        "boundary_method": {"const": "centered_form_segment_enclosure"},
        "arg_width_gate": {"type": "string"},
        "winding_tolerance": {"type": "string"},
        "newton_steps": {"type": "integer"},
        "probe_residual_gate": {"type": "string"}
      }
    },
    "sheet_statement": {"type": "string"},
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["W", "Z"],
      "properties": {
        "W": {"$ref": "#/$defs/particle_rows"},
        "Z": {"$ref": "#/$defs/particle_rows"}
      }
    },
    "precision_nesting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["W", "Z"],
      "properties": {
        "W": {"$ref": "#/$defs/nesting_row"},
        "Z": {"$ref": "#/$defs/nesting_row"}
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "second_sheet_pole_certified_on_declared_continuation",
        "simple_root_certified",
        "laurent_denominator_ball_certified",
        "scalar_residue_ball_certified",
        "matrix_rank_laurent_certified",
        "bmhv_restoration_certified",
        "physical_current_claim",
        "oph_native",
        "unit_claim"
      ],
      "properties": {
        "second_sheet_pole_certified_on_declared_continuation": {"type": "boolean"},
        "simple_root_certified": {"type": "boolean"},
        "laurent_denominator_ball_certified": {"type": "boolean"},
        "scalar_residue_ball_certified": {"type": "boolean"},
        "matrix_rank_laurent_certified": {"const": false},
        "bmhv_restoration_certified": {"const": false},
        "physical_current_claim": {"const": false},
        "oph_native": {"const": false},
        "unit_claim": {"const": false}
      }
    },
    "status": {
      "enum": [
        "SECOND_SHEET_POLE_CERTIFIED_ON_DECLARED_CONTINUATION",
        "CERTIFICATION_INCOMPLETE"
      ]
    },
    "receipt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window", "channels", "consistency_probes"],
      "properties": {
        "window": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 2,
          "maxItems": 2
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["m1", "m2", "threshold", "open", "addition"],
            "properties": {
              "m1": {"type": "string"},
              "m2": {"type": "string"},
              "threshold": {"type": "string"},
              "open": {"type": "boolean"},
              "addition": {"type": "string"}
            }
          }
        },
        "consistency_probes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rows", "all_passed"],
          "properties": {
            "rows": {"type": "array", "items": {"type": "object"}},
            "all_passed": {"type": "boolean"}
          }
        }
      }
    },
    "particle_rows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["128", "192", "256"],
      "properties": {
        "128": {"$ref": "#/$defs/particle_row"},
        "192": {"$ref": "#/$defs/particle_row"},
        "256": {"$ref": "#/$defs/particle_row"}
      }
    },
    "particle_row": {
      "type": "object",
      "required": [
        "particle",
        "precision_bits",
        "pole_box",
        "tree_mass_sq",
        "interior_holomorphy",
        "corridor_holomorphy",
        "boundary_winding",
        "interval_newton",
        "simple_root_certified",
        "pole_certified",
        "reading"
      ],
      "properties": {
        "particle": {"enum": ["W", "Z"]},
        "precision_bits": {"enum": [128, 192, 256]},
        "boundary_winding": {
          "type": "object",
          "required": ["certified", "method", "partition"],
          "properties": {
            "certified": {"type": "boolean"},
            "winding": {"type": "integer"},
            "segments": {"type": "integer"},
            "partition": {"enum": ["adaptive", "replayed_base_partition"]}
          }
        },
        "interval_newton": {
          "type": "object",
          "required": ["contracted"],
          "properties": {
            "contracted": {"type": "boolean"},
            "null_vectors": {
              "type": "object",
              "required": [
                "projection",
                "left_residual_contains_zero",
                "right_residual_contains_zero",
                "laurent_denominator_excludes_zero"
              ],
              "properties": {
                "projection": {"const": "transverse_scalar_block_1x1"},
                "left_residual_contains_zero": {"type": "boolean"},
                "right_residual_contains_zero": {"type": "boolean"},
                "laurent_denominator_excludes_zero": {"type": "boolean"}
              }
            }
          }
        },
        "simple_root_certified": {"type": "boolean"},
        "pole_certified": {"type": "boolean"},
        "reading": {"type": "string"}
      }
    },
    "nesting_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enclosures_nested_with_precision",
        "per_quantity_probe_nesting",
        "per_segment_enclosure_nesting",
        "newton_ball_nesting"
      ],
      "properties": {
        "enclosures_nested_with_precision": {"type": "boolean"},
        "per_quantity_probe_nesting": {
          "type": "object",
          "additionalProperties": {"type": "boolean"}
        },
        "per_segment_enclosure_nesting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["segments", "all_nested"],
          "properties": {
            "segments": {"type": "integer"},
            "all_nested": {"type": "boolean"}
          }
        },
        "newton_ball_nesting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pole_ball", "derivative_ball", "residue_ball"],
          "properties": {
            "pole_ball": {"type": "boolean"},
            "derivative_ball": {"type": "boolean"},
            "residue_ball": {"type": "boolean"}
          }
        }
      }
    }
  }
}
