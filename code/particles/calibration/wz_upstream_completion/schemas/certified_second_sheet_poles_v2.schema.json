          "$ref": "#/$defs/rational_pair"
        },
        "im": {
          "$ref": "#/$defs/rational_pair"
        },
        "half_plane": {
          "const": "lower"
        }
      }
    },
    "rational_box": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "re",
        "im"
      ],
      "properties": {
        "re": {
          "$ref": "#/$defs/rational_pair"
        },
        "im": {
          "$ref": "#/$defs/rational_pair"
        }
      }
    },
