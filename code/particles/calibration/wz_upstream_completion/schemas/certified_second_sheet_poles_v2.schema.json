        "continuation_identity_independently_certified": {
          "const": false
        },
        "standard_second_sheet_identification_certified": {
          "const": false
        },
        "full_matrix_rank_n_minus_1_laurent_certified": {
          "const": false
        },
        "matrix_rank_laurent_evidence_supplied": {
          "const": false
        },
        "finite_delta_diagnostics_are_noncertifying": {
