{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oph.local/schemas/certified_second_sheet_poles_v2.schema.json",
  "title": "Declared-chart scalar W/Z pole evidence receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "type",
    "claim_scope",
    "source_subject",
    "pins",
    "fixture",
    "ckm_fixture",
    "dimensional_prefactor_finite_correction",
    "declared_continuation",
    "serialized_gates",
    "sheet_statement",
    "results",
    "precision_nesting",
    "promotion",
    "status",
