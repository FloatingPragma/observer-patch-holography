      "const": "oph.certified_second_sheet_poles.v2"
    },
    "type": {
      "const": "EXTERNAL_SM_EFT_VALIDATION"
    },
    "claim_scope": {
      "$ref": "#/$defs/claim_scope"
    },
    "source_subject": {
      "$ref": "#/$defs/source_subject"
    },
    "pins": {
      "$ref": "#/$defs/pins"
    },
    "fixture": {
      "$ref": "#/$defs/fixture"
    },
    "ckm_fixture": {
      "$ref": "#/$defs/ckm_fixture"
    },
    "dimensional_prefactor_finite_correction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "W",
        "Z"
      ],
      "properties": {
        "W": {
          "const": "(312000*p2 + 90163)/1944000"
        },
        "Z": {
          "const": "(292020000*p2 + 79268959)/1944000000"
        }
      }
    },
    "declared_continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "W",
        "Z"
      ],
      "properties": {
        "W": {
          "$ref": "#/$defs/continuation"
        },
        "Z": {
          "$ref": "#/$defs/continuation"
        }
      }
    },
    "serialized_gates": {
      "$ref": "#/$defs/serialized_gates"
    },
    "sheet_statement": {
      "const": "the pole boxes lie strictly in the open lower half plane on a declared algebraic chart with an explicit per-channel sheet vector; in the W chart W-gamma has the declared action principal, meaning no added chart-relative correction rather than a certified physical-sheet assignment; the one-mass base chart is mass-exchange symmetric and every correction is relative to its recorded base chart; finite-delta probes are non-certifying diagnostics, and no independent continuation identity or physical/unique resonance sheet is certified"
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "W",
        "Z"
      ],
      "properties": {
        "W": {
          "$ref": "#/$defs/particle_rows"
        },
        "Z": {
          "$ref": "#/$defs/particle_rows"
        }
      }
    },
    "precision_nesting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "W",
        "Z"
      ],
      "properties": {
        "W": {
          "$ref": "#/$defs/nesting_row"
        },
        "Z": {
          "$ref": "#/$defs/nesting_row"
        }
      }
    },
    "promotion": {
      "$ref": "#/$defs/promotion"
    },
    "status": {
      "enum": [
        "SCALAR_POLE_CERTIFIED_ON_DECLARED_ALGEBRAIC_CHART",
        "CERTIFICATION_INCOMPLETE"
      ]
    },
    "receipt_sha256": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rational": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$"
    },
    "diagnostic_number": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"
    },
    "rational_pair": {
      "type": "array",
      "items": false,
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/rational"
        },
        {
          "$ref": "#/$defs/rational"
        }
      ]
    },
    "real_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lo",
        "hi"
      ],
      "properties": {
        "lo": {
          "$ref": "#/$defs/rational"
        },
        "hi": {
          "$ref": "#/$defs/rational"
        }
      }
    },
    "complex_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "re",
        "im"
      ],
      "properties": {
        "re": {
          "$ref": "#/$defs/real_interval"
        },
        "im": {
          "$ref": "#/$defs/real_interval"
        }
      }
    },
    "lower_box": {
