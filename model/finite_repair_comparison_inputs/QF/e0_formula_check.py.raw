#!/usr/bin/env python
"""QF. Exact check of the stationary weights of the E0 random-port Metropolis chain on the Z2 triangle:
per-state weight 1 : 2a/3 : a^2/2 : a^3/2 for Phi = 0, 1, 2, 3, at further values of a = exp(-beta), in both
holonomy sectors.  Uses the chain of e0_exact.py (calibrated against the real RepairKernel there).

Run on a box: python e0_formula_check.py  -> e0_formula_check.json
"""
import json
from fractions import Fraction as F

import e0_exact as e

out = {}
for a in (F(1, 3), F(3, 7), F(9, 10)):
    for twist in (None, 1):
        states, phi, rows = e.exact_chain("Z2", twist, a)
        pi = e.stationary_exact(rows)
        w0 = [x for p, x in zip(phi, pi) if p == 0][0]
        ratio = {p: sorted({x / w0 for q, x in zip(phi, pi) if q == p}) for p in range(4)}
        ok = (
            all(len(v) == 1 for v in ratio.values())
            and ratio[1][0] == 2 * a / 3
            and ratio[2][0] == a * a / 2
            and ratio[3][0] == a**3 / 2
        )
        out[f"a={a}, holonomy {'trivial' if twist is None else 'nontrivial'}"] = ok
print(out)
json.dump(out, open("e0_formula_check.json", "w"), indent=1)
