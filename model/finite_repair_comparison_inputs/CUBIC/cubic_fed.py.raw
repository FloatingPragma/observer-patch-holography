"""Edge-sharing cubic federation of icosahedral carriers.

Carriers sit on a simple cubic lattice in the pyritohedral orientation. Each carrier shares the six seams of one
perfect matching (the seams centred on the +-x, +-y, +-z axes) with its six neighbours, so every port belongs to
exactly two carriers and all twelve ports of a carrier are glue ports. Six ports per cell.

The one-load operator of the federation is the sum over carriers of the recharted carrier Laplacian
(flux k per carrier: k = 0 loads, k = 1 spinor frames, k = 2 vector frames), with one link phase per shared seam.
"""
import itertools, json, sys
import numpy as np

PHI = (1 + 5 ** 0.5) / 2
V = []
for s1 in (1, -1):
    for s2 in (1, -1):
        V += [(0.0, s1 * 1.0, s2 * PHI), (s1 * 1.0, s2 * PHI, 0.0), (s1 * PHI, 0.0, s2 * 1.0)]
V = np.array(V)
U = V / np.linalg.norm(V, axis=1, keepdims=True)
EDGES = [(a, b) for a in range(12) for b in range(a + 1, 12) if abs(np.linalg.norm(V[a] - V[b]) - 2) < 1e-9]
assert len(EDGES) == 30
FACES = []
for a, b, c in itertools.combinations(range(12), 3):
    if all(abs(np.linalg.norm(V[i] - V[j]) - 2) < 1e-9 for i, j in ((a, b), (b, c), (a, c))):
        n = np.cross(V[b] - V[a], V[c] - V[a])
        FACES.append((a, b, c) if n @ (V[a] + V[b] + V[c]) > 0 else (a, c, b))
assert len(FACES) == 20


def chi(u):
    """Spin-1/2 coherent state of direction u (north gauge; the south pole is not a port here)."""
    th = np.arccos(np.clip(u[2], -1, 1)); ph = np.arctan2(u[1], u[0])
    return np.array([np.cos(th / 2), np.exp(1j * ph) * np.sin(th / 2)])


CHI = np.array([chi(u) for u in U])


def link(a, b, k):
    z = np.vdot(CHI[b], CHI[a])
    return (z / abs(z)) ** k


def face_flux(k):
    out = []
    for a, b, c in FACES:
        w = link(a, b, k) * link(b, c, k) * link(c, a, k)
        out.append(np.angle(w) / (2 * np.pi / 20))
    return np.array(out)


def carrier_laplacian(k, drop=()):
    L = np.zeros((12, 12), complex)
    for a, b in EDGES:
        if (a, b) in drop:
            continue
        z = link(a, b, k)
        v = np.zeros(12, complex); v[a] = 1; v[b] = -z
        L += np.outer(v, v.conj())
    return L


# port classes: a vertex on the +mu axis seam and its translate on the -mu axis seam are one port
AXIS = []          # for each vertex: (mu, sign of the mu coordinate, label of the transverse coordinate)
for p in range(12):
    mu = int(np.argmax(np.abs(V[p])))          # the coordinate equal to +-phi
    AXIS.append(mu)
CLASS = {}
REP = []
for p in range(12):
    mu = AXIS[p]
    key = (mu, tuple(np.round(np.delete(V[p], mu), 6)))
    if key not in CLASS:
        CLASS[key] = len(CLASS); REP.append(key)
CLS = [CLASS[(AXIS[p], tuple(np.round(np.delete(V[p], AXIS[p]), 6)))] for p in range(12)]
OFF = np.zeros((12, 3))
for p in range(12):
    if V[p][AXIS[p]] < 0:
        OFF[p, AXIS[p]] = -1.0                 # the -mu vertices are the class representative in cell -mu
assert sorted(CLS) == sorted(list(range(6)) * 2)
SHARED = {}                                    # mu -> (+ edge, - edge), both oriented by class order
for a, b in EDGES:
    if AXIS[a] == AXIS[b] and np.sign(V[a][AXIS[a]]) == np.sign(V[b][AXIS[b]]):
        mu = AXIS[a]; sg = int(np.sign(V[a][mu]))
        e = (a, b) if CLS[a] < CLS[b] else (b, a)
        SHARED.setdefault(mu, {})[sg] = e
assert len(SHARED) == 3 and all(len(v) == 2 for v in SHARED.values())


def gauge(k):
    """Reading phases g_p on the home carrier that give each shared seam one link phase."""
    g = np.ones(12, complex)
    for mu, d in SHARED.items():
        a, b = d[1]; c, e = d[-1]
        # effective phase of an oriented seam (a -> b): link(a, b) * conj(g_a) * g_b
        g[e] = link(a, b, k) / link(c, e, k)
    return g


def bloch(kvec, k, count_shared_twice=True, theta=(0, 0, 0)):
    g = gauge(k)
    L = carrier_laplacian(k)
    G = np.zeros((12, 6), complex)
    for p in range(12):
        G[p, CLS[p]] = g[p] * np.exp(1j * ((np.array(kvec) + np.array(theta)) @ OFF[p]))
    H = G.conj().T @ L @ G
    if not count_shared_twice:
        for mu, d in SHARED.items():
            a, b = d[1]
            z = link(a, b, k) * np.conj(g[a]) * g[b]
            v = np.zeros(6, complex); v[CLS[a]] = 1; v[CLS[b]] = -z
            H -= np.outer(v, v.conj())
    return (H + H.conj().T) / 2


if __name__ == '__main__':
    np.set_printoptions(precision=6, suppress=True, linewidth=160)
    for k in (0, 1, 2):
        print('flux', k, 'face fluxes (units of 1/20):', np.round(face_flux(k), 6)[:4], 'sum', round(face_flux(k).sum(), 6))
        print('  carrier levels', np.round(np.linalg.eigvalsh(carrier_laplacian(k)), 6))
        for twice in (True, False):
            print('  shared seams counted', 'twice' if twice else 'once')
            for name, kv in (('Gamma', (0, 0, 0)), ('X', (np.pi, 0, 0)), ('M', (np.pi, np.pi, 0)), ('R', (np.pi, np.pi, np.pi)),
                             ('(pi/2,pi/2,pi/2)', (np.pi / 2,) * 3), ('(0.1,0,0)', (0.1, 0, 0)), ('(0.1,0.1,0.1)/sqrt3', tuple(np.ones(3) * 0.1 / 3 ** 0.5))):
                print('   ', name.ljust(22), np.round(np.linalg.eigvalsh(bloch(kv, k, twice)), 6))
