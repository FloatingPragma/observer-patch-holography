import itertools, sys
import numpy as np
from s6_common import *
import s6_census_lib as cl
for n in (2, 3, 4, 5, 6):
    st, ix, H = cl.sector(n, SEAMS)
    rows = cl.census(st, ix, H, cl.AUT, cl.dec_aut)
    big = [(r['level'], r['dimension'], r['content']) for r in rows if sum(r['content'].values()) > 1]
    print('N', n, big)
