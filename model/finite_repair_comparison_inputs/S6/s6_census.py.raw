"""S6 (4): the multiplet census, an instrument for "colour / weak isospin = a symmetry acting on a degenerate multiplet".

An internal symmetry commutes with the carrier rotations. In the spectrum of the generator it therefore shows up
as an eigenspace that contains the SAME irreducible representation of the geometric symmetry group more than
once (multiplicity space = the internal multiplet). A degenerate multiplet that is a single irreducible of the
geometric group is a rotation multiplet and is no internal quantum number.

Instrument: eigenspaces of the generator on a sector, each decomposed over the ten irreducibles of the full
automorphism group of the port graph (rotations x antipodal map).
Controls (known answers):
  + three-species exclusion (declared, hidden SU(3)): every eigenspace must show multiplicity 3;
  + complete graph on the twelve ports (larger geometric symmetry): eigenspaces reducible under the rotations;
  + hidden SU(2) of the bare law: every level of sector N-1 must reappear in sector N.
Unknown: the bare native law on its binary (balanced) sectors N = 1..6, where one attempt acts as
1 - H/(2M), H = sum over seams of (1 - exchange).

Floating-point linear algebra (numpy, symmetric eigensolver); degeneracy tolerance 1e-8; characters are rounded
to integers with the residual reported.

Run:  cd SCR/rer-edit && PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=. nice -n 10 python SCR/research/S6/s6_census.py OUT.json
"""
import itertools, json, sys, time
import numpy as np

from s6_common import *   # noqa: F401,F403

T0 = time.time()
TOL = 1e-8
AUT = [tuple(int(v) for v in a) for a in SRC.incidence_automorphisms()]
assert len(AUT) == 120


def split(a):
    """automorphism = (rotation, parity): a = r or a = antipode o r."""
    if a in ROTSET:
        return a, 1
    r = tuple(ANTI[v] for v in a)
    assert r in ROTSET
    return r, -1


SQRT5 = 5 ** 0.5
chi_float = {n: {c: float(v[0]) + float(v[1]) * SQRT5 for c, v in CHI[n].items()} for n in IRREPS}
IRR10 = [(n, e) for n in IRREPS for e in (1, -1)]


def sector(n_particles, seams, nports=12):
    states = list(itertools.combinations(range(nports), n_particles))
    index = {s: i for i, s in enumerate(states)}
    H = np.zeros((len(states), len(states)))
    for i, s in enumerate(states):
        ss = set(s)
        for a, b in seams:
            if (a in ss) != (b in ss):
                t = tuple(sorted(ss ^ {a, b}))
                H[i, i] += 1.0
                H[index[t], i] -= 1.0
    return states, index, H


def census(states, index, H, group, decompose_fn):
    w, V = np.linalg.eigh(H)
    out, start = [], 0
    perms = []
    for a in group:
        perms.append(np.array([index[tuple(sorted(a[p] for p in s))] for s in states]))
    while start < len(w):
        end = start
        while end + 1 < len(w) and w[end + 1] - w[start] < TOL:
            end += 1
        E = V[:, start:end + 1]
        chars = [float(np.sum(E[p, :] * E)) for p in perms]
        mult, resid = decompose_fn(chars)
        out.append({'level': round(float(w[start]), 10), 'dimension': end - start + 1, 'content': mult, 'residual': resid})
        start = end + 1
    return out


def dec_aut(chars):
    mult, resid = {}, 0.0
    for (n, e) in IRR10:
        s = 0.0
        for a, c in zip(AUT, chars):
            r, par = split(a)
            s += c * chi_float[n][CLASS_OF[r]] * (e if par == -1 else 1)
        s /= 120.0
        k = int(round(s))
        resid = max(resid, abs(s - k))
        if k:
            mult[n + ('+' if e == 1 else '-')] = k
    return mult, resid


def dec_rot(chars):
    mult, resid = {}, 0.0
    for n in IRREPS:
        s = sum(c * chi_float[n][CLASS_OF[r]] for r, c in zip(ROT, chars)) / 60.0
        k = int(round(s))
        resid = max(resid, abs(s - k))
        if k:
            mult[n] = k
    return mult, resid


def summary(rows):
    return {'levels': len(rows), 'max_dimension': max(r['dimension'] for r in rows),
            'max_multiplicity_of_one_irreducible': max(max(r['content'].values()) for r in rows),
            'levels_with_more_than_one_irreducible': sum(1 for r in rows if sum(r['content'].values()) > 1),
            'max_character_residual': max(r['residual'] for r in rows),
            'dimension_histogram': {str(d): sum(1 for r in rows if r['dimension'] == d) for d in sorted({r['dimension'] for r in rows})}}


out = {'schema': 's6.census.v1', 'tolerance': TOL}

# ---------------------------------------------------------------- controls
# (i) complete graph, one quantum: symmetry S12, eigenspace of dimension 11 is reducible under the rotations
K12 = [(a, b) for a in range(12) for b in range(a + 1, 12)]
st, ix, H = sector(1, K12)
rows = census(st, ix, H, ROT, dec_rot)
out['control_complete_graph_one_quantum'] = {'rows': rows, **summary(rows),
                                             'flagged': any(sum(r['content'].values()) > 1 for r in rows)}
# (ii) three species, one quantum of one colour: state space = 3 copies; hidden SU(3) acts on the colour index
st, ix, H = sector(1, SEAMS)
H3 = np.kron(np.eye(3), H)
w, V = np.linalg.eigh(H3)
rows3, start = [], 0
perm1 = [np.array([ix[(a[s[0]],)] for s in st]) for a in AUT]
while start < len(w):
    end = start
    while end + 1 < len(w) and w[end + 1] - w[start] < TOL:
        end += 1
    E = V[:, start:end + 1]
    chars = []
    for p in perm1:
        big = np.concatenate([p + 12 * c for c in range(3)])
        chars.append(float(np.sum(E[big, :] * E)))
    mult, resid = dec_aut(chars)
    rows3.append({'level': round(float(w[start]), 10), 'dimension': end - start + 1, 'content': mult, 'residual': resid})
    start = end + 1
out['control_three_species_one_quantum'] = {'rows': rows3, **summary(rows3),
                                            'flagged_multiplicity_three': all(set(r['content'].values()) == {3} for r in rows3)}
print('control K12:', [(r['dimension'], r['content']) for r in out['control_complete_graph_one_quantum']['rows']])
print('control 3 species:', [(r['level'], r['dimension'], r['content']) for r in rows3])

# ---------------------------------------------------------------- the bare law
prev = None
out['bare_law'] = {}
for n in (1, 2, 3, 4, 5, 6):
    st, ix, H = sector(n, SEAMS)
    assert np.allclose(H, H.T)
    rows = census(st, ix, H, AUT, dec_aut)
    levels = np.array([r['level'] for r in rows])
    rec = {'states': len(st), **summary(rows)}
    if prev is not None:
        rec['all_levels_of_previous_sector_present (hidden SU(2))'] = bool(all(np.min(np.abs(levels - v)) < 1e-7 for v in prev))
    rec['spectrum_range'] = [float(levels.min()), float(levels.max())]
    rec['rows'] = rows if n <= 3 else rows[:12]
    out['bare_law'][f'N={n}'] = rec
    prev = levels
    print(f'N={n}', {k: v for k, v in rec.items() if k != 'rows'}, round(time.time() - T0, 1))
    if n <= 2:
        print('   ', [(r['level'], r['dimension'], r['content']) for r in rows])
out['verdict'] = {
    'bare_law_has_internal_multiplicity': any(v['max_multiplicity_of_one_irreducible'] > 1 for v in out['bare_law'].values()),
    'bare_law_has_accidental_degeneracy': any(v['levels_with_more_than_one_irreducible'] > 0 for v in out['bare_law'].values()),
}
print(out['verdict'])
out['seconds'] = round(time.time() - T0, 1)
json.dump(out, open(sys.argv[1], 'w'), indent=1)
print('written', sys.argv[1], out['seconds'])
