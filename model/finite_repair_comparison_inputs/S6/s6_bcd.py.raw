"""S6 (b), (c), (d): Z6 labels, non-abelian frame holonomy (quantum doubles), the port module as adjoint,
and the rotation content of the Dirac-point shells.

Exact finite-group arithmetic. No repair rule is executed.

Run:  cd SCR/rer-edit && PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=. nice -n 10 python SCR/research/S6/s6_bcd.py OUT.json
"""
import itertools, json, sys, time
from fractions import Fraction as F

from s6_common import *   # noqa: F401,F403

T0 = time.time()
out = {'schema': 's6.bcd.v1'}

# ================================================================ (b) Z6
# six-axis class group: Z^6 modulo zero-sum vectors and the diagonal (the relations the repository declares)
zero_sum = [[1 if k == 0 else -1 if k == i else 0 for k in range(6)] for i in range(1, 6)]
rel = zero_sum + [[1] * 6]
axis_any = {n: smith_invariants([[1 if k == 0 else -1 if k == i else 0 for k in range(n)] for i in range(1, n)] + [[1] * n]) for n in (5, 6, 10, 12)}
# critical groups (cokernels of the integer Laplacians): the finite charge groups the incidence itself supplies
def lap(n, edges):
    m = [[0] * n for _ in range(n)]
    for a, b in edges:
        m[a][a] += 1; m[b][b] += 1; m[a][b] -= 1; m[b][a] -= 1
    return m
port_lap = lap(NPORT, SEAMS)
dual_edges = sorted({tuple(sorted((f, g))) for f in range(NFACE) for g in range(NFACE) if DIST[f][g] == 1})
face_lap = lap(NFACE, dual_edges)
crit_port = [d for d in smith_invariants(port_lap) if d > 1]
crit_face = [d for d in smith_invariants(face_lap) if d > 1]
# curl (face-seam incidence) has unit invariants: integer face charges have no torsion
curl = [list(r) for r in law.face_incidence(SEAMS, FACES)]
out['b_Z6'] = {
    'six_axis_class_group_invariants': smith_invariants(rel),
    'the_same_construction_on_n_objects_gives_Z_n': {str(n): v[-1] for n, v in axis_any.items()},
    'rotations_act_trivially_on_it': True,
    'automorphisms_of_Z6': 2,
    'curl_invariants (face charges are free of torsion)': sorted(set(smith_invariants(curl))),
    'critical_group_of_port_graph': crit_port, 'critical_group_of_dual_graph': crit_face,
    'order_of_critical_group': int(__import__('math').prod(crit_port)),
    'critical_group_has_element_of_order_6': any(d % 6 == 0 for d in crit_port),
    'reading': 'a Z6 label carries the class 6Y mod 6 only (see s6_target.json): four values on five multiplets; '
               'the modulus six is declared in every place it occurs (axis relations, simulation register).',
}
print('b', out['b_Z6'])

# ================================================================ (c) quantum doubles
def group_data(elements, mulf, invf, ident):
    els = list(elements)
    index = {g: i for i, g in enumerate(els)}
    classes, seen = [], set()
    for g in els:
        if g in seen:
            continue
        c = {mulf(mulf(h, g), invf(h)) for h in els}
        seen |= c
        classes.append(c)
    centre = [g for g in els if all(mulf(g, h) == mulf(h, g) for h in els)]
    # derived subgroup
    gen = {mulf(mulf(a, b), mulf(invf(a), invf(b))) for a in els for b in els}
    sub = set(gen) | {ident}
    while True:
        new = {mulf(a, b) for a in sub for b in gen} - sub
        if not new:
            break
        sub |= new
    types, detail = 0, []
    for c in classes:
        g = min(c)
        cent = [h for h in els if mulf(g, h) == mulf(h, g)]
        cs, cseen, ncl = set(cent), set(), 0
        for h in cent:
            if h in cseen:
                continue
            cseen |= {mulf(mulf(k, h), invf(k)) for k in cent}
            ncl += 1
        abelian = ncl == len(cent)
        types += ncl
        o, x = 1, g
        while x != ident:
            x = mulf(x, g); o += 1
        detail.append({'class_size': len(c), 'element_order': o, 'centralizer_order': len(cent), 'centralizer_abelian': abelian,
                       'charge_types': ncl})
    return {'order': len(els), 'classes': len(classes), 'centre_order': len(centre), 'abelianization_order': len(els) // len(sub),
            'anyon_types': types, 'invertible_anyon_types': len(centre) * (len(els) // len(sub)),
            'fluxes': sorted(detail, key=lambda d: (d['element_order'], d['class_size']))}


A5 = group_data(ROT, mul, inv, IDENT)
AUT = [tuple(int(v) for v in a) for a in SRC.incidence_automorphisms()]
IH = group_data(AUT, mul, inv, IDENT)
# binary icosahedral group as SL(2,5)
sl = [(a, b, c, d) for a in range(5) for b in range(5) for c in range(5) for d in range(5) if (a * d - b * c) % 5 == 1]
slmul = lambda x, y: ((x[0] * y[0] + x[1] * y[2]) % 5, (x[0] * y[1] + x[1] * y[3]) % 5, (x[2] * y[0] + x[3] * y[2]) % 5, (x[2] * y[1] + x[3] * y[3]) % 5)
slinv = lambda x: (x[3] % 5, (-x[1]) % 5, (-x[2]) % 5, x[0] % 5)
TWOI = group_data(sl, slmul, slinv, (1, 0, 0, 1))
# twists of D(A5): flux g with abelian centralizer C: charge = character chi of C, twist = chi(g)
twists = {'1': 5}      # five pure charges, all twist 1
tw = {'bosons (twist 1)': 5, 'fermions (twist -1)': 0, 'twist of order 3': 0, 'twist of order 5': 0}
dims = [1, 3, 3, 4, 5]
for f in A5['fluxes']:
    if f['element_order'] == 1:
        continue
    n, size = f['centralizer_order'], f['class_size']
    dims += [size] * n
    if f['element_order'] == 2:      # centralizer V4: chi(g) = +1 twice, -1 twice
        tw['bosons (twist 1)'] += 2; tw['fermions (twist -1)'] += 2
    else:                            # cyclic centralizer generated by g: chi_k(g) = zeta^k
        tw['bosons (twist 1)'] += 1
        tw['twist of order %d' % f['element_order']] += n - 1
out['c_quantum_double'] = {
    'rotation_group_A5': A5, 'full_automorphism_group_A5xZ2': {k: v for k, v in IH.items() if k != 'fluxes'},
    'binary_icosahedral_group_SL(2,5)': {k: v for k, v in TWOI.items() if k != 'fluxes'},
    'D(A5)_quantum_dimensions': sorted(dims), 'D(A5)_total_dimension_squared': sum(d * d for d in dims), 'D(A5)_twists': tw,
    'reading': 'the group of invertible (additive) charges of D(G) is Z(G) x Hom(G, U(1)): trivial for the rotation group, Z2 for the binary '
               'cover, Z2 x Z2 with the antipodal map. No Z3, no Z6, no integer charge: hypercharge and triality have no carrier here.',
}
print('c  A5:', {k: v for k, v in A5.items() if k != 'fluxes'})
print('   fluxes', A5['fluxes'])
print('   Ih:', {k: v for k, v in IH.items() if k != 'fluxes'}, '\n   2I:', {k: v for k, v in TWOI.items() if k != 'fluxes'})
print('   dims', sorted(dims), sum(d * d for d in dims), tw)

# ================================================================ (d) the port module as adjoint
SQ = {'1': '1', '2': '1', '3': '3', '5A': '5B', '5B': '5A'}       # class of g^2


def cf_mul(a, b): return {c: q5mul(a[c], b[c]) for c in CLASSES}
def cf_add(a, b, s=1): return {c: q5add(a[c], q5mul(q5(s), b[c])) for c in CLASSES}
def cf_scale(a, s): return {c: q5mul(q5(s), a[c]) for c in CLASSES}
def cf_ext2(a): return {c: q5mul(q5(F(1, 2)), q5add(q5mul(a[c], a[c]), q5mul(q5(-1), a[SQ[c]]))) for c in CLASSES}
def from_mult(m):
    z = {c: q5(0) for c in CLASSES}
    for name, k in zip(IRREPS, m):
        z = cf_add(z, cf_scale(CHI[name], k))
    return z
def tup(cf):
    d = decompose(cf)
    return tuple(d[n] for n in IRREPS)

TRIV = CHI['1']
su2_opts = {'trivial': tup(cf_scale(TRIV, 3)), "via 3": tup(CHI['3']), "via 3'": tup(CHI["3'"])}
su3_opts = {'trivial': tup(cf_scale(TRIV, 8)), 'via 3': tup(cf_add(cf_mul(CHI['3'], CHI['3']), TRIV, -1)),
            "via 3'": tup(cf_add(cf_mul(CHI["3'"], CHI["3'"]), TRIV, -1))}
vec5 = {'5': (0, 0, 0, 0, 1), '4+1': (1, 0, 0, 1, 0), '3+1+1': (2, 1, 0, 0, 0), "3'+1+1": (2, 0, 1, 0, 0), 'trivial': (5, 0, 0, 0, 0)}
so5_opts = {k: tup(cf_ext2(from_mult(v))) for k, v in vec5.items()}
DIM = (1, 3, 3, 4, 5)
def centres(z):
    return [m for m in itertools.product(*(range(z // d + 1) for d in DIM)) if sum(a * d for a, d in zip(m, DIM)) == z]
TARGET = tuple(decompose(chars_ports := class_function(lambda r: sum(1 for p in range(NPORT) if r[p] == p)))[n] for n in IRREPS)
types = [(0, 4, 0, 0), (1, 1, 1, 0), (2, 0, 0, 1), (3, 3, 0, 0), (4, 0, 1, 0), (6, 2, 0, 0), (9, 1, 0, 0), (12, 0, 0, 0)]
def label(t):
    z, a, b, c = t
    parts = ([f'u(1)^{z}' if z > 1 else 'u(1)'] if z else []) + ([f'su(2)^{a}' if a > 1 else 'su(2)'] if a else []) + (['su(3)'] if b else []) + (['so(5)'] if c else [])
    return ' + '.join(parts)
lie = []
for t in types:
    z, a, b, c = t
    sols = []
    for cen in centres(z):
        for s2 in itertools.combinations_with_replacement(sorted(su2_opts), a):
            for s3 in itertools.combinations_with_replacement(sorted(su3_opts), b):
                for s5 in itertools.combinations_with_replacement(sorted(so5_opts), c):
                    tot = list(cen)
                    for k in s2: tot = [x + y for x, y in zip(tot, su2_opts[k])]
                    for k in s3: tot = [x + y for x, y in zip(tot, su3_opts[k])]
                    for k in s5: tot = [x + y for x, y in zip(tot, so5_opts[k])]
                    if tuple(tot) == TARGET:
                        sols.append({'centre': show(dict(zip(IRREPS, cen))), 'centre_rational': cen[1] == cen[2], 'su(2)': list(s2), 'su(3)': list(s3), 'so(5)': list(s5)})
    lie.append({'algebra': label(t), 'centre_dimension': z, 'module_structures_equal_to_port_module': len(sols),
                'with_rational_centre': sum(1 for s in sols if s['centre_rational']), 'solutions': sols})
out['d_port_module'] = {
    'port_module': show(dict(zip(IRREPS, TARGET))),
    'adjoint_options': {'su(2)': {k: show(dict(zip(IRREPS, v))) for k, v in su2_opts.items()},
                        'su(3)': {k: show(dict(zip(IRREPS, v))) for k, v in su3_opts.items()},
                        'so(5) by vector module': {k: show(dict(zip(IRREPS, v))) for k, v in so5_opts.items()}},
    'compact_lie_algebras_of_dimension_12': lie,
    'compatible_types': [r['algebra'] for r in lie if r['module_structures_equal_to_port_module']],
    'compatible_with_rational_centre': [r['algebra'] for r in lie if r['with_rational_centre']],
    'compatible_with_centre_at_most_one': [r['algebra'] for r in lie if r['module_structures_equal_to_port_module'] and r['centre_dimension'] <= 1],
    'multiplicity_of_4_in_port_module': TARGET[3],
    'reading': 'Hom(ports, 4) = 0: no rotation-equivariant map sends port loads to the four Cartan charges. The port module is the adjoint module '
               'of five of the eight algebras; the bracket is a point of a 14-dimensional space of equivariant brackets (second-pass result).',
}
print('d', out['d_port_module']['compatible_types'], '| rational centre:', out['d_port_module']['compatible_with_rational_centre'],
      '| centre <= 1:', out['d_port_module']['compatible_with_centre_at_most_one'])
for r in lie:
    print('  ', r['algebra'], r['module_structures_equal_to_port_module'], [(s['centre'], s['su(2)'], s['su(3)'], s['so(5)']) for s in r['solutions']])

# matter under the repository's embedding (rotations act as diag(R, sigma R) inside the gauge group): spinorial content
# classes of the binary icosahedral group by real part a of the unit quaternion; chi(Sym^k of the doublet) = U_k(a)
def q5c(x): return (x[0], -x[1])
HALF = q5(F(1, 2))
PH2, PHC2 = q5mul(HALF, PHI), q5mul(HALF, PHIC)       # phi/2 and (1 - phi)/2 = -1/(2 phi)
def neg(x): return (-x[0], -x[1])
B_CLASSES = [('+1', q5(1), 1, '1'), ('-1', q5(-1), 1, '1'), ('order 4', q5(0), 30, '2'), ('order 6', HALF, 20, '3'), ('order 3', neg(HALF), 20, '3'),
             ('order 10 (72 deg)', PH2, 12, '5A'), ('order 5 (288 deg)', neg(PH2), 12, '5A'),
             ('order 5 (144 deg)', neg(PHC2), 12, '5B'), ('order 10 (216 deg)', PHC2, 12, '5B')]
assert sum(s for _, _, s, _ in B_CLASSES) == 120
def cheb(k, a):
    u0, u1 = q5(1), q5mul(q5(2), a)
    if k == 0: return u0
    for _ in range(k - 1):
        u0, u1 = u1, q5add(q5mul(q5mul(q5(2), a), u1), neg(u0))
    return u1
def sym(k): return [cheb(k, a) for _, a, _, _ in B_CLASSES]                 # spin k/2 of the doublet 2
def symc(k): return [q5c(cheb(k, a)) for _, a, _, _ in B_CLASSES]          # the same for the conjugate doublet 2'
def times(x, y): return [q5mul(a, b) for a, b in zip(x, y)]
def linear_decomposition(ch):
    """A character of the binary group that is trivial on -1, decomposed over the five irreducibles of the rotation group."""
    assert ch[0] == ch[1], 'spinorial: not a representation of the rotation group'
    res = {}
    for name in IRREPS:
        s = q5(0)
        for (_, _, size, cls), v in zip(B_CLASSES, ch):
            s = q5add(s, q5mul(q5(size), q5mul(v, CHI[name][cls])))
        assert s[1] == 0 and (s[0] / 120).denominator == 1
        res[name] = int(s[0] / 120)
    return res
def is_spinorial(ch): return ch[0] != ch[1]
assert linear_decomposition(sym(2)) == {'1': 0, '3': 1, "3'": 0, '4': 0, '5': 0}
assert linear_decomposition(symc(2)) == {'1': 0, '3': 0, "3'": 1, '4': 0, '5': 0}
shells = {}
for k in (1, 3, 5, 7, 9):
    a = times(sym(k), symc(1)); b = times(sym(k), sym(1))
    shells[f'spin {k}/2'] = {'dimension': int(a[0][0]), 'times conjugate doublet 2\'': show(linear_decomposition(a)),
                             'times the same doublet 2': show(linear_decomposition(b))}
# the fifteen states under the binary group acting as 3 on colour and 2' on the weak doublet
three, two_c = sym(2), symc(1)
def ext2(ch_fn_pairs):      # exterior square of a direct sum given characters at g and g^2: use (chi(g)^2 - chi(g^2))/2
    return None
# power map on the classes by the half-angle: a -> 2a^2 - 1
def square_index(i):
    a = B_CLASSES[i][1]
    b = q5add(q5mul(q5(2), q5mul(a, a)), q5(-1))
    return next(j for j, (_, c, _, _) in enumerate(B_CLASSES) if c == b)
SQB = [square_index(i) for i in range(9)]
V = [q5add(x, y) for x, y in zip(three, two_c)]                      # C^3 + C^2
L2 = [q5mul(HALF, q5add(q5mul(V[i], V[i]), neg(V[SQB[i]]))) for i in range(9)]     # the 10
quark_doublet = times(three, two_c)                                 # (3,2)
out['d_port_module']['matter_under_the_repository_embedding'] = {
    'embedding': 'rotation g acts as diag(R_g, sigma(R_g)) (colour triplet 3, weak adjoint 3\'); on C^3 + C^2 this needs the binary cover: 3 + 2\'',
    'weak_doublet_is_spinorial': is_spinorial(two_c), 'quark_doublet_(3,2)_is_spinorial': is_spinorial(quark_doublet),
    'quark_doublet_dimension': int(quark_doublet[0][0]),
    'quark_doublet_norm (1 = irreducible)': str(sum(F(s) * q5mul(v, v)[0] for (_, _, s, _), v in zip(B_CLASSES, quark_doublet)) / 120),
    'the_10_is_a_rotation_group_module': not is_spinorial(L2),
    'reading': 'L and Q are faithful on the centre of the binary cover, so they occur in no module built from ports, seams or faces (those are '
               'modules of the rotation group). u^c, d^c (each 3) and e^c (1) are rotation modules; 3 and 3bar coincide.',
}
out['dirac_shells'] = {
    'input': 'simulation session: shells of 4 | 8 | 12 | 16 states next to the Dirac point, rotation multiplets (4), (5,3), (3,5,4)',
    'spin_times_valley': shells,
    'reading': 'the observed first shell (4) fits spin 1/2 times the conjugate doublet 2\' and excludes 2 x 2 = 1 + 3. '
               'The pattern predicts for the fourth shell 1 + 3 + 3\' + 4 + 5.',
}
print('shells', shells)
print('matter', out['d_port_module']['matter_under_the_repository_embedding'])

out['seconds'] = round(time.time() - T0, 1)
json.dump(out, open(sys.argv[1], 'w'), indent=1)
print('written', sys.argv[1], out['seconds'], 's')
