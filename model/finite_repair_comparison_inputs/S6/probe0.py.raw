import time, sys
t=time.time()
from model.common_source import slow_geometry
src = slow_geometry.source()
print('load', round(time.time()-t,2))
print('seams', len(src.seams()), src.seams()[:6])
print('faces', len(src.oriented_faces()), src.oriented_faces()[:6])
rot = src.rotations()
print('rot', len(rot), type(rot), rot[0], rot[1])
print([n for n in dir(src) if not n.startswith('_')])
