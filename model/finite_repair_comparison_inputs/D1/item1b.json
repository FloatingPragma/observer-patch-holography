{
 "arithmetic": "Q(sqrt5) and integers; every statement exact",
 "canonical": {
  "second_index_space": "the multiplicity space of the frame triplet in the port space; as a subspace of the port space the triplet-isotypic part (rank 9) of the frame group",
  "kernel_copies": "slow = the sqrt5 eigenspace of the adjacency (the 3 of the sixty rotations); fast = the -sqrt5 eigenspace (the 3prime); middle = the 5 of the rotations intersected with the triplet-isotypic part of the frame group. Slow and fast do not depend on the frame; the middle copy depends on the frame and on nothing else",
  "axis_lines_of_the_second_index": "the joint eigenspaces of the right Klein group {1, F, P, FP}: normal line = P-even = the middle copy; long line = F-even; short line = FP-even",
  "mixing_angle_copies_vs_lines": "squared overlaps (5 + sqrt5)/10 and (5 - sqrt5)/10 in the P-odd plane; the middle copy is a line"
 },
