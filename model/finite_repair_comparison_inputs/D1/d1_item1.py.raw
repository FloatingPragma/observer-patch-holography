"""D1 item 1. Exact certificate (integers and Q(sqrt5)) of design entry A, for all five frames and all twelve base ports.

Run from the public checkout:
  PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=.:RL/work/KD:RL/work/D1 python RL/work/D1/d1_item1.py [out.json]
"""
import json
import sys
from fractions import Fraction as F
from itertools import product

import kdlib as kd
from kdlib import K, ONE, ZERO, PHI, R5
from model.common_source import slow_geometry

import d1lib as d
from d1lib import (pmul, pinv, pmat, imm, iadd, isub, iscale, itrans, ieye, izero, irank, frame, torsor, canonical_ops,
                   adjacency, antipode, i3mul, i3T, i3vec, IDP)

A = adjacency()
P_ANTI = antipode()
M3_CANON = ((-1, 0, 0), (0, -1, 2), (0, 2, 1))
checks = {}
counts = {}


def ok(name, cond):
    assert cond, name
    checks[name] = True


def bump(name, n=1):
    counts[name] = counts.get(name, 0) + n


rot3 = d.rot3


CP_BODY = rot3((1, 1, 1))            # about n + s + l
CM_BODY = rot3((-1, 1, 1))           # about -n + s + l
HN, HS, HL = ((1, 0, 0), (0, -1, 0), (0, 0, -1)), ((-1, 0, 0), (0, 1, 0), (0, 0, -1)), ((-1, 0, 0), (0, -1, 0), (0, 0, 1))
I3 = ((1, 0, 0), (0, 1, 0), (0, 0, 1))


def kron3(X, Y):
    return [[X[i][k] * Y[j][l] for k in range(3) for l in range(3)] for i in range(3) for j in range(3)]


frames_out = []
m3_frame_sets = []
all_ok_golden = True
for f in range(5):
    fr = frame(f)
    T, rho, kind = fr['T'], fr['rho'], fr['kind']
    kinds = sorted(kind.values())
    ok('order 12: identity, three half-turns, eight thirds of a turn',
       kinds.count('identity') == 1 and kinds.count('half-turn') == 3 and kinds.count('third of a turn') == 8)
    ok('the three half-turns are the Klein group of the frame', {g for g in T if kind[g] == 'half-turn'} == set(fr['klein']))
    ok('closed under composition and inverse', all(pmul(a, b) in fr['index'] for a in T for b in T) and all(pinv(a) in fr['index'] for a in T))
    ok('free: no rotation of the frame group other than the identity fixes a port',
       all(all(g[p] != p for p in range(12)) for g in T if g != IDP))
    ok('transitive: the orbit of every port is all twelve ports', all(len({g[p] for g in T}) == 12 for p in range(12)))
    # generated by one half-turn and one third of a turn
    gen_pairs = 0
    for h in T:
        for c in T:
            if kind[h] == 'half-turn' and kind[c] == 'third of a turn':
                seen = {IDP}; queue = [IDP]
                for x in queue:
                    for g in (h, c):
                        y = pmul(g, x)
                        if y not in seen:
                            seen.add(y); queue.append(y)
                assert len(seen) == 12
                gen_pairs += 1
    ok('every pair (half-turn, third of a turn) generates the frame group', gen_pairs == 24)
    ops = canonical_ops(f)
    Fp, Pp, Cp, Cm = ops['F'], ops['P'], ops['C+'], ops['C-']
    ok('P is the antipodal map and commutes with the adjacency', Pp == P_ANTI and imm(pmat(Pp), A) == imm(A, pmat(Pp)))
    ok('F (frame-seam partner) is a fixed-point-free involution that does not commute with the adjacency',
       pmul(Fp, Fp) == IDP and imm(pmat(Fp), A) != imm(A, pmat(Fp)))
    ok('C+ and C- have order three and move every port to a neighbour',
       all(pmul(C, pmul(C, C)) == IDP and all(A[p][C[p]] for p in range(12)) for C in (Cp, Cm)))
    ok('adjacency = F + C+ + C+^-1 + C- + C-^-1 (operators on port amplitudes)',
       A == [[sum(pmat(x)[i][j] for x in (Fp, Cp, pinv(Cp), Cm, pinv(Cm))) for j in range(12)] for i in range(12)])
    # the 8 faces turned by C+ and C-: two tetrahedra, 4 faces each, 24 seams; the other 6 seams are the matching
    def cycles(C):
        return {tuple(sorted((p, C[p], C[C[p]]))) for p in range(12)}
    fp, fm = cycles(Cp), cycles(Cm)
    all_faces = set(d.faces())
    ok('C+ and C- each turn four faces; the eight faces are disjoint in seams and miss exactly the six frame seams',
       len(fp) == 4 and len(fm) == 4 and fp <= all_faces and fm <= all_faces and not (fp & fm)
       and {tuple(sorted(e)) for fc in fp | fm for e in ((fc[0], fc[1]), (fc[1], fc[2]), (fc[0], fc[2]))}
       == set(kd.carrier()['seams']) - set(fr['matching']))
    ok('P exchanges the two tetrahedra: P C+ P = C-^-1', pmul(Pp, pmul(Cp, Pp)) == pinv(Cm))
    # centralizer of the left action among all permutations of the ports
    central = set()
    for t in range(12):
        sig = [None] * 12
        for g in T:
            sig[g[0]] = g[t]                                        # sigma(g 0) = g sigma(0) with sigma(0) = t
        sig = tuple(sig)
        assert sorted(sig) == list(range(12)) and all(pmul(sig, g) == pmul(g, sig) for g in T)
        central.add(sig)
    ok('centralizer of the frame rotations in the permutations of the ports has exactly twelve elements', len(central) == 12)
    Lmat = {g: pmat(g) for g in T}
    ok('left action commutes with the adjacency', all(imm(Lmat[g], A) == imm(A, Lmat[g]) for g in T))
    base_rows = []
    m3_frames = set()
    right_sets = set()
    for p0 in range(12):
        to = torsor(f, p0)
        elem, S, right, rhoB, B0 = to['elem'], to['S'], to['right'], to['rhoB'], to['B0']
        bump('base ports checked')
        # body rotation matrices: the base port is (0, 1, phi) and the named elements have the stated matrices
        h_n = next(g for g in T if rhoB[g] == HN); h_s = next(g for g in T if rhoB[g] == HS); h_l = next(g for g in T if rhoB[g] == HL)
        c_p = next(g for g in T if rhoB[g] == CP_BODY); c_m = next(g for g in T if rhoB[g] == CM_BODY)
        ok('generators: the half-turn about the long axis of the base port and the thirds of a turn about n+s+l and -n+s+l with inverses',
           set(S) == {h_l, c_p, pinv(c_p), c_m, pinv(c_m)} and len(S) == 5)
        ok('seam graph = Cayley graph: ports p, q adjacent iff g_p^-1 g_q is a generator',
           all((A[p][q] == 1) == (pmul(pinv(elem[p]), elem[q]) in S) for p in range(12) for q in range(12)))
        Rmat = {k: pmat(right[k]) for k in T}
        ok('right translations are permutations and form the centralizer', set(right.values()) == central)
        right_sets.add(frozenset(right.values()))
        ok('left and right actions commute', all(imm(Lmat[a], Rmat[b]) == imm(Rmat[b], Lmat[a]) for a in T for b in T))
        commuting = {k for k in T if imm(Rmat[k], A) == imm(A, Rmat[k])}
        ok('right translations that commute with the adjacency: only the identity and the half-turn about the normal (the antipode)',
           commuting == {IDP, h_n})
        ok('conjugations that keep the generator set: only the identity and the half-turn about the normal',
           {k for k in T if {pmul(k, pmul(s, pinv(k))) for s in S} == set(S)} == {IDP, h_n})
        ok('adjacency = sum of the right translations by the five generators',
           A == [[sum(Rmat[s][i][j] for s in S) for j in range(12)] for i in range(12)])
        ok('named right translations: R(h_long) = F, R(h_normal) = P, R(h_short) = F P, R(c+^-1) = C+, R(c-^-1) = C-',
           right[h_l] == Fp and right[h_n] == Pp and right[h_s] == pmul(Fp, Pp) and right[pinv(c_p)] == Cp and right[pinv(c_m)] == Cm)
        # relabelling under a change of base port
        for a in T:
            to2 = torsor(f, a[p0])
            assert all(to2['right'][k] == right[pmul(pinv(a), pmul(k, a))] for k in T)
            bump('relabelling identities R_(a p0)(k) = R_p0(a^-1 k a)', 12)
        # the triplet block: matrix coefficients
        Phi = [[rhoB[elem[p]][i][j] for i in range(3) for j in range(3)] for p in range(12)]
        ok('matrix coefficients are orthogonal: Phi^T Phi = 4', imm(itrans(Phi), Phi) == iscale(4, ieye(9)))
        ok('left action on the first index: L(k) Phi = Phi (rho(k) x 1)',
           all(imm(Lmat[k], Phi) == imm(Phi, kron3(rhoB[k], I3)) for k in T))
        ok('right action on the second index: R(k) Phi = Phi (1 x rho(k))',
           all(imm(Rmat[k], Phi) == imm(Phi, kron3(I3, rhoB[k])) for k in T))
        M3 = tuple(tuple(sum(rhoB[s][i][j] for s in S) for j in range(3)) for i in range(3))
        ok('M3 = sum of the generators in the body axes (normal, short, long) of the base port = [[-1,0,0],[0,-1,2],[0,2,1]]', M3 == M3_CANON)
        ok('adjacency on the triplet block acts on the second index only: A Phi = Phi (1 x M3)', imm(A, Phi) == imm(Phi, kron3(I3, M3)))
        # the three singlets: functions on the three Klein orbits (golden rectangles)
        klein = {IDP, h_n, h_s, h_l}
        cls = {}
        for p in range(12):
            g = elem[p]
            cls[p] = next(m for m in range(3) if pmul(g, pinv([IDP, c_p, pmul(c_p, c_p)][m])) in klein)
        rect = [[int(cls[p] == m) for m in range(3)] for p in range(12)]
        ok('the three Klein orbits are the three golden rectangles (four ports each)', all(sum(r[m] for r in rect) == 4 for m in range(3)))
        ok('adjacency on the Klein-invariant functions is 2J - 1: values 5, -1, -1',
           imm(A, rect) == imm(rect, [[1, 2, 2], [2, 1, 2], [2, 2, 1]]))
        ok('left third of a turn permutes the three rectangles cyclically; the right Klein group fixes them',
           imm(Lmat[c_p], rect) == imm(rect, [[0, 0, 1], [1, 0, 0], [0, 1, 0]])
           and all(imm(Rmat[k], rect) == rect for k in klein))
        full = [rect[p] + Phi[p] for p in range(12)]
        ok('completeness: 3 + 9 = 12, Gram = 4', imm(itrans(full), full) == iscale(4, ieye(12)))
        # exact eigen-decomposition of M3 over Q(sqrt5)
        u = (ZERO, ONE, PHI); w = (ZERO, PHI, -ONE); n = (ONE, ZERO, ZERO)
        def act(M, v):
            return tuple(sum((K(M[i][j]) * v[j] for j in range(3)), ZERO) for i in range(3))
        ok('M3 (0,1,phi) = sqrt5 (0,1,phi); M3 (1,0,0) = -(1,0,0); M3 (0,phi,-1) = -sqrt5 (0,phi,-1)',
           act(M3, u) == tuple(R5 * x for x in u) and act(M3, n) == tuple(-x for x in n) and act(M3, w) == tuple(-R5 * x for x in w))
        # geometric meaning of the three copies
        coords = fr['coords']
        def bodyvec(p, v):                                           # v = (a, b, c) in body axes of port p -> frame coordinates
            nn, ss, ll = fr['body'][p]
            return tuple(K.lift(v[0]) * nn[i] + K.lift(v[1]) * ss[i] + K.lift(v[2]) * ll[i] for i in range(3))
        for p in range(12):
            assert bodyvec(p, u) == coords[p]                          # port position
            # second-index vector a, first-index e_i: function p -> (B0 rho(g_p)^frame-coordinates ...): check slow copy
            g = elem[p]
            for i in range(3):
                val = sum((K(Phi[p][3 * i + j]) * u[j] for j in range(3)), ZERO)
                assert val == sum((K(B0[i][t]) * coords[p][t] for t in range(3)), ZERO)
                val = sum((K(Phi[p][3 * i + j]) * w[j] for j in range(3)), ZERO)
                assert val == sum((K(B0[i][t]) * bodyvec(p, w)[t] for t in range(3)), ZERO)
                val = sum((K(Phi[p][3 * i + j]) * n[j] for j in range(3)), ZERO)
                assert val == sum((K(B0[i][t]) * bodyvec(p, n)[t] for t in range(3)), ZERO)
            bump('port-wise identities for the three copies', 9)
        # M3 in fixed frame coordinates (depends on the base port)
        M3f = i3mul(i3mul(i3T(B0), M3), B0)
        assert M3f == tuple(tuple(sum(rho[s][i][j] for s in S) for j in range(3)) for i in range(3))
        m3_frames.add(M3f)
        base_rows.append({'base_port': p0, 'frame_coordinates_of_base_port': [repr(x) for x in coords[p0]],
                          'body_axes_normal_short_long': [list(x) for x in B0],
                          'half_turn_generator_axis_in_frame_coordinates': list(fr['body'][p0][2]),
                          'M3_in_frame_coordinates': [list(r) for r in M3f]})
    ok('the set of right translations does not depend on the base port', len(right_sets) == 1)
    ok('six different matrices M3 in fixed frame coordinates over the twelve base ports (antipodal base ports agree)', len(m3_frames) == 6)
    m3_frame_sets.append(sorted(m3_frames))
    frames_out.append({'frame': f, 'matching': [list(e) for e in fr['matching']],
                       'axes_Qsqrt5': [[repr(x) for x in ax] for ax in fr['axes']],
                       'F': list(Fp), 'P': list(Pp), 'C_plus': list(Cp), 'C_minus': list(Cm),
                       'base_ports': base_rows})

ok('the same six integer matrices M3 occur in the frame coordinates of all five frames',
   all(s == m3_frame_sets[0] for s in m3_frame_sets))

# the slow copy is the public family band (rank three, Laplacian eigenvalue 5 - sqrt5)
c = slow_geometry.source()
proj = c.slow_band_projector_exact()
projK = tuple(tuple(K.lift(x) for x in row) for row in proj)
to = torsor(0, 0)
Phi = [[to['rhoB'][to['elem'][p]][i][j] for i in range(3) for j in range(3)] for p in range(12)]
u = (ZERO, ONE, PHI)
slow = [tuple(sum((K(Phi[p][3 * i + j]) * u[j] for j in range(3)), ZERO) for p in range(12)) for i in range(3)]
for vec in slow:
    img = tuple(sum((projK[p][q] * vec[q] for q in range(12)), ZERO) for p in range(12))
    assert img == vec
ok('the copy with second index (0,1,phi) is the public slow band (exact projector of the pinned carrier)', True)

# closed forms
kernel_triplet = {'slow (second index along the port, (0,1,phi))': '11/12 + sqrt5/60',
                  'middle (second index along the normal of the rectangle)': '9/10',
                  'fast (second index along the conjugate port, (0,phi,-1))': '11/12 - sqrt5/60'}
sq = {'short': repr(ONE / (PHI + K(2))), 'long': repr(PHI * PHI / (PHI + K(2)))}
ok('squared components of the port direction on its short and long axes are (5 - sqrt5)/10 and (5 + sqrt5)/10',
   ONE / (PHI + K(2)) == K(F(1, 2), F(-1, 10)) and PHI * PHI / (PHI + K(2)) == K(F(1, 2), F(1, 10)))

out = {
    'arithmetic': 'integers and Q(sqrt5); every listed identity is exact',
    'statement': {
        'group': 'rotation group of a cubic frame: order 12, simply transitive on the twelve ports (all five frames)',
        'generators': 'F = exchange of the two ports of each frame seam (right translation by the half-turn about the long axis '
                      'of the base port); C+ and C- = thirds of a turn of every port inside its face of the first and of the '
                      'second inscribed tetrahedron (right translations by the thirds of a turn about n+s+l and -n+s+l)',
        'adjacency': 'A = F + C+ + C+^-1 + C- + C-^-1; kernel = 1 - (5 - A)/60',
        'port_space': '1 + 1\' + 1\'\' + 3 x 3: three Klein-invariant functions (on the three golden rectangles) and nine matrix '
                      'coefficients rho(g_p)_ij',
        'second_action': 'right translations = the centralizer of the frame rotations in the permutations of the ports (12 '
                         'elements, canonical as a set). Canonical with names: F, P (antipode), F P, C+, C-. The labelling of the '
                         'right translations by group elements depends on the base port through conjugation: '
                         'R_(a p0)(k) = R_p0(a^-1 k a).',
        'kernel_on_second_index': 'singlets: 5, -1, -1 (A = 2J - 1 on the rectangles). Triplet: M3 = [[-1,0,0],[0,-1,2],[0,2,1]] in '
                                  'the body axes (normal, short, long) of the base port, for every frame and base port. In fixed '
                                  'frame coordinates M3 takes six values (base ports p and P p agree).',
        'commuting_part': 'of the twelve right translations only the identity and P commute with the kernel',
        'M3_eigenvectors': '(0,1,phi): sqrt5, the port itself (slow band); (1,0,0): -1, the normal of the rectangle (triplet inside '
                           'the quintet); (0,phi,-1): -sqrt5, the conjugate port (fast band)',
        'mixing_angle': 'tan = 1/phi between the slow eigenvector and the long axis; squared components ' + sq['long'] + ' and ' + sq['short'],
        'kernel_levels_triplet': kernel_triplet,
        'kernel_levels_singlets': ['1', '9/10', '9/10'],
    },
    'frames': frames_out,
    'M3_in_frame_coordinates_six_values': [[list(r) for r in M] for M in m3_frame_sets[0]],
    'checks': checks,
    'counts': counts,
}
path = sys.argv[1] if len(sys.argv) > 1 else 'item1.json'
json.dump(out, open(path, 'w'), indent=1)
print('all checks passed:', len(checks), '| counts:', counts)
