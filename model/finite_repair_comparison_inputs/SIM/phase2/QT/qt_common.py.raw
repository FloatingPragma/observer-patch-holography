"""Worker QT: exact walk engine for two or three loads. Plain law, uniform consensus address, Z6 link phases,
declared completions T-A, T-B, T-C at seam total three (CANDIDATES.md sections 2 and 3).

The public checkout is imported read only through FR's resolver (work/FR/fr_common.py, manifest hash guard).
Run every script of this directory as
  PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=<RL>/work/FR /tmp/oph-completion-venv/bin/python -B <script>

Representation. A basis state is (configuration index, record). Amplitudes are stored in a scaled form
b_i = a_i / tau_i with tau_i^2 = 1/2 on the states (adjacent double and single, record >= 2) of the laws T-A and T-C
and tau_i = 1 elsewhere. In this form every entry of every seam event is rational (times a power of w with a flux).
True weights are tau_i^2 |b_i|^2. The true operator is S U~ S^-1 with S = diag(tau); it is checked to be unitary.
"""
from __future__ import annotations

import itertools
import json
import math
import os
import sys
from fractions import Fraction as Fr

sys.dont_write_bytecode = True
os.environ.setdefault('PYTHONDONTWRITEBYTECODE', '1')

import numpy as np  # noqa: E402
import sympy as sp  # noqa: E402

import fr_common as FC  # noqa: E402  (work/FR, read only)

HEX = [2, 3, 9, 1, 0, 10]                                    # screen sense around the f axis
HEX_SEAMS = [(2, 3), (3, 9), (9, 1), (1, 0), (0, 10), (10, 2)]
HEX_TYPES = ['C', 'E', 'C', 'E', 'C', 'E']
ORBIT_A = {2, 9, 0}
ORBIT_B = {3, 1, 10}
FACE_F = (4, 5, 11)
FACE_FP = (6, 7, 8)
SQ3H = math.sqrt(3) / 2


# ---------------------------------------------------------------------- the field Q(w), w = exp(i pi/3), w^2 = w - 1
class Qw:
    __slots__ = ('a', 'b')

    def __init__(self, a=0, b=0):
        self.a = a if isinstance(a, Fr) else Fr(a)
        self.b = b if isinstance(b, Fr) else Fr(b)

    @staticmethod
    def of(x):
        return x if isinstance(x, Qw) else Qw(x)

    def __add__(self, o):
        o = Qw.of(o)
        return Qw(self.a + o.a, self.b + o.b)

    __radd__ = __add__

    def __sub__(self, o):
        o = Qw.of(o)
        return Qw(self.a - o.a, self.b - o.b)

    def __rsub__(self, o):
        o = Qw.of(o)
        return Qw(o.a - self.a, o.b - self.b)

    def __neg__(self):
        return Qw(-self.a, -self.b)

    def __mul__(self, o):
        o = Qw.of(o)
        bd = self.b * o.b
        return Qw(self.a * o.a - bd, self.a * o.b + self.b * o.a + bd)

    __rmul__ = __mul__

    def conj(self):
        return Qw(self.a + self.b, -self.b)

    def norm2(self):
        """|z|^2 as a fraction."""
        return self.a * self.a + self.a * self.b + self.b * self.b

    def inv(self):
        n = self.norm2()
        return Qw((self.a + self.b) / n, -self.b / n)

    def __truediv__(self, o):
        return self * Qw.of(o).inv()

    def __rtruediv__(self, o):
        return Qw.of(o) * self.inv()

    def __eq__(self, o):
        o = Qw.of(o)
        return self.a == o.a and self.b == o.b

    def __hash__(self):
        return hash((self.a, self.b))

    def __bool__(self):
        return self.a != 0 or self.b != 0

    def __complex__(self):
        return complex(float(self.a) + 0.5 * float(self.b), SQ3H * float(self.b))

    def __repr__(self):
        if self.b == 0:
            return str(self.a)
        return f'({self.a}) + ({self.b}) w'


W6 = [Qw(1, 0), Qw(0, 1), Qw(-1, 1), Qw(-1, 0), Qw(0, -1), Qw(1, -1)]      # powers of w
assert all((W6[1] * W6[m]) == W6[(m + 1) % 6] for m in range(6))


def conj(x):
    return x.conj() if isinstance(x, Qw) else x


def norm2(x):
    return x.norm2() if isinstance(x, Qw) else x * x


def to_complex(x):
    return complex(x) if isinstance(x, Qw) else complex(float(x), 0.0)


def to_mod(x, p, wp):
    if isinstance(x, Qw):
        return (to_mod(x.a, p, wp) + to_mod(x.b, p, wp) * wp) % p
    return (x.numerator % p) * pow(x.denominator % p, -1, p) % p


def sixth_root_mod(p):
    """An element of order six in F_p (p = 1 mod 6): a root of x^2 - x + 1."""
    assert p % 6 == 1
    for g in range(2, 200):
        c = pow(g, (p - 1) // 6, p)
        if (c * c - c + 1) % p == 0:
            return c
    raise ArithmeticError('no sixth root found')


def _primes(count=2):
    """The largest primes below 2^31 that equal 1 modulo 6 (products of two residues fit in int64)."""
    out, p = [], 2 ** 31
    while len(out) < count:
        p = int(sp.prevprime(p))
        if p % 6 == 1:
            out.append(p)
    return tuple(out)


PRIMES = _primes()


# ---------------------------------------------------------------------- the local completion
SEAM_STATES = [(0, 0), (1, 0), (0, 1), (1, 1), (2, 0), (0, 2), (2, 1), (1, 2), (3, 0), (0, 3)]


class Law:
    """Local completion on (n_a, n_b, record) for seam totals 0 to 3.

    Totals 0 to 2: the pairs of the public `local_repair_unitary`. Total 3: the shell pump plus the candidate pairs.
    U = I - sum_j v_j v_j^T with v_j = left_j - right_j.
    """

    def __init__(self, name):
        assert name in ('T-A', 'T-B', 'T-C', 'T-A6')
        self.name = name
        self.nrec = 6 if name in ('T-C', 'T-A6') else 4
        self.scaled = name in ('T-A', 'T-C', 'T-A6')
        keys = [(s, r) for s in SEAM_STATES for r in range(self.nrec)]
        self.keys = keys
        self.idx = {k: i for i, k in enumerate(keys)}
        n = len(keys)
        h = 1 / sp.sqrt(2)
        pairs = [
            ({((1, 0), 0): h, ((0, 1), 0): -h}, {((1, 0), 1): h, ((0, 1), 1): h}),            # public: |-,0> <-> |+,1>
            ({((2, 0), 0): 1}, {((1, 1), 2): 1}),                                             # public: |20,0> <-> |11,2>
            ({((0, 2), 0): 1}, {((1, 1), 3): 1}),                                             # public: |02,0> <-> |11,3>
            ({((2, 1), 0): h, ((1, 2), 0): -h}, {((2, 1), 1): h, ((1, 2), 1): h}),            # shell pump at total three
        ]
        if name == 'T-A':
            pairs += [({((3, 0), 0): 1}, {((2, 1), 2): h, ((1, 2), 2): h}),
                      ({((0, 3), 0): 1}, {((2, 1), 3): h, ((1, 2), 3): h})]
        elif name == 'T-A6':                 # control (qt5_controls.py): T-A with separate record values 4, 5 for the triple
            pairs += [({((3, 0), 0): 1}, {((2, 1), 4): h, ((1, 2), 4): h}),
                      ({((0, 3), 0): 1}, {((2, 1), 5): h, ((1, 2), 5): h})]
        elif name == 'T-B':
            pairs += [({((3, 0), 0): 1}, {((2, 1), 2): 1}),
                      ({((0, 3), 0): 1}, {((1, 2), 3): 1})]
        else:
            pairs += [({((3, 0), 0): 1}, {((2, 1), 2): h, ((1, 2), 4): h}),
                      ({((0, 3), 0): 1}, {((1, 2), 3): h, ((2, 1), 5): h})]
        vs = []
        for left, right in pairs:
            v = sp.zeros(n, 1)
            for k, c in left.items():
                v[self.idx[k]] += c
            for k, c in right.items():
                v[self.idx[k]] -= c
            vs.append(v)
        for i, v in enumerate(vs):
            assert sp.simplify((v.T * v)[0] - 2) == 0, 'reflector norm'
            for u in vs[:i]:
                assert sp.simplify((u.T * v)[0]) == 0, 'reflectors orthogonal'
        U = sp.eye(n)
        for v in vs:
            U -= v * v.T
        self.U_true = U.applyfunc(sp.nsimplify)
        self.pairs = pairs
        self.tau2 = {k: (Fr(1, 2) if (self.scaled and k[0] in ((2, 1), (1, 2)) and k[1] >= 2) else Fr(1)) for k in keys}
        # scaled operator U~_ij = U_ij tau_j / tau_i : rational
        self.col = {}
        for j, kj in enumerate(keys):
            out = []
            for i, ki in enumerate(keys):
                u = self.U_true[i, j]
                if u == 0:
                    continue
                val = sp.nsimplify(u * sp.sqrt(sp.Rational(self.tau2[kj].numerator, self.tau2[kj].denominator))
                                   / sp.sqrt(sp.Rational(self.tau2[ki].numerator, self.tau2[ki].denominator)))
                assert val.is_Rational, (name, ki, kj, val)
                out.append(((ki[0][0], ki[0][1], ki[1]), Fr(int(val.p), int(val.q))))
            self.col[(kj[0][0], kj[0][1], kj[1])] = out


# ---------------------------------------------------------------------- the walk
class Model:
    def __init__(self, ports, seams, law, nloads=3, flux=None):
        """seams: pairs in their reference orientation. flux: {seam index: e}, link phase w^e on that orientation."""
        self.ports = list(ports)
        self.pidx = {p: i for i, p in enumerate(self.ports)}
        self.seams = [tuple(s) for s in seams]
        self.law = law
        self.nrec = law.nrec
        self.nloads = nloads
        self.flux = {i: e % 6 for i, e in (flux or {}).items() if e % 6}
        self.real = all(e == 3 for e in self.flux.values())
        self.NA = 2 * len(self.seams)
        n = len(self.ports)
        cfgs = set()
        for ms in itertools.combinations_with_replacement(range(n), nloads):
            c = [0] * n
            for i in ms:
                c[i] += 1
            cfgs.add(tuple(c))
        self.cfg = sorted(cfgs, reverse=True)
        self.ci = {c: i for i, c in enumerate(self.cfg)}
        self.ncr = len(self.cfg) * self.nrec
        self.seam_set = {frozenset(s): i for i, s in enumerate(self.seams)}
        self._img = {}
        self._tau2 = {}

    # ------------------------------------------------------------------ configurations
    def cfg_of(self, *ports):
        c = [0] * len(self.ports)
        for p in ports:
            c[self.pidx[p]] += 1
        return tuple(c)

    def ports_of(self, cfg):
        return tuple(self.ports[i] for i in range(len(self.ports)) for _ in range(cfg[i]))

    def ctype(self, cfg):
        m = max(cfg)
        if self.nloads == 3:
            return {3: 'triple', 2: 'double+single', 1: 'separated'}[m]
        return {2: 'double', 1: 'separated'}[m]

    def adjacent_double_single(self, cfg):
        if self.nloads != 3 or max(cfg) != 2:
            return False
        a = self.ports[cfg.index(2)]
        b = self.ports[cfg.index(1)]
        return frozenset((a, b)) in self.seam_set

    def tau2(self, c, rec):
        key = (c, rec)
        hit = self._tau2.get(key)
        if hit is None:
            hit = Fr(1, 2) if (self.law.scaled and rec >= 2 and self.adjacent_double_single(self.cfg[c])) else Fr(1)
            self._tau2[key] = hit
        return hit

    def sidx(self, c, rec):
        return c * self.nrec + rec

    # ------------------------------------------------------------------ the event (plain law)
    def pair_at(self, k):
        s, o = divmod(k, 2)
        x, y = self.seams[s]
        return (x, y) if o == 0 else (y, x)

    def phase(self, m):
        m %= 6
        if self.real:
            return Fr(1) if m == 0 else Fr(-1)
        return W6[m]

    def local(self, c, rec, k):
        """Images of (configuration, record) under the event at address k: list of (c', rec', scaled amplitude)."""
        key = (c, rec, k)
        hit = self._img.get(key)
        if hit is not None:
            return hit
        cfg = self.cfg[c]
        a, b = self.pair_at(k)
        ia, ib = self.pidx[a], self.pidx[b]
        s = k // 2
        e = self.flux.get(s, 0)
        head_is_b = (b == self.seams[s][1])
        na, nb = cfg[ia], cfg[ib]
        out = []
        for (na2, nb2, r2), u in self.law.col[(na, nb, rec)]:
            c2 = list(cfg)
            c2[ia], c2[ib] = na2, nb2
            amp = u
            if e:
                d = (nb2 - nb) if head_is_b else (na2 - na)
                if d:
                    amp = self.phase(e * d) * u
            out.append((self.ci[tuple(c2)], r2, amp))
        self._img[key] = out
        return out

    def Qstep(self, state):
        new = {}
        for (c, rec, k), amp in state.items():
            for c2, r2, u in self.local(c, rec, k):
                key = (c2, r2, k)
                v = new.get(key, 0) + amp * u
                if v:
                    new[key] = v
                else:
                    new.pop(key, None)
        return new

    def Rstep(self, state):
        groups = {}
        for (c, rec, k), amp in state.items():
            groups.setdefault((c, rec), {})[k] = amp
        new = {}
        for (c, rec), g in groups.items():
            mean = sum(g.values(), Fr(0)) / self.NA
            for k in range(self.NA):
                v = 2 * mean - g.get(k, 0)
                if v:
                    new[(c, rec, k)] = v
        return new

    def W(self, state):
        return self.Qstep(self.Rstep(state))

    def Winv(self, state):
        return self.Rstep(self.Qstep(state))

    def embed(self, amps, rec=0):
        """{configuration: amplitude} with a record value and the uniform address (unnormalized)."""
        return {(self.ci[c], rec, k): a for c, a in amps.items() for k in range(self.NA)}

    def weight(self, state):
        """True squared norm of a scaled state."""
        return sum((self.tau2(c, rec) * norm2(a) for (c, rec, k), a in state.items()), Fr(0))

    # ------------------------------------------------------------------ discriminant
    def Dsparse(self):
        """Scaled discriminant D~ = A^dag Q~ A as {column: {row: value}}."""
        D = {}
        for c in range(len(self.cfg)):
            for rec in range(self.nrec):
                j = self.sidx(c, rec)
                col = {}
                for k in range(self.NA):
                    for c2, r2, u in self.local(c, rec, k):
                        i = self.sidx(c2, r2)
                        col[i] = col.get(i, 0) + u
                D[j] = {i: v / self.NA for i, v in col.items() if v}
        return D

    def components(self):
        """Connected components of the basis states under all seam events."""
        parent = list(range(self.ncr))

        def find(x):
            while parent[x] != x:
                parent[x] = parent[parent[x]]
                x = parent[x]
            return x
        for c in range(len(self.cfg)):
            for rec in range(self.nrec):
                j = self.sidx(c, rec)
                for k in range(self.NA):
                    for c2, r2, u in self.local(c, rec, k):
                        i = self.sidx(c2, r2)
                        if i != j:
                            ri, rj = find(i), find(j)
                            if ri != rj:
                                parent[ri] = rj
        comps = {}
        for x in range(self.ncr):
            comps.setdefault(find(x), []).append(x)
        return sorted(comps.values(), key=lambda v: (-len(v), v[0]))

    def tau_vec(self):
        return np.array([math.sqrt(float(self.tau2(c, rec))) for c in range(len(self.cfg)) for rec in range(self.nrec)])

    def Dfloat(self, D=None, idx=None):
        """True discriminant (unitary basis) as a complex matrix, on the listed states."""
        D = D or self.Dsparse()
        idx = list(range(self.ncr)) if idx is None else idx
        pos = {s: t for t, s in enumerate(idx)}
        tau = self.tau_vec()
        M = np.zeros((len(idx), len(idx)), dtype=complex)
        for j in idx:
            for i, v in D[j].items():
                M[pos[i], pos[j]] = to_complex(v) * tau[i] / tau[j]
        return M

    def Dmod(self, D, idx, p, wp):
        """D~ - I modulo p on the listed states (int64)."""
        pos = {s: t for t, s in enumerate(idx)}
        M = np.zeros((len(idx), len(idx)), dtype=np.int64)
        for j in idx:
            for i, v in D[j].items():
                M[pos[i], pos[j]] = to_mod(v, p, wp)
        for t in range(len(idx)):
            M[t, t] = (M[t, t] - 1) % p
        return M

    def Dexact(self, D, idx):
        pos = {s: t for t, s in enumerate(idx)}
        zero = Fr(0)
        M = [[zero] * len(idx) for _ in idx]
        for j in idx:
            for i, v in D[j].items():
                M[pos[i]][pos[j]] = v
        return M


# ---------------------------------------------------------------------- linear algebra
def nullspace(M):
    """Exact basis of the kernel of a matrix over Q or Q(w) (list of rows)."""
    rows = [list(r) for r in M]
    ncol = len(rows[0]) if rows else 0
    piv = []
    r = 0
    for c in range(ncol):
        p = next((i for i in range(r, len(rows)) if rows[i][c] != 0), None)
        if p is None:
            continue
        rows[r], rows[p] = rows[p], rows[r]
        inv = 1 / rows[r][c]
        rows[r] = [x * inv if x != 0 else x for x in rows[r]]
        pr = rows[r]
        nz = [t for t in range(ncol) if pr[t] != 0]
        for i in range(len(rows)):
            if i != r and rows[i][c] != 0:
                f = rows[i][c]
                ri = rows[i]
                for t in nz:
                    ri[t] = ri[t] - f * pr[t]
        piv.append(c)
        r += 1
        if r == len(rows):
            break
    free = [c for c in range(ncol) if c not in piv]
    basis = []
    for f in free:
        v = [Fr(0)] * ncol
        v[f] = Fr(1)
        for i, c in enumerate(piv):
            v[c] = -rows[i][f]
        basis.append(v)
    return basis


def rank_exact(rows):
    if not rows or not rows[0]:
        return 0
    return len(rows[0]) - len(nullspace(rows))


def mod_rank(M, p):
    """Rank of an int64 matrix modulo p (entries reduced, p < 2^31)."""
    A = np.array(M, dtype=np.int64) % p
    nr, nc = A.shape
    r = 0
    for c in range(nc):
        if r == nr:
            break
        nzr = np.nonzero(A[r:, c])[0]
        if len(nzr) == 0:
            continue
        pr = r + int(nzr[0])
        if pr != r:
            A[[r, pr]] = A[[pr, r]]
        inv = pow(int(A[r, c]), -1, p)
        A[r] = (A[r] * inv) % p
        f = A[:, c].copy()
        f[r] = 0
        rows = np.nonzero(f)[0]
        if len(rows):
            A[rows] = (A[rows] - (f[rows, None] * A[r][None, :]) % p) % p
        r += 1
    return r


def minus_identity(M):
    return [[M[i][j] - (1 if i == j else 0) for j in range(len(M))] for i in range(len(M))]


def fstr(x):
    return repr(x) if isinstance(x, Qw) else str(x)


def jdump(obj, path):
    with open(path, 'w') as fh:
        json.dump(obj, fh, indent=1, default=str)


# ---------------------------------------------------------------------- the two geometries
def hexagon(law, k=0, seam=0, nloads=3):
    """Hexagon model with the class-k link phase w^k on the reference orientation of one hexagon seam."""
    return Model(HEX, HEX_SEAMS, law, nloads=nloads, flux=({seam: k} if k % 6 else {}))


def dual_path(faces, f_from, f_to):
    """Shortest dual path between two faces (the construction of LP's lp3b_carrier.py)."""
    def shared(x, y):
        s = set(x) & set(y)
        return tuple(sorted(s)) if len(s) == 2 else None
    prev = {f_from: None}
    queue = [f_from]
    while queue:
        nxt = []
        for x in queue:
            for y in faces:
                if y not in prev and shared(x, y):
                    prev[y] = x
                    nxt.append(y)
        queue = nxt
    path = [f_to]
    while prev[path[-1]] is not None:
        path.append(prev[path[-1]])
    path = list(reversed(path))
    return path, [shared(path[i], path[i + 1]) for i in range(len(path) - 1)]


def carrier_flux(k):
    """Exponents of the class-k string from f to f' on the carrier seams (the orientation rule of LP's lp6_classes.py)."""
    car = FC.carrier()
    seams = [tuple(s) for s in car['seams']]
    faces = list(FC.faces())
    path, crossed = dual_path(faces, FACE_F, FACE_FP)
    sidx = {frozenset(e): i for i, e in enumerate(seams)}
    flux = {}
    left = None
    prev = None
    for e in crossed:
        u, v = e
        if left is None:
            left = u
        elif left not in e:
            left = u if (v in prev) else v
        i = sidx[frozenset(e)]
        x, y = seams[i]
        flux[i] = (k if x == left else -k) % 6
        prev = e
    return seams, faces, path, crossed, flux


def carrier(law, k=0, nloads=3):
    seams, faces, path, crossed, flux = carrier_flux(k)
    return Model(list(range(12)), seams, law, nloads=nloads, flux=flux)


def face_fluxes(model, faces):
    """Class of the flux through each face (product of the link phases in the outward cyclic order)."""
    sidx = model.seam_set
    out = {}
    for f in faces:
        p, q, r = FC.outward(f)
        tot = 0
        for (a, b) in ((p, q), (q, r), (r, p)):
            i = sidx[frozenset((a, b))]
            e = model.flux.get(i, 0)
            tot += e if model.seams[i] == (a, b) else -e
        if tot % 6:
            out[str(list(f))] = tot % 6
    return out
