"""QT: builds RESULTS.md from the result files of this directory (no computation, no measured value)."""
from __future__ import annotations

import json
import sys

TYPES = ('triple', 'double+single', 'separated')


def load(name):
    with open(name) as fh:
        return json.load(fh)


def cnt(pt, modnull_proves_zero=True):
    """Count of consensus states on the blank cyclic subspace with its label."""
    f, e, mn = (pt['consensus states on the blank cyclic subspace (float)'], pt['consensus states on the blank cyclic subspace (exact)'],
                pt['modular nullity (upper bound, exact)'])
    if e is not None:
        return f'{e}'
    if mn == 0:
        return '0'
    return f'{f} (see E1)'


def main():
    c0 = load('qt0_checks.json')
    hx = load('qt1_hexagon.json')
    ca = load('qt1_carrier_A.json')
    cb = load('qt1_carrier_BC.json')
    ex = load('qt1b_exact.json')
    an = load('qt2_analyzer.json')
    nf = load('qt3_nfold.json')
    L = []
    A = L.append
    A('# Worker QT: results (generated by `qt_results.py` from the result files; no measured value was read)')
    A('')
    A('Law: plain law. Address premise: uniform consensus address. Completion at seam total three: DECLARED candidates')
    A('T-A (agreeing-state pump), T-B (single emission), T-C (current record). Counts are EXACT; values of A are MEASURED')
    A('(float64, ten digits).')
    A('')
    A('## 1. Checks')
    A('')
    for name in ('T-A', 'T-B', 'T-C'):
        r = c0['C2_and_N'][name]
        A(f"- {name}: real symmetric {r['real symmetric']}, involution {r['involution']}, conserves the load {r['conserves the load']}, "
          f"equals the public completion on totals 0 to 2 {r['equals the public completion on totals 0 to 2 (576 entries)']}, "
          f"native populations at total three {r['N: all total-three states pass']}.")
    A(f"- C1, two loads against LP's table, hexagon and carrier, six classes: all rows agree {c0['C1_two_loads_against_LP']['all rows agree with LP']}.")
    g = hx['C3_gauge']
    worst = max(v['largest spectral difference to seam 0'] for v in g['class-2 phase on each hexagon seam'].values())
    A(f"- C3, class-2 phase moved to each hexagon seam: largest spectral difference {worst:.1e}; conjugate classes: "
      f"{max(g['largest spectral difference between conjugate classes'].values()):.1e}.")
    A(f"- Double+single and separated blocks equal for the three laws (hexagon): {hx['double+single and separated blocks equal for the three laws']}.")
    A('')
    A('## 2. Consensus states on the cyclic subspace of the blank preparations')
    A('')
    A('Entries: number of independent consensus states (triple, double and single, separated).')
    A('')
    A('| Class | Hexagon T-A | Hexagon T-B | Hexagon T-C | Carrier T-A | Carrier T-B, triple | Carrier T-C, triple |')
    A('| --- | --- | --- | --- | --- | --- | --- |')
    for k in range(6):
        row = [f'{k}']
        for name in ('T-A', 'T-B', 'T-C'):
            bt = hx['laws'][name][f'class {k}']['by type']
            row.append('(' + ', '.join(cnt(bt[t]) for t in TYPES) + ')')
        bt = ca['laws']['T-A'][f'class {k}']['by type']
        row.append('(' + ', '.join(cnt(bt[t]) for t in TYPES) + ')')
        for name in ('T-B', 'T-C'):
            row.append(cnt(cb['laws'][name][f'class {k}']['by type']['triple']))
        A('| ' + ' | '.join(row) + ' |')
    A('')
    e1 = ex['E1_carrier_class_0']
    A(f"E1 (carrier, class 0): the uniform separated state is fixed exactly ({e1['fixed by D exactly']}) and the modular nullity of its "
      f"component is {e1['modular nullity of its component']}; the uniform double+single state with its emission states is fixed exactly "
      f"({e1['fixed by D exactly (double+single)']}) and the modular nullity is {e1['modular nullity of its component (double+single)']}. Both counts are 1.")
    A('')
    A('Fixed vectors of D on the components that contain the blank preparations (the count of LP\'s table convention), law T-A:')
    A('')
    A('| Class | Hexagon (triple, double and single, separated) | Carrier (triple, double and single, separated) |')
    A('| --- | --- | --- |')
    for k in range(6):
        h = hx['laws']['T-A'][f'class {k}']['by type']
        c = ca['laws']['T-A'][f'class {k}']['by type']
        A(f"| {k} | ({', '.join(str(h[t]['fixed vectors on these components (float)']) for t in TYPES)}) | "
          f"({', '.join(str(c[t]['fixed vectors on these components (float)']) for t in TYPES)}) |")
    A('')
    A('In the triple component 12 (hexagon) and 60 (carrier) of these are the antisymmetric shell states with record 2 or 3,')
    A('which no event touches. In the hexagon double+single component one is a record-1 state without a blank part (E2).')
    for k in (0, 2, 4):
        w = ex['E2_hexagon'][f'class {k}']['written-record vector of the double+single component (record 1 only)']
        A(f"- E2, hexagon class {k}: {len(w)} such vector, support {w[0]['support']}, equal moduli {w[0]['equal moduli']}, fixed exactly {w[0]['fixed by D exactly']}.")
    A('')
    A('## 3. Lowest A on each cyclic subspace (law T-A; double+single and separated are law independent)')
    A('')
    A('| Class | Hexagon triple | Hexagon double and single | Hexagon separated | Carrier triple | Carrier double and single | Carrier separated |')
    A('| --- | --- | --- | --- | --- | --- | --- |')
    for k in range(6):
        h = hx['laws']['T-A'][f'class {k}']['by type']
        c = ca['laws']['T-A'][f'class {k}']['by type']
        vals = [abs(h[t]['lowest A on the cyclic subspace']) for t in TYPES] + [abs(c[t]['lowest A on the cyclic subspace']) for t in TYPES]
        A(f'| {k} | ' + ' | '.join(f'{v:.10f}' for v in vals) + ' |')
    A('')
    A('States at the lowest A (weights by content and record value; carrier, law T-A):')
    A('')
    for k in (1, 3, 5):
        c = ca['laws']['T-A'][f'class {k}']['by type']
        for t in TYPES:
            st = c[t].get('state at the largest eigenvalue')
            A(f"- class {k}, {t}: dimension {st['dimension on the cyclic subspace']}, weights {st['weights by content and record']}")
    A('')
    A('## 4. Analyzer rows')
    A('')
    ctl = an['control: pair around a class-3 flux, hexagon']
    cc = ctl['circulants']['A1']
    A(f"Control, pair around a class-3 flux: weights {ctl['(w_0, w_H, w_+, w_-)']}, theta = {ctl['theta = P(R+ xor H)']}, ratios "
      f"{cc['y_mid / y_min']} and {cc['y_max / y_min']}, Q = {cc['Q = sum y / (sum sqrt y)^2']}.")
    A('')
    A('| Row | Law, model, class | Selected | (w_0, w_H, w_+, w_-) | theta | Circulant | y_k (k = 0, 1, 2) | y_mid/y_min | y_max/y_min | y_max/y_mid | Q | sum y |')
    A('| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |')

    def emit(label, where, sel, r, mode):
        c = r['circulants'][mode]
        A(f"| {label} | {where} | {sel} | ({', '.join(r['(w_0, w_H, w_+, w_-)'])}) | {r['theta = P(R+ xor H)']} | {mode} | "
          f"{', '.join(v[:14] for v in c['y_k (k = 0, 1, 2)'])} | {c['y_mid / y_min']} | {c['y_max / y_min']} | {c['y_max / y_mid']} | "
          f"{c['Q = sum y / (sum sqrt y)^2']} | {c['sum of y_k'][:14]} |")
    for k in (0, 2, 4):
        sel = 'yes' if k in (2, 4) else 'no (three consensus states)'
        emit('R1', f'T-A, hexagon, class {k}', sel, an['law T-A'][f'R1 and R3, class {k}'], 'A1')
    for k in (0, 2, 4):
        sel = 'yes' if k in (2, 4) else 'no (three consensus states)'
        emit('R2', f'T-A, carrier, class {k}', sel, an['law T-A'][f'R2, class {k}'], 'A1')
    for k in (0, 2, 4):
        sel = 'yes' if k in (2, 4) else 'no (three consensus states)'
        emit('R3', f'T-A, hexagon, class {k}', sel, an['law T-A'][f'R1 and R3, class {k}'], 'A2')
    for k in (0, 2, 4):
        emit('R4', f'T-C, hexagon, class {k}, flag set single', 'no (one consensus state per port)',
             an['laws T-B and T-C (uniform triple)'][f'R4: T-C, flag set single, hexagon, class {k}'], 'A1')
    for lab in ('T-B, flags as R1', 'T-C, flag set all'):
        for geo in ('hexagon', 'carrier'):
            emit('under R1' if geo == 'hexagon' else 'under R2', f'{lab}, {geo}, class 2', 'no (one consensus state per port)',
                 an['laws T-B and T-C (uniform triple)'][f'{lab}, {geo}, class 2'], 'A1')
    A('')
    r = an['law T-A']['R1 and R3, class 2']
    p = r['consensus state on the cyclic subspace']
    A(f"Consensus state of the triple, T-A, hexagon, class 2: support {p['basis states in its support']} basis states, equal moduli "
      f"{p['all scaled amplitudes of equal modulus']}, blank-record weight {p['weight of its blank-record part']}; standing state: "
      f"{r['standing state']['configurations']} triples with squared moduli {r['standing state']['squared moduli of its amplitudes']}; "
      f"inverse tick restores it: {r['inverse tick restores the standing state']}.")
    r = an['law T-A']['R2, class 2']
    p = r['consensus state on the cyclic subspace']
    A(f"The same on the carrier: support {p['basis states in its support']}, equal moduli {p['all scaled amplitudes of equal modulus']}, "
      f"blank-record weight {p['weight of its blank-record part']}; {r['standing state']['configurations']} triples; one triple at any single "
      f"port gives {r['one triple at a single port: distinct (w_0, w_H, w_+, w_-, theta)']}.")
    r = an['law T-A']['R1 and R3, class 2']
    A(f"One triple at a single hexagon port gives {r['one triple at a single port: distinct (w_0, w_H, w_+, w_-, theta)']} (orbit B, orbit A).")
    A('R5+: no further content is selected in class 2 or 4.')
    A('')
    A('## 5. X6: n-fold loads under the agreeing-state pump at every total')
    A('')
    for geo in ('hexagon', 'carrier'):
        t = nf['X6'][geo]
        A(f"{geo.capitalize()}: lowest A of the block by crossing phase w^m, m = 0 to 5: "
          + ', '.join(f"{abs(t['by crossing phase w^m'][str(m)]['lowest A']):.10f}" for m in range(6))
          + f"; fixed vectors: {', '.join(str(t['by crossing phase w^m'][str(m)]['fixed vectors (exact)']) for m in range(6))}.")
        A('')
        A('| n | ' + ' | '.join(f'class {k}' for k in range(6)) + ' |')
        A('| --- | --- | --- | --- | --- | --- | --- |')
        for n in range(2, 7):
            A(f'| {n} | ' + ' | '.join(str(t['by load number and class'][f'n = {n}'][f'class {k}']['fixed vectors (exact)']) for k in range(6)) + ' |')
        A(f"Selected exactly when n k is a multiple of six: {t['selected exactly when n k is a multiple of six']}.")
        A('')
    s = nf['size of the full six-load problem']
    A(f"Full six-load problem: {s['configurations on the hexagon']} configurations on the hexagon, {s['configurations on the carrier']} on the carrier; {s['status']}.")
    A('')
    with open('RESULTS.md', 'w') as fh:
        fh.write('\n'.join(L))
    print('written RESULTS.md', len(L), 'lines')


if __name__ == '__main__':
    sys.exit(main())
