            'SIM/runs/universe/L6/view/early_universe.json': sha(RUN / 'view/early_universe.json'),
            'SIM/runs/universe/L6/cuts/end.npz': sha(RUN / 'cuts/end.npz'),
            'SIM/runs/universe/L6/run.json': sha(RUN / 'run.json')},
        reports=['repair-law/MATCH.md', 'repair-law/reports/SS.md', 'repair-law/reports/DG.md', 'repair-law/reports/GL.md',
                 'repair-law/reports/CH_HYPERCHARGE.md']),
    levels=[dict(id=LEVELS[i], kind='colour' if i < 3 else 'weak', colour=COLOURS[i] if i < 3 else None, six_Y=SIX_Y_LEVEL[i],
                 Y=F(SIX_Y_LEVEL[i], 6), T3=T3_LEVEL[i], Q=Q_LEVEL[i]) for i in range(5)],
    patterns=P, multiplets=MULTIPLETS, class_table=CLASS_TABLE,
    anomaly_sums={'16': AN16, '16bar': AN16B},
    copies=dict(count=3, names={k: dict(symbols=list(v['syms']), names=list(v['names'])) for k, v in SPECIES.items()},
                note='The copy changes no charge. Three copies per pattern: 32 Weyl blocks per copy (CH).'),
    bosons=dict(
        currents=CURRENTS,
        groups=[dict(name='gluons', symbol='g', count=8, rep='(8,1)_0', Q='0', k=0, spin='1', statistics='boson',
                     action='six moves between colour levels and two diagonal generators'),
                dict(name='W', symbol='W', count=3, rep='(1,3)_0', Q='+1, -1, 0', k=0, spin='1', statistics='boson',
                     action='W+ moves s2 to s1, W- moves s1 to s2, W3 is diagonal'),
                dict(name='B', symbol='B', count=1, rep='(1,1)_0', Q='0', k=0, spin='1', statistics='boson',
                     action='the hypercharge generator Y')],
        mixing=dict(photon='the combination of W3 and B with generator Q = T3 + Y; the neutral register component H0 carries Q = 0',
                    Z='the other combination of W3 and B', note='The decoder carries no mixing angle and no mass.'),
        spin_label='integer EXACT; vector with two polarizations taken from GL and X5 (SS table)',
        not_gauged=dict(count=len(LEPTOQUARK), six_dY=[-5, 5], classes=[1, 5],
                        note='Moves between a colour level and a weak level change 6Y by 5. They are not among the twelve currents (GL).'),
        higgs=HIGGS),
    composites=dict(
        rule='A set of quanta has a colour singlet component exactly when every colour level is occupied equally often over the set. '
             'A colour singlet set has class sum 0 or 3. It is class neutral exactly when it holds an even number of doublet patterns.',
        no_mass='The decoder carries no masses. Names follow the flavour content; the order of states inside a flavour content is that of the quark model.',
        names_label='Names of the quark model in the naming scheme for hadrons of the Particle Data Group. Lowest states only: '
                    'pseudoscalar mesons, baryons of spin 1/2 and 3/2. A content with a top quark has no entry. '
