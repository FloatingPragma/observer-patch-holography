"""Self tests of gauge_mc.py (task MA, run H4).

    python gauge_selftest.py [quick|full] [out.json]

quick (local, numpy only): gauge invariance, W(1,1) = plaquette, cluster bookkeeping on hand-made fields, strong-coupling
    single-plaquette value at small kappa.
full (box): in addition exact enumeration of Z2 on the 2^3 torus (2^24 states) against both heat-bath engines, and
    numpy against numba at the same kappa for Z2 and Z3.
"""
import json, sys, time
import numpy as np
import gauge_mc as G

mode = sys.argv[1] if len(sys.argv) > 1 else 'quick'
outf = sys.argv[2] if len(sys.argv) > 2 else None
rng = np.random.default_rng(1); res = {}; t0 = time.time()

# 1. gauge invariance and W(1,1)
for N in (2, 3):
    n = G.hot((6, 6, 6), N, rng); p0 = G.plaquette_ints(n, N)
    lam = rng.integers(0, N, (6, 6, 6))
    m = np.stack([(n[mu] + lam - np.roll(lam, -1, mu)) % N for mu in range(3)]).astype(np.int16)
    W = G.wilson_loops(n, N, 3)
    res[f'Z{N}_gauge_invariance'] = bool(np.all(G.plaquette_ints(m, N) == p0)) and bool(np.allclose(G.wilson_loops(m, N, 3), W))
    res[f'Z{N}_W11_equals_plaquette'] = bool(abs(W[0, 0] - G.plaquette_obs(n, N)[1]) < 1e-12)
print('gauge invariance / W11', res, flush=True)

# 2. clusters on hand-made fields
n = G.cold((8, 8, 8)); n[1, 3, 4, 5] = 1
c = G.flux_clusters(n, 2); res['single_link_cluster'] = [c['clusters'], c['largest'][0]]               # expect 1 cluster of 4
n = G.cold((8, 8, 8)); n[0, 2, 2:6, :] = 1                                                                   # sheet -> two lines along axis 2
c = G.flux_clusters(n, 2); res['two_lines_clusters'] = [c['clusters'], c['largest'][:2], c['large_clusters'][0]['wraps_axes']]
n = G.cold((8, 8, 8)); n[0, 2, 2:6, 3:6] = 1                                                                 # finite sheet -> one closed loop
c = G.flux_clusters(n, 2); res['closed_loop'] = [c['clusters'], c['largest'][:1], c.get('large_clusters', [])]
print('clusters', res['single_link_cluster'], res['two_lines_clusters'], res['closed_loop'], flush=True)

# 3. strong coupling: <Re W> = single-plaquette average + O(u^5)
for N, kappa in ((2, 0.15), (3, 0.2)):
    ct = G.cos_table(N); sp = float((ct * np.exp(kappa * ct)).sum() / np.exp(kappa * ct).sum())
    n = G.hot((8, 8, 8), N, rng); hb = G.HeatBath(n, N, kappa, 5, engine='numpy'); hb.sweeps(20)
    e = []
    for _ in range(150):
        hb.sweeps(1); e.append(G.plaquette_obs(n, N)[1])
    m, err = G.binned(e, 10)
    res[f'Z{N}_strong_coupling_kappa{kappa}'] = {'mc': m, 'err': err, 'single_plaquette': sp}
    print(f'Z{N} kappa {kappa}: MC {m:.5f} +- {err:.5f}, single plaquette {sp:.5f}', flush=True)

if mode == 'full':
    # 4. exact enumeration Z2, 2x2x2 torus, 24 links
    shape = (2, 2, 2); beta = 0.5
    idx = {}
    for mu in range(3):
        for x in np.ndindex(shape):
            idx[(mu,) + x] = len(idx)
    plaq = []
    for mu, nu in G.PLANES:
        for x in np.ndindex(shape):
            xm = list(x); xm[mu] = (xm[mu] + 1) % 2; xn = list(x); xn[nu] = (xn[nu] + 1) % 2
            plaq.append([idx[(mu,) + x], idx[(nu,) + tuple(xm)], idx[(mu,) + tuple(xn)], idx[(nu,) + x]])
    plaq = np.array(plaq)
    Z = 0.0; S = 0.0; chunk = 1 << 20
    for start in range(0, 1 << 24, chunk):
        s = np.arange(start, start + chunk, dtype=np.int64)
        bits = ((s[:, None] >> np.arange(24)) & 1).astype(np.int8)
        par = bits[:, plaq].sum(2) % 2
        u = (1 - 2 * par).sum(1).astype(float)                       # sum of U_p
        w = np.exp(beta * (u - 24))
        Z += w.sum(); S += (w * u).sum()
    exact = S / Z / 24
    res['Z2_exact_2cube_beta0.5'] = {'exact_mean_Up': exact}
    for eng in (['numpy', 'numba'] if G.HAVE_NUMBA else ['numpy']):
        n = G.hot(shape, 2, rng); hb = G.HeatBath(n, 2, beta, 11, engine=eng); hb.sweeps(100); e = []
        for _ in range(200000 if eng == 'numba' else 40000):
            hb.sweeps(1); e.append(G.plaquette_obs(n, 2)[1]) if eng == 'numpy' else e.append(float(np.mean(1 - 2 * (G.plaquette_ints(n, 2)))))
        m, err = G.binned(e, 50)
        res['Z2_exact_2cube_beta0.5'][eng] = [m, err]
        print('exact', exact, eng, m, '+-', err, f'{time.time() - t0:.0f}s', flush=True)
    # 5. numpy against numba at intermediate coupling, 12^3
    if G.HAVE_NUMBA:
        for N, kappa in ((2, 0.74), (3, 1.0)):
            row = {}
            for eng in ('numpy', 'numba'):
                n = G.cold((12, 12, 12)); hb = G.HeatBath(n, N, kappa, 21, engine=eng); hb.sweeps(300); e = []
                for _ in range(3000):
                    hb.sweeps(1); e.append(G.plaquette_obs(n, N)[1])
                row[eng] = G.binned(e, 20)
            res[f'Z{N}_numpy_vs_numba_12^3_kappa{kappa}_cold_start'] = row
            print(N, kappa, row, f'{time.time() - t0:.0f}s', flush=True)
    if G.HAVE_NUMBA:
        n = G.cold((48, 48, 48)); hb = G.HeatBath(n, 3, 1.0, 3); hb.sweeps(1); t1 = time.time(); hb.sweeps(20)
        res['numba_seconds_per_sweep_48^3_Z3'] = (time.time() - t1) / 20
        t1 = time.time(); G.wilson_loops(n, 3, 8); res['seconds_per_wilson_8x8_48^3'] = time.time() - t1
        t1 = time.time(); G.plaquette_obs(n, 3); res['seconds_per_plaquette_48^3'] = time.time() - t1
        print({k: v for k, v in res.items() if 'seconds' in k}, flush=True)
res['seconds'] = time.time() - t0
if outf:
    json.dump(res, open(outf, 'w'), indent=1); print('written', outf)
