"""Run H3b: the pair of run H3 in a gas of long flux lines instead of smallest flux loops.

    python cf1_h3b.py N out.json

Background: straight Z3 flux lines along each axis, in line and antiline pairs joined by a sheet of links that carry
the phase. The number of lines is chosen so that the nontrivial plaquettes per carrier equal 0.2676, the density of
classes 2 and 4 of the committed level-10 run, the same as in runs H2 and H3. Only the shape of the flux differs:
H2 and H3 use independent random links, whose flux is a loop around one link. Readout as in H3.
"""
import json, sys, time
import numpy as np
from cf1_lib import Engine, positive_coin

N = int(sys.argv[1]); outf = sys.argv[2]
rng = np.random.default_rng(20261111); shape = (2 * N, N, N); cells = int(np.prod(shape)); w = np.exp(2j * np.pi / 3)
u = [np.ones(shape, complex) for _ in range(3)]
lines = {}
for a, b, c in ((0, 1, 2), (1, 2, 0), (2, 0, 1)):                 # lines along axis c; sheet of a-links spanning rows of axis b
    n_pairs = int(round(0.2676 / 3 * cells / shape[c] / 2)); lines[c] = 2 * n_pairs
    for _ in range(n_pairs):
        x0 = int(rng.integers(0, shape[a])); y0 = int(rng.integers(0, shape[b])); ext = int(rng.integers(1, shape[b] // 2)); ph = w if rng.random() < 0.5 else np.conj(w)
        rows = [(y0 + 1 + k) % shape[b] for k in range(ext)]
        idx = [slice(None)] * 3; idx[a] = x0; idx[b] = rows
        u[a][tuple(idx)] *= ph
def plaquette_density(u):
    n = 0
    for i in range(3):
        for j in range(i + 1, 3):
            W = u[i] * np.roll(u[j], -1, axis=i) * np.conj(np.roll(u[i], -1, axis=j)) * np.conj(u[j]); n += np.sum(np.abs(W - 1) > 1e-9)
    return float(n / cells)
p0 = 2 * np.pi * 8 / shape[0]; width = 5.0; start = (N // 3, N // 2, N // 2); coin = positive_coin((p0, 0, 0), 0.0); T = N
grids = np.meshgrid(*[np.arange(s) for s in shape], indexing='ij', sparse=True)
def ballistic(links):
    eng = Engine(shape, links); psi = eng.gaussian(start, width, (p0, 0, 0), coin); rows = []
    for t in range(T):
        psi = eng.step(psi, 0.0, 'Y', t)
        if (t + 1) % 4 == 0:
            rho = Engine.density(psi); xc = start[0] + (t + 1)
            dx = ((grids[0] - xc + shape[0] / 2) % shape[0]) - shape[0] / 2; dy = grids[1] - start[1]; dz = grids[2] - start[2]
            rows.append(float(rho[(np.abs(dx) <= 2.5 * width) & (np.sqrt(dy ** 2 + dz ** 2) <= 2.5 * width + 0 * dx)].sum()))
    return np.array(rows)
ts = np.arange(4, T + 1, 4); free = ballistic(None); t0 = time.time()
out = {'run': 'H3b', 'label': 'candidate CF-1, single quantum and rigid pair in a gas of straight Z3 flux lines, no rest angle', 'lattice': list(shape), 'seed': 20261111,
       'flux_lines_by_axis': lines, 'nontrivial_plaquettes_per_carrier': plaquette_density(u), 'target_per_carrier': 0.2676, 'ticks': [int(t) for t in ts], 'pairs': []}
print('lines', lines, 'plaquettes per carrier', out['nontrivial_plaquettes_per_carrier'], flush=True)
def rate(r):
    ok = r > 1e-3
    return float(-np.polyfit(ts[ok], np.log(r[ok]), 1)[0]) if ok.sum() >= 3 else float('nan')
single = ballistic(u) / free; r1 = rate(single); out['single'] = {'ballistic_share_relative_to_free': [float(x) for x in single], 'rate_per_tick': r1, 'mean_free_path_cells': 1 / r1}
print('single quantum: rate', round(r1, 5), 'mean free path', round(1 / r1, 2), flush=True)
for s in (0, 1, 2, 3, 4, 6, 8, 12, 16):
    links = None if s == 0 else [u[i] * np.conj(np.roll(u[i], -s, axis=1)) for i in range(3)]
    r = ballistic(links) / free; rr = rate(r) if s else 0.0
    out['pairs'].append({'separation': s, 'ballistic_share_relative_to_free': [float(x) for x in r], 'rate_per_tick': rr, 'rate_over_single_quantum_rate': rr / r1})
    print('pair s =', s, 'rate', round(rr, 5), 'rate / single', round(rr / r1, 3), 'share at the end', round(float(r[-1]), 4), f'{time.time() - t0:.0f}s', flush=True)
json.dump(out, open(outf, 'w'), indent=1); print('written', outf)
