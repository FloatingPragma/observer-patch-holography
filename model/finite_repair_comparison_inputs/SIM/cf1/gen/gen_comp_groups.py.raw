"""Task GEN, supplementary to P2.6 (near miss of the nominal rule): reaction counts of the composition groups of the
frozen classes at the end of the runs with carrier-tier identities (L3 to L6). Not part of the decision.

    python gen_comp_groups.py <run dir L> [<run dir> ...] <out.json>

For every defect face of class k on the end cut (intra_face, intra_cls, intra_id) the composition of its carrier is
read; per composition group: number of defects, share created by the fusion 1 + 3 -> 4 (product identity), share by
creation channel, and the number of 1 + 3 -> 4 fusions and of 3 + 3 annihilations that happened on the carriers of the
group during the whole run, per defect of the group (catalogue conventions as in observer/events.py).
"""
import json
import sys
from pathlib import Path

import numpy as np


def comp_name(cnt):
    ms = []
    for k in range(5):
        ms += [k + 1] * int(cnt[k])
    return '{' + ','.join(map(str, ms)) + '}'


def main():
    runs, out_path = sys.argv[1:-1], sys.argv[-1]
    out = {}
    for rd in runs:
        rd = Path(rd)
        meta = json.load(open(rd / 'run.json'))
        L = meta['config']['level']
        N = 20 * 4 ** L
        z = np.load(rd / 'catalogue.npz')
        cat = {k: z[k] for k in ('cls', 'tier', 'cause', 'parent1', 'parent2', 'child1', 'partner', 'birth_face', 'last_face')}
        cls = cat['cls'].astype(np.int64)
        cause = cat['cause'].astype(np.int64)
        p1, p2, c1, partner = (cat[k].astype(np.int64) for k in ('parent1', 'parent2', 'child1', 'partner'))
        n = len(cls)
        # fusion 1 + 3 -> 4 products, 3 + 3 annihilations
        jj = np.nonzero((p1 >= 0) & (p2 >= 0) & (cls == 4) & (cat['tier'] == 0))[0]
        okp = (cause[p1[jj]] == 2) & (np.sort(np.stack([cls[p1[jj]], cls[p2[jj]]], 1), 1) == np.array([1, 3])).all(1)
        fus_prod = np.zeros(n, bool); fus_prod[jj[okp]] = True
        fus_carrier = cat['birth_face'][jj[okp]].astype(np.int64) // 20
        kk = np.nonzero((cause == 1) & (cls == 3) & (partner >= 0) & (cat['tier'] == 0))[0]
        kk = kk[cls[partner[kk]] == 3]
        kk = kk[kk < partner[kk]]                                   # one row per event
        ann_carrier = cat['last_face'][kk].astype(np.int64) // 20
        origin = np.full(n, 'pair birth', dtype=object)
        origin[(p1 >= 0) & (p2 < 0)] = 'split product'
        two = (p1 >= 0) & (p2 >= 0)
        origin[two & (cause[np.where(p1 >= 0, p1, 0)] == 2)] = 'fusion product'
        origin[two & (cause[np.where(p1 >= 0, p1, 0)] == 4)] = 'exchange product'
        e = np.load(rd / 'cuts' / 'end.npz')
        face, ecls, eid = e['intra_face'].astype(np.int64), e['intra_cls'].astype(np.int64), e['intra_id'].astype(np.int64)
        W = np.zeros((N, 20), np.int64)
        W[face // 20, face % 20] = ecls
        cnt = np.stack([(W == k).sum(1) for k in range(1, 6)], 1)
        key = cnt @ (21 ** np.arange(5))
        fus_per_carrier = np.bincount(fus_carrier, minlength=N)
        ann_per_carrier = np.bincount(ann_carrier, minlength=N)
        res = {'end_sweep': meta['config']['sweeps'], 'fusion_1_3_to_4_events_carrier_tier': int(okp.sum()),
               'annihilation_3_3_events_carrier_tier': int(len(kk)), 'classes': {}}
        for k in (4, 2, 3):
            m = ecls == k
            car = face[m] // 20
            ids = eid[m]
            keys = key[car]
            u, inv, c = np.unique(keys, return_inverse=True, return_counts=True)
            rows = []
            for i in np.argsort(-c):
                sel = inv == i
                cars = np.unique(car[sel])
                ido = ids[sel]
                rows.append({'composition': comp_name(cnt[car[sel][0]]), 'defects': int(c[i]), 'share': float(c[i] / m.sum()),
                             'carriers': int(len(cars)),
                             'created_by_fusion_1_3_to_4': float(fus_prod[ido].mean()) if k == 4 else None,
                             'creation': {o: int((origin[ido] == o).sum()) for o in ('pair birth', 'split product', 'fusion product', 'exchange product')},
                             'fusion_1_3_to_4_events_on_these_carriers_per_defect': float(fus_per_carrier[cars].sum() / c[i]),
                             'annihilation_3_3_events_on_these_carriers_per_defect': float(ann_per_carrier[cars].sum() / c[i])})
            res['classes'][str(k)] = {'defects': int(m.sum()), 'groups': rows[:6]}
        out[f'L{L}'] = res
        print(L, {k: [(r['composition'], r['defects'], round(r['share'], 4), r['created_by_fusion_1_3_to_4'] if r['created_by_fusion_1_3_to_4'] is None else round(r['created_by_fusion_1_3_to_4'], 4),
                       round(r['fusion_1_3_to_4_events_on_these_carriers_per_defect'], 4), round(r['annihilation_3_3_events_on_these_carriers_per_defect'], 4))
                      for r in v['groups'][:3]] for k, v in res['classes'].items()})
    json.dump(out, open(out_path, 'w'), indent=1)


if __name__ == '__main__':
    main()
