"""Small exact-ish tools shared by the search: icosahedron, matchings, Lie closure (numerical rank with tolerance)."""
import itertools
import numpy as np

PHI = (1 + 5 ** 0.5) / 2


def icosahedron():
    V = []
    for s1 in (1, -1):
        for s2 in (1, -1):
            V += [(0, s1, s2 * PHI), (s1, s2 * PHI, 0), (s2 * PHI, 0, s1)]
    V = np.array(V, float)
    E = [(a, b) for a in range(12) for b in range(a + 1, 12) if abs(np.linalg.norm(V[a] - V[b]) - 2) < 1e-9]
    F = [(a, b, c) for a, b, c in itertools.combinations(range(12), 3)
         if all(abs(np.linalg.norm(V[x] - V[y]) - 2) < 1e-9 for x, y in ((a, b), (b, c), (a, c)))]
    return V, E, F


def octahedral_classes(V, E):
    """The five perfect matchings: edges whose midpoints lie on three mutually orthogonal axes."""
    mids = [(V[a] + V[b]) / 2 for a, b in E]
    mids = [m / np.linalg.norm(m) for m in mids]
    classes, used = [], set()
    for i in range(len(E)):
        if i in used:
            continue
        cls = [j for j in range(len(E)) if abs(abs(mids[i] @ mids[j]) - 1) < 1e-9 or abs(mids[i] @ mids[j]) < 1e-9]
        # keep those mutually orthogonal or parallel with all others in cls
        cls = [j for j in cls if all(abs(abs(mids[j] @ mids[k]) - 1) < 1e-9 or abs(mids[j] @ mids[k]) < 1e-9 for k in cls)]
        classes.append(cls)
        used.update(cls)
    return classes


def lie_closure(gens, tol=1e-9, max_dim=2000):
    """Real Lie algebra generated by anti-Hermitian matrices; returns an orthonormal basis (as real vectors) and dims per depth."""
    def vec(m):
        return np.concatenate([m.real.ravel(), m.imag.ravel()])
    basis, mats, dims = [], [], []

    def add(m):
        v = vec(m)
        for b in basis:
            v = v - (b @ v) * b
        n = np.linalg.norm(v)
        if n > tol * max(1.0, np.linalg.norm(vec(m))):
            v = v / n
            for b in basis:   # re-orthogonalise
                v = v - (b @ v) * b
            v = v / np.linalg.norm(v)
            basis.append(v)
            k = len(v) // 2
            d = int(round(k ** 0.5))
            mats.append((v[:k] + 1j * v[k:]).reshape(d, d))
            return True
        return False
    for g in gens:
        add(g)
    dims.append(len(basis))
    start = 0
    while True:
        new = 0
        n0 = len(mats)
        for i in range(n0):
            for j in range(max(start, i + 1), n0):
                c = mats[i] @ mats[j] - mats[j] @ mats[i]
                if add(c):
                    new += 1
                if len(basis) > max_dim:
                    return mats, dims + [len(basis)]
        start = 0
        dims.append(len(basis))
        if new == 0:
            break
    return mats, dims


def centre_dim(mats, tol=1e-8):
    """Dimension of the centre of the real Lie algebra spanned by mats (assumed a basis)."""
    n = len(mats)
    rows = []
    for j in range(n):
        cols = [np.concatenate([(mats[i] @ mats[j] - mats[j] @ mats[i]).real.ravel(), (mats[i] @ mats[j] - mats[j] @ mats[i]).imag.ravel()]) for i in range(n)]
        rows.append(np.array(cols).T)
    M = np.concatenate(rows, axis=0)
    s = np.linalg.svd(M, compute_uv=False)
    return int((s < tol * max(1.0, s[0])).sum()) if len(s) else n


def killing_signature(mats, tol=1e-8):
    n = len(mats)
    G = np.array([[np.vdot(a, b).real for b in mats] for a in mats])
    Gi = np.linalg.inv(G)

    def coords(m):
        return Gi @ np.array([np.vdot(a, m).real for a in mats])
    ad = np.zeros((n, n, n))
    for i in range(n):
        for j in range(n):
            ad[i][:, j] = coords(mats[i] @ mats[j] - mats[j] @ mats[i])
    K = np.array([[np.trace(ad[i] @ ad[j]) for j in range(n)] for i in range(n)])
    w = np.linalg.eigvalsh((K + K.T) / 2)
    return int((w < -tol).sum()), int((abs(w) <= tol).sum()), int((w > tol).sum())
