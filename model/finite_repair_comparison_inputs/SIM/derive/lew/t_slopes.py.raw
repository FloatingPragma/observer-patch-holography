"""Slope dependence of the chain (PREREGISTRATION Addendum 4): census D0 = (6, 1, -3) of worker DB.

Forward root P of the declared Thomson map (Stage-5 transport) with the slopes replaced, then the D10 packet, the
criticality at the K4 scale of that root (two loops), and the SMDR readout with A1 and A2. Writes t_slopes.json.
SMDR work files s.dat / u.dat.
"""
from __future__ import annotations

import json
import math

import lewlib as L

ICC = L.ICC
CLOSURE = L.CLOSURE
E = L.E_STAR_BRANCH
SLOPES = {"D0": (6, 1, -3)}


def forward_point(slopes) -> dict:
    mpb = ICC.MpBackend(40)
    mpb.b_mssm = tuple(mpb.num(x) for x in slopes)
    solver = ICC.PointSolver(mpb, 30, 30)
    alpha = solver.fixed_point(ICC.MODE_SOURCE)
    row = solver.inner(alpha, ICC.MODE_SOURCE)
    b = solver.b
    p, au, mz, mu_u, v = row["p"], row["alpha_u"], row["mz"], row["mu_u"], row["v"]
    a1, a2, a3 = (ICC.alpha_run(b, au, c, mz, mu_u) for c in b.b_mssm)
    cb = ICC.MpBackend(40)
    t = CLOSURE.mass_coefficients(cb, cb.num(b.ctx.nstr(p, 35)), cb.num(b.ctx.nstr(au, 35)))
    g1 = math.sqrt(4 * math.pi * float(a1))
    sq2 = math.sqrt(2.0)
    pk = {"Q0": float(mz) * E, "v": float(v) * E, "gY": math.sqrt(0.6) * g1,
          "g2": math.sqrt(4 * math.pi * float(a2)), "g3": math.sqrt(4 * math.pi * float(a3)),
          "yu": 6.0 ** -6, "yc": 6.0 ** -3, "yt": None, "yd": 6.0 ** -6, "ys": 6.0 ** -4, "yb": 6.0 ** -2,
          "ye": sq2 * float(t[0]), "ymu": sq2 * float(t[1]), "ytau": sq2 * float(t[2]), "lambda": None}
    pf = float(p)
    return {"P": b.ctx.nstr(p, 25), "alpha_inv": float(row["alpha_inv"]), "alpha_U": float(au),
            "sin2w_Q0": 0.6 * float(a1) / (0.6 * float(a1) + float(a2)), "alpha3_Q0": float(a3),
            "mu_c_GeV": E * math.exp(-math.pi) * pf ** (-1.0 / 6.0), "packet": pk}


def attach_a2(pk: dict) -> dict:
    vs = pk["v"]
    q = 163.0
    for _ in range(80):
        row = L.rg_to(pk, q, 5, name="u.dat")
        q_new = row["yt"] * vs / math.sqrt(2.0)
        if abs(q_new - q) < 1e-9:
            break
        q = q_new
    r = L.rg_to(pk, q, 5, name="u.dat")["v"] / vs
    new = dict(pk)
    new["v"] = vs / r
    return {"Q_t": q, "r": r, "outputs": L.readout(new)}


def main():
    L.compile_drivers()
    t1 = json.loads((L.LANE / "t1_chain.json").read_text())
    refs = t1["references_compare_only_GeV"]
    out = {"schema": "lew.t_slopes.v1", "census": {}}
    for name, slopes in SLOPES.items():
        pt = forward_point(slopes)
        pk = pt.pop("packet")
        crit = L.solve_criticality(pk, pt["mu_c_GeV"], 2, name="s.dat")
        pk["yt"], pk["lambda"] = crit["yt_Q0"], crit["lambda_Q0"]
        a1 = L.readout(pk)
        a2 = attach_a2(pk)
        pt.update({"slopes": slopes, "Q0_GeV": pk["Q0"], "v_source_GeV": pk["v"], "gY": pk["gY"], "g2": pk["g2"],
                   "g3": pk["g3"], "yt_Q0": crit["yt_Q0"], "lambda_Q0": crit["lambda_Q0"],
                   "boundary_lambda": crit["boundary"]["lambda"], "A1": a1, "A2": a2["outputs"],
                   "A2_scale_GeV": a2["Q_t"],
                   "gate_P_vs_DB": float(pt["P"]) / 1.6314884466 - 1.0,
                   "residual_percent_compare_only": {ak: {k: 100 * (o[k] / refs[k] - 1) for k in ("W", "Z", "H", "t")}
                                                     for ak, o in (("A1", a1), ("A2", a2["outputs"]))}})
        out["census"][name] = pt
    (L.LANE / "t_slopes.json").write_text(json.dumps(out, indent=2) + "\n")
    print(json.dumps(out, indent=1))


if __name__ == "__main__":
    main()
