"""Q4: masses from what the law produces, and (CONDITIONAL, not derived) from the target circulant. Writes q4_compare.json.

Formula (before evaluation): sqrt(m_k) = lambda_k (eigenvalue of the family operator), Q = sum m / (sum sqrt m)^2,
ratios against the lightest. Target circulant: lambda_k = sqrt(q) + 2 sqrt(p) cos(theta + 2 pi k/3), q = 1/6, p = 1/12.
MEASURED (brief): m_mu/m_e = 206.7682830(46), m_tau/m_e = 3477.23 +- 0.23.
"""
import json
from mpmath import mp, mpf, sqrt, cos, pi, findroot, acos

mp.dps = 40
MU_E, MU_E_SIG = mpf('206.7682830'), mpf('0.0000046')
TAU_E, TAU_E_SIG = mpf('3477.23'), mpf('0.23')


def koide(roots):
    return sum(r * r for r in roots) / sum(abs(r) for r in roots) ** 2


def ratios(roots):
    m = sorted(r * r for r in roots)
    return m[1] / m[0], m[2] / m[0]


out = {'question': 'Q4'}
# what the coherent law gives on the family band: scalar a I_3
a = mpf(11) / 12 + sqrt(5) / 60
band = [a, a, a]
out['law_family_band'] = {'eigenvalues': [str(x) for x in band], 'Q': str(koide(band)),
                          'mu_over_e': '1', 'tau_over_e': '1', 'status': 'EXACT; excluded by the MEASURED ratios'}
# face-orbit compression (19/20, 9/10, 9/10) as a second example of the law's real symmetric circulants
face = [mpf(19) / 20, mpf(9) / 10, mpf(9) / 10]
r1, r2 = ratios(face)
out['law_face_orbit'] = {'eigenvalues': ['19/20', '9/10', '9/10'], 'Q': str(koide(face)), 'ratios': [str(r1), str(r2)]}
# A-clock reading of the band (energy = correction probability) and Floquet reading: still equal
out['law_band_clocks'] = {'A_clock_energy_all_three': str(1 - a), 'Floquet_rest_phase_all_three': str(acos(a)),
                          'Q': '1/3 in both readings'}

# CONDITIONAL on the target circulant (not produced by the law)
p, q = mpf(1) / 12, mpf(1) / 6
def lam(theta):
    return [sqrt(q) + 2 * sqrt(p) * cos(theta + 2 * pi * k / 3) for k in range(3)]
t = mpf(2) / 9
L = lam(t)
r1, r2 = ratios(L)
d_fit = findroot(lambda x: ratios(lam(x))[0] - MU_E, mpf('0.2222'))
r1f, r2f = ratios(lam(d_fit))
out['CONDITIONAL_target_circulant_not_derived'] = {
    'theta': '2/9', 'sqrt_m_k': [str(x) for x in L], 'Q': str(koide(L)),
    'mu_over_e': str(r1), 'tau_over_e': str(r2),
    'mu_over_e_residual_ppm': str((r1 / MU_E - 1) * 10**6), 'mu_over_e_pull_sigma': str((r1 - MU_E) / MU_E_SIG),
    'tau_over_e_pull_sigma': str((r2 - TAU_E) / TAU_E_SIG),
    'theta_from_mu_over_e_with_Q_2_3': str(d_fit), 'theta_shift_ppm': str((d_fit / t - 1) * 10**6),
    'tau_over_e_at_that_theta': str(r2f), 'tau_pull_at_that_theta_sigma': str((r2f - TAU_E) / TAU_E_SIG),
    'status': 'CONDITIONAL: the law does not produce this circulant (Q2, Q3); numbers for reference only',
}
json.dump(out, open('q4_compare.json', 'w'), indent=1)
print(json.dumps(out, indent=1))
