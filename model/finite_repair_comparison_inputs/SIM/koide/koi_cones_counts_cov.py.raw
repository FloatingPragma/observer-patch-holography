"""Task KOI, part G-b, addition: turn covariance of every count vector with Q3 = 2/3 (sum of counts <= 12).
W = turn about (1,1,1) on the even copies (cones (x) spin), ZW = the turn carried through one tick (koi_cones.py).
Output: koide.json key 'G-b counts covariance'."""
import itertools
import numpy as np
from koide_lib import save
exec(open('koi_cones_counts.py').read().split("vecs =")[0].split("print('slot traces")[0])   # slot matrices Bs, Ms, rep, slots
u = (np.eye(2) - 1j * (np.array([[0, 1], [1, 0]]) + np.array([[0, -1j], [1j, 0]]) + np.diag([1.0, -1.0]))) / 2
P4 = np.zeros((4, 4)); Rmap = {0: 0, 1: 2, 2: 3, 3: 1}
for j, i in Rmap.items(): P4[i, j] = 1
W = np.kron(P4, u); Z = np.kron(np.diag([1, 1, -1, -1]), np.eye(2)); ZW = Z @ W
Wa, ZWa = W[2:, 2:], ZW[2:, 2:]
def comps(total, parts):
    if parts == 1:
        yield (total,); return
    for k in range(total + 1):
        for rest in comps(total - k, parts - 1): yield (k,) + rest
N = np.array([c for tot in range(1, 13) for c in comps(tot, 8)], dtype=np.int64)
G3 = np.rint(np.array([[np.trace(a @ b).real for b in Bs] for a in Bs])).astype(np.int64)
t3 = np.rint(np.array([np.trace(b).real for b in Bs])).astype(np.int64)
hit = np.where(3 * 2 * np.einsum('si,ij,sj->s', N, G3, N) == 2 * (N @ t3) ** 2)[0]
cov = []
for s in hit:
    B = sum(int(N[s, c]) * Bs[c] for c in range(8))
    cw, czw = np.abs(Wa @ B - B @ Wa).max() < 1e-12, np.abs(ZWa @ B - B @ ZWa).max() < 1e-12
    if cw or czw: cov.append((N[s].tolist(), bool(cw), bool(czw)))
print('Q3 = 2/3 vectors:', len(hit), '| turn-covariant among them:', len(cov), cov[:5])
save('G-b counts covariance', {'Q3_two_thirds_vectors': int(len(hit)), 'covariant_under_W_or_ZW': cov, 'label': 'EXACT (integer matrices, test to 1e-12)'})
