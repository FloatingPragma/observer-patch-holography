"""Task KOI: the answers as one key of koide.json (key 'summary'); run after all parts."""
from koide_lib import save, load
d = load()
need = ['G-a', 'G-e', 'G-e scan', 'G-b', 'G-b engine', 'G-b counts', 'G-b counts covariance', 'two_ninths', 'two_ninths_shift']
missing = [k for k in need if k not in d]
save('summary', {
 'parts_present': [k for k in need if k in d], 'parts_missing': missing,
 'Q_two_thirds': 'yes, exactly, only at rank two (lightest copy massless, delta = pi/12 by Lemma 3): G-b one even + one odd point source of equal angle on the axis cones (16 pairs; E0+O2 under W and E2+O0 under ZW are covariant circulants a = 2, |b| = sqrt2, arg b = 3pi/4); G-e particle along a body diagonal with loads on a face or belt triple plus one port (144 cases, not covariant). sqrt reading only (mass reading 0.5505). Rank three needs >= 10 equal sources (G-b; 4 covariant patterns up to 12, delta 0.0855) or tuned angles. G-a never.',
 'delta_two_ninths': 'never: Lemma 2 (algebraic copy matrices have algebraic cos 3delta; cos(2/3) transcendental); rest-phase readings give 0.27 to 0.90. Nearest natural: pi/15 (T5 face sum), 0.2117 (G-b covariant rank two, Q = 19/27), 0.2709 (M3 kernel). Lemma 3prime: rank two with delta = 2/9 has Q = 0.695325.',
 'body_diagonal_2_9': 'cannot enter a third-turn-covariant phase: (a) the free spectrum is a function on the cubic group and identical at all 32 rest points, so it adds E(q) times 1 to every copy matrix (a only); (b) delta is a q^0 quantity, 2/9 a q^3 coefficient; (c) Lemma 2; (d) the coefficient depends on the momentum unit (period: -2/9 per cell^2 = -2/27 in DP units; one-tick DP automaton: -+2/9 in DP units = 2 sqrt3/9 in cells); (e) no on-site unitary or antiunitary, plain or staggered, realises the turn on the period (exact nullspaces 0; half-turn control 2).',
 'lemmas': {'1': 'three rationals never have Q = 2/3', '2': 'algebraic copy matrix => delta != 2/9', '3': 'rank two and Q = 2/3 <=> ratio 2 - sqrt3 <=> delta = pi/12', '3prime': 'rank two: Q = 1/3 + 1/(6 cos^2(delta + 2pi/3))'},
 'labels': 'EXACT unless stated; flux-pair copy assignment on G-e MEASURED; beyond-first-order statement ARGUED'})
print('summary saved; missing parts:', missing)
