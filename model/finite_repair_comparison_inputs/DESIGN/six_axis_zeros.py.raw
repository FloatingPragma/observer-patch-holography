import json, numpy as np
from scipy.optimize import minimize
import six_axis as sa
d = json.load(open('six_axis.json'))
rows = []
for q0, ph in d['smallest_phases_away_from_origin']:
    r = minimize(lambda q: sa.phase(q)[0], np.array(q0), method='Nelder-Mead', options={'xatol': 1e-12, 'fatol': 1e-14, 'maxiter': 6000})
    q = r.x
    # chirality: sign of det of the Jacobian of the vector part of W2 at the zero
    def vec(q):
        W = sa.W2(q); return np.array([np.imag(np.trace(W @ s)) / 2 for s in sa.sig]) * -1
    J = np.array([(vec(q + 1e-6 * e) - vec(q - 1e-6 * e)) / 2e-6 for e in np.eye(3)]).T
    rows.append((np.round(q, 5).tolist(), float(r.fun), float(np.linalg.norm(q)), float(np.sign(np.linalg.det(J))), np.round(np.linalg.svd(J)[1], 4).tolist()))
    print('zero at q =', rows[-1][0], '|q| =', round(rows[-1][2], 5), 'residual phase', f'{r.fun:.2e}', 'chirality sign', rows[-1][3], 'speeds (singular values)', rows[-1][4])
def vec(q):
    W = sa.W2(q); return np.array([np.imag(np.trace(W @ s)) / 2 for s in sa.sig]) * -1
J0 = np.array([(vec(1e-6 * e) - vec(-1e-6 * e)) / 2e-6 for e in np.eye(3)]).T
print('origin: chirality sign', np.sign(np.linalg.det(J0)), 'speeds', np.round(np.linalg.svd(J0)[1], 4))
