// S7 kernel: native repair histories on an arbitrary seam graph, exact causal-order counts, longest chains,
// accumulated seam-current records, and a brute-force Minkowski control.
//
// Reference rule (NATIVE): draw a seam (a,b) uniformly and a fair coin c; d = x_a - x_b;
// j = floor(d/2) for c = 1 and ceil(d/2) for c = 0; x_a -= j; x_b += j.
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

static inline uint64_t rotl(const uint64_t x, int k) { return (x << k) | (x >> (64 - k)); }
static inline uint64_t next(uint64_t *s) {
  const uint64_t result = rotl(s[1] * 5, 7) * 9;
  const uint64_t t = s[1] << 17;
  s[2] ^= s[0]; s[3] ^= s[1]; s[1] ^= s[2]; s[0] ^= s[3]; s[2] ^= t; s[3] = rotl(s[3], 45);
  return result;
}
void s7_seed(uint64_t *s, uint64_t seed) {
  uint64_t z = seed;
  for (int i = 0; i < 4; i++) {
    z += 0x9e3779b97f4a7c15ULL;
    uint64_t x = z;
    x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;
    x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;
    s[i] = x ^ (x >> 31);
  }
}
static inline int64_t draw_seam(uint64_t *s, int64_t M) { return (int64_t)(((__uint128_t)next(s) * (uint64_t)M) >> 64); }
static inline int32_t native_current(int32_t d, int coin) {
  if ((d & 1) == 0) return d / 2;
  return coin ? (d - 1) / 2 : (d + 1) / 2;
}

// One history of T attempts. out_seam[t] = seam index, out_cur[t] = current (clipped to int8), out_coin optional.
void s7_history(int32_t *x, const int32_t *sa, const int32_t *sb, int64_t M, int64_t T, uint64_t *s,
                int32_t *out_seam, int8_t *out_cur, int8_t *out_coin) {
  for (int64_t t = 0; t < T; t++) {
    const int64_t e = draw_seam(s, M);
    const int coin = (int)(next(s) >> 63);
    const int32_t a = sa[e], b = sb[e];
    const int32_t j = native_current(x[a] - x[b], coin);
    x[a] -= j; x[b] += j;
    out_seam[t] = (int32_t)e;
    out_cur[t] = (int8_t)(j > 127 ? 127 : (j < -127 ? -127 : j));
    if (out_coin) out_coin[t] = (int8_t)coin;
  }
}

// History without storage: accumulate the seam-current record R (int64 per seam), the coin record S (sum of 1-2c),
// the move count K, the attempt count A. Any pointer may be NULL.
void s7_accumulate(int32_t *x, const int32_t *sa, const int32_t *sb, int64_t M, int64_t T, uint64_t *s,
                   int64_t *R, int64_t *S, int64_t *K, int64_t *A) {
  for (int64_t t = 0; t < T; t++) {
    const int64_t e = draw_seam(s, M);
    const int coin = (int)(next(s) >> 63);
    const int32_t a = sa[e], b = sb[e];
    const int32_t j = native_current(x[a] - x[b], coin);
    x[a] -= j; x[b] += j;
    if (R) R[e] += j;
    if (S) S[e] += 1 - 2 * coin;
    if (K) K[e] += (j != 0);
    if (A) A[e] += 1;
  }
}

// Exact interval statistics of the provenance order.
// Events: attempts t in [t0, t1] with use[t] != 0 (use == NULL: every attempt). An event precedes the next event on
// each of its two ports; the order is the transitive closure. Requires that t0 and t1 are events.
// Returns N = |{e : e0 <= e <= e1}| (0 if e1 is not in the future of e0), *R = number of strictly related pairs inside,
// *H = number of events in the longest chain from e0 to e1, *P = number of distinct ports in the interval,
// *L = number of links (covering relations generated by port succession, counted per shared port).
int64_t s7_interval(const int32_t *seam, const uint8_t *use, const int32_t *sa, const int32_t *sb, int32_t nports,
                    int64_t t0, int64_t t1, int64_t *R, int64_t *H, int64_t *P, int64_t *L) {
  const int64_t span = t1 - t0 + 1;
  uint8_t *fut = (uint8_t *)calloc((size_t)span, 1);
  uint8_t *mark = (uint8_t *)calloc((size_t)nports, 1);
  *R = 0; *H = 0; *P = 0; *L = 0;
  fut[0] = 1; mark[sa[seam[t0]]] = 1; mark[sb[seam[t0]]] = 1;
  for (int64_t t = t0 + 1; t <= t1; t++) {
    if (use && !use[t]) continue;
    const int32_t a = sa[seam[t]], b = sb[seam[t]];
    if (mark[a] || mark[b]) { fut[t - t0] = 1; mark[a] = 1; mark[b] = 1; }
  }
  if (!fut[span - 1]) { free(fut); free(mark); return 0; }
  memset(mark, 0, (size_t)nports);
  mark[sa[seam[t1]]] = 1; mark[sb[seam[t1]]] = 1;
  fut[span - 1] = 2;
  int64_t N = 1;
  for (int64_t t = t1 - 1; t >= t0; t--) {
    if (!fut[t - t0]) continue;
    const int32_t a = sa[seam[t]], b = sb[seam[t]];
    if (mark[a] || mark[b]) { fut[t - t0] = 2; mark[a] = 1; mark[b] = 1; N++; }
  }
  if (fut[0] != 2) { free(fut); free(mark); return 0; }
  // compact port ids
  int32_t *loc = (int32_t *)malloc(sizeof(int32_t) * (size_t)nports);
  for (int32_t p = 0; p < nports; p++) loc[p] = -1;
  int64_t np = 0;
  for (int64_t t = t0; t <= t1; t++) {
    if (fut[t - t0] != 2) continue;
    const int32_t a = sa[seam[t]], b = sb[seam[t]];
    if (loc[a] < 0) loc[a] = (int32_t)np++;
    if (loc[b] < 0) loc[b] = (int32_t)np++;
  }
  uint64_t **bs = (uint64_t **)calloc((size_t)np, sizeof(uint64_t *));   // bitset of the last event at the port and its past
  int64_t *len = (int64_t *)calloc((size_t)np, sizeof(int64_t));         // words
  int32_t **rc = (int32_t **)calloc((size_t)np, sizeof(int32_t *));      // shared reference counters
  int32_t *hp = (int32_t *)calloc((size_t)np, sizeof(int32_t));
  int64_t i = 0, rel = 0, links = 0; int32_t height = 0;
  for (int64_t t = t0; t <= t1; t++) {
    if (fut[t - t0] != 2) continue;
    const int32_t a = loc[sa[seam[t]]], b = loc[sb[seam[t]]];
    const int64_t w = (i >> 6) + 1;
    uint64_t *nb = (uint64_t *)calloc((size_t)w, sizeof(uint64_t));
    if (bs[a]) { const uint64_t *q = bs[a]; const int64_t n = len[a]; for (int64_t k = 0; k < n; k++) nb[k] |= q[k]; links++; }
    if (bs[b] && bs[b] != bs[a]) { const uint64_t *q = bs[b]; const int64_t n = len[b]; for (int64_t k = 0; k < n; k++) nb[k] |= q[k]; links++; }
    int64_t c = 0;
    for (int64_t k = 0; k < w; k++) c += __builtin_popcountll(nb[k]);
    rel += c;
    nb[i >> 6] |= (uint64_t)1 << (i & 63);
    const int32_t h = 1 + (hp[a] > hp[b] ? hp[a] : hp[b]);
    hp[a] = h; hp[b] = h; height = h;
    if (bs[a]) { if (--(*rc[a]) == 0) { free(bs[a]); free(rc[a]); } }
    if (bs[b]) { if (--(*rc[b]) == 0) { free(bs[b]); free(rc[b]); } }
    int32_t *r = (int32_t *)malloc(sizeof(int32_t)); *r = 2;
    bs[a] = nb; bs[b] = nb; len[a] = w; len[b] = w; rc[a] = r; rc[b] = r;
    i++;
  }
  for (int64_t p = 0; p < np; p++) if (bs[p]) { if (--(*rc[p]) == 0) { free(bs[p]); free(rc[p]); } }
  free(bs); free(len); free(rc); free(hp); free(loc); free(fut); free(mark);
  *R = rel; *H = height; *P = np; *L = links;
  return N;
}

// Longest chains from one marked event: val[p] = number of events in the longest chain from the event at attempt t0
// to the latest event at port p (0: port not in the causal future). Runs attempts (tb, te]; the caller sets
// val[sa[seam[t0]]] = val[sb[seam[t0]]] = 1 and passes tb = t0.
void s7_chain(int32_t *val, const int32_t *seam, const uint8_t *use, const int32_t *sa, const int32_t *sb, int64_t tb, int64_t te) {
  for (int64_t t = tb + 1; t <= te; t++) {
    if (use && !use[t]) continue;
    const int32_t a = sa[seam[t]], b = sb[seam[t]];
    const int32_t m = val[a] > val[b] ? val[a] : val[b];
    if (m > 0) { val[a] = m + 1; val[b] = m + 1; }
  }
}

// Control: n points (t, x[dim]) sorted by t, relation p < q iff |x_q - x_p| <= t_q - t_p (speed one).
// Returns related pairs among points with flag in[i] != 0 (in == NULL: all); chain[i] = longest chain ending at i
// that starts at point 0 (0 if not in the future of point 0).
int64_t s7_minkowski(const double *t, const double *x, int dim, int64_t n, const uint8_t *in, int32_t *chain) {
  int64_t rel = 0;
  for (int64_t i = 0; i < n; i++) chain[i] = 0;
  chain[0] = 1;
  for (int64_t i = 1; i < n; i++) {
    int32_t best = 0;
    for (int64_t k = 0; k < i; k++) {
      const double dt = t[i] - t[k];
      double r2 = 0.0;
      for (int d = 0; d < dim; d++) { const double dx = x[i * dim + d] - x[k * dim + d]; r2 += dx * dx; }
      if (r2 <= dt * dt) {
        if (!in || (in[i] && in[k])) rel++;
        if (chain[k] > best) best = chain[k];
      }
    }
    chain[i] = best > 0 ? best + 1 : 0;
  }
  return rel;
}
