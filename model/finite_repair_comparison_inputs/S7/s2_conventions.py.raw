"""Exact conventions for the accumulated seam-current record of one carrier (arithmetic in Q(sqrt5)).

Builds, in the pinned source chart (model.common_source.slow_geometry / oph_exact.carrier):
  B   (12 x 30)  boundary:  B[a,e] = +1, B[b,e] = -1 for seam e = (a,b), a < b      (x_t = x_0 - B R)
  C   (30 x 20)  face boundary: C[e,f] = +1 if oriented face f runs a -> b on seam e = (a,b), -1 if b -> a
  K = C C^T      (30 x 30) "curl-curl"; its spectral projectors split the cycle space ker B = im C
  W   (3 x 30)   axial readback, W[:,e] = u_a x u_b         (A = W R)
  V   (3 x 30)   polar readback, V[:,e] = u_b - u_a         (X_t - X_0 = V R, X = sum_p x_p u_p)
and checks every identity quoted in CONVENTIONS.md exactly. Writes s2_conventions.json and conventions_arrays.npz.
"""
import json
from fractions import Fraction as Fr
from pathlib import Path

import numpy as np

from model.common_source import slow_geometry

HERE = Path(__file__).resolve().parent
src = slow_geometry.source()


class Q5:
    """a + b sqrt5 with rational a, b."""
    __slots__ = ('a', 'b')

    def __init__(self, a=0, b=0):
        self.a = Fr(a); self.b = Fr(b)

    @staticmethod
    def of(x):
        return x if isinstance(x, Q5) else Q5(x)

    def __add__(self, o): o = Q5.of(o); return Q5(self.a + o.a, self.b + o.b)
    __radd__ = __add__
    def __neg__(self): return Q5(-self.a, -self.b)
    def __sub__(self, o): o = Q5.of(o); return Q5(self.a - o.a, self.b - o.b)
    def __rsub__(self, o): return Q5.of(o) - self
    def __mul__(self, o): o = Q5.of(o); return Q5(self.a * o.a + 5 * self.b * o.b, self.a * o.b + self.b * o.a)
    __rmul__ = __mul__
    def inv(self):
        n = self.a * self.a - 5 * self.b * self.b
        return Q5(self.a / n, -self.b / n)
    def __truediv__(self, o): return self * Q5.of(o).inv()
    def __eq__(self, o): o = Q5.of(o); return self.a == o.a and self.b == o.b
    def __hash__(self): return hash((self.a, self.b))
    def conj(self): return Q5(self.a, -self.b)
    def __float__(self): return float(self.a) + float(self.b) * 5 ** 0.5
    def __repr__(self):
        if self.b == 0: return str(self.a)
        if self.a == 0: return f'({self.b})*sqrt5'
        return f'{self.a} + ({self.b})*sqrt5'


ZERO, ONE = Q5(0), Q5(1)
PHI = Q5(Fr(1, 2), Fr(1, 2))
S5 = Q5(0, 1)


def mat(rows, cols, fill=None):
    return [[Q5(0) for _ in range(cols)] for _ in range(rows)]


def mul(X, Y):
    n, k, m = len(X), len(Y), len(Y[0])
    out = mat(n, m)
    for i in range(n):
        Xi = X[i]
        for t in range(k):
            x = Xi[t]
            if x.a == 0 and x.b == 0:
                continue
            Yt = Y[t]; oi = out[i]
            for j in range(m):
                y = Yt[j]
                if y.a == 0 and y.b == 0:
                    continue
                oi[j] = oi[j] + x * y
    return out


def tr(X): return [[X[i][j] for i in range(len(X))] for j in range(len(X[0]))]
def eye(n): return [[Q5(int(i == j)) for j in range(n)] for i in range(n)]
def add(X, Y, s=1): return [[x + s * y for x, y in zip(r, q)] for r, q in zip(X, Y)]
def scal(c, X): return [[c * x for x in r] for r in X]
def equal(X, Y): return all(x == y for r, q in zip(X, Y) for x, y in zip(r, q))
def is_zero(X): return all(x == ZERO for r in X for x in r)
def trace(X): return sum((X[i][i] for i in range(len(X))), Q5(0))
def fl(X): return np.array([[float(x) for x in r] for r in X])


def cross(u, v):
    return [u[1] * v[2] - u[2] * v[1], u[2] * v[0] - u[0] * v[2], u[0] * v[1] - u[1] * v[0]]


def dot(u, v): return u[0] * v[0] + u[1] * v[1] + u[2] * v[2]


def build():
    seams = [tuple(int(v) for v in s) for s in src.seams()]
    faces = [tuple(int(v) for v in f) for f in src.oriented_faces()]
    raw = [[Q5.of(Q5(c[0], c[1])) for c in vec] for vec in slow_geometry.raw_frame()]     # entries (a, b) = a + b sqrt5
    norm2 = dot(raw[0], raw[0])                                                          # phi + 2
    assert all(dot(r, r) == norm2 for r in raw) and norm2 == PHI + 2
    B = mat(12, 30)
    for e, (a, b) in enumerate(seams):
        assert a < b
        B[a][e] = Q5(1); B[b][e] = Q5(-1)
    key = {s: e for e, s in enumerate(seams)}
    C = mat(30, 20)
    for f, (p, q, r) in enumerate(faces):
        for u, v in ((p, q), (q, r), (r, p)):
            e = key[(min(u, v), max(u, v))]
            C[e][f] = Q5(1 if u < v else -1)
    W = mat(3, 30); Wc = mat(3, 30)
    for e, (a, b) in enumerate(seams):
        w = cross(raw[a], raw[b])
        rc_a = [x.conj() for x in raw[a]]; rc_b = [x.conj() for x in raw[b]]
        wc = cross(rc_a, rc_b)
        for i in range(3):
            W[i][e] = w[i] / norm2                 # u_a x u_b, unit port vectors
            Wc[i][e] = wc[i] / norm2.conj()        # Galois conjugate frame
    return seams, faces, raw, norm2, B, C, W, Wc


def main():
    seams, faces, raw, norm2, B, C, W, Wc = build()
    out = {'checks': {}}
    chk = out['checks']
    # adjacency and antipodes in the chart
    chk['seam_dot_is_phi'] = all(dot(raw[a], raw[b]) == PHI for a, b in seams)                 # u_a . u_b = 1/sqrt5
    chk['unit_dot_is_1_over_sqrt5'] = (PHI / norm2) == S5.inv()
    # orientation of faces: det(u_p, u_q, u_r) sign
    dets = [dot(raw[p], cross(raw[q], raw[r])) for p, q, r in faces]
    chk['faces_counterclockwise_from_outside'] = all(float(d) > 0 for d in dets)
    chk['faces_clockwise_from_outside'] = all(float(d) < 0 for d in dets)
    Bt, Ct = tr(B), tr(C)
    chk['B_C_is_zero'] = is_zero(mul(B, C))
    L = mul(B, Bt)                                                                           # port Laplacian 5 - A
    D = mul(Ct, C)                                                                           # dual (dodecahedron) Laplacian 3 - A_dual
    K = mul(C, Ct)
    chk['W_Bt_is_zero'] = is_zero(mul(W, Bt))
    WWt = mul(W, tr(W))
    chk['W_Wt_is_8I'] = equal(WWt, scal(Q5(8), eye(3)))
    chk['Wc_Bt_is_zero'] = is_zero(mul(Wc, Bt))
    chk['Wc_Wct_is_8I'] = equal(mul(Wc, tr(Wc)), scal(Q5(8), eye(3)))
    chk['W_Wct_is_zero'] = is_zero(mul(W, tr(Wc)))
    # eigenvalue of K on the axial triplet
    KWt = mul(K, tr(W))
    lam = None
    for cand in (Q5(3, -1), Q5(3, 1), Q5(2), Q5(3), Q5(5)):
        if equal(KWt, scal(cand, tr(W))):
            lam = cand
    KWct = mul(K, tr(Wc))
    lamc = None
    for cand in (Q5(3, -1), Q5(3, 1), Q5(2), Q5(3), Q5(5)):
        if equal(KWct, scal(cand, tr(Wc))):
            lamc = cand
    out['K_eigenvalue_axial_triplet'] = repr(lam)
    out['K_eigenvalue_conjugate_triplet'] = repr(lamc)
    # spectral projectors of K
    spectrum = {'3': Q5(3, -1), "3'": Q5(3, 1), '5': Q5(2), '4a': Q5(3), '4b': Q5(5), 'grad': Q5(0)}
    I30 = eye(30)
    proj = {}
    for name, mu in spectrum.items():
        P = eye(30)
        for other, nu in spectrum.items():
            if other == name:
                continue
            P = mul(P, add(K, scal(nu, I30), -1))
            P = scal((mu - nu).inv(), P)
        proj[name] = P
    chk['projectors_idempotent'] = all(equal(mul(P, P), P) for P in proj.values())
    out['projector_traces'] = {k: repr(trace(P)) for k, P in proj.items()}
    chk['projectors_sum_to_identity'] = equal(I30, [[sum((proj[k][i][j] for k in proj), Q5(0)) for j in range(30)] for i in range(30)])
    # P_3 = W^T W / 8 and P_3' = Wc^T Wc / 8
    chk['P3_is_Wt_W_over_8'] = equal(proj['3'], scal(Q5(Fr(1, 8)), mul(tr(W), W))) if lam == Q5(3, -1) else equal(proj["3'"], scal(Q5(Fr(1, 8)), mul(tr(W), W)))
    chk['P3prime_is_Wct_Wc_over_8'] = equal(proj["3'"], scal(Q5(Fr(1, 8)), mul(tr(Wc), Wc))) if lamc == Q5(3, 1) else equal(proj['3'], scal(Q5(Fr(1, 8)), mul(tr(Wc), Wc)))
    # cycle projector from the port Laplacian: Pi_cyc = I - B^T L^+ B ; verify sum of the five cycle projectors equals it
    Pcyc = add(I30, proj['grad'], -1)
    chk['Pcyc_B_is_zero'] = is_zero(mul(B, Pcyc))
    chk['Pcyc_rank_19'] = trace(Pcyc) == Q5(19)
    chk['Pcyc_rational'] = all(x.b == 0 for r in Pcyc for x in r)
    # gradient projector: P_grad = B^T L^+ B, with L^+ = sum over bands; check via L: P_grad B^T = B^T
    chk['Pgrad_fixes_gradients'] = equal(mul(proj['grad'], Bt), Bt)
    # face readback: W C[:, f] = (u_p x u_q + u_q x u_r + u_r x u_p) = twice the area vector of face f
    WC = mul(W, C)
    ok = True
    ratios = set()
    for f, (p, q, r) in enumerate(faces):
        cen = [raw[p][i] + raw[q][i] + raw[r][i] for i in range(3)]
        col = [WC[i][f] for i in range(3)]
        cr = cross(col, cen)
        ok &= all(x == ZERO for x in cr)
        # ratio col / cen on a nonzero component
        k = next(i for i in range(3) if cen[i] != ZERO)
        ratios.add(col[k] / cen[k])
    chk['W_C_columns_parallel_to_face_centroids'] = ok
    out['W_C_column_over_raw_centroid'] = [repr(x) for x in ratios]
    # with unit face normals n_f = (r_p + r_q + r_r)/|r_p + r_q + r_r| : W C[:, f] = c_face n_f, c_face^2 = |W C[:, f]|^2
    c2 = dot([WC[i][0] for i in range(3)], [WC[i][0] for i in range(3)])
    out['face_column_norm_squared'] = repr(c2)
    out['face_column_norm'] = float(c2) ** 0.5
    out['face_column_sign_vs_outward_normal'] = int(np.sign(float(next(iter(ratios)))))
    # A from face circulations: A = (1/lam) W C omega, omega = C^T R
    lhs = mul(W, Pcyc)                                         # W itself (W annihilates gradients)
    rhs = scal(lam.inv(), mul(mul(W, C), Ct))
    chk['A_equals_WC_omega_over_lambda'] = equal(lhs, rhs) and equal(lhs, W)
    # polar readback in the raw frame: Vraw[:, e] = r_b - r_a ; Vraw C = 0 ; Vraw Vraw^T ; L-band of the polar triplet
    Vraw = mat(3, 30)
    for e, (a, b) in enumerate(seams):
        for i in range(3):
            Vraw[i][e] = raw[b][i] - raw[a][i]
    chk['V_C_is_zero'] = is_zero(mul(Vraw, C))
    VVt = mul(Vraw, tr(Vraw))
    out['Vraw_Vrawt_over_norm2'] = repr(VVt[0][0] / norm2)
    chk['V_Vt_scalar'] = equal(VVt, scal(VVt[0][0], eye(3)))
    chk['V_Wt_is_zero'] = is_zero(mul(Vraw, tr(W)))
    # V = -U B with U the 3 x 12 matrix of port vectors; U L = (5 - sqrt5) U
    U = [[raw[p][i] for p in range(12)] for i in range(3)]
    chk['V_is_minus_U_B'] = equal(Vraw, scal(Q5(-1), mul(U, B)))
    chk['U_L_is_slow_band'] = equal(mul(U, L), scal(Q5(5, -1), U))
    chk['U_Ut_is_4_norm2_I'] = equal(mul(U, tr(U)), scal(Q5(4) * norm2, eye(3)))
    # rotations: covariance of W and of the projectors
    rots = src.rotations()
    okW = True; okP = True; classes = {}
    Un = fl(U) / float(norm2) ** 0.5
    Wn = fl(W)
    Pn = {k: fl(P) for k, P in proj.items()}
    for g in rots:
        # rotation matrix from the port action: Rg = (1/4) sum_p u_{g(p)} u_p^T
        Rg = sum(np.outer(Un[:, g[p]], Un[:, p]) for p in range(12)) / 4
        # signed seam permutation: seam (a,b) -> (g(a), g(b))
        S = np.zeros((30, 30))
        key = {s: e for e, s in enumerate(seams)}
        for e, (a, b) in enumerate(seams):
            ga, gb = g[a], g[b]
            S[key[(min(ga, gb), max(ga, gb))], e] = 1 if ga < gb else -1
        okW &= np.allclose(Wn @ S, Rg @ Wn)                    # A(g.R) = R_g A(R)
        okP &= all(np.allclose(S @ P, P @ S) for P in Pn.values())
        t = round(float(np.trace(Rg)), 6)
        classes[t] = classes.get(t, 0) + 1
    chk['W_rotation_covariant'] = bool(okW)
    chk['projectors_rotation_invariant'] = bool(okP)
    out['rotation_trace_classes'] = {str(k): v for k, v in sorted(classes.items())}
    out['all_checks_true'] = all(bool(v) for k, v in chk.items() if k != 'faces_clockwise_from_outside')
    out['seams'] = seams
    out['faces'] = faces
    out['port_vectors_raw'] = [[repr(x) for x in r] for r in raw]
    out['raw_norm_squared'] = repr(norm2)
    (HERE / 's2_conventions.json').write_text(json.dumps(out, indent=1))
    np.savez(HERE / 'conventions_arrays.npz', seams=np.array(seams), faces=np.array(faces), U_unit=Un, B=fl(B), C=fl(C), W=Wn,
             W_conj=fl(Wc), V_unit=fl(Vraw) / float(norm2) ** 0.5, K=fl(K),
             P3=Pn['3'], P3p=Pn["3'"], P5=Pn['5'], P4a=Pn['4a'], P4b=Pn['4b'], Pgrad=Pn['grad'], Pcyc=fl(Pcyc))
    for k, v in out.items():
        if k not in ('seams', 'faces', 'port_vectors_raw'):
            print(k, ':', v)
    return out


if __name__ == '__main__':
    main()
