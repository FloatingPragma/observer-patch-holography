"""Numerical linear algebra used by the tests (tolerances are stated at each function)."""
from __future__ import annotations

import numpy as np
import scipy.linalg as sla
import scipy.sparse as sp

RANK_TOL = 1e-8        # relative residual below which a vector counts as dependent
ZERO_TOL = 1e-10       # absolute tolerance for "zero" matrix entries and identities


# ------------------------------------------------------------------ real spans

class RealSpan:
    """Orthonormal basis of a real span of (complex) arrays, grown one vector at a time."""

    def __init__(self, size, tol=RANK_TOL):
        self.n = 2 * size
        self.q = np.zeros((16, self.n))
        self.k = 0
        self.tol = tol

    @staticmethod
    def _real(x):
        x = np.asarray(x).ravel()
        return np.concatenate([x.real, x.imag]) if np.iscomplexobj(x) else np.concatenate([x, np.zeros_like(x)])

    def residual(self, x):
        v = self._real(x).astype(float)
        norm = np.linalg.norm(v)
        if norm == 0:
            return v, 0.0, 0.0
        r = v.copy()
        if self.k:
            q = self.q[:self.k]
            r -= q.T @ (q @ r)
            r -= q.T @ (q @ r)
        return r, float(np.linalg.norm(r)), float(norm)

    def contains(self, x):
        _, res, norm = self.residual(x)
        return norm == 0 or res <= self.tol * norm

    def add(self, x):
        r, res, norm = self.residual(x)
        if norm == 0 or res <= self.tol * norm:
            return False
        if self.k == self.q.shape[0]:
            self.q = np.vstack([self.q, np.zeros_like(self.q)])
        self.q[self.k] = r / res
        self.k += 1
        return True

    def element(self, i, shape):
        v = self.q[i]
        half = self.n // 2
        return (v[:half] + 1j * v[half:]).reshape(shape)

    def elements(self, shape):
        return [self.element(i, shape) for i in range(self.k)]


def real_rank(mats, tol=RANK_TOL):
    mats = list(mats)
    if not mats:
        return 0
    span = RealSpan(np.asarray(mats[0]).size, tol)
    for m in mats:
        span.add(m)
    return span.k


# ------------------------------------------------------------------ Lie algebras of anti-Hermitian matrices

def lie_closure(gens, cap=400, seed=0, verify_limit=220):
    """Real Lie algebra generated by anti-Hermitian matrices.

    Randomized growth (commutators of random elements) followed, when the dimension is at most
    `verify_limit`, by a deterministic check that every pairwise commutator of the basis lies in the span.
    Returns dict(dim, capped, basis, verified).  `capped` means the dimension is "at least dim".
    """
    gens = [np.asarray(g, complex) for g in gens]
    if not gens:
        return {"dim": 0, "capped": False, "basis": [], "verified": True, "span": 0}
    shape = gens[0].shape
    span = RealSpan(gens[0].size)
    for g in gens:
        span.add(g)
    gen_rank = span.k
    rng = np.random.default_rng(seed)

    def grow():
        fails = 0
        while span.k < cap and fails < 8 and span.k > 1:
            basis = span.elements(shape)
            x = sum(c * b for c, b in zip(rng.standard_normal(span.k), basis))
            y = sum(c * b for c, b in zip(rng.standard_normal(span.k), basis))
            z = x @ y - y @ x
            if np.linalg.norm(z) < 1e-12 * (np.linalg.norm(x) * np.linalg.norm(y) + 1e-300):
                fails += 1
                continue
            fails = 0 if span.add(z) else fails + 1

    grow()
    verified = False
    while span.k <= verify_limit and span.k < cap:
        basis = span.elements(shape)
        added = False
        for i in range(len(basis)):
            for j in range(i):
                z = basis[i] @ basis[j] - basis[j] @ basis[i]
                if span.add(z):
                    added = True
        if not added:
            verified = True
            break
        grow()
    return {"dim": span.k, "capped": span.k >= cap, "basis": span.elements(shape), "verified": verified,
            "span": gen_rank}


def lie_centre(basis):
    """Centre of the Lie algebra spanned by an orthonormal anti-Hermitian basis. Returns (dim, central elements)."""
    k = len(basis)
    if k == 0:
        return 0, []
    rows = []
    for y in basis:
        cols = []
        for b in basis:
            z = b @ y - y @ b
            cols.append(np.concatenate([z.real.ravel(), z.imag.ravel()]))
        rows.append(np.array(cols).T)
    m = np.vstack(rows)
    gram = m.T @ m
    w, v = np.linalg.eigh(gram)
    null = v[:, w < 1e-14 * max(1.0, w.max())]
    return null.shape[1], [sum(c * b for c, b in zip(null[:, i], basis)) for i in range(null.shape[1])]


def lie_ideals(basis, seed=0):
    """Dimensions of the simple ideals of a compact Lie algebra given by an orthonormal anti-Hermitian basis.

    Uses the commutant of the adjoint representation (two generic elements). Returns sorted list of ideal
    dimensions (the centre is not included)."""
    k = len(basis)
    if k == 0:
        return []
    rng = np.random.default_rng(seed + 17)
    vecs = np.array([np.concatenate([b.real.ravel(), b.imag.ravel()]) for b in basis])
    ads = []
    for _ in range(3):
        y = sum(c * b for c, b in zip(rng.standard_normal(k), basis))
        cols = []
        for b in basis:
            z = y @ b - b @ y
            cols.append(vecs @ np.concatenate([z.real.ravel(), z.imag.ravel()]))
        ads.append(1j * np.array(cols).T)          # i*ad_y is Hermitian (ad_y real antisymmetric)
    com = commutant(ads, hermitian_generators=True, seed=seed)
    if com is None:
        return None
    blocks = algebra_blocks(com, seed=seed)
    if blocks is None:
        return None
    return sorted(b["m"] for b in blocks if not (b["m"] == 1))


LIE_NAMES = {3: "su(2)", 8: "su(3)", 10: "so(5)", 14: "g2", 15: "su(4)", 21: "so(7)|sp(3)", 24: "su(5)",
             28: "so(8)", 35: "su(6)", 36: "so(9)|sp(4)", 45: "so(10)", 48: "su(7)", 52: "f4",
             55: "so(11)|sp(5)", 63: "su(8)", 66: "so(12)", 78: "so(13)|sp(6)|e6", 80: "su(9)", 91: "so(14)",
             99: "su(10)", 105: "so(15)|sp(7)", 120: "su(11)|so(16)", 143: "su(12)"}


def lie_type(dim, centre, ideals):
    if ideals is None:
        return f"dim {dim}, centre {centre} (ideals not resolved)"
    parts = [f"u(1)^{centre}" if centre > 1 else "u(1)"] if centre else []
    parts += [LIE_NAMES.get(n, f"simple[{n}]") for n in ideals]
    return " + ".join(parts) if parts else "0"


# ------------------------------------------------------------------ commutants and *-algebra structure

def _clusters(values, tol):
    order = np.argsort(values)
    groups, current = [], [order[0]]
    for i in order[1:]:
        if abs(values[i] - values[current[-1]]) <= tol:
            current.append(i)
        else:
            groups.append(current)
            current = [i]
    groups.append(current)
    return groups


def commutant(ops, hermitian_generators=False, seed=0, max_unknowns=3600):
    """Basis (list of d x d matrices) of the commutant of the *-algebra generated by `ops`.

    Method: commutant of a few random Hermitian combinations, verified against every generator and
    extended (more combinations, then products) until the verification passes. Returns None when the
    reduced linear system exceeds `max_unknowns` unknowns.
    Tolerances: eigenvalue clustering 1e-8 (relative), null space 1e-9, verification 1e-7.
    """
    ops = [np.asarray(o, complex) for o in ops]
    d = ops[0].shape[0]
    rng = np.random.default_rng(seed + 5)
    herm = []
    for o in ops:
        if hermitian_generators:
            herm.append(o)
        else:
            herm.append(o + o.conj().T)
            herm.append(1j * (o - o.conj().T))
    herm = [h for h in herm if np.linalg.norm(h) > 1e-13]
    if not herm:
        return [np.eye(d, dtype=complex)] if d == 1 else _matrix_units(d)
    scale = max(np.linalg.norm(h, 2) for h in herm[:8]) or 1.0

    def combo(products=False):
        g = sum(c * h for c, h in zip(rng.standard_normal(len(herm)), herm))
        if products:
            a = sum(c * h for c, h in zip(rng.standard_normal(len(herm)), herm))
            b = sum(c * h for c, h in zip(rng.standard_normal(len(herm)), herm))
            g = g + (a @ b + b @ a) / scale
        return g / np.sqrt(len(herm))

    gens = [combo(), combo()]
    for attempt in range(4):
        basis = _commutant_of_hermitian(gens, max_unknowns)
        if basis is None:
            return None
        worst = 0.0
        for x in basis:
            nx = np.linalg.norm(x) or 1.0
            for h in herm:
                worst = max(worst, np.linalg.norm(x @ h - h @ x) / (nx * scale))
        if worst < 1e-7:
            return basis
        gens.append(combo(products=attempt >= 1))
        gens.append(combo(products=attempt >= 1))
    return basis


def _matrix_units(d):
    out = []
    for i in range(d):
        for j in range(d):
            m = np.zeros((d, d), complex)
            m[i, j] = 1
            out.append(m)
    return out


def _commutant_of_hermitian(gens, max_unknowns):
    g1 = gens[0]
    d = g1.shape[0]
    w, v = np.linalg.eigh((g1 + g1.conj().T) / 2)
    tol = 1e-8 * max(1.0, np.abs(w).max())
    groups = _clusters(w, tol)
    frames = [v[:, g] for g in groups]
    sizes = [len(g) for g in groups]
    offsets = np.concatenate([[0], np.cumsum([s * s for s in sizes])])
    n_unknown = int(offsets[-1])
    rest = gens[1:]
    if all(s == 1 for s in sizes):
        # multiplicity-free: X is diagonal in this frame; constraints identify entries along nonzero links
        parent = list(range(d))

        def find(i):
            while parent[i] != i:
                parent[i] = parent[parent[i]]
                i = parent[i]
            return i

        vv = np.hstack(frames)
        for g in rest:
            m = vv.conj().T @ g @ vv
            link = np.abs(m) > 1e-9 * max(1.0, np.abs(m).max())
            for i, j in zip(*np.nonzero(np.triu(link, 1))):
                ri, rj = find(i), find(j)
                if ri != rj:
                    parent[ri] = rj
        comps = {}
        for i in range(d):
            comps.setdefault(find(i), []).append(i)
        return [vv[:, idx] @ vv[:, idx].conj().T for idx in comps.values()]
    if n_unknown > max_unknowns:
        if all(np.linalg.norm(g - np.trace(g) / d * np.eye(d)) < 1e-9 for g in gens):
            return _matrix_units(d)
        return None
    gram = np.zeros((n_unknown, n_unknown), complex)
    for g in rest:
        for b, fb in enumerate(frames):
            for c, fc in enumerate(frames):
                m = fb.conj().T @ g @ fc                    # m_b x m_c
                if np.linalg.norm(m) < 1e-11:
                    continue
                mb, mc = sizes[b], sizes[c]
                # equations: X_b m - m X_c = 0 ; row-major vec: (I (x) m^T) vec X_b - (m (x) I) vec X_c
                ab = np.kron(np.eye(mb), m.T)
                ac = np.kron(m, np.eye(mc))
                sb = slice(int(offsets[b]), int(offsets[b + 1]))
                sc = slice(int(offsets[c]), int(offsets[c + 1]))
                if b == c:
                    a = ab - ac
                    gram[sb, sb] += a.conj().T @ a
                else:
                    gram[sb, sb] += ab.conj().T @ ab
                    gram[sc, sc] += ac.conj().T @ ac
                    cross = ab.conj().T @ ac
                    gram[sb, sc] -= cross
                    gram[sc, sb] -= cross.conj().T
    ew, ev = np.linalg.eigh(gram)
    null = ev[:, ew < 1e-9 * max(1.0, ew.max())]
    basis = []
    for k in range(null.shape[1]):
        x = np.zeros((d, d), complex)
        for b, fb in enumerate(frames):
            xb = null[int(offsets[b]):int(offsets[b + 1]), k].reshape(sizes[b], sizes[b])
            x += fb @ xb @ fb.conj().T
        basis.append(x)
    return basis


def algebra_blocks(basis, seed=0, max_dim=600):
    """Wedderburn structure of a *-algebra given by a linear basis: list of dict(n, m, dim, projector).

    The algebra is isomorphic to the direct sum of M_n (x) 1_m over the returned blocks."""
    f = len(basis)
    if f == 0:
        return []
    d = basis[0].shape[0]
    if f == d * d:
        return [{"n": d, "m": 1, "dim": d, "projector": np.eye(d, dtype=complex)}]
    if f > max_dim:
        return None
    rng = np.random.default_rng(seed + 11)
    h = np.zeros((d, d), complex)
    for x in basis:
        a, b = rng.standard_normal(2)
        h += a * (x + x.conj().T) + b * 1j * (x - x.conj().T)
    w, v = np.linalg.eigh(h)
    groups = _clusters(w, 1e-8 * max(1.0, np.abs(w).max()))
    frames = [v[:, g] for g in groups]
    k = len(frames)
    parent = list(range(k))

    def find(i):
        while parent[i] != i:
            parent[i] = parent[parent[i]]
            i = parent[i]
        return i

    for x in basis:
        nx = np.linalg.norm(x) or 1.0
        for i in range(k):
            left = frames[i].conj().T @ x
            for j in range(k):
                if i != j and find(i) != find(j) and np.linalg.norm(left @ frames[j]) > 1e-7 * nx:
                    parent[find(i)] = find(j)
    comps = {}
    for i in range(k):
        comps.setdefault(find(i), []).append(i)
    blocks = []
    for idx in comps.values():
        ms = {frames[i].shape[1] for i in idx}
        frame = np.hstack([frames[i] for i in idx])
        blocks.append({"n": len(idx), "m": int(sorted(ms)[0]), "dim": int(frame.shape[1]),
                       "consistent": len(ms) == 1, "projector": frame @ frame.conj().T,
                       "minimal_projector": frames[idx[0]] @ frames[idx[0]].conj().T})
    blocks.sort(key=lambda b: (b["dim"], b["n"]))
    return blocks


# ------------------------------------------------------------------ channels

def superoperator(kraus):
    """Sparse matrix of rho -> sum K rho K^dagger on row-major vec(rho)."""
    total = None
    for k in kraus:
        k = sp.csr_matrix(k)
        term = sp.kron(k, k.conj(), format="csr")
        total = term if total is None else total + term
    return total


def apply_channel(kraus, rho):
    out = np.zeros_like(rho, dtype=complex)
    for k in kraus:
        out += k @ rho @ k.conj().T
    return out


def hamiltonian_part(kraus, d):
    """Canonical Hamiltonian of the generator Phi - id (GKLS form with traceless jump operators).

    H = (i/2) sum_r (conj(c_r) K_r - c_r K_r^dagger), c_r = Tr K_r / d; Phi - id = -i[H, .] + dissipator.
    Independent of the Kraus representation."""
    h = np.zeros((d, d), complex)
    for k in kraus:
        k = np.asarray(k.todense()) if sp.issparse(k) else np.asarray(k)
        c = np.trace(k) / d
        h += 0.5j * (np.conj(c) * k - c * k.conj().T)
    return h


def unitary_log(k):
    """If K^dagger K is a multiple of 1: (weight, anti-Hermitian principal log of the unitary part), else None.

    Phase convention: K is first multiplied by a phase making Tr K real positive (when Tr K != 0); the
    eigenphases are then taken in (-pi, pi]."""
    k = np.asarray(k.todense()) if sp.issparse(k) else np.asarray(k, complex)
    d = k.shape[0]
    g = k.conj().T @ k
    lam = np.trace(g).real / d
    if lam < 1e-14 or np.linalg.norm(g - lam * np.eye(d)) > 1e-9 * max(1.0, lam) * np.sqrt(d):
        return None
    u = k / np.sqrt(lam)
    tr = np.trace(u)
    if abs(tr) > 1e-9:
        u = u * (abs(tr) / tr)
    t, z = sla.schur(u, output="complex")
    phases = np.angle(np.diag(t))
    phases[np.abs(phases + np.pi) < 1e-9] = np.pi
    return lam, (z * (1j * phases)) @ z.conj().T


def entropy(eigs):
    eigs = np.asarray(eigs, float)
    eigs = eigs[eigs > 1e-14]
    return float(-(eigs * np.log(eigs)).sum())


def support_spread(eigs, floor=1e-9):
    """log(max/min) of the eigenvalues above floor*max (0 for a flat spectrum), and the support rank."""
    eigs = np.asarray(eigs, float)
    top = eigs.max() if eigs.size else 0.0
    if top <= 0:
        return 0.0, 0
    kept = eigs[eigs > floor * top]
    return float(np.log(kept.max() / kept.min())), int(kept.size)
