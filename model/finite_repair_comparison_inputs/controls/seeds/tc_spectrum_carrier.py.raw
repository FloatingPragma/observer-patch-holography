"""Leading spectrum of the transported-contrast chain on the icosahedral carrier with one unit seam (adjacent face pair)."""
import sys, time
import numpy as np
import scipy.sparse as sp
import scipy.sparse.linalg as spla
from model.transported_contrast import law

seams, faces = law.carrier()
m = len(seams)
def reach(start, offsets, limit):
    seen = {start: 0}; order = [start]; queue = [start]
    rows, cols = [], []
    while queue:
        nxt_queue = []
        for s in queue:
            i = seen[s]
            for k in range(m):
                for coin in (0, 1):
                    t, _ = law.attempt(s, offsets, seams, k, coin)
                    j = seen.get(t)
                    if j is None:
                        j = len(order); seen[t] = j; order.append(t); nxt_queue.append(t)
                        if len(order) > limit: raise SystemExit('limit')
                    rows.append(j); cols.append(i)
        queue = nxt_queue
    n = len(order)
    T = sp.coo_matrix((np.full(len(rows), 1 / (2 * m)), (rows, cols)), shape=(n, n)).tocsr()
    return order, T

for name, offsets, total in (('vacuum', (0,) * 30, 1), ('vacuum', (0,) * 30, 2), ('unit seam', tuple(int(k == 0) for k in range(30)), 0),
                             ('unit seam', tuple(int(k == 0) for k in range(30)), 1), ('unit seam', tuple(int(k == 0) for k in range(30)), 2)):
    start = tuple([1] * total + [0] * (12 - total))
    t0 = time.time()
    order, T = reach(start, offsets, 400000)
    n = len(order)
    # recurrent part: iterate to find states with stationary mass
    k = min(24, n - 2)
    ev = spla.eigs(T, k=k, which='LM', return_eigenvectors=False, maxiter=20000, tol=1e-10) if n > 60 else np.linalg.eigvals(T.toarray())
    ev = ev[np.argsort(-np.abs(ev))]
    vals = [f'{e.real:.5f}{"" if abs(e.imag) < 1e-9 else f"{e.imag:+.5f}i"}' for e in ev[:22]]
    print(f'{name:10s} total={total} reachable={n} time={time.time()-t0:.1f}s\n   leading eigenvalues: {" ".join(vals)}', flush=True)
print('vacuum one-quantum factors 1 - lambda/60:', [round(1 - v / 60, 5) for v in (0, 5 - 5 ** .5, 6, 5 + 5 ** .5)])
