"""Seed computations for the law search (one carrier, one quantum on C^12 unless stated).

1. Lie closures of port-attached operators compressed to native invariant sectors.
2. The swap dilation of the native rule: fixed-point algebra and spectrum.
"""
import itertools, sys
import numpy as np
from model.transported_contrast import law
from model.common_source import slow_geometry

seams, faces = law.carrier()
n = 12
A = np.zeros((n, n))
for a, b in seams: A[a, b] = A[b, a] = 1
w, v = np.linalg.eigh(A)
def proj(val): 
    sel = np.abs(w - val) < 1e-9
    return v[:, sel] @ v[:, sel].T
s5 = 5 ** .5
P1, P3, P5, P3p = proj(5), proj(s5), proj(-1), proj(-s5)
print('band ranks 1,3,5,3\':', [int(round(np.trace(P))) for P in (P1, P3, P5, P3p)])
N = [np.diag((np.arange(n) == p).astype(float)) for p in range(n)]
# oriented pentagon link of each port from the oriented faces: face (p,a,b) gives a -> b around p
nxt = [dict() for _ in range(n)]
for f in faces:
    for k in range(3):
        p, a, b = f[k], f[(k + 1) % 3], f[(k + 2) % 3]
        nxt[p][a] = b
C = []
for p in range(n):
    M = np.zeros((n, n), complex)
    for a, b in nxt[p].items():
        M[b, a] += 1j; M[a, b] -= 1j          # Hermitian circulation generator around p
    C.append(M)
Hop = []
for p in range(n):
    M = np.zeros((n, n))
    for q in range(n):
        if A[p, q]: M[p, q] = M[q, p] = 1
    Hop.append(M)

def closure(herm, tol=1e-9, cap=400):
    """Real Lie algebra generated by i*X for Hermitian X: returns (dimension, centre dimension)."""
    basis = []
    def add(X):
        nonlocal basis
        vec = np.concatenate([X.real.ravel(), X.imag.ravel()])
        if basis:
            B = np.array(basis)
            coef, *_ = np.linalg.lstsq(B.T, vec, rcond=None)
            vec2 = vec - B.T @ coef
        else:
            vec2 = vec
        if np.linalg.norm(vec2) > tol * max(1, np.linalg.norm(vec)):
            basis.append(vec2 / np.linalg.norm(vec2)); return True
        return False
    gens = [1j * np.asarray(X, complex) for X in herm]
    elems = []
    for G in gens:
        if add(G): elems.append(G)
    frontier = list(elems)
    while frontier and len(elems) < cap:
        new = []
        for X in frontier:
            for Y in list(elems):
                Z = X @ Y - Y @ X
                if add(Z): new.append(Z)
        elems += new; frontier = new
    dim = len(elems)
    # centre: elements commuting with all
    B = np.array([np.concatenate([E.real.ravel(), E.imag.ravel()]) for E in elems])
    rows = []
    for Y in elems:
        rows.append(np.array([np.concatenate([(E @ Y - Y @ E).real.ravel(), (E @ Y - Y @ E).imag.ravel()]) for E in elems]).T)
    Mx = np.vstack(rows) if rows else np.zeros((1, 1))
    centre = dim - np.linalg.matrix_rank(Mx, tol=1e-7)
    return dim, centre

def comp(X, *Ps):
    return sum(P @ X @ P for P in Ps)
tests = {
 'number N_p on full C^12': N,
 'number, compressed to slow band 3': [comp(X, P3) for X in N],
 'number, compressed to 3\'': [comp(X, P3p) for X in N],
 'number, block-compressed to 3 + 3\' (no cross terms)': [comp(X, P3, P3p) for X in N],
 'number, compressed to the joint six-space P3+P3\'': [(P3 + P3p) @ X @ (P3 + P3p) for X in N],
 'number, block-compressed to 1 + 3 + 5 + 3\' (all bands, no cross terms)': [comp(X, P1, P3, P5, P3p) for X in N],
 'number, compressed to 3 + 5 jointly': [(P3 + P5) @ X @ (P3 + P5) for X in N],
 'circulation C_p on full C^12': C,
 'circulation, compressed to slow band 3': [comp(X, P3) for X in C],
 'circulation, block-compressed to 3 + 3\'': [comp(X, P3, P3p) for X in C],
 'number on 3 only, plus circulation on 3 and 3\' (the 12-dimensional target?)': [comp(X, P3) for X in N] + [comp(X, P3, P3p) for X in C],
 'number + circulation, block-compressed to 3 + 3\'': [comp(X, P3, P3p) for X in N] + [comp(X, P3, P3p) for X in C],
 'star hopping Hop_p on full C^12': Hop,
 'star hopping, compressed to slow band 3': [comp(X, P3) for X in Hop],
 'seam exchanges P_ab summed over the star of p, full C^12': [sum(np.eye(n) - np.outer(np.eye(n)[p] - np.eye(n)[q], np.eye(n)[p] - np.eye(n)[q]) for q in range(n) if A[p, q]) for p in range(n)],
}
for name, ops in tests.items():
    span = np.linalg.matrix_rank(np.array([np.concatenate([np.asarray(X, complex).real.ravel(), np.asarray(X, complex).imag.ravel()]) for X in ops]), tol=1e-9)
    dim, centre = closure(ops)
    print(f'{name:78s} span {span:3d}  closure {dim:3d}  centre {centre}')

# 2. swap dilation: Phi(rho) = (1/M) sum_e (rho + P_e rho P_e)/2
def swap_channel(perms, dimH):
    K = np.zeros((dimH * dimH, dimH * dimH))
    for Pm in perms:
        K += 0.5 * np.eye(dimH * dimH) + 0.5 * np.kron(Pm, Pm)
    return K / len(perms)
perm1 = []
for a, b in seams:
    Pm = np.eye(n); Pm[[a, b]] = Pm[[b, a]]; perm1.append(Pm)
K1 = swap_channel(perm1, n)
ev = np.linalg.eigvalsh((K1 + K1.T) / 2)
print('\nswap dilation, one quantum: symmetric superoperator:', np.allclose(K1, K1.T), ' fixed-point dimension:', int(np.sum(ev > 1 - 1e-9)), ' second eigenvalue:', np.sort(ev)[-3:], ' (native population gap factor', 1 - (5 - s5) / 60, ')')
states = [c for c in itertools.combinations(range(n), 2)]
idx = {c: i for i, c in enumerate(states)}
perm2 = []
for a, b in seams:
    Pm = np.zeros((66, 66))
    for c in states:
        d = tuple(sorted({a: b, b: a}.get(x, x) for x in c)); Pm[idx[d], idx[c]] = 1
    perm2.append(Pm)
# fixed points = commutant of the 30 permutation matrices on the 66-space
rows = np.vstack([np.kron(np.eye(66), Pm) - np.kron(Pm.T, np.eye(66)) for Pm in perm2[:11]])
print('swap dilation, two quanta: commutant dimension of the seam exchanges (protected sectors):', 66 * 66 - np.linalg.matrix_rank(rows, tol=1e-8), ' (first 11 seams; all 30 give the same if the graph is connected)')
H = sum(np.eye(66) - Pm for Pm in perm2)
vals = np.round(np.linalg.eigvalsh(H), 6)
print('sectors by total spin: multiplicities of the Casimir-like sum over ALL pairs:')
allpairs = sum(np.eye(66) - np.array([[1 if tuple(sorted({a: b, b: a}.get(x, x) for x in c)) == d else 0 for c in states] for d in states]) for a, b in itertools.combinations(range(n), 2))
u, cts = np.unique(np.round(np.linalg.eigvalsh(allpairs), 6), return_counts=True)
print('  ', dict(zip(u, cts)))
