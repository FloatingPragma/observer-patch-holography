"""Independent exact extension of the phase-addressed mixed pump to the icosahedron."""
from pathlib import Path
import json
import sympy as s
from check_flux import E,A,N,P

HERE=Path(__file__).resolve().parent

def event(X,a,b):
 n=X.rows;Y=X.copy();outside=[j for j in range(n) if j not in (a,b)]
 Y[a,a]=Y[b,b]=(X[a,a]+X[b,b])/2
 Y[a,b]=Y[b,a]=(X[a,a]+X[b,b])/8-s.Rational(3,40)*(X[a,b]+X[b,a])
 for j in outside:
  Y[j,a]=Y[j,b]=s.Rational(3,20)*(X[j,a]+X[j,b])
  Y[a,j]=Y[b,j]=s.Rational(3,20)*(X[a,j]+X[b,j])
 return Y

def average(X,edges):return sum((event(X,a,b) for a,b in edges),s.zeros(X.rows))/len(edges)
# Independent reproduction of the three-port result through the averaged local formula.
n=3;basis=[]
for i in range(n):
 for j in range(n):
  X=s.zeros(n);X[i,j]=1;basis.append(X)
L=s.Matrix.hstack(*(s.Matrix(list(average(X,[(0,1),(1,2)]))) for X in basis))
v=(L-s.eye(9)).nullspace();assert len(v)==1
R=s.Matrix(3,3,list(v[0]));R=R/s.trace(R)
assert R==s.Matrix([[s.Rational(1,3),s.Rational(85,2013),s.Rational(5,671)],
 [s.Rational(85,2013),s.Rational(1,3),s.Rational(85,2013)],
 [s.Rational(5,671),s.Rational(85,2013),s.Rational(1,3)]])
# Four exact orbital coordinates of the carrier-covariant stationary state.
n=12;I=s.eye(n);B=[I,A,N,P]
coordinates=[(0,0),E[0],next((i,j) for i in range(n) for j in range(n) if N[i,j]==1),next((i,j) for i in range(n) for j in range(n) if P[i,j]==1)]
C=s.zeros(4)
for col,X in enumerate(B):
 Y=average(X,E);coefs=[Y[i,j] for i,j in coordinates]
 assert Y==sum((coef*base for coef,base in zip(coefs,B)),s.zeros(n))
 C[:,col]=s.Matrix(coefs)
vs=(C-s.eye(4)).nullspace();assert len(vs)==1
v=vs[0]/(12*vs[0][0]);rho=sum((v[k]*B[k] for k in range(4)),s.zeros(n))
assert average(rho,E)==rho and s.trace(rho)==1
spectrum=[]
for name,mul,lam,p,j in [('1',1,5,1,12),('3',3,s.sqrt(5),-1,0),('3prime',3,-s.sqrt(5),-1,0),('5',5,-1,1,0)]:
 value=s.simplify(v[0]+v[1]*lam+v[2]*(j-1-lam-p)+v[3]*p)
 assert value.is_positive
 spectrum.append({'carrier_irrep':name,'multiplicity':mul,'rho_eigenvalue':str(value),'decimal':float(value)})
assert rho!=I/12
# Exact native-history span constructive identities: one-event phase effects
# span the seam's real/imaginary off-diagonals and Na+Nb; unsigned incidence rank12.
inc=s.zeros(30,12)
for k,(a,b) in enumerate(E):inc[k,a]=inc[k,b]=1
assert inc.rank()==12
# Each missing coherence X_xb is created from X_xa by the actual none-setting
# no-jump effect pullback: K0 E_xa K0=(E_xa+E_xb)/4.
checked=0
for a,b in E:
 p=s.zeros(n,1);p[a]=p[b]=1/s.sqrt(2);Qp=p*p.T
 outside=I.copy();outside[a,a]=outside[b,b]=0
 K0=outside+Qp/2
 for x in range(n):
  if x in (a,b):continue
  for imag in (False,True):
   Xa=s.zeros(n);Xb=s.zeros(n)
   if imag:
    Xa[x,a]=s.I;Xa[a,x]=-s.I;Xb[x,b]=s.I;Xb[b,x]=-s.I
   else:
    Xa[x,a]=Xa[a,x]=1;Xb[x,b]=Xb[b,x]=1
   assert K0*Xa*K0==(Xa+Xb)/4;checked+=1
# Graph diameter3 => all cross effects obtained from initial distance-one effects in <=3 events.
dist=[[0 if i==j else (1 if A[i,j] else 99) for j in range(n)] for i in range(n)]
for k in range(n):
 for i in range(n):
  for j in range(n):dist[i][j]=min(dist[i][j],dist[i][k]+dist[k][j])
assert max(map(max,dist))==3
out={'status':'EXACT symbolic stationary state and effect-span identities; conditional declared pump law',
 'reverse_probability':'3/4','phase_settings':'uniform I, Za(+i), Za(-i), Zb(+i), Zb(-i), all retained',
 'three_port_result_independently_reproduced':True,
 'stationary_orbital_coefficients':[str(x) for x in v],
 'carrier_stationary_density_spectrum':spectrum,'faithful_nontracial':True,
 'covariance':'every graph automorphism permutes equal-weight seams and retained endpoint phase settings',
 'all_input_population_shadow':'EXACT from local formula, independent of all off-diagonal inputs',
 'history_effect_real_span':144,'history_length_suffices':3,'exact_coherence_extension_identities':checked,
 'uniqueness_argument':'unphased K1 and adjoint K2 generate all diagonal differences and connected edge matrix units; no common invariant subspace; faithful stationary fixed-space scalar by Schwarz equality',
 'native_coin_current_history_preserved':False,'faithful_stationary_geometric_modular_flow_proved':False,
 'protected_record_beyond_load_proved':False,'unitary_or_relativistic_transport_proved':False,'gauge_premises_proved':False}
(HERE/'pump_carrier_results.json').write_text(json.dumps(out,indent=2)+'\n')
print(json.dumps(out,indent=2))
