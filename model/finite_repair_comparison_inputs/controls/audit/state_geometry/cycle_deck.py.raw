"""Exact rank-four deck records generated by the public native carrier law.

Uses a copied S6 face chart as a candidate, verifies it under every public
carrier rotation, then derives integer deck maps, actual transition kernels,
correctors and diffusion tensors. No sampled or hand-fed covariance is used.
"""
from collections import Counter, deque
from fractions import Fraction as Q
from pathlib import Path
import hashlib,json,sys
import sympy as s
from sympy.matrices.normalforms import hermite_normal_form,smith_normal_form

HERE=Path(__file__).resolve().parent;ROOT=HERE.parents[2]
sys.path.insert(0,str(ROOT/'reverse-engineering-reality'))
from model.observer import native
from model.common_source import slow_geometry
from checks import EDGES,FACES

SRC=slow_geometry.source()
assert tuple(SRC.seams())==tuple(EDGES)
chart_path=ROOT/'repair-law/work/S6/s6_a_face_lattice.json'
chart=json.loads(chart_path.read_text())['charts']['face_chart']
ordered=[tuple(chart[str(i)]['ordered_triads']) for i in range(20)]
assert set(ordered)=={(i,j) for i in range(5) for j in range(5) if i!=j}
assert all(tuple(chart[str(i)]['ports'])==f for i,f in enumerate(FACES))
ei={e:i for i,e in enumerate(EDGES)};fi={frozenset(f):i for i,f in enumerate(FACES)}
adj={i:[] for i in range(12)}
B=s.zeros(30,12);C=s.zeros(20,30)
for e,(a,b) in enumerate(EDGES):B[e,a]=-1;B[e,b]=1;adj[a].append(b);adj[b].append(a)
for f,face in enumerate(FACES):
    for i in range(3):
        a,b=face[i],face[(i+1)%3];C[f,ei[tuple(sorted((a,b)))]]=1 if a<b else -1
assert C*B==s.zeros(20,12) and C.rank()==19
triangles={frozenset((a,b,c)) for a in range(12) for b in adj[a] for c in adj[b] if c in adj[a]}
assert set(fi)==triangles
rotations=[tuple(map(int,r)) for r in SRC.rotations()]
assert len(set(rotations))==60
rotation_data=[]
for r in rotations:
    fp=[fi[frozenset(r[v] for v in f)] for f in FACES]
    perm=[]
    for i in range(5):
        images={ordered[fp[f]][0] for f in range(20) if ordered[f][0]==i}
        assert len(images)==1;perm.append(images.pop())
    assert sorted(perm)==list(range(5))
    assert all(ordered[fp[f]]==(perm[i],perm[j]) for f,(i,j) in enumerate(ordered))
    assert sum(perm[i]>perm[j] for i in range(5) for j in range(i+1,5))%2==0
    E=s.zeros(30,30)
    for k,(a,b) in enumerate(EDGES):
        u,v=r[a],r[b];E[ei[tuple(sorted((u,v)))],k]=1 if u<v else -1
    A=s.zeros(5,4)
    for i in range(4):A[i,i]=1;A[4,i]=-1
    RA=s.zeros(5,4)
    for i in range(5):RA[perm[i],:]=A[i,:]
    rotation_data.append((E,RA[:4,:]))
parent={0:None};queue=[0]
for a in queue:
    for b in sorted(adj[a]):
        if b not in parent:parent[b]=a;queue.append(b)
assert len(parent)==12
def antipode(a):
    distance={a:0};todo=[a]
    for u in todo:
        for v in adj[u]:
            if v not in distance:distance[v]=distance[u]+1;todo.append(v)
    far=[v for v,d in distance.items() if d==3];assert len(far)==1
    return far[0]
anti=[antipode(a) for a in range(12)];EA=s.zeros(30,30)
for k,(a,b) in enumerate(EDGES):
    u,v=anti[a],anti[b];EA[ei[tuple(sorted((u,v)))],k]=1 if u<v else -1

def encode(M):return [[str(v) for v in row] for row in M.tolist()]
def frac(v):return Q(int(s.numer(v)),int(s.denom(v)))

def kernel_and_diffusion(Z,H,voltage,g,q):
    states=native.states(binary=True) if q==2 else tuple(tuple(int(i==j) for i in range(12)) for j in range(12))
    index={x:i for i,x in enumerate(states)};N=len(states)
    Xi=Z*H.inv().T
    xi=[tuple(frac(v) for v in Xi[e,:]) for e in range(30)]
    gsite=[tuple(frac(v) for v in g[a,:]) for a in range(12)]
    gc=[tuple(sum(x[a]*gsite[a][k] for a in range(12)) for k in range(4)) for x in states]
    kernel=Counter();drifts=[];raw_moment=s.zeros(4,4);count=s.zeros(N,N)
    for i,x in enumerate(states):
        raw_mean=[0]*4;deck_mean=[0]*4;corrector_mean=[Q(0)]*4
        for e,(a,b) in enumerate(EDGES):
            for coin in (0,1):
                y,record=native.native(x,(a,b),coin);j=index[y];cur=record[1]
                dz=tuple(cur*int(voltage[e,k]) for k in range(4))
                kernel[(i,j,dz)]+=1;count[i,j]+=1
                for k in range(4):
                    raw_mean[k]+=cur*int(Z[e,k]);deck_mean[k]+=dz[k]
                    corrector_mean[k]+=gc[j][k]-gc[i][k]
                    assert Q(dz[k])+gc[j][k]-gc[i][k]==cur*xi[e][k]
                raw_moment+=cur*cur*(Z[e,:].T*Z[e,:])
        assert raw_mean==[0]*4
        assert all(Q(deck_mean[k])+corrector_mean[k]==0 for k in range(4))
        drifts.append([str(Q(v,60)) for v in deck_mean])
    assert count==count.T and all(sum(count[i,j] for j in range(N))==60 for i in range(N))
    assert all(kernel[(j,i,tuple(-v for v in z))]==n for (i,j,z),n in kernel.items())
    assert min(count[i,i] for i in range(N))>0
    # Integer deck periods of the actual N-configuration graph, not just ports.
    neighbours={i:[] for i in range(N)}
    for (i,j,z),n in sorted(kernel.items()):
        if i!=j:neighbours[i].append((j,s.Matrix(z)))
    potentials={0:s.zeros(4,1)};todo=[0]
    for i in todo:
        for j,z in neighbours[i]:
            if j not in potentials:potentials[j]=potentials[i]+z;todo.append(j)
    assert len(todo)==N
    periods=[z+potentials[i]-potentials[j] for i in range(N) for j,z in neighbours[i]]
    period_matrix=s.Matrix.hstack(*periods)
    period_basis=hermite_normal_form(period_matrix)
    assert period_basis==s.eye(4)
    Sigma_raw=raw_moment/(N*60)
    expected=s.Rational(2*q*(12-q),12*11*60)*(Z.T*Z)
    assert Sigma_raw==expected
    Sigma=H.inv()*Sigma_raw*H.inv().T
    assert all(Sigma[:k,:k].det()>0 for k in range(1,5))
    rows=[[i,j,list(z),n] for (i,j,z),n in sorted(kernel.items())]
    return {'source_load':q,'internal_states':N,'native_branches_checked':N*60,
            'kernel_denominator':60,'aggregated_kernel_rows':rows,
            'states':[list(x) for x in states],
            'native_reversal_balance':True,'internal_chain_irreducible':True,'period':1,
            'minimum_hold_probability':str(s.Rational(min(count[i,i] for i in range(N)),60)),
            'all_Bloch_transfer_lower_bound':str(2*s.Rational(min(count[i,i] for i in range(N)),60)-1),
            'configuration_cover_period_lattice':encode(period_basis),
            'all_corrected_conditional_drifts_zero':True,
            'raw_harmonic_record_covariance_per_attempt':encode(Sigma_raw),
            'primitive_deck_record_asymptotic_covariance_per_attempt':encode(Sigma),
            'primitive_covariance_determinant':str(Sigma.det()),'diffusion_rank':4,
            'primitive_drift_by_internal_state':drifts,
            'state_corrector':[[str(v) for v in row] for row in gc],
            'stationary_corrected_second_moment':'exactly n Sigma after n attempts',
            'principal_Bloch_eigenvalue':'lambda(k)=1-(1/2) k^T Sigma k+O(|k|^4); exact Hessian from zero corrected conditional drift',
            'uncorrected_coordinate':'differs from corrected martingale by bounded internal-state corrector'}

def component(sign):
    F=s.Matrix([[int(i==k)-int(i==4)+sign*(int(j==k)-int(j==4)) for k in range(4)] for i,j in ordered])
    Z=C.T*F
    assert B.T*Z==s.zeros(12,4) and Z.rank()==4
    assert Z.T*Z==30*(s.eye(4)+s.ones(4))
    assert all(E*Z==Z*R for E,R in rotation_data)
    assert EA*Z==-sign*Z
    h=s.zeros(12,4)
    for b in queue[1:]:
        a=parent[b];h[b,:]=h[a,:]+(1 if a<b else -1)*Z[ei[tuple(sorted((a,b)))],:]
    raw_voltage=s.Matrix([list(Z[e,:]+h[a,:]-h[b,:]) for e,(a,b) in enumerate(EDGES)])
    H=hermite_normal_form(raw_voltage.T);SN=smith_normal_form(raw_voltage.T,domain=s.ZZ)
    voltage=raw_voltage*H.inv().T;g=h*H.inv().T
    assert all(v.q==1 for v in voltage)
    voltage=s.Matrix([[int(v) for v in row] for row in voltage.tolist()])
    assert hermite_normal_form(voltage.T)==s.eye(4)
    # Exact finite adjacency/Fourier kernel is exported below as coefficient rows.
    data={'face_parity':'even' if sign==1 else 'odd','oriented_edge_antipodal_eigenvalue':-sign,
          'face_pattern':'a_i+a_j' if sign==1 else 'a_i-a_j',
          'ordered_triad_chart_rotation_equivariance_verified':60,
          'integer_harmonic_cochains':encode(Z),'harmonic_gram':encode(Z.T*Z),
          'raw_period_Hermite_basis':encode(H),'raw_period_Smith_diagonal':[str(abs(SN[i,i])) for i in range(4)],
          'primitive_integer_edge_deck_map':[[int(v) for v in row] for row in voltage.tolist()],
          'site_corrector':encode(g),'tree_parent':parent,
          'source_sectors':[kernel_and_diffusion(Z,H,voltage,g,q) for q in (1,2)]}
    return data,Z

def main():
    even,Zp=component(1);odd,Zm=component(-1)
    assert Zp.T*Zm==s.zeros(4)
    inputs=[Path(__file__),chart_path,Path(native.__file__),Path(slow_geometry.__file__),Path(SRC.__file__)]
    result={'schema':'oph.repair_law.cycle_deck.v1','status':'EXACT integer/rational source-attachment checks',
        'source_contract':{'carrier':'public pinned 12-port icosahedron','endpoint_rule':'public model.observer.native.native',
            'scheduler':'DECLARED fresh uniform seam and fair endpoint coin per complete attempt',
            'initial_law':'DECLARED uniform binary q=1 or q=2 sector',
            'record':'sum of native signed current times selected integer edge deck vector; all zero-current attempts retained',
            'new_native_event':False,'coordinate_choice':'DECLARED even or odd antipodal rank-four cycle component',
            'finite_capacity':'finite horizon plus four bounded integer counters; unbounded cover is a growing-capacity idealization'},
        'seams':[list(e) for e in EDGES],'faces':[list(f) for f in FACES],
        'components':{'face_even':even,'face_odd':odd},'even_odd_harmonic_cross_gram_zero':True,
        'scope':{'Gaussian_field_sampler_implemented':False,'OS_reflection_positivity_proved':False,
                 'four_physical_spacetime_coordinates_proved':False,'mass_or_relativistic_particle_claim':False,
                 'common_federated_observer_coordinates_proved':False},
        'source_sha256':{str(p.relative_to(ROOT)):hashlib.sha256(p.read_bytes()).hexdigest() for p in inputs}}
    (HERE/'cycle_deck_results.json').write_text(json.dumps(result,indent=2)+'\n')
    print('PASS: both exact rank-four native-current deck maps, 60 rotations, q=1/q=2 complete kernels, correctors and positive diffusion tensors')
    for name,d in result['components'].items():
        q2=d['source_sectors'][1]
        print(name,'SNF',d['raw_period_Smith_diagonal'],'q2 covariance',q2['primitive_deck_record_asymptotic_covariance_per_attempt'])

if __name__=='__main__':main()
