"""Exact small controls for typed repair/probe events and heralded references.

These are declared finite controls, not a native particle construction.
"""
from pathlib import Path
import json
import sympy as s


def require(value, message):
    if not value:
        raise AssertionError(message)


def run():
    I = s.eye(2)
    X = s.Matrix([[0, 1], [1, 0]])
    Y = s.Matrix([[0, -s.I], [s.I, 0]])
    Z = s.diag(1, -1)
    rg = s.diag(s.Rational(2, 3), s.Rational(1, 3))
    rl = s.diag(s.Rational(3, 5), s.Rational(2, 5))
    rho = s.kronecker_product(rl, rg)
    W = s.kronecker_product(s.diag(1, s.I), I)
    Ks = []
    for i in range(2):
        for j in range(2):
            k = s.zeros(2)
            k[i, j] = s.sqrt(rg[i, i])
            Ks.append(s.kronecker_product(I, k))
    require(sum((k.H * k for k in Ks), s.zeros(4)) == s.eye(4), 'TP repair')
    require(sum((k * rho * k.H for k in Ks), s.zeros(4)) == rho, 'stationary repair')
    require(W * rho * W.H == rho, 'same-reference coherent flow')
    for a in [I, X, Y, Z]:
        aa = s.kronecker_product(a, I)
        require(sum((k.H * aa * k for k in Ks), s.zeros(4)) == aa,
                'logical algebra protected by repair')
    lx, ly, lz = [s.kronecker_product(a, I) for a in (X, Y, Z)]
    require(W.H * lx * W == -ly and W.H * ly * W == lx,
            'undamped nontrivial logical motion')
    effects = []
    for a in [X, Y, Z]:
        for b in [X, Y, Z]:
            for sa in [-1, 1]:
                for sb in [-1, 1]:
                    effects.append(s.kronecker_product((I + sa * a) / 2, (I + sb * b) / 2))
    rank = s.Matrix.hstack(*(e.reshape(16, 1) for e in effects)).rank()
    require(rank == 16, 'optional apparatus has complete effect span')
    pplus, pminus = (s.eye(4) + lz) / 2, (s.eye(4) - lz) / 2
    require(pplus * lx * pplus + pminus * lx * pminus == s.zeros(4),
            'destructive Z readout intentionally erases X')

    alpha = s.Rational(1, 2)
    kp = (s.eye(4) + alpha * W) / (1 + alpha)
    km = s.sqrt(alpha) * (s.eye(4) - W) / (1 + alpha)
    require(s.simplify(kp.H * kp + km.H * km) == s.eye(4), 'complete filter instrument')
    numerator = s.simplify((s.eye(4) + alpha * W) * (s.eye(4) + alpha * W.H))
    rhof = numerator / s.trace(numerator)
    require(s.simplify(W * rhof * W.H - rhof) == s.zeros(4), 'filter state stationary')
    require(rhof != s.eye(4) / 4 and all(x > 0 for x in rhof.eigenvals()),
            'filter faithful and nontracial')

    # Values independently derived from the actual carrier's coherent pump walk.
    d, trace_w = 1440, -1276
    norm = (1 + alpha**2) * d + 2 * alpha * trace_w
    probability = norm / ((1 + alpha)**2 * d)
    require(norm == 524 and probability == s.Rational(131, 810), 'carrier reference normalization')
    return {
        'status': 'EXACT finite controls; declared architecture, not particle identification',
        'repair_fixed_logical_algebra': 'M2 tensor I2',
        'same_stationary_density': [str(rho[i, i]) for i in range(4)],
        'transported_logical_X': '-Y',
        'transported_logical_Y': 'X',
        'optional_probe_effect_span': rank,
        'including_destructive_probes_in_idle_channel_preserves_logical_memory': False,
        'heralded_filter': {'alpha': '1/2', 'complete_two_outcome_instrument': True,
            'carrier_d': d, 'carrier_trace_W': trace_w, 'carrier_normalization': str(norm),
            'success_probability': str(probability), 'minimum_density_eigenvalue_bound': '1/2096',
            'k_trial_failure_probability': '(679/810)^k',
            'carrier_trace_provenance': '../native/coherent_control.py and coherent_control.json',
            'scope': 'The generic filter is checked here; the carrier walk must be checked separately.'}}


if __name__ == '__main__':
    result = run()
    Path(__file__).with_suffix('.json').write_text(json.dumps(result, indent=2) + '\n')
    print(json.dumps(result, indent=2))
