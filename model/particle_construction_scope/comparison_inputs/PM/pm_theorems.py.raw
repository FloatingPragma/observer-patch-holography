"""PM Part A (exact statements) and the algebra of Part B. No measured value enters.

    /tmp/oph-completion-venv/bin/python pm_theorems.py theorems.json

Exact: sympy over Q(sqrt3, i) with symbolic theta and real symbols. Numbers at theta = +-2/9: mpmath, 40 digits.
"""
import json
import sys

import sympy as sp
import mpmath as mp

import pm_lib as L

out, checks = {}, {}


def ok(name, cond):
    assert cond, name
    checks[name] = True


th = sp.symbols('theta', real=True)
w = sp.Rational(-1, 2) + sp.sqrt(3) * sp.I / 2
a, b = 1 / sp.sqrt(6), 1 / sp.sqrt(12)
S = sp.Matrix(3, 3, lambda i, j: 1 if i == (j + 1) % 3 else 0)
Sinv = S.T
f = [sp.Matrix([w ** (-k * n) for n in range(3)]) / sp.sqrt(3) for k in range(3)]
for k in range(3):
    ok(f'S f_{k} = w^{k} f_{k}', sp.simplify(S * f[k] - w ** k * f[k]) == sp.zeros(3, 1))
Ce = a * sp.eye(3) + b * (sp.exp(sp.I * th) * S + sp.exp(-sp.I * th) * Sinv)

# ------------------------------------------------------------------------------------------------ A0
# eigenvalue of C_e on f_k: a + 2 b cos(theta + 2 pi k/3)
for k in range(3):
    lamk = a + 2 * b * sp.cos(th + 2 * sp.pi * k / 3)
    diff = sp.simplify((Ce * f[k] - lamk * f[k]).applyfunc(lambda z: sp.expand_complex(sp.expand(z.rewrite(sp.exp)))))
    ok(f'A0: C_e f_{k} = (a + 2b cos(theta + 2 pi {k}/3)) f_{k}', diff == sp.zeros(3, 1))
g1 = sp.simplify(sp.cos(th) - sp.cos(th + 2 * sp.pi / 3) - sp.sqrt(3) * sp.sin(th + sp.pi / 3))
g2 = sp.simplify(sp.cos(th) - sp.cos(th - 2 * sp.pi / 3) + sp.sqrt(3) * sp.sin(th - sp.pi / 3))
ok('A0: cos t - cos(t + 2pi/3) = sqrt3 sin(t + pi/3) and cos t - cos(t - 2pi/3) = -sqrt3 sin(t - pi/3)',
   g1 == 0 and g2 == 0)
rows = {}
for sgn in (+1, -1):
    t = sgn * L.THETA
    lams = [L.lam(t, k) for k in range(3)]
    rows[('+' if sgn > 0 else '-') + '2/9'] = {'lambda_k': [mp.nstr(x, 15) for x in lams],
                            'mass_fraction_k': [mp.nstr(x ** 2, 15) for x in lams],
                            'rows': L.lepton_rows(t)}
ok('A0: theta = +2/9 puts tau on f_0, e on f_1, mu on f_2', rows['+2/9']['rows'] == {'e': 1, 'mu': 2, 'tau': 0})
ok('A0: theta = -2/9 puts tau on f_0, e on f_2, mu on f_1', rows['-2/9']['rows'] == {'e': 2, 'mu': 1, 'tau': 0})
ok('A0: sum of lambda_k^2 = 1 and Q = 2/3 at theta = 2/9',
   abs(sum(L.lam(L.THETA, k) ** 2 for k in range(3)) - 1) < mp.mpf(10) ** -35 and
   abs(sum(L.lam(L.THETA, k) ** 2 for k in range(3)) / sum(abs(L.lam(L.THETA, k)) for k in range(3)) ** 2
       - mp.mpf(2) / 3) < mp.mpf(10) ** -35)
out['A0'] = {'statement': 'C_e is diagonal on f_k with lambda_k = a + 2b cos(theta + 2 pi k/3). The axial character f_0 '
                          'carries the largest lambda exactly when theta lies in (-pi/3, pi/3) mod 2 pi (identities above). '
                          'At theta = +-2/9 tau sits on f_0; e and mu sit on the conjugate characters f_1, f_2.',
             'values': rows}

# ------------------------------------------------------------------------------------------------ A1
comm = sp.simplify((Ce * S - S * Ce).applyfunc(lambda z: sp.expand(z)))
ok('A1: C_e commutes with S for every theta', comm == sp.zeros(3, 3))
CeD = Ce.H
words = {'C_e^dagger C_e': CeD * Ce, 'C_e C_e^dagger': Ce * CeD, 'C_e^2': Ce * Ce,
         '(C_e^dagger C_e)^2': CeD * Ce * CeD * Ce, 'C_e^dagger S C_e (a hop that carries the shift)': CeD * S * Ce}
for name, Wd in words.items():
    c = sp.simplify((Wd * S - S * Wd).applyfunc(lambda z: sp.expand(z)))
    ok(f'A1: {name} commutes with S', c == sp.zeros(3, 3))
# general Y: T = X 1 + sigma Y Y^dagger commutes with Y Y^dagger (numerical check on random complex Y)
mp.mp.dps = 40
Y = mp.matrix([[mp.mpc(mp.rand() - 0.5, mp.rand() - 0.5) for _ in range(3)] for _ in range(3)])
YY = Y * L.dagger(Y)
T = mp.mpf('0.37') * mp.eye(3) + mp.mpf('-1.9') * YY
ok('A1: X 1 + sigma Y Y^dagger commutes with Y Y^dagger (random complex Y)', mp.mnorm(T * YY - YY * T, 1) < mp.mpf(10) ** -30)
# nondegenerate spectrum of C_e at +-2/9: the commutant is diagonal on f_k
for sgn in (+1, -1):
    lams = sorted(L.lam(sgn * L.THETA, k) for k in range(3))
    ok(f'A1: C_e has three distinct eigenvalues at theta = {"+" if sgn > 0 else "-"}2/9', min(lams[1] - lams[0], lams[2] - lams[1]) > mp.mpf('0.1'))
out['A1'] = {'statement': 'Every word in C_e, C_e^dagger and S, every trace and the identity commute with S, hence with C_e. '
                          'With C_e nondegenerate, an operator commuting with C_e is diagonal on the f_k, so its eigenbasis '
                          'is the charged-lepton basis and U_PMNS is a permutation matrix times phases: every angle is 0 or 90 '
                          'degrees and J = 0. Spurion form (all orders): if T(Y) obeys T(U Y V^dagger) = U T(Y) U^dagger for '
                          'all unitary U, V, write Y = U_L D V_R^dagger; then T(Y) = U_L T(D) U_L^dagger and T(D) = P T(D) '
                          'P^dagger for every diagonal phase P, so T(D) is diagonal and T(Y) is diagonal in the left mass '
                          'basis of Y.'}

# ------------------------------------------------------------------------------------------------ A2
v0, v1, v2 = sp.symbols('v0 v1 v2', real=True)
v = sp.Matrix([v0, v1, v2])
d12 = sp.simplify(sp.expand(abs((f[1].H * v)[0]) ** 2 - abs((f[2].H * v)[0]) ** 2))
ok('A2: abs(<f_1|v>) = abs(<f_2|v>) for every real v', d12 == 0)
ok('A2: f_2 = conj(f_1)', sp.simplify(f[2] - f[1].conjugate()) == sp.zeros(3, 1))
out['A2'] = {'statement': 'For a real vector v, <f_2|v> = conj(<f_1|v>). With e and mu on f_1, f_2 (A0), every neutrino '
                          'eigenbasis that is real in the counter basis gives abs(U_e i) = abs(U_mu i), i = 1, 2, 3.'}

# ------------------------------------------------------------------------------------------------ A3
U3 = sp.Matrix(3, 3, lambda al, i: (f[[1, 2, 0][al]].H * sp.eye(3)[:, i])[0])
mods = U3.applyfunc(lambda z: sp.nsimplify(sp.simplify(abs(z) ** 2)))
J3 = sp.simplify(sp.im(sp.expand(U3[0, 0] * U3[1, 1] * sp.conjugate(U3[0, 1]) * sp.conjugate(U3[1, 0]))))
ok('A3: abs(U)^2 = 1/3 everywhere for the counter basis', all(x == sp.Rational(1, 3) for x in mods))
ok('A3: J^2 = 1/108 for the counter basis', sp.simplify(J3 ** 2 - sp.Rational(1, 108)) == 0)
out['A3'] = {'statement': 'Counter basis (or any basis unbiased to the f_k): abs(U)^2 = 1/3, abs(J) = 1/(6 sqrt3), the '
                          'largest value of a 3 x 3 unitary; sin^2 theta13 = 1/3 in every column order.',
             'J_counter_order_012': str(sp.nsimplify(J3))}

# ------------------------------------------------------------------------------------------------ A4
s12, s13, cd = sp.symbols('s12 s13 cd', real=True)
c12 = sp.sqrt(1 - s12 ** 2)
diff_mu_tau = sp.simplify(  # abs(U_mu1)^2 - abs(U_tau1)^2 at theta23 = 45 degrees, PDG form
    (s12 ** 2 / 2 + c12 ** 2 * s13 ** 2 / 2 + s12 * c12 * s13 * cd)
    - (s12 ** 2 / 2 + c12 ** 2 * s13 ** 2 / 2 - s12 * c12 * s13 * cd))
ok('A4: at theta23 = 45 degrees abs(U_mu1)^2 - abs(U_tau1)^2 = 2 s12 c12 s13 cos delta', sp.simplify(diff_mu_tau - 2 * s12 * c12 * s13 * cd) == 0)
out['A4'] = {'statement': 'If e sat on f_0 (DECLARED theta_e = 2/9 + 2 pi/3; no source), A2 applies to the mu and tau rows: '
                          'abs(U_mu i) = abs(U_tau i), so theta23 = 45 degrees and cos delta = 0 whenever s12 c12 s13 is '
                          'nonzero; abs(U_e i)^2 = (v_i . (1,1,1))^2/3 for a real basis {v_i}.'}

# ------------------------------------------------------------------------------------------------ B algebra
x = sp.symbols('x', real=True)
l2 = [sp.Symbol(f'l{k}', positive=True) for k in range(3)]       # lambda_e^2 < lambda_mu^2 < lambda_tau^2
r_lin_NO = ((x + l2[1]) ** 2 - (x + l2[0]) ** 2) / ((x + l2[2]) ** 2 - (x + l2[0]) ** 2)
r_lin_NO_s = sp.simplify(sp.factor(r_lin_NO))
ok('B: linear reading, x >= 0: r_NO = (l_mu - l_e)(2x + l_mu + l_e) / ((l_tau - l_e)(2x + l_tau + l_e))',
   sp.simplify(r_lin_NO_s - (l2[1] - l2[0]) * (2 * x + l2[1] + l2[0]) / ((l2[2] - l2[0]) * (2 * x + l2[2] + l2[0]))) == 0)
lim_lin = sp.limit(r_lin_NO_s, x, sp.oo)
r_sq_NO = ((x + l2[1]) ** 4 - (x + l2[0]) ** 4) / ((x + l2[2]) ** 4 - (x + l2[0]) ** 4)
lim_sq = sp.limit(r_sq_NO, x, sp.oo)
ok('B3: both readings tend to (l_mu - l_e)/(l_tau - l_e) as x -> +infinity',
   sp.simplify(lim_lin - (l2[1] - l2[0]) / (l2[2] - l2[0])) == 0 and sp.simplify(lim_sq - (l2[1] - l2[0]) / (l2[2] - l2[0])) == 0)
out['B_algebra'] = {'T_k': 'x + lambda_k^2 (s = +1 without loss: s = -1 is -(T) at -x)',
                    'r_linear_NO_for_x_ge_0': str(r_lin_NO_s),
                    'limit_x_to_plus_infinity_both_readings': str(lim_lin)}

out['checks'] = checks
print(json.dumps(out, indent=1))
if len(sys.argv) > 1:
    json.dump(out, open(sys.argv[1], 'w'), indent=1)
