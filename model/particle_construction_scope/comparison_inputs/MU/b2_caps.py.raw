"""Block 2(b): cap effects E_C = sum_{p in C} |chi_p><chi_p| on the spinor space, as boosts; the group they generate.

Identity checked for every cap: E_C = (n_C / (2 cosh eta)) exp(eta m.sigma), tanh eta = |mean port axis| = cbar,
m the unit mean vector; E_C^(1/2) = sqrt(n_C / (2 cosh eta)) * boost of rapidity eta along m.
Writes caps.json (table of caps for other workers) and cap_group.json.
"""
import itertools, json
import numpy as np
from carrier_tools import C
from mu_lib import (icosphere, mesh_edges, sections, cap_ports, cap_effect, axes_of_carrier, herm, vec, boost,
                    lorentz, powm_pos, expm_herm, ETA, I2, SIG, angle)

ALPHAS = [20, 35, 50, 65, 80, 95, 110, 125, 140]
ax = axes_of_carrier()
out = {'convention': 'cap = ports with angle to the axis below alpha_deg; E_C = (n_C/2)(1 + cbar m.sigma); continuum cbar = cos^2(alpha/2)',
       'axes': {k: v.tolist() for k, v in ax.items()}, 'levels': {}}
worst = {'identity': 0.0, 'sqrt': 0.0, 'lorentz': 0.0}


def record(U, W, idx, n, alpha):
    if len(idx) == 0:
        return {'alpha_deg': alpha, 'n_C': 0, 'cbar': None, 'eta': None}
    E, nC, m = cap_effect(U, idx)
    E2 = W[idx].conj().T @ W[idx]
    cbar = float(np.linalg.norm(m))
    eta = float(np.arctanh(cbar)) if cbar < 1 - 1e-12 else None          # None: one port, a null direction
    row = {'alpha_deg': alpha, 'n_C': int(nC), 'cbar': cbar, 'eta': eta,
           'axis_misalignment_rad': angle(m, n) if cbar > 1e-12 else 0.0,
           'effect_four_vector_(t,r)': vec(E).tolist()}
    if alpha is not None:
        cinf = np.cos(np.radians(alpha) / 2) ** 2
        row['cbar_continuum'] = float(cinf); row['eta_continuum'] = float(np.arctanh(cinf))
        row['n_C_continuum'] = float(len(U) * (1 - np.cos(np.radians(alpha))) / 2)
    d0 = float(np.abs(E - E2).max())
    if eta is not None and nC > 1:
        mh = m / cbar
        d1 = float(np.abs(E2 - nC / (2 * np.cosh(eta)) * expm_herm(herm(0, mh), eta)).max() / nC)
        d2 = float(np.abs(powm_pos(E2, 0.5) - np.sqrt(nC / (2 * np.cosh(eta))) * boost(mh, eta)).max() / np.sqrt(nC))
        A = powm_pos(E2, 0.5) / np.sqrt(nC / (2 * np.cosh(eta)))
        L = lorentz(A)
        d3 = float(max(np.abs(L.T @ ETA @ L - ETA).max(), abs(L[0, 0] - np.cosh(eta))))
        worst['identity'] = max(worst['identity'], d0 / nC, d1); worst['sqrt'] = max(worst['sqrt'], d2); worst['lorentz'] = max(worst['lorentz'], d3)
    return row


for L in range(5):
    U, F = icosphere(L)
    W = sections(U)
    N = len(U)
    lev = {'N': N, 'caps': {}}
    for name, n in ax.items():
        rows = []
        for a0 in ALPHAS:
            a = float(a0)
            for _ in range(20):
                try:
                    idx = cap_ports(U, n, a); break
                except ValueError:
                    a += 0.37
            row = record(U, W, idx, n, a)
            if L <= 2:
                row['ports'] = [int(i) for i in idx]
            rows.append(row)
        lev['caps'][name] = rows
    if L == 0:
        nat = {'seam': list(C.E[0]), 'face': list(C.F[0]), 'star': [0] + C.nbr[0],
               'all_but_antipode': [p for p in range(12) if p != C.anti[0]]}
        lev['native_caps'] = {}
        for k, idx in nat.items():
            n = U[idx].mean(axis=0)
            row = record(U, W, np.array(idx), n / np.linalg.norm(n), None)
            row['ports'] = [int(i) for i in idx]
            lev['native_caps'][k] = row
    out['levels'][str(L)] = lev
    print('level', L, 'N', N, 'port axis:', [(r['alpha_deg'], r['n_C'], r['cbar'], r['eta']) for r in lev['caps']['port']], flush=True)
out['identity_defects_max'] = worst

# convergence of the rapidity to the continuum value
conv = {}
for name in ax:
    for i, a0 in enumerate(ALPHAS):
        conv.setdefault(name, {})[str(a0)] = [(abs(out['levels'][str(L)]['caps'][name][i]['eta'] - out['levels'][str(L)]['caps'][name][i]['eta_continuum'])
                                               if out['levels'][str(L)]['caps'][name][i]['eta'] is not None else None) for L in range(5)]
out['abs_error_of_eta_vs_continuum_by_level'] = conv
errs = np.array([[np.mean([conv[n][str(a)][L] for n in ax for a in ALPHAS[2:8] if conv[n][str(a)][L] is not None]) for L in range(5)]])
Ns = np.array([out['levels'][str(L)]['N'] for L in range(5)], float)
p = np.polyfit(np.log(Ns[1:]), np.log(errs[0, 1:]), 1)
out['eta_error_rate'] = {'caps': 'alpha 50 to 125 degrees, four axes', 'mean_abs_error_by_level': errs[0].tolist(), 'fit_exponent_levels_1_to_4': float(p[0])}
json.dump(out, open('caps.json', 'w'), indent=1)
print('identity defects', worst, 'eta error by level', errs[0], 'exponent', p[0])

# ------------------------------------------------------------------ the group generated by the cap effects (level 0)
grp = {}
U, F = icosphere(0)
nat = out['levels']['0']['native_caps']
gens = {}
for kind in ('star', 'all_but_antipode'):
    eta = nat[kind]['eta']
    gens[kind] = [boost(U[p], eta) for p in range(12)]
eta_f = nat['face']['eta']
gens['face'] = [boost(U[list(f)].sum(axis=0), eta_f) for f in C.F]
eta_s = nat['seam']['eta']
gens['seam'] = [boost(U[list(e)].sum(axis=0), eta_s) for e in C.E]


def real_lie_closure(mats, tol=1e-9):
    basis = []

    def add(m):
        v = np.concatenate([m.real.ravel(), m.imag.ravel()])
        for b in basis:
            v = v - (b @ v) * b
        if np.linalg.norm(v) > tol:
            basis.append(v / np.linalg.norm(v)); return True
        return False
    ms = []
    for m in mats:
        if add(m):
            ms.append(m)
    changed = True
    while changed:
        changed = False
        for a, b in itertools.combinations(list(ms), 2):
            c = a @ b - b @ a
            if add(c):
                ms.append(c); changed = True
    return len(basis)


logs = [herm(0, U[p]) for p in range(12)]
grp['real_Lie_algebra_generated_by_log_E_C'] = {
    'traceless_parts (boost generators n.sigma of the six port axes)': real_lie_closure(logs),
    'with_the_identity': real_lie_closure(logs + [I2]),
    'real_span_of_the_generators': int(np.linalg.matrix_rank(np.array([np.concatenate([m.real.ravel(), m.imag.ravel()]) for m in logs + [I2]]), tol=1e-9))}


def jorgensen(A, B):
    tr = np.trace(A)
    com = A @ B @ np.linalg.inv(A) @ np.linalg.inv(B)
    return float(abs(tr * tr - 4) + abs(np.trace(com) - 2))


grp['jorgensen'] = {}
for kind, g in gens.items():
    vals = sorted(jorgensen(g[i], g[j]) for i in range(len(g)) for j in range(len(g)) if i != j and abs(abs(np.trace(g[i] @ np.linalg.inv(g[j]))) - 2) > 1e-9)
    grp['jorgensen'][kind] = {'eta': float(np.arccosh(np.real(np.trace(g[0])) / 2) * 2), 'min_J': vals[0], 'max_J': vals[-1]}
# mixed pair: star boost composed with the inverse 11-cap boost etc. Search short words for a violating pair
allg = gens['star'] + gens['all_but_antipode'] + gens['face'] + gens['seam']
best = min(jorgensen(a, b) for a, b in itertools.permutations(gens['all_but_antipode'][:6], 2) if abs(abs(np.trace(a @ np.linalg.inv(b))) - 2) > 1e-9)
grp['jorgensen']['statement'] = ('a pair of hyperbolic elements with four distinct fixed points and J = |tr^2 A - 4| + |tr[A,B] - 2| < 1 generates a '
                                 'non-discrete group (IMPORTED: Jorgensen inequality); with the six axes not on one circle the closure is SL(2,C) (ARGUED: '
                                 'the identity component of the closure has an Ad-invariant Lie algebra, sl(2,C) is simple as a real Lie algebra)')
grp['jorgensen']['min_J_over_pairs_of_11_port_caps'] = best
# Schottky threshold: the twelve port caps of angular radius beta, tan(beta/2) = exp(-eta/2), are disjoint
th = np.arccos(1 / np.sqrt(5)) / 2
grp['schottky_threshold_eta_for_port_axes'] = float(-2 * np.log(np.tan(th / 2)))
# small elements: words in the star generators near the identity and the real span of their logarithms
rng = np.random.default_rng(1)
G = gens['star']
Ginv = [np.linalg.inv(g) for g in G]
letters = G + Ginv
small = []
frontier = [I2]
seen = 0
for depth in range(1, 7):
    new = []
    for w in frontier:
        for g in letters:
            x = g @ w
            new.append(x)
    if len(new) > 40000:
        sel = rng.choice(len(new), 40000, replace=False)
        new = [new[i] for i in sel]
    frontier = new
    for x in new:
        d = np.linalg.norm(x - I2 * np.sign(np.real(np.trace(x))))
        if 1e-6 < d < 0.25:
            small.append((d, x * np.sign(np.real(np.trace(x)))))
small.sort(key=lambda t: t[0])
if small:
    from scipy.linalg import logm
    lg = [logm(x) for d, x in small[:200]]
    rk = int(np.linalg.matrix_rank(np.array([np.concatenate([m.real.ravel(), m.imag.ravel()]) for m in lg]), tol=1e-6))
    grp['words_in_star_boosts_up_to_length_6'] = {'elements_within_0.25_of_identity': len(small), 'closest': small[0][0],
                                                  'real_rank_of_their_logarithms (6 = sl(2,C))': rk}
json.dump(grp, open('cap_group.json', 'w'), indent=1)
print(json.dumps(grp, indent=1))
