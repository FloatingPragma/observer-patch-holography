def find(path, phrase):
    full = os.path.join(RER, path)
    if not os.path.isfile(full):
        return None
    with open(full, encoding='utf-8', errors='replace') as fh:
        for n, line in enumerate(fh, 1):
            if phrase in line:
                return n
    return None


def main():
    head = subprocess.run(['git', '-C', RER, 'log', '-1', '--format=%h %ci'], capture_output=True, text=True).stdout.strip()
    out = {'checkout': RER, 'head': head, 'sections': {}}
    total = unmatched = 0
    md = ['# Stack statements bearing on the unit of the clock (worker LT, step L3)', '',
          f'Checkout: `{RER}` at `{head}`. Every row was matched by `lt_statements.py`: the quoted phrase occurs at the '
          'given line of the current tree. Status words are the files\' own or describe the kind of file.']
    rows_md = []
    for sid, summary, entries in SECTIONS:
        rows = []
        for path, phrase, status in entries:
            n = find(path, phrase)
            total += 1
            unmatched += n is None
            rows.append({'file': path, 'line': n, 'phrase': phrase, 'status': status})
        out['sections'][sid] = {'summary': summary, 'rows': rows}
        rows_md += ['', f'## {sid}', '', summary, '', '| File and line | Quoted phrase | Status |', '| --- | --- | --- |']
        for r in rows:
            phrase = r['phrase'].strip().replace('|', '\\|')
            rows_md.append(f"| `{r['file']}:{r['line']}` | {phrase} | {r['status']} |")
    out['entries'], out['unmatched'] = total, unmatched
    md[2] += f' Entries: {total}, unmatched: {unmatched}.'
    json.dump(out, open(os.path.join(HERE, 'statements_check.json'), 'w'), indent=1)
    open(os.path.join(HERE, 'STATEMENTS.md'), 'w').write('\n'.join(md + rows_md) + '\n')
    print('entries', total, 'unmatched', unmatched)
    for sid, sec in out['sections'].items():
        for r in sec['rows']:
            if r['line'] is None:
                print('UNMATCHED', sid, r['file'], '|', r['phrase'])


if __name__ == '__main__':
    main()
