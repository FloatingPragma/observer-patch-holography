out['C_units'] = C

pS = prim['equal_normalization_SM']; pM = prim['equal_normalization_MSSM_proxy']
out['summary'] = {
    'D4_ratios': 'gauge invariance leaves three weights; one class function on the five levels (equivalently the family trace or a tracial reference) gives g1^2:g2^2:g3^2 = 1:1:1 and sin2 = 3/8; '
