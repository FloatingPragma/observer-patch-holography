    'pump_pairings (sin2, alpha3/alpha2)': [[r['implied']['sin2_theta_W_float'], r['implied']['alpha3/alpha2_float']] for r in forms if r['name'] == 'pump-weighted form'],
    'field_step': 'c_f = n sqrt(eps kappa); alpha_m = n eps/(4 pi); alpha_f = sqrt(eps/kappa)/(4 pi); routing speed iff n^2 eps kappa = 1, n >= 2',
    'running_SM_primary (NOT BLIND)': {'scale_GeV': pS['scale_where_alpha1=alpha2_GeV (sin2 = 3/8)'], 'inverse_alpha_U': pS['inverse_alpha_U_there'], 'alpha_s_predicted': pS['predicted_alpha_s(MZ)'],
