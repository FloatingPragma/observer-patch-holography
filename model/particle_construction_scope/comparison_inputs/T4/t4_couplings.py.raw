json.dump(out, open(sys.argv[1] if len(sys.argv) > 1 else 'couplings.json', 'w'), indent=1, default=str)

# ---- console summary ------------------------------------------------------------------------------------------------
print('A. exact checks:', {k: v for k, v in A.items() if isinstance(v, bool)})
print('A. float defects:', {k: (f'{v:.1e}' if isinstance(v, float) else '') for k, v in A['float_checks_on_the_carrier_vectors'].items() if isinstance(v, float)})
print('A. pump:', pump.get('levels_used'), 'difference from CX', pump.get('largest_difference_from_CX_levels'), pump.get('error', ''))
for r in forms:
    imp = r.get('implied') or r.get('implied_per_block') or {}
    print('N.', r['name'], '|', r.get('pairing', '')[:28], '| weights', r.get('weights_relative_to_Tr5 (1, 3prime, 3, 5)', r.get('weights_relative_to_Tr5 (1, 3prime, 3, 5), up to a common factor', '')),
          '| invariant', r.get('invariant_under_the_gauge_algebra'), '| ad defect', r.get('ad_invariance_defect (float, trace-orthonormal basis)'),
          '| sin2', imp.get('sin2_theta_W'), '| a3/a2', imp.get('alpha3/alpha2'))
    for kx in ('implied_if_the_colour_form_is_averaged_over_SU(3)', 'implied_if_the_inverse_colour_form_is_averaged'):
        if kx in r: print('     ', kx, r[kx])
print('B. Coulomb ratios', [(r['lattice'], r['r1'], r['r2'], round(r['ratio'], 4)) for r in coul])
print('B. isotropy', iso)
print('D. alpha^-1(MZ)', ainvZ, 'd_lep', dlep, 'sin2 on-shell', s2_os, 'sin2 GF', s2_GF)
for name, V in D['variants'].items():
    print('D.', name, [round(x, 4) for x in V['inverse_couplings_at_MZ (alpha1 unified normalization, alpha2, alpha3)']])
    for kx in ('equal_normalization_SM', 'equal_normalization_MSSM_proxy'):
        u = V[kx]; print('   ', kx, {k2: (f'{v2:.5g}' if isinstance(v2, float) else v2) for k2, v2 in u.items() if k2 not in ('coefficients', 'b')})
    for r in V['required_normalization_by_scale_SM']: print('    required at', r['scale'], f"{r['GeV']:.4g}", 'sin2', round(r['required_sin2'], 4), 'a3/a2', round(r['required_alpha3/alpha2'], 4), 'inv', [round(x, 2) for x in r['inverse_couplings']])
    for r in V['candidates_against_SM_running']: print('    cand', r['normalization'][:60], 'sin2', round(r['sin2'], 4), 'a3/a2', round(r['alpha3/alpha2'], 4), 'mu_w', r['scale_from_the_weak_mixing_angle_GeV'], 'mu_s', r['scale_from_alpha3/alpha2_GeV'])
    print('    fits', V['fits_not_derivations'])
print('C. pixel', {k: v for k, v in C['if_the_cell_is_the_public_pixel'].items() if not isinstance(v, (list, dict))})
print('C. pixel trace form run down', C['if_the_cell_is_the_public_pixel']['trace_form_at_this_scale_run_down (SM)'])
print('C. required at pixel', C['if_the_cell_is_the_public_pixel']['couplings_required_at_this_scale (SM one loop, inverse)'])
print('C. D10', C['source_derived_anchors_claimed_by_the_public_checkout']['D10_lane']['values_at_P_C'])
print('C. D10 with SM', {k2: v2 for k2, v2 in C['source_derived_anchors_claimed_by_the_public_checkout']['D10_lane'].items() if k2.startswith('same') or k2.startswith('eps')})
print('C. cheapest', C['cheapest_anchor']['unit_then'])
print('A. invariant form counts', A['count_of_invariant_quadratic_forms'])
for r in cop: print('D. copies', {k2: (f'{v2:.4g}' if isinstance(v2, float) else v2) for k2, v2 in r.items() if k2 != 'b'})
print('SUMMARY', json.dumps(out['summary'], indent=1, default=str))
