        'D10_lane': {'values_at_P_C': {'M_U_GeV': d10['M_U'] * Estar, 'alpha_U_inverse': 1 / d10['alpha_U'], 'sin2(mZ)': d10['sin2w_mz'], 'alpha3(mZ)': d10['alpha3_mz'],
                                       'alpha_em_inverse(mZ)': d10['alpha_em_inv_mz'], 'mZ_GeV': d10['mZ_run'] * Estar, 'v_GeV': d10['v'] * Estar, 'v/E_star': d10['v']},
                     'assumes': 'equal couplings alpha_U at M_U (the trace-form normalization), the MSSM proxy, the declared transmutation; W/Z chart conditional on the unemitted QT1-QT5 certificate (code/particles/README.md)',
                     'same_point_run_down_with_SM_coefficients (inverse couplings at MZ)': at([1 / d10['alpha_U']] * 3, [-x for x in B_SM], math.log(d10['M_U'] * Estar / MZ)),
                     'same_point_with_SM_coefficients: alpha3 diverges at GeV': d10['M_U'] * Estar * math.exp(-2 * math.pi / d10['alpha_U'] / 7),
                     'same_point_with_the_MSSM_set (inverse couplings at MZ)': at([1 / d10['alpha_U']] * 3, [-x for x in B_MSSM], math.log(d10['M_U'] * Estar / MZ)),
                     'eps_kappa_for_n=2_if_CF-1_adopted_alpha_U(P)': eps_kappa(d10['alpha_U'], 2)},
        'what_none_of_them_fixes': 'a unit: E_star is externally normalized (docs/research/OPH_PARTICLE_MASS_RESPONSE.md; code/particles/runs/clock/clock_source_energy_closure_audit.json verdict NOT_FINAL_SOURCE_ONLY_PACKET)'},
    'if_the_cell_is_the_public_pixel': {'declared': 'a^2 = P l_star^2 with l_star the Planck length', 'l_Planck_m': lP, 'cell_m': a_pix, 'tick_s': a_pix / si['c_m_s'], 'lattice_scale_GeV = E_star/sqrt(P)': E_cell,
                                         'public_M_U_GeV': M_U, 'electron_rest_phase_per_tick_required': me / E_cell, 'top_rest_phase_required': mass['top'] / E_cell,
                                         'Z_rest_phase_required': MZ / E_cell,
                                         'couplings_required_at_this_scale (SM one loop, inverse)': aE, 'required_sin2': sin2_of(aE), 'required_alpha3/alpha2': aE[1] / aE[2],
                                         'trace_form_at_this_scale_run_down (SM)': {'alpha_U_inverse from alpha(MZ)': aU_pix, 'sin2(MZ)': a2_pix / ainvZ, 'inverse_alpha3(MZ)': a3_pix,
                                                                                    'alpha3 diverges at GeV': E_cell * math.exp(-2 * math.pi * aU_pix / (-bS[2]))}},
    'scales_the_candidate_offers (reports/R7.md, electron anchor)': [
        {'option': 'M1 (flux reading V)', 'cell_fm': [33.9, 66.1], 'lattice_scale_GeV = hbar c/cell': [hbarc / 66.1e-15, hbarc / 33.9e-15]},
        {'option': 'H (background of the runs)', 'cell_fm': 3.09, 'lattice_scale_GeV': hbarc / 3.09e-15},
        {'option': 'M2 (free angle), bound if the top shares the clock', 'cell_m_below': 3.59e-18, 'lattice_scale_GeV_above': hbarc / 3.59e-18},
