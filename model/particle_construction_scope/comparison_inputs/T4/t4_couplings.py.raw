    'running_MSSM_proxy_primary (NOT BLIND; content absent from CF-1)': {'scale_GeV': pM['scale_where_alpha1=alpha2_GeV (sin2 = 3/8)'], 'inverse_alpha_U': pM['inverse_alpha_U_there'],
