"""Item 5: the dressed one-quantum branch of the complete tick U = F_eps F_kappa M S (forward order) to second order in eps.

Unperturbed state: links flat, quantum in the plane wave |p, s> (E = E_s(p)). Second-order Floquet perturbation theory
(PROOFS.md, section 5) gives, relative to the vacuum,
    omega(p) = E(p) + eps^2 sigma(p),
    sigma(p) = -(1/2) sum_links [ <p| cot((H_l - E)/2 - a) |p> + cot(a) ],      a = kappa * (plaquettes per link),
with H_l the quasi-energy operator of the one-body tick with the single link l flipped. Two evaluations:
  dense(...)      definition level, eigen-decomposition of every one-link-flipped one-body tick (small lattices);
  kspace(...)     rank-4 resolvent identity (PROOFS.md):  sigma = -(1/(2 sin^2 a)) sum_i v_i^+ (D K_i D)^(-1) v_i,
                  K_i from a Brillouin-zone sum of 4x4 symbols; any lattice size; eta > 0 gives the retarded value.
"""
import itertools, json, sys, time
import numpy as np
from r5lib import Routing, ALPHA, BETA, matrix_of

I4 = np.eye(4, dtype=complex)
PP = [(I4 + a) / 2 for a in ALPHA]; PM = [(I4 - a) / 2 for a in ALPHA]


def coin_on_axis(p1, theta, sigma1=+1):
    """positive branch of the forward symbol at p = (p1, 0, 0), spin sigma_1 = +-1; index 2*record + spin"""
    X = np.array([[0, 1], [1, 0]], complex); Y = np.array([[0, -1j], [1j, 0]])
    U2 = (np.cos(theta) * np.eye(2) - 1j * np.sin(theta) * Y) @ (np.cos(p1) * np.eye(2) - 1j * sigma1 * np.sin(p1) * X)
    lam, v = np.linalg.eig(U2); j = int(np.argmax(-np.angle(lam))); r = v[:, j] / np.linalg.norm(v[:, j])
    return np.kron(r, np.array([1, sigma1]) / np.sqrt(2)), float(-np.angle(lam[j]))


def one_body(shape, theta, p, flip=None):
    """dense one-body forward tick on the torus with twist such that the uniform state has kinetic momentum p;
    flip = (cell, axis) flips the sign of one link"""
    links = [np.full(shape, np.exp(1j * p[i]) if shape[i] > 1 else 1.0, dtype=complex) for i in range(3)]
    if flip is not None: links[flip[1]][flip[0]] *= -1
    eng = Routing(shape, links)
    return matrix_of(lambda psi: eng.tick(psi, theta), tuple(shape) + (2, 2))


def dense(shape, theta, kappa, p, coin, E):
    """definition-level sigma(p) (real, no regulator) and the vacuum term"""
    shape = tuple(shape); N = int(np.prod(shape)); dirs = [i for i in range(3) if shape[i] > 1]
    npl = 2 * (len(dirs) - 1); a = kappa * npl
    psi0 = np.tile(coin, N) / np.sqrt(N)
    U0 = one_body(shape, theta, p); res0 = np.linalg.norm(U0 @ psi0 - np.exp(-1j * E) * psi0)
    tot = 0.0
    for i in dirs:                                           # all links of one direction are equivalent
        Ul = one_body(shape, theta, p, flip=((0, 0, 0), i))
        mu = np.exp(-1j * (E + 2 * a))                        # cot((H_l - E)/2 - a) = -i (U_l + mu)(U_l - mu)^(-1)
        val = -1j * np.vdot(psi0, (Ul + mu * np.eye(len(Ul))) @ np.linalg.solve(Ul - mu * np.eye(len(Ul)), psi0))
        tot += N * float(val.real + 1 / np.tan(a))
    return -0.5 * tot, dict(residual_unperturbed=float(res0), vacuum_shift_per_eps2=0.5 * N * len(dirs) / np.tan(a), plaquettes_per_link=npl)


def symbol_grid(K, theta):
    """forward symbol on an array of momenta K[..., 3]"""
    out = np.broadcast_to(I4, K.shape[:-1] + (4, 4)).copy()
    for i in range(3):
        out = (np.cos(K[..., i])[..., None, None] * I4 - 1j * np.sin(K[..., i])[..., None, None] * ALPHA[i]) @ out
    return (np.cos(theta) * I4 - 1j * np.sin(theta) * BETA) @ out


def kspace(dims, L, theta, kappa, p, coin, E, eta=0.0):
    """sigma(p) on the L^dims torus (momentum grid p + 2 pi n/L); complex if eta > 0"""
    npl = 2 * (dims - 1); a = kappa * npl; N = L ** dims
    axes = [2 * np.pi * np.arange(L) / L + p[i] if i < dims else np.array([p[i]]) for i in range(3)]
    K = np.stack(np.meshgrid(*axes, indexing='ij'), axis=-1).reshape(-1, 3)
    U = symbol_grid(K, theta)
    mu = np.exp(-1j * (E + 2 * a + 1j * eta))                 # cot((y - H0(k))/2) = i (U0 + mu)(U0 - mu)^(-1), y = E + 2a + i eta
    c = 1j * (U + mu * I4) @ np.linalg.inv(U - mu * I4)
    tot = 0.0
    for i in range(dims):
        S = np.broadcast_to(I4, (len(K), 4, 4)).copy()
        for j in range(i):
            S = (np.cos(K[:, j])[:, None, None] * I4 - 1j * np.sin(K[:, j])[:, None, None] * ALPHA[j]) @ S
        Ct = S @ c @ np.linalg.inv(S)
        ph = np.exp(1j * K[:, i])[:, None, None]
        K8 = np.block([[Ct.mean(axis=0), (Ct / ph).mean(axis=0)], [(Ct * ph).mean(axis=0), Ct.mean(axis=0)]])
        D = np.block([[PP[i], np.zeros((4, 4))], [np.zeros((4, 4)), PM[i]]])
        w = coin.copy()
        for j in range(i): w = (np.cos(p[j]) * I4 - 1j * np.sin(p[j]) * ALPHA[j]) @ w
        v = D @ np.concatenate([w, np.exp(1j * p[i]) * w])
        tot = tot + np.vdot(v, np.linalg.pinv(D @ K8 @ D, rcond=1e-10) @ v)
    sig = -tot / (2 * np.sin(a) ** 2)
    return (float(sig.real) if eta == 0 else complex(sig))


if __name__ == '__main__':
    out = {}; t0 = time.time(); th = 0.157935
    # 1. the two evaluations agree (small lattices, no regulator)
    rows = []
    for shape, dims, L, kap in (((4, 4, 1), 2, 4, -0.06), ((5, 5, 1), 2, 5, 0.31), ((3, 3, 3), 3, 3, -0.03)):
        for p1 in (0.1, 0.3):
            coin, E = coin_on_axis(p1, th); p = (p1, 0.0, 0.0)
            d, info = dense(shape, th, kap, p, coin, E); k = kspace(dims, L, th, kap, p, coin, E)
            rows.append(dict(shape=shape, kappa=kap, p1=p1, sigma_dense=d, sigma_kspace=k, residual_unperturbed=info['residual_unperturbed']))
            print(f'1. {shape} kappa={kap} p1={p1}: sigma dense {d:+.8f}  k-space {k:+.8f}  (unperturbed residual {info["residual_unperturbed"]:.1e})')
    out['dense_against_kspace'] = rows
    json.dump(out, open(sys.argv[1] if len(sys.argv) > 1 else 'selfenergy_check.json', 'w'), indent=1)
    print('seconds', round(time.time() - t0, 1))
