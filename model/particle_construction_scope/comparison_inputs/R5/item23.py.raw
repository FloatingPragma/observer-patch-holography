"""Items 2 and 3: the strict cone and the exact symmetries of the complete tick (one charged quantum, quantum Z2 links).

Cone (PROOFS.md, Theorem 2): an operator supported on the cells x_i <= a and the links with both ends there is carried by
one tick into the same region with a + 1, for every axis, both directions, any eps, kappa, theta(x). Executed as exact
zeros of commutators [U^n O_A U^-n, O_B] outside the region and nonzero values on its boundary.
Symmetries (Theorem 3): Gauss operators, translations, half-turns about the frame axes with their spin lifts, parity,
time reversal of the alternating pair, charge conjugation (one-body identity), and the 24 cube rotations on the symbol.
"""
import itertools, json, sys, time
import numpy as np
from qlink import QLink, selftest
from r5lib import Routing, SIG, X2, Y2, I2, ALPHA, BETA

out = {}; t0 = time.time()
w, inv = selftest(); out['selftest_routing_against_reference_engine'] = w; out['selftest_inverse_tick'] = inv
print('selftest: routing against the reference engine %.1e, inverse tick %.1e' % (w, inv))
rngU = np.random.default_rng(7)
def haar4():
    q, r = np.linalg.qr(rngU.normal(size=(4, 4)) + 1j * rngU.normal(size=(4, 4))); return q

def heis(q, n, opA, Phi):
    """(U^n O_A U^-n) Phi for the alternating schedule (tick t = 1..n, odd t forward)"""
    for t in range(n, 0, -1): Phi = q.tick_inv(Phi, reverse=(t % 2 == 0))
    Phi = opA(Phi)
    for t in range(1, n + 1): Phi = q.tick(Phi, reverse=(t % 2 == 0))
    return Phi

def comm(q, n, opA, opB, Psi):
    return float(np.linalg.norm(heis(q, n, opA, opB(Psi)) - opB(heis(q, n, opA, Psi))))

# ---- item 2a: a ring of 10 cells, quantum links, eps = 0.4 ---------------------------------------------------------
L = 10; q = QLink((L, 1, 1), theta=0.3, eps=0.4); Psi = q.random(3); V = haar4(); Vb = haar4()
cone = []
for n in (1, 2, 3):
    opA = lambda P: q.op_cell(P, (0, 0, 0), V)
    outside, boundary = [], []
    for d in range(-4, 5):
        c = comm(q, n, opA, lambda P: q.op_cell(P, (d % L, 0, 0), Vb), Psi)
        (outside if abs(d) > n else boundary if abs(d) == n else []).append(c)
    for x in range(-5, 5):                                   # link from x to x + 1
        l = q.lid[((x % L, 0, 0), 0)]
        for op in (q.op_X, q.op_Z):
            c = comm(q, n, opA, lambda P: op(P, l), Psi)
            inside = (-n <= x) and (x + 1 <= n)
            (outside if not inside else boundary if (x == -n or x + 1 == n) else []).append(c)
    cone.append(dict(ticks=n, max_commutator_outside=max(outside), min_commutator_on_boundary=min(boundary), operators_outside=len(outside)))
    print(f'ring of {L}, eps=0.4: after {n} ticks max commutator outside the cone {max(outside):.1e} ({len(outside)} operators), min on its boundary {min(boundary):.2e}')
out['cone_ring'] = cone

# ---- item 2b: 4 x 2 x 1 with plaquettes, eps = 0.4, kappa = 0.5, one tick ---------------------------------------------
q = QLink((4, 2, 1), theta=0.3, eps=0.4, kappa=0.5); Psi = q.random(4)
res = []
A_ops = {'cell (0,0)': lambda P: q.op_cell(P, (0, 0, 0), V), 'X on the transverse link at x1 = 0': lambda P: q.op_X(P, q.lid[((0, 0, 0), 1)])}
for name, opA in A_ops.items():
    outside = []
    for x2 in (0, 1):
        outside.append(comm(q, 1, opA, lambda P: q.op_cell(P, (2, x2, 0), Vb), Psi))
        for l in (q.lid[((2, x2, 0), 1)], q.lid[((1, x2, 0), 0)], q.lid[((2, x2, 0), 0)]):
            for op in (q.op_X, q.op_Z): outside.append(comm(q, 1, opA, lambda P: op(P, l), Psi))
    inside = [comm(q, 1, opA, lambda P: q.op_cell(P, (1, 0, 0), Vb), Psi), comm(q, 1, opA, lambda P: q.op_X(P, q.lid[((1, 0, 0), 1)]), Psi),
              comm(q, 1, opA, lambda P: q.op_Z(P, q.lid[((1, 0, 0), 1)]), Psi), comm(q, 1, opA, lambda P: q.op_X(P, q.lid[((0, 0, 0), 0)]), Psi)]
    res.append(dict(operator=name, max_commutator_outside=max(outside), operators_outside=len(outside), commutators_on_the_boundary_column=inside))
    print(f'4x2, eps=0.4, kappa=0.5, one tick, O_A = {name}: max commutator with the {len(outside)} operators at distance 2: {max(outside):.1e}; at distance 1: ' + ', '.join('%.2e' % v for v in inside))
out['cone_4x2'] = res

# ---- item 3: symmetries on 3 x 2 x 1 --------------------------------------------------------------------------------
q = QLink((3, 2, 1), theta=0.3, eps=0.3, kappa=0.2); Psi = q.random(5); sym = {}
nrm = lambda a: float(np.linalg.norm(a))
sym['gauss_forward'] = max(nrm(q.tick(q.gauss(Psi, c)) - q.gauss(q.tick(Psi), c)) for c in q.cells)
sym['gauss_reverse'] = max(nrm(q.tick(q.gauss(Psi, c), True) - q.gauss(q.tick(Psi, True), c)) for c in q.cells)
qx = QLink((3, 2, 1), theta=np.random.default_rng(1).uniform(0, 0.5, 6), eps=0.3, kappa=0.2, twist=(0.4, -0.3, 0.0))
sym['gauss_with_theta_of_x_and_U1_twist'] = max(nrm(qx.tick(qx.gauss(Psi, c)) - qx.gauss(qx.tick(Psi), c)) for c in qx.cells)
S3 = np.kron(I2, SIG[2]); S1 = np.kron(I2, SIG[0]); S2m = np.kron(I2, SIG[1]); E4 = np.eye(4)
maps = {'translation_axis_1': ((0, 1, 2), (1, 1, 1), (1, 0, 0), E4), 'translation_axis_2': ((0, 1, 2), (1, 1, 1), (0, 1, 0), E4),
        'half_turn_axis_3': ((0, 1, 2), (-1, -1, 1), (0, 0, 0), S3), 'half_turn_axis_1': ((0, 1, 2), (1, -1, -1), (0, 0, 0), S1),
        'half_turn_axis_2': ((0, 1, 2), (-1, 1, -1), (0, 0, 0), S2m), 'parity': ((0, 1, 2), (-1, -1, -1), (0, 0, 0), BETA)}
for name, (perm, sign, t, u) in maps.items():
    f = lambda P: q.spatial(P, perm, sign, t, u)
    sym[name] = max(nrm(q.tick(f(Psi), r) - f(q.tick(Psi, r))) for r in (False, True))
# a wrong lift as a control: half-turn about axis 3 without the spin lift
f = lambda P: q.spatial(P, (0, 1, 2), (-1, -1, 1), (0, 0, 0), E4)
sym['control_half_turn_axis_3_without_spin_lift'] = nrm(q.tick(f(Psi)) - f(q.tick(Psi)))
GT = np.kron(X2, SIG[1]); GC = np.kron(Y2, SIG[1])
theta_ = lambda P: np.conj(P) @ GT.T
thp = lambda P: q.mass(q.field_eps(theta_(P)))                       # Theta' = M F_eps Theta
sym['time_reversal_of_the_alternating_pair'] = nrm(q.two(thp(q.two(Psi))) - thp(Psi))
sym['control_time_reversal_single_forward_tick'] = nrm(q.tick(thp(q.tick(Psi))) - thp(Psi))
cc = lambda P: np.conj(P) @ GC.T
ms = lambda P, r: q.mass(q.route(P, r))
sym['charge_conjugation_one_body_routing_and_mass_all_link_words'] = max(nrm(ms(cc(Psi), r) - cc(ms(Psi, r))) for r in (False, True))
sym['control_charge_conjugation_antiunitary_against_field_step'] = nrm(q.tick(cc(Psi)) - cc(q.tick(Psi)))
out['symmetries_3x2'] = sym
for k, v in sym.items(): print(f'  {k}: {v:.2e}')

# ---- frame rotations on the symbol -----------------------------------------------------------------------------------
def rotations():
    for perm in itertools.permutations(range(3)):
        for s in itertools.product((1, -1), repeat=3):
            R = np.zeros((3, 3));
            for i in range(3): R[perm[i], i] = s[i]
            if np.linalg.det(R) > 0: yield R
def lift(R):
    ang = np.arccos(np.clip((np.trace(R) - 1) / 2, -1, 1))
    if ang < 1e-9: return np.eye(2, dtype=complex)
    if abs(ang - np.pi) < 1e-9:
        wv, v = np.linalg.eigh(R); n = v[:, int(np.argmax(wv))]
    else:
        n = np.array([R[2, 1] - R[1, 2], R[0, 2] - R[2, 0], R[1, 0] - R[0, 1]]) / (2 * np.sin(ang))
    return np.cos(ang / 2) * np.eye(2) - 1j * np.sin(ang / 2) * sum(n[i] * SIG[i] for i in range(3))
def sym_f(p, th): return Routing.symbol(p, th)
def sym_r(p, th):
    o = np.eye(4, dtype=complex)
    for i in (2, 1, 0): o = (np.cos(p[i]) * np.eye(4) - 1j * np.sin(p[i]) * ALPHA[i]) @ o
    return (np.cos(th) * np.eye(4) - 1j * np.sin(th) * BETA) @ o
def spec(m): return np.sort(np.angle(np.linalg.eigvals(m)))
rng = np.random.default_rng(9); ps = [rng.uniform(-1, 1, 3) for _ in range(5)]; th = 0.157935
cls = dict(keeps_each_ordered_tick=0, exchanges_forward_and_reverse=0, neither=0); three = []
for R in rotations():
    u = np.kron(I2, lift(R))
    df = max(np.abs(u @ sym_f(p, th) @ u.conj().T - sym_f(R @ p, th)).max() for p in ps)
    dr = max(np.abs(u @ sym_f(p, th) @ u.conj().T - sym_r(R @ p, th)).max() for p in ps)
    key = 'keeps_each_ordered_tick' if df < 1e-12 else 'exchanges_forward_and_reverse' if dr < 1e-12 else 'neither'
    cls[key] += 1
    if abs(np.trace(R)) < 1e-9 and key == 'neither' and not three:      # a third of a turn about a cube diagonal
        for scale in (0.4, 0.2, 0.1):
            p = scale * np.array([0.5, 0.3, -0.8]); row = dict(p_norm=float(np.linalg.norm(p)))
            row['massless_forward_spectrum_defect'] = float(np.abs(spec(sym_f(p, 0)) - spec(sym_f(R @ p, 0))).max())
            row['massive_forward_spectrum_defect'] = float(np.abs(spec(sym_f(p, th)) - spec(sym_f(R @ p, th))).max())
            row['massive_alternating_pair_spectrum_defect'] = float(np.abs(spec(sym_r(p, th) @ sym_f(p, th)) - spec(sym_r(R @ p, th) @ sym_f(R @ p, th))).max()) / 2
            three.append(row)
out['cube_rotations_on_the_symbol'] = cls; out['third_of_a_turn'] = three
print('24 cube rotations with spin lift, on the symbol:', cls)
for r in three: print('  third of a turn about a cube diagonal:', {k: (round(v, 6) if k == 'p_norm' else float('%.3e' % v)) for k, v in r.items()})
out['seconds'] = time.time() - t0
json.dump(out, open(sys.argv[1] if len(sys.argv) > 1 else 'item23.json', 'w'), indent=1)
