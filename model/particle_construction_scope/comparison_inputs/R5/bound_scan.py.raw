"""Item 5: rest phases of the levels that ONE flipped link binds, in infinite-volume approximation (torus L^dims), per link direction.
A level at phase y exists iff the Hermitian 4x4 matrix K_i(y) = Q_i^+ cot((y - H_0)/2) Q_i (PROOFS.md, section 5) has a zero eigenvalue;
y is scanned through the two gaps of the flat tick, (-theta, theta) and (pi - theta, pi + theta).
NOTE (R5): valid for two dimensions. In three dimensions the forward-only tick is not gapped (PROOFS.md 1c), K is not
Hermitian there (printed defect 1e11) and the listed 3D "levels" are artefacts. Alternating schedule: selfenergy_alt.py.
"""
import json, sys, time
from multiprocessing import Pool
import numpy as np
from selfenergy import symbol_grid, I4, PP, PM
from r5lib import ALPHA
TH = 0.157935
def kmat_eigs(args):
    dims, L, theta, y = args
    axes = [2 * np.pi * np.arange(L) / L if i < dims else np.array([0.0]) for i in range(3)]
    K = np.stack(np.meshgrid(*axes, indexing='ij'), axis=-1).reshape(-1, 3)
    U = symbol_grid(K, theta); mu = np.exp(-1j * y)
    c = 1j * (U + mu * I4) @ np.linalg.inv(U - mu * I4); out = []
    for i in range(dims):
        S = np.broadcast_to(I4, (len(K), 4, 4)).copy()
        for j in range(i): S = (np.cos(K[:, j])[:, None, None] * I4 - 1j * np.sin(K[:, j])[:, None, None] * ALPHA[j]) @ S
        Ct = S @ c @ np.linalg.inv(S); ph = np.exp(1j * K[:, i])[:, None, None]
        K8 = np.block([[Ct.mean(axis=0), (Ct / ph).mean(axis=0)], [(Ct * ph).mean(axis=0), Ct.mean(axis=0)]])
        D = np.block([[PP[i], np.zeros((4, 4))], [np.zeros((4, 4)), PM[i]]])
        w, v = np.linalg.eigh(D); B = v[:, w > 0.5]
        Kr = B.conj().T @ K8 @ B
        out.append(np.linalg.eigvalsh((Kr + Kr.conj().T) / 2).tolist() + [float(np.abs(Kr - Kr.conj().T).max())])
    return out
if __name__ == '__main__':
    t0 = time.time(); res = {}
    for dims, L in ((2, 128), (3, 40), (3, 64)):
        ys = np.concatenate([np.linspace(-TH + 0.004, TH - 0.004, 151), np.linspace(np.pi - TH + 0.004, np.pi + TH - 0.004, 151)])
        with Pool(12) as pool: rows = pool.map(kmat_eigs, [(dims, L, TH, float(y)) for y in ys], chunksize=4)
        for i in range(dims):
            ev = np.array([r[i][:4] for r in rows]); herm = max(r[i][4] for r in rows); levels = []
            for half in (slice(0, 151), slice(151, 302)):
                yy, ee = ys[half], ev[half]
                for col in range(4):
                    for a in range(len(yy) - 1):
                        if ee[a, col] * ee[a + 1, col] < 0 and abs(ee[a, col]) + abs(ee[a + 1, col]) < 5:
                            levels.append(float(yy[a] - ee[a, col] * (yy[a + 1] - yy[a]) / (ee[a + 1, col] - ee[a, col])))
                        elif ee[a, col] == 0: levels.append(float(yy[a]))
            res[f'{dims}D L={L} link direction {i + 1}'] = dict(levels=sorted(levels), antihermitian_part=herm)
            print(f'{dims}D L={L}, flipped link of direction {i + 1}: bound levels at y =', [round(x, 5) for x in sorted(levels)], ' (anti-Hermitian part of K %.1e)' % herm)
    res['seconds'] = time.time() - t0
    json.dump(res, open('bound_scan.json', 'w'), indent=1)
