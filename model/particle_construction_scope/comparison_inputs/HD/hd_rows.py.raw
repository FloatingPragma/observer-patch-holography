#!/usr/bin/env python3
"""HD steps C2 to C4: hadron rows from Lambda^(3) (lambda.json) and imported QCD ratios.

Reads no measured hadron mass. Every lattice number below is IMPORTED with its primary reference
(CANDIDATES.md section B). Run: /tmp/oph-completion-venv/bin/python hd_rows.py lambda.json rows.json
"""

from __future__ import annotations

import json
import math
import sys
from pathlib import Path

HD = Path(__file__).resolve().parent

# ---- IMPORTED lattice numbers (value, stat, syst) in MeV unless stated ----
IMPORTS = {
    "I1_ALPHA17_Lambda3": {"value": 341.0, "err": [12.0], "ref": "ALPHA 17, Bruno et al., PRL 119 (2017) 102001, arXiv:1706.03821, eq. (17)",
                            "scheme": "MSbar Nf=3", "scale": "f_piK = (2 f_K + f_pi)/3 = 147.6 MeV (PDG) via mu*_ref = 478(7) MeV"},
    "I1b_ALPHA22_Lambda3": {"value": 336.0, "err": [12.0], "ref": "ALPHA 22, Dalla Brida et al., EPJC 82 (2022) 1092, arXiv:2209.14204 (as quoted in FLAG 2024 eq. (330))",
                             "scheme": "MSbar Nf=3", "scale": "sqrt(t0)"},
    "I1c_FLAG24_Lambda3": {"value": 338.0, "err": [10.0], "ref": "FLAG 2024, arXiv:2411.04268, eqs. (393), (402)",
                            "scheme": "MSbar Nf=2+1 average", "scale": "r0 = 0.472 fm, [r0 Lambda]^(3) = 0.809(23)"},
    "I2_BMW08_mN_Xi": {"value": 936.0, "err": [25.0, 22.0], "ref": "BMW 08, Durr et al., Science 322 (2008) 1224, arXiv:0906.3599, Table 1",
                        "scheme": "Nf=2+1", "scale": "M_Xi; quark masses from M_pi/M_Xi, M_K/M_Xi"},
    "I2_BMW08_mN_Omega": {"value": 953.0, "err": [29.0, 19.0], "ref": "BMW 08, Table 1", "scheme": "Nf=2+1",
                           "scale": "M_Omega; quark masses from M_pi/M_Omega, M_K/M_Omega"},
    "I3_BMW08_mrho_Xi": {"value": 775.0, "err": [29.0, 13.0], "ref": "BMW 08, Table 1", "scheme": "Nf=2+1",
                          "scale": "M_Xi; finite-volume resonance correction"},
    "I3_BMW08_mrho_Omega": {"value": 778.0, "err": [30.0, 33.0], "ref": "BMW 08, Table 1", "scheme": "Nf=2+1",
                             "scale": "M_Omega; finite-volume resonance correction"},
    "I4_BMW13_B_2GeV": {"value": 2682.0, "err": [36.0, 39.0], "ref": "BMW 13, Borsanyi et al., PRD 88 (2013) 014513, arXiv:1205.0788, eq. (34)",
                         "scheme": "MSbar 2 GeV, SU(2) LO", "scale": "f_pi = 130.41 MeV, M_pi = 134.8 MeV; m_ud from BMW 10"},
    "I4b_BMW13_f": {"value": 122.72, "err": [0.07, 0.35], "ref": "BMW 13, eq. (17)", "scheme": "SU(2) chiral limit, f = sqrt2 F", "scale": "f_pi"},
    "I4b_BMW13_Lambda3_NLO": {"value": 653.0, "err": [32.0, 101.0], "ref": "BMW 13, eq. (18)", "scheme": "SU(2) NLO scale (l3bar)", "scale": "f_pi"},
    "I5_BMW14_np_total": {"value": 1.51, "err": [0.16, 0.23], "ref": "BMW 14, Borsanyi et al., Science 347 (2015) 1452, arXiv:1406.4088, Table 1",
                           "scheme": "Nf=1+1+1+1 QCD+QED", "scale": "M_Omega"},
    "I5_BMW14_np_QCD": {"value": 2.52, "err": [0.17, 0.24], "ref": "BMW 14, Table 1", "scheme": "QCD part", "scale": "M_Omega"},
    "I5_BMW14_np_QED": {"value": -1.00, "err": [0.07, 0.14], "ref": "BMW 14, Table 1", "scheme": "QED part", "scale": "M_Omega"},
    "I6_FLAG24_sigma_piN": {"value": 42.2, "err": [2.4], "ref": "FLAG 2024 eq. (445) (BMW 11A, BMW 15, chiQCD 15A, RQCD 22, Mainz 23)", "scheme": "Nf=2+1", "scale": "various"},
    "I6_FLAG24_sigma_s": {"value": 44.9, "err": [6.4], "ref": "FLAG 2024 eq. (447)", "scheme": "Nf=2+1", "scale": "various"},
    "I7_FLAG24_m_ud_2p1": {"value": 3.387, "err": [0.039], "ref": "FLAG 2024 Table 1", "scheme": "MSbar 2 GeV", "scale": "from measured M_pi (NOT BLIND)"},
    "I7_FLAG24_m_s_2p1": {"value": 92.4, "err": [1.0], "ref": "FLAG 2024 Table 1", "scheme": "MSbar 2 GeV", "scale": "from measured M_K (NOT BLIND)"},
    "I7_FLAG24_ms_over_mud_2p1p1": {"value": 27.227, "err": [0.081], "ref": "FLAG 2024 Table 1", "scheme": "ratio", "scale": "NOT BLIND"},
    "I7_FLAG24_mu_over_md_2p1p1": {"value": 0.465, "err": [0.024], "ref": "FLAG 2024 Table 1", "scheme": "ratio", "scale": "NOT BLIND"},
    "I7_FLAG24_m_u_2p1p1": {"value": 2.14, "err": [0.08], "ref": "FLAG 2024 Table 1", "scheme": "MSbar 2 GeV", "scale": "NOT BLIND"},
    "I7_FLAG24_m_d_2p1p1": {"value": 4.70, "err": [0.05], "ref": "FLAG 2024 Table 1", "scheme": "MSbar 2 GeV", "scale": "NOT BLIND"},
}


def rel(key: str) -> float:
    e = IMPORTS[key]
    return math.sqrt(sum(x * x for x in e["err"])) / abs(e["value"])


def ratio(num: str, den: str) -> dict:
    v = IMPORTS[num]["value"] / IMPORTS[den]["value"]
    r = math.sqrt(rel(num) ** 2 + rel(den) ** 2)
    return {"value": v, "err": v * r, "rel_err": r, "numerator": num, "denominator": den}


def main(lam_path: Path, out: Path) -> None:
    lam = json.loads(lam_path.read_text())
    L3 = lam["central"]["lambda3_gev"]
    L3_over_E = lam["lambda3_over_Estar"]
    E_STAR = lam["inputs"]["E_star_GeV"]
    L3_lo, L3_hi = lam["lambda3_threshold_corner_interval_GeV"]
    dlnL_db3 = lam["colour_slope_below_MU"]["dlnL3_db3_held"]

    # ---- C2: ratio sets ----
    sets = {
        "C-1 (primary): BMW 08 Xi set / ALPHA 17": ("I2_BMW08_mN_Xi", "I3_BMW08_mrho_Xi", "I1_ALPHA17_Lambda3"),
        "C-2: BMW 08 Omega set / ALPHA 17": ("I2_BMW08_mN_Omega", "I3_BMW08_mrho_Omega", "I1_ALPHA17_Lambda3"),
        "C-3: BMW 08 Xi set / FLAG 2024": ("I2_BMW08_mN_Xi", "I3_BMW08_mrho_Xi", "I1c_FLAG24_Lambda3"),
        "C-4: BMW 08 Xi set / ALPHA 22": ("I2_BMW08_mN_Xi", "I3_BMW08_mrho_Xi", "I1b_ALPHA22_Lambda3"),
    }
    ratio_rows = {}
    for name, (n, r_, l) in sets.items():
        cN, cR = ratio(n, l), ratio(r_, l)
        ratio_rows[name] = {
            "c_N": cN, "c_rho": cR,
            "m_N_over_Estar": cN["value"] * L3_over_E, "m_rho_over_Estar": cR["value"] * L3_over_E,
            "m_N_GeV": cN["value"] * L3, "m_N_err_import_GeV": cN["err"] * L3,
            "m_N_threshold_corner_range_GeV": [cN["value"] * L3_lo, cN["value"] * L3_hi],
            "m_rho_GeV": cR["value"] * L3, "m_rho_err_import_GeV": cR["err"] * L3,
            "m_rho_threshold_corner_range_GeV": [cR["value"] * L3_lo, cR["value"] * L3_hi],
        }
    ratio_rows["C-R: repository constant 2.775 (reference only)"] = {
        "c_N": {"value": 2.775, "err": 0.105}, "m_N_GeV": 2.775 * L3, "m_N_over_Estar": 2.775 * L3_over_E}

    prim = ratio_rows["C-1 (primary): BMW 08 Xi set / ALPHA 17"]
    cN, cR = prim["c_N"]["value"], prim["c_rho"]["value"]

    # ---- C2b: quark-mass dependence of m_N (Feynman-Hellmann, linear about the import's physical point) ----
    s_piN, s_s = IMPORTS["I6_FLAG24_sigma_piN"]["value"], IMPORTS["I6_FLAG24_sigma_s"]["value"]
    fh = {
        "formula": "m_N(m_ud, m_s) = m_N* + sigma_piN (m_ud/m_ud* - 1) + sigma_s (m_s/m_s* - 1)",
        "sigma_piN_MeV": s_piN, "sigma_s_MeV": s_s,
        "dm_N_per_10pct_in_both_MeV": 0.1 * (s_piN + s_s),
        "relative_dm_N_per_10pct": 0.1 * (s_piN + s_s) / IMPORTS["I2_BMW08_mN_Xi"]["value"],
        "chiral_limit_drop_linear_MeV": -(s_piN + s_s),
        "note": "linear in the quark masses; the m_pi^3 term and higher are dropped (ARGUED small for factors near 1)",
    }

    # ---- C3: GMOR ----
    B_over_L = ratio("I4_BMW13_B_2GeV", "I1_ALPHA17_Lambda3")
    f_over_L = ratio("I4b_BMW13_f", "I1_ALPHA17_Lambda3")
    L3nlo_over_L = ratio("I4b_BMW13_Lambda3_NLO", "I1_ALPHA17_Lambda3")
    B_D10 = B_over_L["value"] * L3  # GeV, MSbar 2 GeV, in the D10 unit
    gmor = {
        "B_over_Lambda3": B_over_L,
        "f_over_Lambda3": f_over_L,
        "Lambda3NLO_over_Lambda3": L3nlo_over_L,
        "B_in_D10_unit_GeV": B_D10,
        "B_over_Estar": B_over_L["value"] * L3_over_E,
        "pion_LO": "M_pi^2 = 2 B m_ud, B = (B/Lambda3) Lambda3",
        "pion_NLO": "M_pi^2 = chi [1 + chi/(16 pi^2 f^2) ln(chi/Lambda_3NLO^2)], chi = 2 B m_ud",
        "kaon_LO": "M_K^2 = B (m_s + m_ud); M_K0^2 - M_K+^2 = B (m_d - m_u) + EM",
        "ratio_LO": "M_K^2/M_pi^2 = (m_s/m_ud + 1)/2 (B and Lambda drop out)",
        "scale_note": "B, f, Lambda_3NLO are quoted by BMW 13 with the f_pi scale; dividing by the ALPHA 17 Lambda mixes two scale settings (ARGUED, inside the quoted errors only if both reproduce nature)",
        "pion_value": None, "kaon_value": None,
        "status": "OPEN: QM supplies no quark mass (reports/QM.md: x = 1/2 in every sector, Y_u proportional to Y_d proportional to the lepton circulant)",
    }

    def m_pi_LO(m_ud_GeV: float) -> float:
        return math.sqrt(2 * B_D10 * m_ud_GeV)

    # Dependence table: M_pi and M_K (LO, D10 unit) per MeV of quark mass, symbolic scaling
    gmor["pion_LO_GeV_for_m_ud_1MeV"] = m_pi_LO(1e-3)
    gmor["kaon_LO_GeV_for_ms_plus_mud_100MeV"] = math.sqrt(B_D10 * 0.1)

    # QM's furthest derivation in meson language (appendix E of CANDIDATES.md, registered before this run):
    # Y_d proportional to the lepton circulant: m_s/m_d = m_mu/m_e of the source circulant; Y_u = Y_d: m_u = m_d.
    qm_ratio_ms_md = None
    qm_path = HD.parent / "QM" / "values.json"
    if qm_path.exists():
        v = json.loads(qm_path.read_text())
        row = v.get("B1-S1_own_quantum", {})
        sp = row.get("spectra", {}).get("down|P1", {})
        if sp:
            qm_ratio_ms_md = sp["y2_over_y3"] / sp["y1_over_y3"]
    qm_meson = None
    if qm_ratio_ms_md:
        r = qm_ratio_ms_md  # m_s/m_d, and m_ud = m_d when m_u = m_d
        qm_meson = {"source_row": "QM B1-S1 (x = 1/2, Y_u = Y_d = lepton circulant), down sector P1",
                    "m_s_over_m_d": r, "m_u_over_m_d": 1.0, "m_s_over_m_ud": r,
                    "MK_over_Mpi_LO": math.sqrt((r + 1) / 2)}

    # ---- C4: nucleon isospin splitting (formula; value OPEN) ----
    split = {
        "formula": "m_n - m_p = Delta_QCD (m_d - m_u)/(m_d - m_u)_ref + Delta_QED alpha/alpha_ref",
        "Delta_QCD_MeV": IMPORTS["I5_BMW14_np_QCD"]["value"],
        "Delta_QED_MeV": IMPORTS["I5_BMW14_np_QED"]["value"],
        "m_d_minus_m_u_ref_MeV": IMPORTS["I7_FLAG24_m_d_2p1p1"]["value"] - IMPORTS["I7_FLAG24_m_u_2p1p1"]["value"],
        "slope_dDelta_d(md-mu)": IMPORTS["I5_BMW14_np_QCD"]["value"] / (IMPORTS["I7_FLAG24_m_d_2p1p1"]["value"] - IMPORTS["I7_FLAG24_m_u_2p1p1"]["value"]),
        "value": None,
        "status": "OPEN: m_d - m_u from QM (none); alpha from the P fixed point (CONDITIONAL)",
    }
    # E2 (appendix F): QM's furthest derivation m_u = m_d, alpha(0) from P_fwd through P = phi + sqrt(pi) alpha
    P_FWD = lam["inputs"]["P_fwd"]
    alpha0 = (P_FWD - (1 + math.sqrt(5)) / 2) / math.sqrt(math.pi)
    qed = IMPORTS["I5_BMW14_np_QED"]
    split["qm_furthest_mu_equals_md"] = {
        "alpha0_inverse_from_P_fwd": 1 / alpha0,
        "m_n_minus_m_p_MeV": qed["value"] * alpha0 * 137.035999177,
        "err_MeV": math.sqrt(sum(x * x for x in qed["err"])),
        "note": "Delta_QCD = 0 at m_u = m_d; the QED part alone remains (proton heavier than neutron)",
    }

    # ---- assembled rows ----
    def band(c: dict, kind: str) -> dict:
        return {"value_GeV": c["value"] * L3, "import_err_GeV": c["err"] * L3,
                "threshold_corner_range_GeV": [c["value"] * L3_lo, c["value"] * L3_hi],
                "over_Estar": c["value"] * L3_over_E,
                "relative_change_for_b3_minus_0.01_held (Delta_b3 = 3.99)": math.exp(-0.01 * dlnL_db3) - 1.0}

    status_common = ("CONDITIONAL x IMPORTED: Lambda^(3) from the D10 alpha_3 (declared slopes (33/5, 1, -3), unification at "
                     "M_U, pixel closure) with IMPORTED heavy thresholds; c_h IMPORTED from lattice QCD at the physical point "
                     "(quark masses tuned to measured M_pi, M_K; MeV unit from M_Xi or f_piK). Valid only if the derived gauge "
                     "sector is QCD; source prerequisites: SU(3) links (GL: M1 declared), one cone per species (T3 member B, "
                     "declared seam weight), weak coupling at the cell scale (open: the source's cut coupling fails, cut rows)")
    rows = [
        {"particle": "Lambda_MSbar^(3)", "value_GeV": L3, "over_Estar": L3_over_E,
         "threshold_corner_range_GeV": [L3_lo, L3_hi], "status": "CONDITIONAL (D10 alpha_3; thresholds IMPORTED)"},
        {"particle": "nucleon (isospin average)", "c": prim["c_N"], **band(prim["c_N"], "N"), "status": status_common},
        {"particle": "proton", "c": prim["c_N"], **band(prim["c_N"], "N"),
         "splitting": "m_p = m_N - Delta/2, Delta OPEN (QM); |Delta/2| of order 1e-3 m_N", "status": status_common},
        {"particle": "neutron", "c": prim["c_N"], **band(prim["c_N"], "N"),
         "splitting": "m_n = m_N + Delta/2, Delta OPEN (QM)", "status": status_common},
        {"particle": "n - p splitting", "value_GeV": None, "formula": split["formula"], "status": split["status"]},
        {"particle": "pion", "value_GeV": None, "formula": "M_pi = sqrt(2 B m_ud) [NLO: BMW 13 form], B = %.4f Lambda^(3) = %.4f GeV (D10 unit)" % (B_over_L["value"], B_D10),
         "status": "OPEN: m_ud from QM (none)"},
        {"particle": "kaon", "value_GeV": None, "formula": "M_K = sqrt(B (m_s + m_ud)) at LO", "status": "OPEN: m_s, m_ud from QM (none)"},
        {"particle": "rho(770)", "c": prim["c_rho"], **band(prim["c_rho"], "rho"), "status": status_common},
    ]

    # cut rows: colour scale and nucleon order of magnitude
    cut = []
    for r in lam["cut_rows"]["rows"]:
        scale = r.get("lambda3_GeV") or r.get("pole_scale_GeV")
        cut.append({"start": r["start"], "b3": r["b3"], "colour_scale_GeV": scale, "kind": r["colour_scale_kind"],
                    "m_N_order_GeV": cN * scale, "m_N_order_over_Estar": cN * scale / E_STAR,
                    "status": "EXCLUDED as a light-hadron sector (colour scale far above 1 GeV)"})

    out.write_text(json.dumps({
        "artifact": "HD_rows", "reads_measured_values": False,
        "imports": IMPORTS, "lambda3": {"GeV": L3, "over_Estar": L3_over_E, "corner_range_GeV": [L3_lo, L3_hi]},
        "ratio_rows": ratio_rows, "feynman_hellmann": fh, "gmor": gmor, "qm_furthest_in_meson_language": qm_meson,
        "np_splitting": split, "rows": rows, "cut_rows": cut,
    }, indent=1) + "\n")

    print("Lambda3 = %.5f GeV, Lambda3/E* = %.4e, corners %s" % (L3, L3_over_E, [round(x, 5) for x in (L3_lo, L3_hi)]))
    for k, v in ratio_rows.items():
        if "c_rho" in v:
            print("%-45s c_N = %.4f +- %.4f  m_N = %.4f +- %.4f GeV | c_rho = %.4f +- %.4f  m_rho = %.4f +- %.4f GeV" % (
                k, v["c_N"]["value"], v["c_N"]["err"], v["m_N_GeV"], v["m_N_err_import_GeV"],
                v["c_rho"]["value"], v["c_rho"]["err"], v["m_rho_GeV"], v["m_rho_err_import_GeV"]))
        else:
            print("%-45s c_N = %.4f  m_N = %.5f GeV" % (k, v["c_N"]["value"], v["m_N_GeV"]))
    print("B/Lambda3 = %.4f +- %.4f; B(D10 unit) = %.4f GeV; f/Lambda3 = %.4f; Lambda3NLO/Lambda3 = %.3f" % (
        B_over_L["value"], B_over_L["err"], B_D10, f_over_L["value"], L3nlo_over_L["value"]))
    print("Feynman-Hellmann: dm_N per 10%% in m_ud and m_s = %.2f MeV (%.2f%%)" % (fh["dm_N_per_10pct_in_both_MeV"], 100 * fh["relative_dm_N_per_10pct"]))
    print("QM furthest in meson language:", qm_meson)
    print("Lambda change for b3 = -3.01 (Delta b3 = 3.99), held:", rows[1]["relative_change_for_b3_minus_0.01_held (Delta_b3 = 3.99)"])
    for c in cut:
        print("cut %-18s b3=%5.1f colour scale %.3e GeV  m_N ~ %.2e GeV" % (c["start"], c["b3"], c["colour_scale_GeV"], c["m_N_order_GeV"]))


if __name__ == "__main__":
    main(Path(sys.argv[1]), Path(sys.argv[2]))
