    'declared': [], 'verdict': 'two codes with separate gauge fields: a mirror sector, not a generation.'})

for c in cands:
    c['score'] = sum(PTS[c['tests'][r]['verdict']] for r in REQ)
    c['verdicts'] = [c['tests'][r]['verdict'] for r in REQ]
ranking = sorted(cands, key=lambda c: -c['score'])
assert ranking[0]['id'] == 'f' and ranking[1]['id'] == 'ab'

# loadable data for the simulation session -------------------------------------------------------------------
geo = geometry()
V = geo['V']
fr0 = geo['frames'][0]
port = geo['port_axes'][0][0]
def u0(conj):
    tr = gal_vec if conj else (lambda v: v)
    nvec = np.array([fl(x) for x in tr(V[port])]); nvec /= np.linalg.norm(nvec)
    E = np.array([[fl(x) for x in tr(e)] for e in fr0['axes']])
    a1 = np.cross(nvec, E[0] if abs(nvec @ E[0]) < 0.9 else E[1]); a1 /= np.linalg.norm(a1); b1 = np.cross(nvec, a1)
    ep = (a1 + 1j * b1) / math.sqrt(2)
    U = np.array([[nvec @ e for e in E], [np.vdot(ep, e) for e in E], [np.vdot(ep.conj(), e) for e in E]])
    assert np.allclose(U @ U.conj().T, np.eye(3))
    return {'rows': ['state along the port axis', 'circular state +', 'circular state -'], 'columns': ['frame axis 1', 'frame axis 2', 'frame axis 3'],
            'real': [[round(float(x.real), 9) for x in r] for r in U], 'imag': [[round(float(x.imag), 9) for x in r] for r in U],
            'squared': [[round(float(abs(x) ** 2), 9) for x in r] for r in U]}
names = {(0, 0): 'antineutrino singlet', (1, 0): 'down quark, right-handed', (2, 0): 'up antiquark', (3, 0): 'electron, right-handed',
         (0, 1): 'antilepton doublet', (1, 1): 'quark doublet', (2, 1): 'antiquark doublet', (3, 1): 'lepton doublet',
         (0, 2): 'positron', (1, 2): 'up quark, right-handed', (2, 2): 'down antiquark', (3, 2): 'neutrino, right-handed'}
copy_name = {'slow triplet 3': 'copy 1', 'quintet 5': 'copy 2', 'fast triplet 3prime': 'copy 3'}
grid = []
for ch in walk['three_copies_in_one_klein_character']['characters']:
    for e in ch['eigenvectors']:
        a = e['mass_angle_per_tick_blank_record']
        grid.append({'first_index_klein_character': ch['klein_character'], 'copy': copy_name[e['sector']], 'carrier_multiplet': e['sector'], 'kernel_eigenvalue': e['kernel_eigenvalue'],
                     'rest_angle_per_tick_blank_record': a, 'correction_probability_at_rest': 1 - math.cos(a), 'port_amplitudes': e['port_amplitudes'],
                     'squared_overlaps_with_the_three_rectangles': e['floats']})
loadable = {
    'second_index': {
        'frame': {'matching': [list(e) for e in fr0['matching']], 'axes': [[fl(x) for x in e] for e in fr0['axes']],
                  'half_turns_as_port_permutations': [list(h['perm']) for h in fr0['half_turns']],
                  'note': 'the raw-chart frame of the public carrier; the four others are rotated copies'},
        'axes_of_the_second_index': {'rectangles_of_ports': walk['three_copies_in_one_klein_character']['rectangles'],
                                     'note': 'the three orbits of the Klein group on the ports: each holds the two frame seams shared with the two neighbours along one lattice axis. '
                                             'For a fixed first index the three axes are the three rectangles, in an order that shifts cyclically with the first index'},
        'copies': [{'id': 'copy 1', 'kernel_level': si['kernel_levels_of_the_three_copies_blank_record'][0], 'rest_angle_per_tick_blank_record': a_slow, 'correction_probability_at_rest': p_corr[0]},
                   {'id': 'copy 2', 'kernel_level': si['kernel_levels_of_the_three_copies_blank_record'][1], 'rest_angle_per_tick_blank_record': a_quint, 'correction_probability_at_rest': p_corr[1]},
                   {'id': 'copy 3', 'kernel_level': si['kernel_levels_of_the_three_copies_blank_record'][2], 'rest_angle_per_tick_blank_record': a_fast, 'correction_probability_at_rest': p_corr[2]}],
        'adjacency_on_the_index_raw_frame': si['M3_in_the_raw_frame'],
        'nine_states': grid,
        'one_dimensional_types': 'uniform (kernel 1, rest angle 0, one copy) and the two complex characters of the third of a turn inside the quintet (kernel 9/10, rest angle %s)' % f6(a_quint)},
    'copies_of_the_chart': [{'pattern': list(k), 'name': v, 'Q6': 3 * k[1] - 2 * k[0], 'copies': ['copy 1', 'copy 2', 'copy 3'], 'charges_of_the_copies': 'identical'} for k, v in names.items()],
    'first_index_alternative': {
        'labels': [{'id': f'g{j + 1}', 'frame_axis': [fl(x) for x in fr0['axes'][j]], 'klein_character_on_the_three_half_turns': [1 if i == j else -1 for i in range(3)]} for j in range(3)],
        'mixing_port_against_frame': {'reference_port': port, 'on_the_conjugate_triplet': u0(True), 'on_the_triplet_3': u0(False),
                                      'exact_squares': {'state along the port axis': gold['axial_state'], 'each circular state': gold['circular_states']}}}}

best = {
    'id': 'f',
    'statement': 'A generation is a value of the second index of the port space of a carrier in the cubic frame: the frame group makes the twelve ports its own elements, the port space then holds the triplet three times, and the seams act on the copy index only.',
    'predicts': [
        {'item': 'exactly three copies of every load state of the triplet type, no fourth; one copy of each one-dimensional type, among them the uniform state', 'tag': 'EXACT'},
        {'item': f"three levels with no parameter: kernel {LEVELS}; correction probabilities at rest (one minus the level, lead L30) {p_corr[0]:.6f}, {p_corr[1]:.6f}, {p_corr[2]:.6f}; rest angles {f6(a_slow)}, {f6(a_quint)}, {f6(a_fast)} per tick under option M3, inverted order with the record set", 'tag': 'EXACT eigenvalues'},
        {'item': f"one axis of the index is a level; the two others mix by the angle with tangent 1/phi, {golden_angle:.3f} degrees (squared components {si['squared_components_of_the_sqrt5_eigenvector'][1]} and {si['squared_components_of_the_sqrt5_eigenvector'][2]}); one sign of the second action stays exact, the antipodal map of the carrier", 'tag': 'EXACT'},
        {'item': 'the first index (frame axes) is untouched by the kernel: every copy is three exactly degenerate states', 'tag': 'EXACT'}],
    'refuted_by': [
        {'item': 'a law whose symmetry on the load register stays the full carrier group: the copies are then the inequivalent multiplets 3, 5, 3prime, the middle copy is three fifths of a quintet, and nothing repeats (candidate d). The carrier walk of CF-1 has that symmetry; the frame enters through the routing only', 'where': 'program'},
        {'item': 'no state with rest angle zero in a triplet: the massless type has one copy, so the three copies stay at the scale of the lattice', 'where': 'program'},
        {'item': f"NOT BLIND. Read as masses the levels have the fixed ratios {sec['blank_ratios'][1]} and {sec['blank_ratios'][2]} against {lep['muon_electron_CODATA2022']:.2f} and {lep['tau_electron_CODATA2022']:.2f} for the charged leptons: the levels are not the masses of the generations", 'where': 'measurement'},
        {'item': f"NOT BLIND. As a lepton mixing matrix: one angle {golden_angle:.3f} degrees and two zeros against theta12 = {meas['theta12'][0]}, theta23 = {meas['theta23'][0]}, theta13 = {meas['theta13'][0]} degrees. Read as theta12 the pulls are {f_cmp['read_as_theta12_pulls'][0]}, {f_cmp['read_as_theta12_pulls'][1]}, {f_cmp['read_as_theta12_pulls'][2]}; "
                 f"distance of squared moduli {f_cmp['distance_to_measured_squared_moduli_best_of_36_relabellings']} against {golden_cmp['distance_to_measured_squared_moduli']} for the pattern of candidate ab", 'where': 'measurement'}],
    'resembles_NOT_BLIND': f"three copies of which one does not mix and two mix by one large angle; the angle {golden_angle:.3f} degrees is the golden-ratio value of the solar angle (name imported)",
    'differs_NOT_BLIND': 'no hierarchy and no light copy; the two other mixing angles vanish',
    'second_candidate': {
        'id': 'ab', 'statement': 'the first index: the three frame axes on a triplet register',
        'predicts': [
            f"three exactly degenerate copies; three independent masses are allowed by the Klein group, which is the rotation symmetry of the CF-1 tick, and none is supplied",
            f"with one mass operator invariant under a port's fifth-turn and another under the frame's Klein group: squared moduli {', '.join(gold['axial_state'])} / {', '.join(gold['circular_states'])}: theta12 = {golden_cmp['theta12_deg']}, theta23 = {golden_cmp['theta23_deg']}, theta13 = {golden_cmp['theta13_deg']} degrees",
            f"NOT BLIND (theta13 as input): Klein group reduced to the half-turn that keeps the column {soft_ok['fixed_column_squared'][0]}, {soft_ok['fixed_column_squared'][1]}, {soft_ok['fixed_column_squared'][2]}, real operator: theta12 = {soft_ok['theta12_deg']} degrees, theta23 = {soft_ok['theta23_deg']} degrees, |sin delta| = {soft_ok['abs_sin_delta']}"],
        'refuted_by': [
            f"a law in which the port load acts on the copies: response algebra {pl['responses_on_the_code_alone']['closure']} -> {pl['responses_plus_load_on_the_conjugate_triplet']['closure']} dimensions, cubic sum {code['gauged_conjugate_triplet']['cubic_sum_if_the_copies_were_a_gauged_SU3_triplet']}",
            f"a chart transport with the holonomy of rule S: the third of a turn about a face permutes the three axes of each of the {tt['frames_fixed_by_each_third_turn']} frames it stabilizes ({tt['pairs_checked']} cases)",
            f"NOT BLIND: theta13 = 0 against {meas['theta13'][0]} +- {meas['theta13'][1]} degrees ({golden_cmp['pulls'][2]} uncertainties); theta12 {golden_cmp['pulls'][0]}, theta23 +{golden_cmp['pulls'][1]}; after the repair theta12 {soft_ok['pull_theta12']}, theta23 +{soft_ok['pull_theta23']}, delta = 270 degrees +{soft_ok['pull_delta_270']} (90 degrees {soft_ok['pull_delta_90']}); the other column gives theta12 = {soft_bad['theta12_deg']} degrees ({soft_bad['pull_theta12']})"]}}

out = {
    'schema': 'oph.repair_law.x4.generations.v1', 'date': '2026-11-10',
    'status': 'best guess for issue 6 of RL/MAP.md. Representation level. No law supplies a generation; no mass and no mixing angle of nature is derived.',
    'requirements': {'exactly_three': 'exactly three copies', 'identical_gauge_charges': 'identical gauge charges for the three',
