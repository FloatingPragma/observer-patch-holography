        'identical_gauge_charges': T('FAIL', f"with the responses of both codes locked port by port the algebra has {gc['code_and_conjugate_code_locked_port_by_port']['closure']} dimensions, not {pr['triplet 3 with doublet 2prime (the code)'][1]}: the second code has gauge fields of its own", 'MEASURED (float64 rank)', 'triplet.json: galois_conjugate_code'),
