        '(angle %s) belongs to the conjugate triplet and 11/12 - sqrt5/60 (angle %s) to the triplet 3: the set-record block is 11/12 - A/60, checked entry by entry on the executable.' % (f6(a_slow), f6(a_fast)),
        'work/DESIGN/DESIGN.md entry A, refinement: of the twelve translations of the second action %d commute with the adjacency, the identity and the half-turn whose translation is the antipodal map; the other ten do not.' % si['second_translations_commuting_with_the_adjacency']],
    'evidence_files': ['code.json', 'triplet.json', 'walk.json', 'z3.json', 'flux.json', 'routing.json']}
path = sys.argv[1] if len(sys.argv) > 1 else os.path.join(HERE, 'generations.json')
json.dump(out, open(path, 'w'), indent=1)

short = {'PASS': 'pass', 'DECLARED': 'declared', 'FAIL': 'fail', 'NONE': 'none'}
print('| Id | Candidate | Copies | Three | Charges | Label | Masses | Mixing | Anomalies | Score |')
print('| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |')
for c in ranking:
    print(f"| {c['id']} | {c['name']} | {c['copies']} | " + ' | '.join(short[v] for v in c['verdicts']) + f" | {c['score']:.1f} |")
print('second index against the frozen lepton angles (NOT BLIND):', f_cmp)
print('correction probabilities of the three copies:', [round(p, 6) for p in p_corr], '; golden angle', round(golden_angle, 3))
