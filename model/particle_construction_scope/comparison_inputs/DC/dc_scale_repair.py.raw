#!/usr/bin/env python3
"""Worker DC, round 2, rows Q1 (source only) and Q2 (FIT). Writes dc_scale_repair.json."""
import json
from pathlib import Path

import mpmath as mp

HERE = Path(__file__).resolve().parent
RER = next((p for p in (Path("WORKSPACE/repair-law/reverse-engineering-reality"),
                        Path("WORKSPACE/reverse-engineering-reality")) if p.is_dir()))
mp.mp.dps = 30
rep = json.loads((RER / "code/P_derivation/runtime/full_p_alpha_report_current.json").read_text())
P = mp.mpf(rep["p"])
aU = mp.mpf(rep["d10"]["alpha_u"])
a_cut = mp.mpf(json.loads((HERE / "dc_numeric.json").read_text())["cut_scale_closure"]["S2_dR_logd@P_fwd"]["alpha_cut"])
lnEM = 2 * mp.pi - mp.mpf(2) / 3 * mp.log(P)  # ln(E_cell/M_U) of the declared form
b_above = 2 * mp.pi * (1 / aU - 1 / a_cut) / lnEM
v_meas = (mp.sqrt(2) * mp.mpf("1.1663788e-5")) ** mp.mpf(-0.5) / mp.mpf("1.220890e19")  # FIT input, Q2 only
beta_fit = 2 * mp.pi / (a_cut * mp.log(P ** mp.mpf(-0.5) / v_meas))
out = {"Q1_source_only": {"alpha_cut_inv": mp.nstr(1 / a_cut, 12), "alpha_U_inv_producer": mp.nstr(1 / aU, 12),
                          "ln_Ecell_over_MU": mp.nstr(lnEM, 12), "b_above": mp.nstr(b_above, 8),
                          "sign": "positive: the unified coupling weakens from E_cell down to M_U (infrared-free running)"},
       "Q2_FIT_beta_for_R0_hierarchy": {"beta": mp.nstr(beta_fit, 8), "label": "FIT, uses the measured v"}}
(HERE / "dc_scale_repair.json").write_text(json.dumps(out, indent=1) + "\n")
print(json.dumps(out, indent=1))
