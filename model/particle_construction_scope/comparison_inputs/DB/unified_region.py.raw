"""Unified region between E_cell and M_U: one-loop slopes of the candidates UR1 to UR9 (CANDIDATES.md, round 2).

Run:
    PYTHONDONTWRITEBYTECODE=1 /tmp/oph-completion-venv/bin/python unified_region.py [out.json]

Convention of paper_math: 1/alpha(mu) = 1/alpha(mu0) + (b/(2 pi)) ln(mu0/mu); b > 0 weakens the coupling toward lower
mu. Requirement (DC2, conditional on the cut closure and the declared chain at P_fwd): one coefficient
b_above = +8.5131 for the unified coupling, i.e. b1 = b2 = b3 = 8.5131 between E_cell and M_U.

Gauge parts: 12 native currents give (0, -22/3, -11); 24 currents (su(5)) give -55/3 on each factor.
Matter: b += (2/3) sum_Weyl T + (1/3) sum_complex_scalar T + (1/6) sum_real_scalar T (IMPORTED functional), with
SU(5) indices T(5) = 1/2, T(10) = 3/2, T(24) = 5, T(75) = 25 and Standard Model indices for the 12-current rows.
UR9 evaluates the supplement's edge-sector formula Delta b_a = sum_R p_R d_R T_a(R), p_R ~ d_R exp(-t C2(R)),
at t = 4 pi^2 / 16.2453 for SU(2) and SU(3) (the formula gives no U(1) value).
"""
import json
import math
import sys
from fractions import Fraction as F
from pathlib import Path

HERE = Path(__file__).parent
OUT = Path(sys.argv[1]) if len(sys.argv) > 1 else HERE / 'unified_region.json'
B_ABOVE = 8.5131
T5, T10, T24, T75 = F(1, 2), F(3, 2), F(5), F(25)
WEYL, CS, RS = F(2, 3), F(1, 3), F(1, 6)

G24 = -F(55, 3)
copy_F = WEYL * (T10 + T5)          # fermion half of one copy (10 + 5bar)
copy_S = CS * (T10 + T5)            # boson half of one copy
H5 = CS * T5                        # complex 5_H
pair_5 = WEYL * T24                 # Weyl 1 + 24 from 5 x 5bar
pair_10 = WEYL * (T24 + T75)        # Weyl 1 + 24 + 75 from 10bar x 10

unified = {
    'UR3': G24 + 3 * copy_F + H5,
    'UR4': G24 + 3 * (copy_F + copy_S) + H5,
    'UR5': G24 + 3 * (copy_F + copy_S) + H5 + WEYL * T24,
    'UR6': G24 + 3 * (copy_F + copy_S) + H5 + 3 * (pair_5 + pair_10),
    'UR7': G24 + 3 * 4 * copy_F + H5,
}
assert unified['UR3'] == F(-85, 6) and unified['UR4'] == F(-73, 6) and unified['UR5'] == F(-53, 6)
assert unified['UR6'] == F(347, 6) and unified['UR7'] == F(-13, 6)

# Standard Model rows (b1, b2, b3), GUT-normalized b1
A = (F(41, 10), F(-19, 6), F(-7))
B = (F(61, 10), F(-7, 6), F(-5))
# link register of the chiral source: blocks V_r* x V_r of U, D (3b,1), Q (3,2), E (1,1), L (1,2), real scalars:
# U, D: (1,1) + (8,1); Q: (1,1) + (8,1) + (1,3) + (8,3); E: (1,1); L: (1,1) + (1,3); all Y = 0
link_b3 = RS * (3 * 3 + 3 * 3)       # three (8,1) with T = 3, one (8,3) with T3 * dim2 = 9
link_b2 = RS * (2 * 2 + 2 * 8)       # two (1,3) with T = 2, one (8,3) with T2 * dim3 = 16
UR8 = (B[0], B[1] + link_b2, B[2] + link_b3)
assert UR8 == (F(61, 10), F(13, 6), F(-2))


def edge(t, group, normalized):
    num = z = 0.0
    if group == 'SU2':
        for n in range(400):
            j = n / 2
            d, c2, T = n + 1, j * (j + 1), j * (j + 1) * (2 * j + 1) / 3
            w = d * math.exp(-t * c2)
            z += w
            num += w * d * T
    else:
        for p in range(80):
            for q in range(80):
                d = (p + 1) * (q + 1) * (p + q + 2) // 2
                c2 = (p * p + q * q + p * q + 3 * p + 3 * q) / 3
                T = d * c2 / 8
                w = d * math.exp(-t * c2)
                z += w
                num += w * d * T
    return num / z if normalized else num


t_cut = 4 * math.pi ** 2 / 16.2453
ur9 = {}
for norm in (True, False):
    d2, d3 = edge(t_cut, 'SU2', norm), edge(t_cut, 'SU3', norm)
    ur9['normalized' if norm else 'unnormalized'] = dict(
        delta_b2=d2, delta_b3=d3, b2=float(B[1]) + d2, b3=float(B[2]) + d3, b1='no value from the stated formula')

rows = {
    'UR1': dict(gauge='12', b=[str(x) for x in A], equal=False),
    'UR2': dict(gauge='12', b=[str(x) for x in B], equal=False),
    'UR8': dict(gauge='12', b=[str(x) for x in UR8], equal=False),
    'UR9': dict(gauge='12', t_cut=t_cut, **ur9),
}
for k, v in unified.items():
    rows[k] = dict(gauge='24', b_unified=str(v), b_float=float(v), minus_required=float(v) - B_ABOVE)
# requirement in matter units for 24 currents and for 12 currents with equal slopes
need24 = B_ABOVE - float(G24)
rows['requirement'] = dict(
    b_above=B_ABOVE, with_24_currents_matter_sum_needed=need24,
    with_12_currents='equal slopes need matter shifts m3 - m2 = 11/3 and m2 - m1 = 22/3 (gauge part (0, -22/3, -11)); '
                     'complete multiplets shift all three equally, so no universal content keeps the couplings unified')
OUT.write_text(json.dumps(rows, indent=1, default=str) + '\n')
print(json.dumps(rows, indent=1, default=str))
