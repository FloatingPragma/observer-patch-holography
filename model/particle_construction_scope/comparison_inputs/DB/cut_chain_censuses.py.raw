"""Every census of rounds 1 and 2 in the cut-scale chain of DC2 at P_fwd (CANDIDATES.md, last addendum).

Run:
    PYTHONDONTWRITEBYTECODE=1 /tmp/oph-completion-venv/bin/python cut_chain_censuses.py [out.json]

Chain (energy unit E* = 1, P = P_fwd fixed, no outer closure):
  cut closure      ellbar_SU2(4 pi^2 a) + ellbar_SU3(4 pi^2 a) = P/4  ->  a_cut = alpha(E_cell)
  unified region   1/alpha_U = 1/a_cut + (b_above/(2 pi)) R(P),  R(P) = ln(E_cell/M_U) = 2 pi - (2/3) ln P,
                   b_above = +8.5131 (DC2)
  transmutation    v = E_cell exp(-2 pi/(4 alpha_U))
  below M_U        the census slopes, m_Z fixed point, couplings at m_Z, Thomson readout of alpha(0) (d10_float.py)
The hierarchy is then fixed above M_U; a census below M_U sets only the m_Z couplings and alpha(0).
Outputs need all three couplings positive at m_Z.
"""
import json
import math
import sys
from fractions import Fraction as F
from pathlib import Path

from scipy.optimize import brentq

from d10_float import Chain, ellbar_su2, ellbar_su3, E_STAR_GEV, PI

HERE = Path(__file__).parent
OUT = Path(sys.argv[1]) if len(sys.argv) > 1 else HERE / 'cut_chain_censuses.json'
P = 1.6309720958588974
B_ABOVE = 8.5131

a_cut = brentq(lambda a: ellbar_su2(4 * PI * PI * a) + ellbar_su3(4 * PI * PI * a) - P / 4, 0.02, 0.2,
               xtol=1e-300, rtol=1e-15)
R = 2 * PI - (2 / 3) * math.log(P)
inv_aU = 1 / a_cut + B_ABOVE / (2 * PI) * R
alpha_U = 1 / inv_aU
mu_u = math.exp(-2 * PI) * P ** (1 / 6)
assert abs(math.log(P ** -0.5 / mu_u) - R) < 1e-12

sets = json.loads((HERE / 'b_coefficients.json').read_text())['sets']
extra = {'A3H': ('43/10', '-17/6', '-7'), 'B2H': ('31/5', '-1', '-5'), 'BHH': ('33/5', '-1/3', '-5')}
rows = {}
for key, b in [(k, (v['b1'], v['b2'], v['b3'])) for k, v in sets.items()] + list(extra.items()):
    ch = Chain(tuple(float(F(x)) for x in b))
    d = ch.d10_at(alpha_U, P)
    entry = dict(b=list(b))
    if 'mz' not in d:
        entry['status'] = 'no m_Z root'
    elif not d['positive']:
        entry['status'] = 'Landau pole above m_Z'
        entry['inv_alpha_123_at_mZ'] = [d['inv1'], d['inv2'], d['inv3']]
    else:
        a0inv, anchor = ch.alpha0_inv(d)
        a1, a2, a3 = 1 / d['inv1'], 1 / d['inv2'], 1 / d['inv3']
        aem = 1 / (d['inv2'] + 5 * d['inv1'] / 3)
        entry.update(status='outputs', v_GeV=d['v'] * E_STAR_GEV, m_Z_GeV=d['mz'] * E_STAR_GEV,
                     m_W_GeV=0.5 * d['v'] * math.sqrt(4 * PI * a2) * E_STAR_GEV, sin2_theta_W_mZ=aem / a2,
                     alpha_s_mZ=a3, alpha_em_inv_mZ=anchor, alpha0_inv=a0inv)
    rows[key] = entry

out = dict(P=P, inv_alpha_cut=1 / a_cut, R=R, b_above=B_ABOVE, alpha_U=alpha_U, M_U_GeV=mu_u * E_STAR_GEV,
           v_GeV=P ** -0.5 * math.exp(-2 * PI / (4 * alpha_U)) * E_STAR_GEV, censuses=rows)
OUT.write_text(json.dumps(out, indent=1) + '\n')
print(f"1/alpha_cut = {1 / a_cut:.6f}  R = {R:.6f}  alpha_U = {alpha_U:.10f}  M_U = {mu_u * E_STAR_GEV:.5e} GeV  "
      f"v = {out['v_GeV']:.4f} GeV")
for k, r in rows.items():
    if r['status'] == 'outputs':
        print(f"{k:5s} {r['b']}: mZ={r['m_Z_GeV']:.4f} mW={r['m_W_GeV']:.4f} s2w={r['sin2_theta_W_mZ']:.5f} "
              f"as={r['alpha_s_mZ']:.5f} 1/aem(mZ)={r['alpha_em_inv_mZ']:.3f} 1/a(0)={r['alpha0_inv']:.3f}")
    else:
        print(f"{k:5s} {r['b']}: {r['status']}")
