"""Structural checks behind the DF statements (no measured value is read).

1. The native C seam (2,3) and E seam (2,10) border the faces {2,3,4}, {2,3,6}, {2,6,10}, {2,10,11}; the axis faces of
   gE gC are {4,5,11} and {6,7,8}. A register change fed by a C or E current never changes the flux of an axis face.
2. Vertex lemma: for Y = D K with D diagonal (the Higgs on the right-quark face), Y^dag Y = K^dag |D|^2 K. Singular
   values and left frames depend on D only through |D|. Every twisted face character has modulus 1/sqrt3 on each port,
   and conjugate sectors k, -k have equal moduli.
3. Odd and even area-record sectors restricted to the frame group: dimension of the multiplicity space of each
   irreducible block (the twisted analogue of the second index of X4).
Run: cd RL/work/DF && PYTHONDONTWRITEBYTECODE=1 /tmp/oph-completion-venv/bin/python -B checks.py
"""
import json
import math
import os

import numpy as np

import dflib as L

HERE = os.path.dirname(os.path.abspath(__file__))
C = L.carrier()
out = {}

# 1 ----------------------------------------------------------------------------------------
def faces_of_seam(e):
    return sorted(tuple(sorted(f)) for f in C['faces'] if e[0] in f and e[1] in f)


inst = {'C': (2, 3), 'E': (2, 10)}
touched = sorted({f for e in inst.values() for f in faces_of_seam(e)})
axis = [tuple(sorted(L.face_of((4, 5, 11)))), tuple(sorted(L.face_of((6, 7, 8))))]
out['instrument_faces'] = touched
out['axis_faces'] = axis
out['instrument_register_touches_axis_face'] = bool(set(touched) & set(axis))
assert not out['instrument_register_touches_axis_face']
gC = next(g for g in C['rots'] if g[2] == 3 and g[3] == 2 and L.order(g) == 2)
gE = next(g for g in C['rots'] if g[2] == 10 and g[10] == 2 and L.order(g) == 2)
gR = L.compose(gE, gC)
out['R_images_of_instrument_seams'] = {k: tuple(sorted((gR[e[0]], gR[e[1]]))) for k, e in inst.items()}

# 2 ----------------------------------------------------------------------------------------
rng = np.random.default_rng(7)
K = rng.normal(size=(3, 3)) + 1j * rng.normal(size=(3, 3))
mod = np.abs(rng.normal(size=3)) + 0.1
dev = 0.0
for _ in range(200):
    D1 = np.diag(mod * np.exp(1j * rng.uniform(0, 2 * np.pi, 3)))
    D2 = np.diag(mod * np.exp(1j * rng.uniform(0, 2 * np.pi, 3)))
    A1, A2 = (D1 @ K).conj().T @ (D1 @ K), (D2 @ K).conj().T @ (D2 @ K)
    dev = max(dev, float(np.max(np.abs(A1 - A2))))
out['vertex_lemma_max_deviation_random'] = dev
assert dev < 1e-12
mods = {}
for k in range(1, 20):
    if k == 10:
        continue
    A = L.twisted_adjacency(k)
    for f in C['faces'][:5]:
        ev, V = np.linalg.eigh(A[np.ix_(f, f)])
        mods[(k, f)] = np.abs(V)
assert all(np.allclose(m, 1 / math.sqrt(3)) for m in mods.values())
out['twisted_face_characters_uniform_modulus'] = True

# 3 ----------------------------------------------------------------------------------------
# frame stabilizer: the rotations that preserve the matching (perfect matching with stabilizer of order 12)
seams = C['seams']


def stab(matching):
    ms = {tuple(sorted(e)) for e in matching}
    return [g for g in C['rots'] if {tuple(sorted((g[u], g[v]))) for u, v in ms} == ms]


# the five frames are the perfect matchings with stabilizer of order 12 (lead L28); find one
frame = None
from itertools import combinations
adj = C['adj']
for e0 in seams:
    # a frame seam's partners: seams related by the Klein group of its frame; search by stabilizer of the seam pair set
    pass
# direct search: matchings invariant under a subgroup of order 12 (A4): take the A4 subgroups generated by a
# half-turn and a third-turn whose product has order 3 or 2
rots = C['rots']
half = [g for g in rots if L.order(g) == 2]
third = [g for g in rots if L.order(g) == 3]


def closure(gens):
    G = {tuple(range(12))}
    frontier = list(G)
    while frontier:
        new = []
        for x in frontier:
            for h in gens:
                y = L.compose(h, x)
                if y not in G:
                    G.add(y)
                    new.append(y)
        frontier = new
    return G


A4s = set()
for h in half:
    for t in third:
        G = closure([h, t])
        if len(G) == 12:
            A4s.add(frozenset(G))
A4s = [sorted(G) for G in A4s]
out['frame_groups_found'] = len(A4s)
assert len(A4s) == 5
G = A4s[0]


def implementer(Ak, g):
    """Diagonal unitary D with D P_g A P_g^dag D^dag = A (gauge-covariant lift); returns D P_g."""
    P = L.perm_matrix(g)
    B = P @ Ak @ P.T
    # solve A[u, v] = d_u B[u, v] conj(d_v) on a spanning tree from port 0
    d = np.zeros(12, complex)
    d[0] = 1.0
    seen, queue = {0}, [0]
    while queue:
        u = queue.pop()
        for v in C['adj'][u]:
            if v not in seen:
                # A[v, u] = d_v B[v, u] conj(d_u)  ->  d_v = A[v, u] d_u / B[v, u]
                d[v] = Ak[v, u] * d[u] / B[v, u]
                seen.add(v)
                queue.append(v)
    M = np.diag(d) @ P
    assert np.allclose(M @ Ak @ M.conj().T, Ak, atol=1e-10)
    return M


mult = {}
for k in (0, 2, 9, 16, 7, 13):
    Ak = L.twisted_adjacency(k)
    Ms = [implementer(Ak, g) for g in G]
    # commutant dimension of the algebra generated by the implementers (projective rep of the frame group)
    # = sum over irreducible blocks of (multiplicity)^2; computed as dim of {X : X M = M X for all M}
    n = 12
    rows = []
    for M in Ms:
        rows.append(np.kron(np.eye(n), M) - np.kron(M.T, np.eye(n)))
    S = np.vstack(rows)
    sv = np.linalg.svd(S, compute_uv=False)
    commutant = int(np.sum(sv < 1e-9))
    _, _, Vh = np.linalg.svd(S)
    basis = [Vh[-i - 1].conj().reshape(n, n, order='F') for i in range(commutant)]
    for X in basis:
        assert all(np.allclose(X @ M, M @ X, atol=1e-8) for M in Ms)
    # centre of the commutant = number of irreducible blocks
    rows2 = []
    for Y in basis:
        rows2.append(np.kron(np.eye(n), Y) - np.kron(Y.T, np.eye(n)))
    S2 = np.vstack(rows + rows2)
    sv2 = np.linalg.svd(S2, compute_uv=False)
    centre = int(np.sum(sv2 < 1e-8))
    # block structure from a generic element of the centre: eigenvalue multiplicities = d_rho * m_rho
    _, _, Vh2 = np.linalg.svd(S2)
    Z = sum(rng.normal() * Vh2[-i - 1].conj().reshape(n, n, order='F') for i in range(centre))
    Z = (Z + Z.conj().T) / 2
    ev = np.round(np.linalg.eigvalsh(Z), 6)
    sizes = sorted(np.unique(ev, return_counts=True)[1].tolist())
    # A_k commutes with every implementer: it lies in the commutant; its spectrum on each block gives the levels
    mult[k] = {'commutant_dimension': commutant, 'irreducible_blocks': centre, 'block_sizes_d_times_m': sizes}
out['frame_group_commutant_dimension_by_sector'] = mult
# even k: regular representation of A4 gives 1+1+1+9 = 12; odd k: spinor regular representation of 2T gives 4+4+4 = 12

with open(os.path.join(HERE, 'checks.json'), 'w') as fh:
    json.dump(out, fh, indent=1, sort_keys=True, default=str)
print(json.dumps(out, indent=1, default=str))
