"""Items 1 and 2 of TASK_R6: three complete instruments on the free tick, records sampled from exact probabilities.

(a)  record after one tick from the blank rest state           outcome (cell, record, spin)   P(record 1) = sin^2 theta
(a') the same record after t = 8 ticks                         same                            P(record 1) = sin^2(8 theta)
(b)  phase estimation, clock register of T = 256 levels        outcome k in Z_T                P(k) = [F(theta - E_k) + F(theta + E_k)]/2
(c)  time of flight: positions at t1 and t2 of a blank packet  outcome (cell, record, spin)    folded mean displacement
     of declared momentum distribution (no branch selection)
Run: python free_instruments.py   (writes free_instruments.json and free_records.npz)"""
import json
import numpy as np
from scipy.optimize import minimize_scalar, brentq
from r6lib import Field, Routing, autocorr, qpe_probs, fejer, sample

THETAS = (0.042383, 0.087847, 0.157935)
EPS = 0.01                     # stated relative error
SEED = 20261110
REPS = 400                     # replicate experiments for bias and variance
out = {'thetas': THETAS, 'stated_relative_error': EPS, 'seed_base': SEED, 'replicates': REPS, 'rows': []}
store = {}


def replicate_stats(est, truth):
    est = np.asarray(est); return {'mean_minus_true': float(est.mean() - truth), 'rms_scatter': float(est.std(ddof=1)), 'replicates': int(len(est))}


# ------------------------------------------------------------------ (a), (a'): record after t ticks from the blank rest state
shape = (4, 4, 4)
for it, theta in enumerate(THETAS):
    f = Field(shape, theta); rest = f.w.plane_wave((0, 0, 0), [1, 0, 0, 0])
    for name, t in (("a", 1), ("a'", 8)):
        psi = f.run(rest, t); P = np.abs(psi) ** 2                         # complete outcome set: (cell, record, spin)
        p1 = float(P[..., 1, :].sum()); N = int(np.ceil(1 / (4 * EPS ** 2 * theta ** 2 * t * t) / 100) * 100)
        seed = SEED + 10 * it + (0 if t == 1 else 1)
        h = sample(P, N, seed); store[f'{name}_theta{it}_counts'] = h
        k = int(h[..., 1, :].sum()); est = float(np.arcsin(np.sqrt(k / N)) / t); se = 1 / (2 * t * np.sqrt(N))
        rng = np.random.default_rng(seed + 5000); ks = rng.binomial(N, p1, size=REPS)
        rep = replicate_stats(np.arcsin(np.sqrt(ks / N)) / t, theta)
        out['rows'].append({'instrument': name, 'ticks_per_record': t, 'theta_true': theta, 'estimate': est, 'error_bar': se, 'records': N,
                            'seed': seed, 'exact_P_record_written': p1, 'defect_vs_sin2': abs(p1 - np.sin(t * theta) ** 2),
                            'records_written': k, 'pull': (est - theta) / se,
                            'bias_formula': float(-1 / (np.tan(2 * t * theta) * 4 * N * t)), 'se_formula': '1/(2 t sqrt N)',
                            'records_for_stated_error_formula': f'1/(4 eps^2 theta^2 t^2) = {1 / (4 * EPS ** 2 * theta ** 2 * t * t):.0f}', **rep})

# ------------------------------------------------------------------ (b): clock register
T = 256; Ek = 2 * np.pi * np.arange(T) / T
model = lambda th: 0.5 * (fejer(th - Ek, T) + fejer(th + Ek, T))
grid = np.arange(0.002, 0.6, 0.002); LL = np.log(np.maximum(np.array([model(g) for g in grid]), 1e-300))


def mle(counts):
    g0 = grid[int(np.argmax(LL @ counts))]
    r = minimize_scalar(lambda th: -float(counts @ np.log(np.maximum(model(th), 1e-300))), bounds=(max(g0 - 0.004, 1e-6), g0 + 0.004), method='bounded', options={'xatol': 1e-10})
    return float(r.x)


def fisher(th, h=1e-6):
    d = (model(th + h) - model(th - h)) / (2 * h); P = model(th)
    return float(np.sum(d[P > 1e-30] ** 2 / P[P > 1e-30]))


for it, theta in enumerate(THETAS):
    f = Field(shape, theta); rest = f.w.plane_wave((0, 0, 0), [1, 0, 0, 0])
    psi_t = [rest]
    for t in range(T - 1): psi_t.append(f.tick(psi_t[-1], t))
    c = np.array([np.vdot(rest, q) for q in psi_t])                        # at rest every tick is the same operator
    P, info = qpe_probs(c)
    I = fisher(theta); N1 = 1 / (I * EPS ** 2 * theta ** 2); N = int(max(100, np.ceil(N1)))
    seed = SEED + 10 * it + 2; h = sample(P, N, seed); store[f'b_theta{it}_counts'] = h
    est = mle(h.astype(float)); se = 1 / np.sqrt(N * fisher(est))
    rng = np.random.default_rng(seed + 5000); reps = [mle(rng.multinomial(N, P).astype(float)) for _ in range(REPS)]
    out['rows'].append({'instrument': 'b', 'clock_levels': T, 'ticks_per_record': f'up to {T - 1} (mean {(T - 1) / 2})', 'theta_true': theta, 'estimate': est,
                        'error_bar': float(se), 'records': N, 'seed': seed, 'pull': (est - theta) / se,
                        'defect_engine_distribution_vs_two_line_formula': float(np.abs(P - model(theta)).max()), **info,
                        'fisher_information_per_record': I, 'fisher_separated_lines_(T^2-1)/3': (T * T - 1) / 3,
                        'records_for_stated_error': float(N1), **replicate_stats(reps, theta)})

# ------------------------------------------------------------------ (c): time of flight
L, n0, width, t1, t2 = 2048, 32, 6.0, 250, 850
p = 2 * np.pi * np.arange(L) / L; d = (np.arange(L) - n0 + L / 2) % L - L / 2
amp = np.exp(-d * d / (2 * width ** 2)); wts = amp ** 2 / np.sum(amp ** 2)               # declared momentum weights of the preparation
p_signed = 2 * np.pi * (n0 + d) / L
MASK = (wts > 1e-14) & (np.abs(np.sin(p_signed)) > 1e-12)
x = np.arange(L); disp = np.abs((x + L / 2) % L - L / 2)                                 # folded distance from the declared centre (cell 0)


def vbar(theta):
    sE = np.sqrt(1 - (np.cos(theta) * np.cos(p_signed[MASK])) ** 2)                       # sin E, cos E = cos theta cos p
    return float(np.sum(wts[MASK] * np.abs(np.cos(theta) * np.sin(p_signed[MASK])) / np.maximum(sE, 1e-300)))


def tof_estimate(h1, h2):
    """h1, h2: position histograms (all records) at t1 and t2"""
    N1, N2 = h1.sum(), h2.sum(); m1, m2 = (h1 @ disp) / N1, (h2 @ disp) / N2
    v1, v2 = (h1 @ disp ** 2) / N1 - m1 ** 2, (h2 @ disp ** 2) / N2 - m2 ** 2
    v = (m2 - m1) / (t2 - t1); sv = np.sqrt(v1 / N1 + v2 / N2) / (t2 - t1)
    if not vbar(1e-7) > v > vbar(1.2): return np.nan, np.nan, v, sv
    th = brentq(lambda a: vbar(a) - v, 1e-7, 1.2, xtol=1e-12); dv = (vbar(th + 1e-6) - vbar(th - 1e-6)) / 2e-6
    return float(th), float(sv / abs(dv)), float(v), float(sv)


for it, theta in enumerate(THETAS):
    f = Field((L, 1, 1), theta)
    psi = np.zeros((L, 1, 1, 2, 2), complex); g = np.fft.ifft(amp) * L                    # blank record, spin up, amplitudes amp over momentum
    psi[:, 0, 0, 0, 0] = g; psi /= np.linalg.norm(psi)
    psi1 = f.run(psi, t1); psi2 = f.run(psi1, t2 - t1, t0=t1)
    P1, P2 = np.abs(psi1) ** 2, np.abs(psi2) ** 2                                         # complete outcome set (cell, record, spin) at each time
    x1, x2 = P1.sum(axis=(1, 2, 3, 4)), P2.sum(axis=(1, 2, 3, 4))
    m1, m2 = x1 @ disp, x2 @ disp; s1, s2 = x1 @ disp ** 2 - m1 ** 2, x2 @ disp ** 2 - m2 ** 2
    v_exact = (m2 - m1) / (t2 - t1); dv = (vbar(theta + 1e-6) - vbar(theta - 1e-6)) / 2e-6
    Npair = (s1 + s2) / ((t2 - t1) * dv * EPS * theta) ** 2; Nh = int(np.ceil(Npair / 100) * 100)
    seed = SEED + 10 * it + 3
    h1, h2 = sample(P1, Nh, seed), sample(P2, Nh, seed + 1); store[f'c_theta{it}_t1_counts'] = h1; store[f'c_theta{it}_t2_counts'] = h2
    est, se, v, sv = tof_estimate(h1.sum(axis=(1, 2, 3, 4)).astype(float), h2.sum(axis=(1, 2, 3, 4)).astype(float))
    rng = np.random.default_rng(seed + 5000)
    reps = [tof_estimate(rng.multinomial(Nh, x1 / x1.sum()).astype(float), rng.multinomial(Nh, x2 / x2.sum()).astype(float))[0] for _ in range(REPS)]
    E0 = np.arccos(np.cos(theta) * np.cos(2 * np.pi * n0 / L))
    plug = float(np.arccos(v_exact / np.sqrt(np.sin(2 * np.pi * n0 / L) ** 2 + v_exact ** 2 * np.cos(2 * np.pi * n0 / L) ** 2)))
    out['rows'].append({'instrument': 'c', 'lattice': [L, 1, 1], 'p0': 2 * np.pi * n0 / L, 'sigma_p': float(np.sqrt(np.sum(wts * (2 * np.pi * d / L) ** 2))),
                        't1': t1, 't2': t2, 'ticks_per_record': f'{t1} or {t2}', 'theta_true': theta, 'estimate': est, 'error_bar': se,
                        'records': 2 * Nh, 'seed': [seed, seed + 1], 'pull': (est - theta) / se, 'velocity_from_records': v, 'velocity_se': sv,
                        'exact_folded_velocity': float(v_exact), 'declared_model_velocity': vbar(theta), 'defect_exact_vs_model_velocity': float(abs(v_exact - vbar(theta))),
                        'theta_from_exact_velocity_infinite_records': float(brentq(lambda a: vbar(a) - v_exact, 1e-7, 1.2, xtol=1e-13)),
                        'plug_in_p0_only_theta_infinite_records': plug, 'plug_in_relative_bias': plug / theta - 1,
                        'mass_between_lobes_at_t1': float(x1[disp < 20].sum()), 'records_for_stated_error': float(2 * Npair), **replicate_stats(reps, theta)})

np.savez_compressed('free_records.npz', **store)
json.dump(out, open('free_instruments.json', 'w'), indent=1)
print(f"{'inst':5s} {'theta':>9s} {'estimate':>10s} {'err bar':>9s} {'records':>8s} {'pull':>6s} {'rep bias':>10s} {'rep rms':>9s}")
for r in out['rows']:
    print(f"{r['instrument']:5s} {r['theta_true']:9.6f} {r['estimate']:10.6f} {r['error_bar']:9.6f} {r['records']:8d} {r['pull']:6.2f} {r['mean_minus_true']:10.2e} {r['rms_scatter']:9.6f}")
