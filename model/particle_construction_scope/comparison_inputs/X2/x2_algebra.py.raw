"""Task X2, item 1: charge label against flux label in the working law (CF-1 section 8).

Exact parts use integers, Fractions and monomial matrices over the sixth roots of unity (no floats).
The one float64 part (engine check E) prints its defect and is tagged MEASURED.

  A  the six centre elements, the phase of flux class k on every occupation state of the five levels
  B  Weyl pair of one Z6 link: mutual phases charge-flux, flux-flux, charge-charge
  C  obstructions to a symmetry that exchanges the two labels (each an exact count)
  D  flux attachment on a surface: which composites change exchange sign
  E  reference engine (work/DIRAC/routing.py): a holonomy k shifts the spectrum of pattern a by k Q6(a)/6

Run from RER (third argument: directory of the simulation session's cf1_lib.py, for the comparison of the tables):
  PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=.:RL/work/DIRAC:RL/work/X2 nice -n 10 /tmp/oph-completion-venv/bin/python \
      RL/work/X2/x2_algebra.py RL/work/X2/algebra.json RL/work/SIM/cf1
"""
import itertools, json, sys
from fractions import Fraction as F
import numpy as np

out = {'schema': 'x2.algebra.v1'}

# ---------------------------------------------------------------- A: centre and pairing (EXACT, integers)
LEVEL_Q = (-2, -2, -2, 3, 3)                      # charge of the three vector and two spinor levels; Q6 = 3 n2 - 2 n3
NAMES = {(0, 0): 'antineutrino singlet', (1, 0): 'down quark, right-handed', (2, 0): 'up antiquark',
         (3, 0): 'electron, right-handed', (0, 1): 'antilepton doublet', (1, 1): 'quark doublet',
         (2, 1): 'antiquark doublet', (3, 1): 'lepton doublet', (0, 2): 'positron',
         (1, 2): 'up quark, right-handed', (2, 2): 'down antiquark', (3, 2): 'neutrino, right-handed'}

# the U(1) generated by Y = diag(LEVEL_Q)/6: g(s) = exp(2 pi i s Y); block determinants in turns
def block_det_turns(s):
    return (3 * F(LEVEL_Q[0], 6) * s) % 1, (2 * F(LEVEL_Q[3], 6) * s) % 1
# g(s) lies in SU(3) x SU(2) iff both block determinants are 1; scan s = m/60, m = 0..359 (six turns of s)
inside = [F(m, 60) for m in range(360) if block_det_turns(F(m, 60)) == (0, 0)]
assert inside == [F(k) for k in range(6)], inside
elements = {k: tuple((F(q, 6) * k) % 1 for q in LEVEL_Q) for k in range(6)}        # level phases in turns
assert len(set(elements.values())) == 6                                            # six distinct elements
assert elements[3] == (0, 0, 0, F(1, 2), F(1, 2))                                  # class 3 = diag(1,1,1,-1,-1)
assert elements[2] == (F(1, 3),) * 3 + (0, 0) and elements[4] == (F(2, 3),) * 3 + (0, 0)   # colour centre
out['A_centre'] = {
    'statement': 'U(1) of the charge diag(-2,-2,-2,3,3)/6 meets SU(3) x SU(2) in exactly six elements g(k), k = 0..5',
    'level_phases_in_turns': {str(k): [str(x) for x in v] for k, v in elements.items()},
    'class_3': 'diag(1,1,1,-1,-1): the central -1 of the doublet block',
    'classes_2_4': 'the two nontrivial cube roots of unity on the triplet block, 1 on the doublet block',
    'classes_1_5': 'generators', 'tag': 'EXACT'}

states = list(itertools.product((0, 1), repeat=5))                                 # 32 occupation states
def pattern(s): return (sum(s[:3]), sum(s[3:]))
def q6(s): return sum(q for q, o in zip(LEVEL_Q, s) if o)
phase6 = {}                                                                        # (k, pattern) -> k Q6 mod 6
for k in range(6):
    for s in states:
        e = (k * q6(s)) % 6                                                        # lift of g(k) to the occupation state
        assert q6(s) == 3 * pattern(s)[1] - 2 * pattern(s)[0]
        assert phase6.setdefault((k, pattern(s)), e) == e                          # scalar on each pattern
mult = {}
for s in states: mult[pattern(s)] = mult.get(pattern(s), 0) + 1
PATTERNS = [(n3, n2) for n2 in range(3) for n3 in range(4)]
fold = lambda a: min(a % 6, 6 - a % 6)
rows = []
for p in PATTERNS:
    Q = 3 * p[1] - 2 * p[0]
    rows.append({'n3': p[0], 'n2': p[1], 'name': NAMES[p], 'states': mult[p], 'Q6': Q, 'charge_class': Q % 6,
                 'phase_sixths_by_flux_class': {str(k): phase6[(k, p)] for k in range(6)},
                 'alpha_sixths_folded': {str(k): fold(phase6[(k, p)]) for k in range(1, 6)},
                 'sees': [k for k in range(1, 6) if phase6[(k, p)] != 0]})
out['A_patterns'] = rows
try:                                                                               # the simulation session's table
    sys.path.insert(0, sys.argv[2] if len(sys.argv) > 2 else '')
    import cf1_lib
    assert all(cf1_lib.alpha_sixths(p, k) == fold(phase6[(k, p)]) for p in PATTERNS for k in range(1, 6))
    assert all(cf1_lib.NAMES[p] == NAMES[p] and cf1_lib.q6(p) == 3 * p[1] - 2 * p[0] for p in PATTERNS)
    out['A_agrees_with_cf1_lib'] = True
except ImportError:
    out['A_agrees_with_cf1_lib'] = 'cf1_lib not on the path'
states_per_class = {q: sum(mult[p] for p in PATTERNS if (3 * p[1] - 2 * p[0]) % 6 == q) for q in range(6)}
members = {q: [list(p) for p in PATTERNS if (3 * p[1] - 2 * p[0]) % 6 == q] for q in range(6)}
assert states_per_class == {0: 4, 1: 6, 2: 6, 3: 4, 4: 6, 5: 6}
out['A_states_per_charge_class'] = {str(q): {'states': states_per_class[q], 'patterns': members[q],
                                              'multiplet_dimensions': [mult[tuple(p)] for p in members[q]]} for q in range(6)}
# label level: the pairing <k, q> = k q mod 6 is symmetric and perfect; label isomorphisms that keep it symmetric
pair = [[(k * q) % 6 for q in range(6)] for k in range(6)]
assert all(pair[k][q] == pair[q][k] for k in range(6) for q in range(6))
assert all(any(pair[k][q] for q in range(6)) for k in range(1, 6))                 # perfect: only k = 0 pairs trivially
isos = [u for u in range(6) if sorted((u * k) % 6 for k in range(6)) == list(range(6))]
assert isos == [1, 5]
out['A_label_level'] = {'pairing_sixths': pair, 'symmetric': True, 'perfect': True,
                        'label_isomorphisms_k_to_q': ['q = k', 'q = -k'],
                        'reading': 'every finite abelian group is isomorphic to its dual: this holds for any Z6 register and carries no information about the law',
                        'tag': 'EXACT'}

# ---------------------------------------------------------------- B: one Z6 link, monomial matrices (EXACT)
class Mono:
    """monomial 6 x 6 matrix: column j has the entry w^e[j] in row p[j], w = exp(2 pi i/6)"""
    def __init__(self, p, e): self.p, self.e = tuple(p), tuple(x % 6 for x in e)
    def __mul__(self, o): return Mono([self.p[o.p[j]] for j in range(6)], [o.e[j] + self.e[o.p[j]] for j in range(6)])
    def __eq__(self, o): return self.p == o.p and self.e == o.e
    def inv(self):
        p = [0] * 6; e = [0] * 6
        for j in range(6): p[self.p[j]] = j; e[self.p[j]] = -self.e[j]
        return Mono(p, e)
    def power(self, n):
        r = Mono(range(6), [0] * 6)
        for _ in range(n % 6): r = r * self
        return r
    def scalar(self):
        return self.e[0] if self.p == tuple(range(6)) and len(set(self.e)) == 1 else None
X = Mono([(j + 1) % 6 for j in range(6)], [0] * 6)          # twist of the link by one unit: creates flux 1 around the link
Z = Mono(range(6), range(6))                                # link phase seen by a unit charge: the hop of charge q carries Z^q
comm = lambda a, b: (a * b * a.inv() * b.inv()).scalar()
cf = [[comm(Z.power(q), X.power(k)) for q in range(6)] for k in range(6)]          # charge q against flux k
assert all(cf[k][q] == (k * q) % 6 for k in range(6) for q in range(6))
assert all(comm(X.power(k), X.power(l)) == 0 for k in range(6) for l in range(6))  # flux against flux
assert all(comm(Z.power(q), Z.power(r)) == 0 for q in range(6) for r in range(6))  # link factors of two hops
out['B_mutual_phases'] = {
    'charge_flux_sixths': cf, 'charge_flux': 'exp(2 pi i k q / 6): group commutator of the hop factor Z^q with the twist X^k',
    'flux_flux': '1 for all pairs (twists commute); exchange sign +1 (link registers are commuting tensor factors)',
    'charge_charge': 'mutual phase 1 (hop factors commute); exchange sign -1 for every pattern, DECLARED (antisymmetric occupations, CF-1 section 8a)',
    'tag': 'EXACT; the Z6 link is a declared extension (CF-1 section 8 lists Z6 links as open), the Z2 case k = 3 is the working law'}

# ---------------------------------------------------------------- C: obstructions to a symmetry exchanging the labels
# C1 exchange sign: a single quantum is a fermion in every charge class; a flux is a boson in every class
fermion_in_class = {q: NAMES[tuple(members[q][0])] for q in range(6)}              # every class holds a pattern (all patterns are CAR modes)
c1 = {'exchange_sign_single_quantum_by_charge_class': {str(q): -1 for q in range(6)},
      'example_pattern_by_class': {str(q): fermion_in_class[q] for q in range(6)},
      'exchange_sign_flux_by_class': {str(k): +1 for k in range(6)},
      'labels_where_the_swap_fails': 6, 'depends_on': 'the DECLARED antisymmetric occupations'}
# C2 sector dimensions: internal states of a charge label against one state per flux label
c2 = {'states_per_charge_class': states_per_class, 'states_per_flux_class': {str(k): 1 for k in range(6)},
      'irreducible_dimensions_on_the_charge_side': sorted(set(mult.values()), reverse=True)}
# C3 label groups: charges add in Z, fluxes in Z6; patterns with Q6 = +-6 are charged and invisible to every flux
blind_but_charged = [NAMES[p] for p in PATTERNS if (3 * p[1] - 2 * p[0]) % 6 == 0 and 3 * p[1] - 2 * p[0] != 0]
c3 = {'Q6_values_of_patterns': sorted({3 * p[1] - 2 * p[0] for p in PATTERNS}),
      'charged_patterns_with_trivial_pairing': blind_but_charged,
      'statement': 'the pairing has kernel 6Z on the charge side; the flux side has no kernel'}
# C4 carrier: independent vertex (Gauss) labels against independent face (flux) labels on the icosahedron
from model.common_source import slow_geometry
cs = slow_geometry.source()
def q5f(x):
    for conv in (lambda v: float(v), lambda v: float(v[0]) + float(v[1]) * 5 ** 0.5):
        try: return conv(x)
        except Exception: pass
    raise TypeError(x)
V = np.array([[q5f(c) for c in v] for v in slow_geometry.raw_frame()])
d2 = ((V[:, None, :] - V[None, :, :]) ** 2).sum(-1)
edges = [(a, b) for a in range(12) for b in range(a + 1, 12) if abs(d2[a, b] - 4) < 1e-9]
faces = [(a, b, c) for a in range(12) for b in range(a + 1, 12) for c in range(b + 1, 12)
         if abs(d2[a, b] - 4) < 1e-9 and abs(d2[b, c] - 4) < 1e-9 and abs(d2[a, c] - 4) < 1e-9]
assert (len(V), len(edges), len(faces)) == (12, 30, 20)
eid = {e: i for i, e in enumerate(edges)}
div = [[0] * 30 for _ in range(12)]                          # oriented vertex-edge incidence
for (a, b), i in eid.items(): div[a][i] = 1; div[b][i] = -1
curl = [[0] * 30 for _ in range(20)]                         # oriented face-edge incidence, faces outward
for f, (a, b, c) in enumerate(faces):
    if np.dot(np.cross(V[b] - V[a], V[c] - V[a]), V[a] + V[b] + V[c]) < 0: a, b, c = a, c, b
    for u, v in ((a, b), (b, c), (c, a)):
        curl[f][eid[(min(u, v), max(u, v))]] = 1 if u < v else -1
def rank_mod(M, p):
    M = [[x % p for x in r] for r in M]; r = 0
    for c in range(len(M[0])):
        piv = next((i for i in range(r, len(M)) if M[i][c]), None)
        if piv is None: continue
        M[r], M[piv] = M[piv], M[r]
        inv = pow(M[r][c], -1, p); M[r] = [(x * inv) % p for x in M[r]]
        for i in range(len(M)):
            if i != r and M[i][c]: M[i] = [(x - M[i][c] * y) % p for x, y in zip(M[i], M[r])]
        r += 1
    return r
assert all(sum(curl[f][i] * div[v][i] for i in range(30)) == 0 for f in range(20) for v in range(12))   # curl of a gradient vanishes
assert all(sum(col) == 0 for col in zip(*curl))              # every twist changes two faces by +delta and -delta
ranks = {'vertex_mod2': rank_mod(div, 2), 'vertex_mod3': rank_mod(div, 3), 'face_mod2': rank_mod(curl, 2), 'face_mod3': rank_mod(curl, 3)}
assert ranks == {'vertex_mod2': 11, 'vertex_mod3': 11, 'face_mod2': 19, 'face_mod3': 19}, ranks
c4 = {'ports': 12, 'seams': 30, 'faces': 20, 'ranks': ranks,
      'independent_charge_labels': 'Z6^11 (twelve port labels with total zero)',
      'independent_flux_labels': 'Z6^19 (twenty face classes with total zero)',
      'statement': 'the carrier is not self-dual (its dual has 20 ports): no map of the carrier exchanges port labels with face labels',
      'class_sum_rule': 'the columns of the face-seam incidence sum to zero: every twist adds +delta to one face and -delta to another face of the same carrier, so the twenty classes of a carrier sum to 0 mod 6 in every history'}
out['C_obstructions'] = {'C1_exchange_sign': c1, 'C2_sector_dimensions': c2, 'C3_label_groups': c3, 'C4_carrier_incidence': c4,
                         'C5_tick': 'Gamma(S) and Gamma(M) are diagonal in the link word (work/DIRAC/interaction_check.json: routing_leaves_the_link_word = 0.0); at eps = kappa = 0 every flux observable is a constant of motion while a packet of quanta moves (CF-1 section 4 item 5: velocity 1.000000). A symmetry of the tick that exchanged the labels would make the position of a quantum a constant of motion.',
                         'tag': 'EXACT (C1 conditional on the declared occupations; C5 cites executed checks)'}

# ---------------------------------------------------------------- D: flux attachment on a surface (EXACT, two dimensions only)
theta = {(q, k): (q * k) % 6 for q in range(6) for k in range(6)}                  # exchange phase of the composite of bosonic charge q with flux k, in sixths
minus = sorted((q, k) for (q, k), v in theta.items() if v == 3)
assert minus == [(1, 3), (3, 1), (3, 3), (3, 5), (5, 3)]
never = [q for q in range(6) if all(theta[(q, k)] != 3 for k in range(6))]
assert never == [0, 2, 4]
out['D_flux_attachment'] = {
    'exchange_phase_sixths_of_composite_q_k': {f'{q},{k}': v for (q, k), v in theta.items()},
    'composites_with_sign_minus_one': minus, 'charge_classes_never_fermionized': never,
    'patterns_never_fermionized': [NAMES[tuple(p)] for q in never for p in members[q]],
    'statement': 'on a surface a charge q bound to a flux k gains the exchange phase exp(2 pi i q k/6); it is -1 only for odd q with flux 3 or q = 3 with odd flux. Quark singlets (classes 2, 4) and the four singlets of class 0 never get a sign this way. In three dimensions there is no such phase (CF-1 section 6).',
    'tag': 'EXACT for point objects on a surface; ARGUED for three dimensions'}

# ---------------------------------------------------------------- E: reference engine, twisted line (MEASURED, float64)
try:
    from routing import Routing
    L = 6; worst = 0.0; worst_gauge = 0.0
    rng = np.random.default_rng(1)
    def spectrum(z_line):
        w = Routing((L, 1, 1), [z_line.reshape(L, 1, 1), np.ones((L, 1, 1)), np.ones((L, 1, 1))])
        n = L * 4; M = np.zeros((n, n), complex)
        for j in range(n):
            e = np.zeros(n, complex); e[j] = 1
            M[:, j] = w.tick(e.reshape(L, 1, 1, 2, 2)).reshape(n)
        assert np.abs(M.conj().T @ M - np.eye(n)).max() < 1e-12
        return np.sort(np.angle(np.linalg.eigvals(M) * np.exp(1j * np.pi / 36))) - np.pi / 36   # cut moved off the spectrum (phases are multiples of 2 pi/36)
    for p in PATTERNS:
        Q = 3 * p[1] - 2 * p[0]
        for k in range(6):
            z = np.ones(L, complex); z[0] = np.exp(2j * np.pi * k * Q / 6)          # all of the holonomy on one link
            E = spectrum(z)
            got = np.abs(E).min() * L / (2 * np.pi) * 6                             # lowest phase in units of (2 pi/L)/6
            worst = max(worst, abs(got - fold((k * Q) % 6)))
            g = np.exp(2j * np.pi * rng.integers(0, 6, size=L) * Q / 6)             # the same holonomy in another gauge
            worst_gauge = max(worst_gauge, np.abs(spectrum(z * g * np.conj(np.roll(g, -1))) - E).max())
    out['E_engine'] = {'lattice': [L, 1, 1], 'cases': 72, 'max_defect_lowest_phase_against_k_Q6_over_6': worst,
                       'max_defect_gauge_invariance_of_spectrum': worst_gauge,
                       'statement': 'a link holonomy of class k shifts the allowed momenta of pattern a by k Q6(a)/6 of a unit: the quantum reads the link word; the engine has no operation that changes the link word',
                       'tag': 'MEASURED (float64); link phases beyond signs are a declared extension'}
except ImportError as err:
    out['E_engine'] = {'skipped': str(err)}

# ---------------------------------------------------------------- F: a flux pair as cargo of a quantum (reading C; EXACT)
# The composite carries the charges of the quantum; the pair (k, -k) has no net flux, so it adds no exchange phase.
# Its rest phase (option M1) depends on alpha = k Q6/6 folded. A Dirac pair needs one alpha for both handedness classes.
LINKS = {'up quark': ((1, 1), (1, 2)), 'down quark': ((1, 1), (1, 0)), 'charged lepton': ((3, 1), (3, 0)), 'neutrino': ((3, 1), (3, 2))}
cargo = {}
for k in range(1, 6):
    al = {name: (fold(phase6[(k, l)]), fold(phase6[(k, r)])) for name, (l, r) in LINKS.items()}
    cargo[k] = {'alpha_sixths_left_right': al, 'one_angle_for_both_handedness_classes': all(a == b for a, b in al.values()),
                'species_with_a_rest_phase': [n for n, (a, b) in al.items() if a == b and a != 0],
                'species_split': [n for n, (a, b) in al.items() if a != b]}
assert [k for k in range(1, 6) if cargo[k]['one_angle_for_both_handedness_classes']] == [2, 4]
assert all(cargo[k]['species_with_a_rest_phase'] == ['up quark', 'down quark'] for k in (2, 4))
assert all(fold(phase6[(k, p)]) == fold(phase6[(6 - k, p)]) for k in range(1, 6) for p in PATTERNS)           # conjugate cargo, same alpha
assert all(fold(phase6[(k, p)]) == fold(phase6[(k, (3 - p[0], 2 - p[1]))]) for k in range(1, 6) for p in PATTERNS)   # antiparticle, same alpha
# reason: an even class depends on n3 only, and the toggle of the neutral doublet level changes n2 only
assert all(phase6[(k, (n3, 0))] == phase6[(k, (n3, 1))] == phase6[(k, (n3, 2))] for k in (2, 4) for n3 in range(4))
assert all(phase6[(k, (n3, 0))] != phase6[(k, (n3, 1))] for k in (1, 3, 5) for n3 in range(4))
blind_to_all = [NAMES[p] for p in PATTERNS if all(phase6[(k, p)] == 0 for k in range(6))]
out['F_cargo'] = {'by_cargo_class': {str(k): v for k, v in cargo.items()},
                  'classes_that_act_alike_on_both_handedness_classes': [2, 4],
                  'reason': 'a class k acts on a pattern as exp(2 pi i k (3 n2 - 2 n3)/6); for even k the factor of n2 is 1; the mass operator changes n2 by one and leaves n3',
                  'patterns_blind_to_every_class': blind_to_all,
                  'net_flux_of_a_pair': 'k + (-k) = 0: no exchange phase is added to the quantum',
                  'tag': 'EXACT (representation level; M1 and the carrying gate are DECLARED)'}

out['verdict_item_1'] = {
    'label_level': 'exact and empty: flux classes and charge classes modulo 6 are dual groups, in two ways (k = q, k = -q)',
    'as_a_symmetry_of_the_working_law': 'excluded: exchange sign (declared occupations), sector dimensions 6, 3, 2, 1 against 1, charge group Z against flux group Z6, 11 against 19 independent labels on a carrier, and the tick (quantum routed, link word read)',
    'approximate': 'no: the obstructions are integers and a sign; no parameter of the law deforms them',
    'reading_B': 'excluded as a statement about the catalogued defects; its table is exact as the table of charge classes of quanta'}
path = sys.argv[1] if len(sys.argv) > 1 else 'algebra.json'
json.dump(out, open(path, 'w'), indent=1, default=str)
print(json.dumps({k: out[k] for k in ('A_states_per_charge_class', 'B_mutual_phases', 'E_engine')}, indent=1, default=str)[:3000])
print('ranks', ranks, '| minus-one composites', minus, '| never', never)
