w(f"- MEASURED. Stationary faces per carrier, class 3 over classes 2 and 4: {f(d3['value'])} +- {f(d3['se'])}; equal population per state gives 0.6667")
w(f"  ({int(d3['z_against_equal_per_state'])} standard errors). Classes 1 and 5 over 2 and 4: {f(d1['value'])} at 300 sweeps, 0 in the limit; equal population gives 1.")
sc = dens['screen_end']; sce = dens['screen_end_combined']
