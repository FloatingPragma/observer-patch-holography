"""Worker LY, shared library: the Z6 face register on the pinned public carrier.

Carrier: RER/evidence/observer_dynamics_20260925/oph-physics-sim/oph_exact/carrier.py (the pinned public copy that
model/common_source/slow_geometry.py loads), imported read only. Register rule: oph_defects/DATASET.md section 1
(unit twist on seam (a, b): the face that traverses a -> b changes by +delta, the face that traverses b -> a by
-delta; committed rule in the balanced band: applied iff the cost does not rise). Cost table T0 and kappa are the
declared values of the runs; A1 and A2 are worker UH's derived tables. No measured value is read here.
"""
from __future__ import annotations

import importlib.util
import os
from collections import deque
from fractions import Fraction

RL = 'WORKSPACE/repair-law'
RER = 'WORKSPACE/reverse-engineering-reality'
if not os.path.isdir(RER):
    RER = os.path.join(RL, 'reverse-engineering-reality')
CARRIER_PATH = os.path.join(RER, 'evidence/observer_dynamics_20260925/oph-physics-sim/oph_exact/carrier.py')


def _load_carrier():
    """Import the pinned public carrier the way model/common_source/slow_geometry.py does (archive on the path
    during the import only; nothing is written)."""
    import importlib
    import sys
    archive = os.path.dirname(os.path.dirname(CARRIER_PATH))
    sys.path.insert(0, archive)
    try:
        mod = importlib.import_module('oph_exact.carrier')
    finally:
        sys.path.remove(archive)
    assert os.path.realpath(mod.__file__) == os.path.realpath(CARRIER_PATH)
    return mod


C = _load_carrier()

T0 = (0, 5, 8, 10, 8, 5)
KAPPA = 5
A1 = tuple(Fraction(x, 10) for x in (0, 17, 9, 8, 9, 17))
A2 = tuple(Fraction(x, 5) for x in (0, 1, 3, 4, 3, 1))

SEAMS = [tuple(map(int, s)) for s in C.seams()]
FACES = [tuple(map(int, f)) for f in C.oriented_faces()]
NF, NS = len(FACES), len(SEAMS)
assert NF == 20 and NS == 30
VAC = (0,) * NF


def _face_sides():
    key = {s: k for k, s in enumerate(SEAMS)}
    plus, minus = [-1] * NS, [-1] * NS
    for f, (p, q, r) in enumerate(FACES):
        for u, v in ((p, q), (q, r), (r, p)):
            k = key[(min(u, v), max(u, v))]
            if u < v:
                assert plus[k] < 0
                plus[k] = f
            else:
                assert minus[k] < 0
                minus[k] = f
    assert min(plus) >= 0 and min(minus) >= 0
    return plus, minus


PLUS, MINUS = _face_sides()
NBR = [[] for _ in range(NF)]
SEAM_OF = {}
for _k in range(NS):
    _a, _b = PLUS[_k], MINUS[_k]
    NBR[_a].append(_b)
    NBR[_b].append(_a)
    SEAM_OF[(_a, _b)] = _k
    SEAM_OF[(_b, _a)] = _k
FACE_SEAMS = [[k for k in range(NS) if PLUS[k] == f or MINUS[k] == f] for f in range(NF)]


def _dual_distances():
    D = [[-1] * NF for _ in range(NF)]
    for s in range(NF):
        D[s][s] = 0
        dq = deque([s])
        while dq:
            x = dq.popleft()
            for y in NBR[x]:
                if D[s][y] < 0:
                    D[s][y] = D[s][x] + 1
                    dq.append(y)
    return D


DIST = _dual_distances()
PROPOSALS = [(k, d) for k in range(NS) for d in (1, 5)]          # 60 pairs (seam, delta); 5 stands for -1


def cost(cfg, table=T0):
    return sum(table[c] for c in cfg)


def twist(cfg, k, delta):
    new = list(cfg)
    new[PLUS[k]] = (new[PLUS[k]] + delta) % 6
    new[MINUS[k]] = (new[MINUS[k]] - delta) % 6
    return tuple(new)


def config(assign):
    cfg = [0] * NF
    for f, c in assign.items():
        cfg[f] = c % 6
    return tuple(cfg)


def defects(cfg):
    return {f: c for f, c in enumerate(cfg) if c}


def classes(cfg):
    return tuple(sorted(c for c in cfg if c))


def allowed_moves(cfg, table=T0):
    """Proposals the committed rule applies: list of (k, delta, new_cfg, rise)."""
    c0 = cost(cfg, table)
    out = []
    for k, d in PROPOSALS:
        y = twist(cfg, k, d)
        r = cost(y, table) - c0
        if r <= 0:
            out.append((k, d, y, r))
    return out


def face_perms():
    fidx = {}
    for i, f in enumerate(FACES):
        for r in range(3):
            fidx[f[r:] + f[:r]] = i
    perms = []
    for perm in C.rotations():
        perms.append([fidx[tuple(perm[v] for v in f)] for f in FACES])
    return perms


def pair_orbit_reps():
    """Representatives of the rotation orbits of unordered face pairs: list of (a, b, distance, size)."""
    perms = face_perms()
    seen, out = set(), []
    for a in range(NF):
        for b in range(a + 1, NF):
            if (a, b) in seen:
                continue
            orb = set()
            for pf in perms:
                x, y = pf[a], pf[b]
                orb.add((min(x, y), max(x, y)))
            seen |= orb
            out.append((a, b, DIST[a][b], len(orb)))
    out.sort(key=lambda r: (r[2], r[3], r[0], r[1]))
    return out


PLACEMENT_WEIGHTS = {2: Fraction(3, 8), 3: Fraction(3, 8), 4: Fraction(3, 16), 5: Fraction(1, 16)}


def antipodal_face(f):
    return max(range(NF), key=lambda g: DIST[f][g])


def hexagon(f):
    """Ports and seams of the hexagon around the axis of face f (the six ports outside f and its antipodal face)."""
    fa = antipodal_face(f)
    assert DIST[f][fa] == 5
    ports = sorted(set(range(12)) - set(FACES[f]) - set(FACES[fa]))
    seams = [k for k, (a, b) in enumerate(SEAMS) if a in ports and b in ports]
    return ports, seams
