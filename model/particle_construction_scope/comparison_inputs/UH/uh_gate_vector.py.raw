"""Worker UH: direct check of the vector constants at finite mass. F(M) = (1/2) int_zone omega(k; M) d^3k/(2 pi)^3
against A0 + A2 M^2 + (M^4/64 pi^2)(ln M^2 - c_V); the residual must fall as M^6 (times a logarithm).
Dispersions: GL's link waves (B4) and the two-step leapfrog (B4t). Writes gate_vector.json."""
import json
import math

import numpy as np

src = open("uh_constants.py").read()
ns = {}
exec(compile(src.split("# ------------------------------------------------------------------ B1, B2")[0], "head", "exec"), ns)
pyramid_nodes, radial = ns["pyramid_nodes"], ns["radial"]
khat2 = lambda p: (4 * np.sin(p / 2) ** 2).sum(-1)
cs = json.load(open("constants.json"))["B4_vector_GL_links_full_zone"]
ct = json.load(open("constants_b4t.json"))
disp = {"B4": (lambda p, M: np.sqrt(khat2(p) + M * M), cs),
        "B4t": (lambda p, M: 4 * np.arcsin(np.sqrt(khat2(p) + M * M) / 4), ct)}
n, w_ang, rmax = pyramid_nodes(math.pi)
out = {}
for name, (om, c) in disp.items():
    def F(M):
        f = lambda p, r: om(p, M)
        ra = min(6 * M, 1.5) if M > 0 else 1.5
        return 0.5 * (radial(f, n, w_ang, 0.0, ra) + radial(f, n, w_ang, ra, math.pi)
                      + radial(f, n, w_ang, math.pi, rmax)) / (2 * math.pi) ** 3
    F0 = F(0.0)
    rows = []
    for M in (0.2, 0.1, 0.05):
        pred = F0 + c["A2"] * M ** 2 + M ** 4 / (64 * math.pi ** 2) * (math.log(M * M) - c["c_cell"])
        res = F(M) - pred
        rows.append({"M": M, "residual": res, "residual_over_M6": res / M ** 6})
        print(name, M, "residual %.3e  /M^6 %.4f" % (res, res / M ** 6))
    out[name] = rows
json.dump(out, open("gate_vector.json", "w"), indent=1)
