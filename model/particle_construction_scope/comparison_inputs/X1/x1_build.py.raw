"""Worker X1: build candidates.json and CANDIDATES.md from the check files of this directory and the cited reports.

  python RL/work/X1/x1_build.py        (reads carrier_checks.json and family_checks.json next to it)

Every number written here comes from carrier_checks.json or family_checks.json (computed by x1_carrier.py and
x1_family.py), or is quoted with its source file. Nothing is fitted.
"""
import json, os
HERE = os.path.dirname(os.path.abspath(__file__))
RL = os.path.dirname(os.path.dirname(HERE))
RER = os.path.join(os.path.dirname(RL), 'reverse-engineering-reality')
C = json.load(open(os.path.join(HERE, 'carrier_checks.json')))
F = json.load(open(os.path.join(HERE, 'family_checks.json')))
R2 = json.load(open(os.path.join(RL, 'work/R2/item2.json')))
R2C = json.load(open(os.path.join(RL, 'work/R2/charges.json')))
SW, LR, PT = C['scalar_walk'], C['link_register'], C['patterns']
CEN = C['census_shadows_L10_sweep300']
Z2PH = {r['separation']: r['rest_phase'] for r in C['doublet_level_with_one_Z2_flux_pair']['rows']}

# ---- agreement of the cited R2 files with this directory's own counts (no recomputation of R2's results)
assert R2['pairs_by_separation'] == LR['pairs_by_separation'] and R2['rotation_group_orbits_on_pairs'] == LR['rotation_content_of_the_190_pairs']['1']
assert all(a['pairs fixed by each half-turn'] == [LR['pairs_fixed_by_a_half_turn']] * 3 for a in R2['A_half_turns_on_faces_and_pairs'])
assert R2C['2_pattern_charges']['patterns with odd n2 (Z2-charged)'] == PT['counts']['Z2_odd_states']
assert R2C['2_pattern_charges']['number of patterns with Q6 = 0'] == PT['counts']['states'] - PT['counts']['states_with_Q6_nonzero']
klein = {'trivial': (190 + 3 * LR['pairs_fixed_by_a_half_turn']) // 4, 'each_sign': (190 - LR['pairs_fixed_by_a_half_turn']) // 4}
assert klein == {'trivial': 55, 'each_sign': 45}

def content_str(c, order=('1', '2', "2'", '3', "3'", '4', '4s', '5', '6')):
    return ' + '.join((f'{c[k]} x ' if c[k] > 1 else '') + k for k in order if c.get(k))

NAMES = {(0, 0): 'empty pattern (conjugate of the right-handed neutrino)', (1, 0): 'down quark, right-handed',
         (2, 0): 'up antiquark', (3, 0): 'electron, right-handed', (0, 1): 'antilepton doublet (gauge numbers of the Higgs doublet)',
         (1, 1): 'quark doublet, left-handed', (2, 1): 'antiquark doublet', (3, 1): 'lepton doublet, left-handed',
         (0, 2): 'positron (charged antilepton)', (1, 2): 'up quark, right-handed', (2, 2): 'down antiquark',
         (3, 2): 'right-handed neutrino (full pattern)'}
MAPROW = {(1, 1): 'Quark doublet, left-handed (3 colours)', (1, 2): 'Up quark, right-handed', (1, 0): 'Down quark, right-handed',
          (3, 1): 'Lepton doublet, left-handed', (3, 0): 'Electron, right-handed', (3, 2): 'Right-handed neutrino'}
AUDIT = {(1, 0): ['wave-triplet-j0..2'], (0, 1): ['wave-doublet-j3..4'], (2, 0): ['aux-even-n3=2-n2=0', 'up_right_conjugate'],
         (1, 1): ['aux-even-n3=1-n2=1', 'up_left', 'down_left'],
         (0, 2): ['aux-even-n3=0-n2=2', 'charged_lepton_right_conjugate', 'particle_primary_regional_fermion:regional_endpoint_irrep'],
         (3, 1): ['aux-even-n3=3-n2=1', 'neutrino_left', 'charged_lepton_left'], (2, 2): ['aux-even-n3=2-n2=2', 'down_right_conjugate']}
rows = []
for r in PT['rows']:
    key = (r['n3'], r['n2']); odd = bool(r['Z2_link_charge']); cc = content_str(r['cover_content_of_internal_factor'])
    rows.append({
        'id': f"pattern_{r['n3']}{r['n2']}", 'type': 'matter-like', 'name': NAMES[key],
        'labels': {'n3': r['n3'], 'n2': r['n2'], 'N': r['N'], 'Q6': r['Q6'], 'Q6_mod_6': r['Q6'] % 6, 'Z2_link_charge': r['Z2_link_charge'],
                   'triality': r['triality'], 'handedness_class_convention': r['handedness_class_convention'], 'conjugate_pattern': r['conjugate']},
        'multiplet_dimension': r['states'], 'components_per_cell_in_CF1 (states x record x pointer)': 4 * r['states'],
        'gauge': {'SU3': r['SU3'], 'SU2': r['SU2'], 'Y': r['Y'], 'electric_charges': r['electric_charges']},
        'sees_Z2_flux_of_the_working_law': odd,
        'centre_flux_classes_seen_under_declared_Z6_reading': r['centre_flux_classes_seen'],
        'cover_content_of_internal_factor': cc, 'sign_of_full_turn_on_internal_factor': r['sign_under_cover_centre'],
        'spin_candidates': (['1/2 native: the occupied spinor level is a spinor of the frame half-turns (R2 result 4); it is the same two states as the weak index',
                             '1/2 by the declared pointer of CF-1'] if odd else
                            ['1/2 by the declared pointer of CF-1 only: the internal factor has integer content']),
        'travels': {'CF1_routing': ('yes: on the cone, gauge covariant, held by the Gauss constraint (R2)' if odd else
                                    'yes: the same routing with link sign 1; no Gauss constraint applies'),
                    'one_carrier_public_walk': 'no: the walk stays on the carrier'},
        'stable': 'pattern kept exactly by the public tick and by CF-1 with M0, M1, M3; M2 changes n2 by one and breaks the Gauss constraint (R7)',
        'protected_by': ('commutant U(3) x U(2) of the central links; Gauss constraint G_x for the Z2 charge' if odd else
                         'commutant U(3) x U(2) of the central links; no gauged charge in the working law'),
        'created_or_destroyed_by': 'declared preparation; the declared toggle of the neutral spinor level (M2); nothing in the idle tick',
        'rest_phase_M1_on_a_carrier_with_one_Z2_pair_by_separation': ({str(d): Z2PH[d] for d in range(1, 6)} if odd else 0.0),
        'executed_as': ('one-quantum wave of the public walk' if key in ((1, 0), (0, 1)) else
                        'occupation pattern: representation level; occupations executed in the audit species package'),
        'audit_source_ids': AUDIT.get(key, []), 'map_row': MAPROW.get(key, 'Antiparticles'),
        'standard_model_multiplet': NAMES[key]})
TOWER = [('walk_uniform_blank', 'uniform load, blank record', '1', 1, '+', 0.0, '1 (in the stationary space of dimension 38)'),
         ('walk_slow_triplet', 'slow triplet: blank 3, recorded 3\'', "3 and 3'", 3, '-', None, '12 = 2 triplets x rotation plane'),
         ('walk_quintet_recorded', 'quintet, recorded', '5', 5, '+', None, '10'),
         ('walk_quintet_blank', 'quintet, blank', '5', 5, '+', None, '10'),
         ('walk_fast_triplet', "fast triplet: blank 3', recorded 3", "3' and 3", 3, '-', None, '12'),
         ('walk_uniform_recorded', 'uniform load, recorded', '1', 1, '+', None, '2')]
osc = {r['sector']: r for r in SW['oscillatory']}
ANG = {'walk_slow_triplet': osc['slow triplet, blank']['rest_phase'], 'walk_quintet_recorded': osc['quintet, recorded']['rest_phase'],
       'walk_quintet_blank': osc['quintet, blank']['rest_phase'], 'walk_fast_triplet': osc['fast triplet, blank']['rest_phase'],
       'walk_uniform_recorded': osc['uniform, recorded']['rest_phase'], 'walk_uniform_blank': 0.0}
assert osc['slow triplet, blank']['rest_phase'] == osc['slow triplet, recorded']['rest_phase']
assert osc['fast triplet, blank']['rest_phase'] == osc['fast triplet, recorded']['rest_phase']
for tid, name, irrep, d, parity, _, dims in TOWER:
    rows.append({'id': tid, 'type': 'matter-like (internal sector of a quantum on its carrier)', 'name': name,
                 'labels': {'rotation_irrep': irrep, 'antipodal_parity': parity, 'rest_phase_per_tick': ANG[tid]},
                 'multiplet_dimension': d, 'walk_dimensions': dims,
                 'gauge': 'none of its own: the sector multiplies the pattern of the quantum',
                 'spin_candidates': ['integer content only: ' + irrep],
                 'travels': {'CF1_routing': 'as a Dirac species with this mass angle under option M3 (declared: the shift is controlled by the address reflection; KD)'
                             if ANG[tid] else 'massless under option M3 (KD)',
                             'one_carrier_public_walk': 'no'},
                 'stable': 'exact invariant sector of the public walk with flat links',
                 'protected_by': 'rotation symmetry of the carrier and the spectral decomposition of W',
                 'created_or_destroyed_by': 'a link sign changes the sectors of the spinor levels (rest phases of CF-1 item 6)',
                 'map_row': None, 'standard_model_multiplet': None})
rows += [
 {'id': 'z2_flux_pair', 'type': 'field-like', 'name': 'Z2 face-flux pair of a carrier (the regional flux of the audit)',
  'labels': {'face_pair': '190 positions', 'separation_classes': LR['pairs_by_separation'], 'regional_parity': 'with a held boundary',
             'gauge_copies_per_position': LR['gauge_copies_per_flux_pattern']},
  'multiplet_dimension': 190, 'gauge': 'neutral: annihilated by all twelve port responses and by the native currents (R2 result 3; audit field_identity_audit)',
  'seen_by': 'patterns with n2 = 1 (sign -1 around it); invisible to the others',
  'spin_candidates': [f"integer content only: {content_str(LR['rotation_content_of_the_190_pairs'])}",
                      f"no spinor pointer: the frame half-turns commute on the pairs, {klein['trivial']} trivial and {klein['each_sign']} of each sign character (R2 result 1)"],
  'travels': {'CF1_routing': 'no: static in CF-1 as defined; with a declared code-moving gate on four body-diagonal lines without a cone (R2)',
              'one_carrier': 'inside a region, when a wave of any level occupies an endpoint of the seam (audit joint program) or addresses the seam (work/JOIN); only waves on spinor levels are changed by it',
              'audit_mobile_flux': 'a complete inside and exterior pair is moved between cells by a declared exchange'},
  'stable': 'number of defects kept by the permitted moves; the parity of a region is protected only with its boundary held; one boundary link flip erases the pair',
  'protected_by': 'regional parity with a held boundary; Gauss sign of the region',
  'created_or_destroyed_by': 'one link flip creates, moves or removes an adjacent pair; the idle tick only moves',
  'map_row': 'defect class 3 of the universe runs: weak-centre flux', 'standard_model_multiplet': None},
 {'id': 'z2_plaquette_flux', 'type': 'field-like', 'name': 'Z2 flux through a plaquette of the cubic lattice of carriers',
  'labels': {'independent_fluxes_on_a_periodic_patch_of_N_carriers': '2 N - 2', 'torus_holonomies': 3},
  'multiplet_dimension': None, 'gauge': 'neutral', 'seen_by': 'patterns with n2 = 1',
  'spin_candidates': ['none: a closed line of plaquettes, no pointer (R2)'],
  'travels': {'CF1_routing': 'no (R2)'}, 'stable': 'static at eps = 0; at eps > 0 no flux label is conserved (R2 result 7d)',
  'protected_by': 'nothing at eps > 0', 'created_or_destroyed_by': 'one link flip makes a closed line of four plaquettes',
  'map_row': None, 'standard_model_multiplet': None},
 {'id': 'port_responses', 'type': 'field-like (operators, no excitation)', 'name': 'the twelve port responses on the five levels',
  'labels': {'algebra': '8 + 3 + 1', 'sum': 'the internal charge'}, 'multiplet_dimension': 12,
  'gauge': 'adjoint 8, adjoint 3 and the centre', 'spin_candidates': ['none: no travelling state'],
  'travels': {'CF1_routing': 'no: the only link field of the working law is Z2'}, 'stable': 'not applicable',
  'protected_by': 'carrier symmetry', 'created_or_destroyed_by': 'not applicable',
  'map_row': 'Gluons (8), W (3), B (1); Photon and Z', 'standard_model_multiplet': 'gauge bosons, at the level of the algebra only'},
 {'id': 'neutral_spinor_toggle', 'type': 'field-like (operator, no excitation)', 'name': 'toggle of the neutral spinor level (option M2)',
  'labels': {'changes': 'n2 by one'}, 'multiplet_dimension': 2, 'gauge': '(1, 2, 1/2) as the multiplet of the two spinor levels',
  'spin_candidates': ['none: no travelling state'], 'travels': {'CF1_routing': 'no'},
  'stable': 'breaks the Gauss constraint: the commutator with G_x has norm 2 |sin theta| (R7)', 'protected_by': 'nothing',
  'created_or_destroyed_by': 'declared', 'map_row': 'Higgs', 'standard_model_multiplet': 'Higgs doublet, at representation level only'},
 {'id': 'z3_colour_centre_flux', 'type': 'field-like', 'name': 'colour-centre flux (classes 2 and 4 of the universe runs)',
  'labels': {'status': 'not an object of the working law: its link register is Z2'}, 'multiplet_dimension': None, 'gauge': 'neutral',
  'seen_by': 'patterns with n3 = 1 or 2 (under the declared Z6 reading)', 'spin_candidates': [],
  'travels': {'CF1_routing': 'no register'}, 'stable': 'no register; as a static link phase it enters the public walk and M1 (CF-1 item 6, alpha = 1/3)',
  'protected_by': 'nothing in the working law', 'created_or_destroyed_by': 'a declared Z6 or Z3 link alphabet would be needed',
  'map_row': 'defect classes 2 and 4: colour-centre flux', 'standard_model_multiplet': None},
 {'id': 'z6_generating_flux', 'type': 'field-like', 'name': 'generating centre flux (classes 1 and 5 of the universe runs)',
  'labels': {'status': 'not an object of the working law; its reduction modulo 2 is z2_flux_pair'}, 'multiplet_dimension': None,
  'gauge': 'neutral', 'seen_by': 'every pattern with Q6 nonzero modulo 6 (under the declared Z6 reading)', 'spin_candidates': [],
  'travels': {'CF1_routing': 'no register'}, 'stable': 'no register', 'protected_by': 'nothing in the working law',
  'created_or_destroyed_by': 'a declared Z6 link alphabet would be needed',
  'map_row': 'defect classes 1 and 5: the generating flux', 'standard_model_multiplet': None},
 {'id': 'quantum_carrying_z2_pair', 'type': 'composite', 'name': 'a quantum on a carrier that holds a Z2 flux pair',
  'labels': {'pattern': 'of the quantum', 'pair_label': 'separation class 1 to 5'}, 'multiplet_dimension': 'that of the pattern',
  'gauge': 'the charges of the quantum', 'spin_candidates': ['as the quantum'],
  'travels': {'CF1_routing': 'yes with one added declared gate (the seam reflector conjugated by a swap of the two link codes); R2 result 5c'},
  'stable': 'pattern and pair label kept in the one-composite sector (R2)',
  'protected_by': 'charges of the quantum and the pair label',
  'rest_phase_M1_by_separation': {'patterns with n2 = 1': {str(d): Z2PH[d] for d in range(1, 6)}, 'patterns with n2 even': 0.0},
  'created_or_destroyed_by': 'declared preparation', 'map_row': None, 'standard_model_multiplet': None},
 {'id': 'mobile_flux_pair', 'type': 'composite', 'name': 'complete inside and exterior flux pair moved between cells (audit mobile_flux)',
  'labels': {'regional_parity': 'moves with the object'}, 'multiplet_dimension': 5, 'gauge': 'neutral singlet under the native currents (audit)',
  'spin_candidates': ['declared two-lane coin of the audit; no rotation of the carrier acts on the five-position code (R2 result 2)'],
  'travels': {'audit_two_lane_route': 'yes, one object, rest-frequency magnitude two in source units', 'CF1_routing': 'no'},
  'stable': 'total number of pairs kept by the idle update', 'protected_by': 'pair number under gates that move whole codes',
  'created_or_destroyed_by': 'a declared reversible preparation', 'map_row': None, 'standard_model_multiplet': None},
 {'id': 'neutral_composites_of_patterns', 'type': 'composite', 'name': 'neutral composites listed by the audit (weak-pair trion, colour-singlet trion, colour determinant with singlet hole)',
  'labels': {'total_Q6': 0, 'source': 'primary Wilson source of the audit, a different tuple'}, 'multiplet_dimension': None,
  'gauge': 'colour singlet, weak singlet, Q6 = 0', 'spin_candidates': ['cube irreps of the audit source: G1 + H (trions), E + T1 + T2 (determinant)'],
  'travels': {'CF1_routing': 'no rule for two quanta in one cell'}, 'stable': 'no binding in the working law',
  'protected_by': 'total pattern only', 'created_or_destroyed_by': 'not defined', 'map_row': None,
  'standard_model_multiplet': 'neutron-type and sterile-type comparisons of the audit; none identified'}]

R4 = json.load(open(os.path.join(RL, 'work/R4/item6_chirality.json')))
wz = R4['weyl_points_over_the_zone']['forward, chi=+1']; hw = R4['ordered_massive_tick_near_half_way_point'][0]
for chi in (1, -1):
    cz = R4['weyl_points_over_the_zone'][f'forward, chi={chi:+d}']['classes']
    assert all(cz[f'corner | phase {ph}']['sign_det_J'] == [chi] and cz[f'half-way point | phase {ph}']['sign_det_J'] == [-chi] for ph in ('0', 'pi'))
rows.append(
 {'id': 'mirror_cone', 'type': 'matter-like (copy in momentum space)', 'name': 'the cones of a pattern away from zero momentum',
  'labels': {'ordered_tick_cones_per_arrow_sector_over_the_zone': wz['points'], 'by_phase_and_winding': wz['counts'],
             'corner_cones_winding': 'equal to the arrow label', 'half_way_cones_winding': 'opposite to the arrow label'},
  'multiplet_dimension': 'that of the pattern', 'gauge': 'the charges of the pattern',
  'spin_candidates': ['as the quantum; opposite handedness at the half-way points'],
  'travels': {'CF1_routing': 'yes'},
  'stable': (f"half-way cones stay closed under the declared mass step of the ordered tick: smallest phase {hw['smallest_phase']:.6f} at |q| = {hw['|q|']} "
             f"against cos(theta) |q| = {hw['cos(theta)|q|']:.6f} (work/R4/item6_chirality.json)"),
  'protected_by': 'zero signed sum of the windings in each arrow sector (reports/R4.md C2, C3)',
  'created_or_destroyed_by': 'a preparation restricted to small momentum excludes them; no step of CF-1 gaps them',
  'map_row': None, 'standard_model_multiplet': None})

labels_one_carrier = [
 {'label': 'internal charge', 'group_and_values': 'U(1): +2 on a vector level, -3 on a spinor level; on patterns Q6 = 3 n2 - 2 n3 is the lifted public charge with the sign reversed',
  'operator': 'Q5 = diag(2, 2, 2, -3, -3) on the code',
  'commutes_with_tick': 'EXACT: model/coherent_seam_repair/gauge_walk.py (any block-unitary link); executed test_model.py::test_complex_mixed_charge_state_preserves_norm_inverse_and_charges',
  'sector_dimensions': 'one quantum: 4,320 and 2,880 of 7,200', 'rotation_cover': 'vector 3 on the three levels, spinor 2\' on the two',
  'port_responses': 'Q5 is the sum of the twelve responses and commutes with each', 'created_or_destroyed_by': 'nothing in the tick'},
 {'label': 'pattern (n3, n2)', 'group_and_values': 'U(3) x U(2), the commutant of the central links on the code; twelve patterns, 32 states',
  'operator': 'occupations N3 and N2 of the vector and spinor levels',
  'commutes_with_tick': 'EXACT: every level projector commutes with the public reflector of a central link (here); executed witness: the same test keeps the norm of every level; occupation lift: species/test_species.py (N and Q5)',
  'sector_dimensions': ', '.join(str(r['states']) for r in PT['rows']),
  'rotation_cover': 'content ' + ', '.join(content_str(r['cover_content_of_internal_factor']) for r in PT['rows']) + '; a full turn is (-1)^n2',
  'port_responses': 'colour and weak multiplet of the pattern (candidate rows)',
  'created_or_destroyed_by': 'declared preparation; the declared toggle M2',
  'note': 'With flat links the tick commutes with U(5) on the code and the multiplets are 1, 5, 10, 10, 5, 1 by N. The split of the five levels into three and two is made by the link sign diag(1, 1, 1, -1, -1) alone: the exchange of a vector level with a spinor level commutes with the flat public reflector and not with the reflector of a central link (exact, here).'},
 {'label': 'link word up to gauge', 'group_and_values': f"Z2^19: {LR['flux_patterns']:,} flux patterns, {LR['gauge_copies_per_flux_pattern']:,} gauge copies each; 190 pairs in separation classes 30, 60, 60, 30, 10",
  'operator': 'face sign = product of the three link signs of a face',
  'commutes_with_tick': 'static-link walk: the register is untouched; joint tick: defects move, their number is kept (audit PROOF.md)',
  'sector_dimensions': '7,200 wave dimensions per link word',
  'rotation_cover': f"faces permuted: 20 faces = {content_str(LR['rotation_content_of_the_20_faces'])}; 190 pairs = {content_str(LR['rotation_content_of_the_190_pairs'])}; integer content; the frame half-turns commute (R2)",
  'port_responses': 'annihilated by all twelve (R2, audit)', 'created_or_destroyed_by': 'one link flip creates, moves or removes an adjacent pair'},
 {'label': 'regional parity with a held boundary', 'group_and_values': 'Z2', 'operator': 'sum of the face bits of a region = sum of its boundary link bits',
  'commutes_with_tick': 'EXACT: python -m model.coherent_seam_repair.protection --check (executed, PASS); test_protection.py (12 passed)',
  'sector_dimensions': 'audit sector: ten link words (five positions, two gauge copies), 72,000 with the wave',
  'rotation_cover': 'none: 0 of 59 rotations keep the five-position code (R2 result 2)', 'port_responses': 'annihilated',
  'created_or_destroyed_by': 'a flip of a boundary link erases the pair (audit counterexample)'},
 {'label': 'interior Gauss sign', 'group_and_values': 'Z2', 'operator': 'star of a port on the links times -1 on the spinor levels at that port',
  'commutes_with_tick': 'EXACT: audit GAUSS.md; test_gauss.py (4 passed, executed)', 'sector_dimensions': '36,000 and 36,000',
  'rotation_cover': 'not applicable', 'port_responses': 'commutes (central)', 'created_or_destroyed_by': 'nothing in the tick'},
 {'label': 'rotations and inversion of the carrier', 'group_and_values': '60 rotations (cover of order 120) and the antipodal map',
  'operator': 'permutation of ports and addresses',
  'commutes_with_tick': 'EXACT here: 60 W commutes with all 120 symmetries in integers',
  'sector_dimensions': f"1,440 = {content_str(SW['rotation_content_total'])}",
  'rotation_cover': 'integer content on the scalar walk', 'port_responses': 'trivial: the walk register is blind to the code',
