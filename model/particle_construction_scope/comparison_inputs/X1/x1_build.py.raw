fa = F['arrow_state_X_r']; fs = F['sublattice_classes']; fh = F['frame_half_turns_on_the_pointer']; ft = F['translations']
sub_max = max(fs['max_commutator_with_tick (mass Y, mass Z with links, reverse order)'].values())
ht_max = max(fh['max_commutator_with_tick'].values())
wp = F['cited']['weyl_points_over_the_zone']['forward, chi=+1']
labels_family = [
