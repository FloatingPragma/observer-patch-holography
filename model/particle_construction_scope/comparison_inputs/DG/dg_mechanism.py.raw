"""DG, step 2: which native number forbids the pairing of the neutral singlet, and whether the source conserves it.
Exact (integers and rationals, sympy). Chart of work/MAP and T6: levels (v1, v2, v3, s1, s2); 6Y = 3 n2 - 2 n3;
T3 = +1/2 on s1, -1/2 on s2; Q = n_s1 - n3/3; left-handed = even occupation; the conjugate of a pattern is its
complement.

Computed here:
  A  the diagonal charges linear in the five level numbers (q = a + sum_j b_j n_j) that are odd under the
     conjugation (q(complement) = -q): the five centred level numbers; inside them B - L = 1 - (2/3) n3 is the one
     direction that is no gauge charge. The native degree n and the number of quanta are even and do not descend
     to the one-family theory; X = 2 n - 5 does, and X = -5 (B - L) + 4 Y.
  B  B - L against every operator of the source on the 32 patterns: the twelve responses, the five level numbers,
     the toggle (restricted to each species block), the ten mass links of T6, and the 45 bilinears of the level
     operators. [B - L, O] = w O with w printed.
  C  the conserved combinations of (number of quanta, native degree, Higgs number) for the vertex sets
     {four Dirac channels} and {four Dirac channels, singlet pairing}, exact.
  D  anomaly sums of B - L on the sixteen and on the fifteen left fields.
  E  Z6 class of the four neutral patterns; which class-0 fields can pair with themselves.

    python dg_mechanism.py [out.json]
"""
import itertools, json, sys
from fractions import Fraction as F
import sympy as sp

LEVELS = ('v1', 'v2', 'v3', 's1', 's2')
N = 5
states = list(itertools.product((0, 1), repeat=N))
index = {s: i for i, s in enumerate(states)}
DIM = 32
comp = lambda s: tuple(1 - x for x in s)


def annihilate(k):
    A = sp.zeros(DIM, DIM)
    for s in states:
        if s[k]:
            t = list(s); t[k] = 0
            A[index[tuple(t)], index[s]] = (-1) ** sum(s[:k])
    return A


a = [annihilate(k) for k in range(N)]
ad = [x.T for x in a]
num = [ad[k] * a[k] for k in range(N)]
comm = lambda A, B: A * B - B * A


def weight(O, G):
    C = comm(G, O)
    nz = [(i, j) for i in range(O.rows) for j in range(O.cols) if O[i, j] != 0]
    if not nz:
        return None
    w = sp.nsimplify(C[nz[0]] / O[nz[0]])
    return w if (C - w * O).is_zero_matrix else None


n3 = lambda s: sum(s[:3])
n2 = lambda s: s[3] + s[4]
deg = lambda s: sum(s)
Y = lambda s: F(3 * n2(s) - 2 * n3(s), 6)
T3 = lambda s: (F(1, 2) if (s[3], s[4]) == (1, 0) else F(-1, 2) if (s[3], s[4]) == (0, 1) else F(0))
Q = lambda s: s[3] - F(n3(s), 3)
BL = lambda s: 1 - F(2, 3) * n3(s)
X = lambda s: 2 * deg(s) - 5
assert all(Q(s) == T3(s) + Y(s) for s in states)
out = {'convention': 'levels (v1, v2, v3, s1, s2); 6Y = 3 n2 - 2 n3; T3 = +1/2 on s1, -1/2 on s2; Q = n_s1 - n3/3; '
                     'left = even occupation; conjugate = complement'}

# ---------------------------------------------------------------------------------------------------- A
# q(s) = a + sum_j b_j n_j(s); odd under the complement iff 2a + sum_j b_j = 0
aa, bb = sp.symbols('a'), sp.symbols('b0:5')
qexpr = lambda s: aa + sum(bb[j] * s[j] for j in range(N))
odd_conditions = {sp.expand(qexpr(s) + qexpr(comp(s))) for s in states}
odd_conditions.discard(0)
sol = sp.solve(list(odd_conditions), aa, dict=True)
assert sol == [{aa: -sum(bb) / 2}]
charges = {
    'number of quanta N': lambda s: F(1),
    'native degree n (sum of the five level numbers)': lambda s: F(deg(s)),
    'vector-level number n3': lambda s: F(n3(s)),
    'hypercharge Y': Y, 'weak isospin T3': T3, 'electric charge Q': Q,
    'B - L = 1 - (2/3) n3': BL, 'X = 2 n - 5': lambda s: F(X(s)),
    'colour Cartan n_v1 - n_v2': lambda s: F(s[0] - s[1]),
}
oddness = {k: all(f(comp(s)) == -f(s) for s in states) for k, f in charges.items()}
assert oddness == {'number of quanta N': False, 'native degree n (sum of the five level numbers)': False,
                   'vector-level number n3': False, 'hypercharge Y': True, 'weak isospin T3': True,
                   'electric charge Q': True, 'B - L = 1 - (2/3) n3': True, 'X = 2 n - 5': True,
                   'colour Cartan n_v1 - n_v2': True}
# X = -5 (B - L) + 4 Y on all 32 patterns; B - L = N - (2/5) n + (4/5) Y per quantum
assert all(X(s) == -5 * BL(s) + 4 * Y(s) for s in states)
assert all(BL(s) == 1 - F(2, 5) * deg(s) + F(4, 5) * Y(s) for s in states)
# the odd space is five-dimensional (centred level numbers n_j - 1/2); the gauge Cartans span four of it:
cent = lambda j: (lambda s: s[j] - F(1, 2))
gauge4 = [lambda s: F(s[0] - s[1]), lambda s: F(s[1] - s[2]), T3, Y]
M = sp.Matrix([[g(s) for g in gauge4] + [BL(s)] for s in states])
Mc = sp.Matrix([[cent(j)(s) for j in range(N)] for s in states])
assert M.rank() == 5 and Mc.rank() == 5 and sp.Matrix.hstack(M, Mc).rank() == 5
out['A_charges_that_survive_the_one_family_identification'] = {
    'odd_condition': 'q = a + sum_j b_j n_j is odd under the complement iff a = -(1/2) sum_j b_j: the space is spanned by the '
                     'five centred level numbers n_j - 1/2',
    'oddness': oddness,
    'identities': ['X = 2 n - 5 = -5 (B - L) + 4 Y on all 32 patterns',
                   'B - L = 1 - (2/3) n3 = N - (2/5) n + (4/5) Y per quantum'],
    'statement': 'The diagonal charges that descend to one family (complements as holes) are the five centred level numbers. '
                 'Four of them are gauge Cartans (two of colour, T3, Y); the fifth independent one is B - L. The native '
                 'degree n and the number of quanta N are even under the complement and do not descend separately; their odd '
                 'combination X = 2 n - 5 N does, and X = -5 (B - L) + 4 Y.'}

# ---------------------------------------------------------------------------------------------------- B
BLop = sp.diag(*[BL(s) for s in states])
Nv = num[0] + num[1] + num[2]
Ns = num[3] + num[4]
Y6 = 3 * Ns - 2 * Nv
T3x2 = num[3] - num[4]
Q3 = 3 * num[3] - Nv
colour = [ad[i] * a[j] for i in range(3) for j in range(3) if i != j] + [num[0] - num[1], num[1] - num[2]]
twelve = colour + [ad[3] * a[4], ad[4] * a[3], T3x2, Y6]
assert all(comm(BLop, G).is_zero_matrix for G in twelve)
assert all(comm(BLop, n).is_zero_matrix for n in num)
parity = sp.diag(*[(-1) ** sum(s) for s in states])
PL = (sp.eye(DIM) + parity) / 2
toggle = a[4] + ad[4]
assert comm(BLop, toggle).is_zero_matrix


def proj(n3v, ns1):
    return sp.diag(*[1 if (sum(s[:3]) == n3v and s[3] == ns1) else 0 for s in states])


def unit(b, c):
    E = sp.zeros(DIM, DIM); E[b, c] = 1
    return E


species = {(1, 0): 'd', (1, 1): 'u', (3, 0): 'e', (3, 1): 'nu', (2, 1): 'd-bar', (2, 0): 'u-bar', (0, 1): 'e-bar', (0, 0): 'nu-bar'}
links = []
for (n3v, ns1), nm in species.items():
    links.append((f'toggle on {nm}', PL * proj(n3v, ns1) * toggle * proj(n3v, ns1) * (sp.eye(DIM) - PL)))
full, empty = index[(1, 1, 1, 1, 1)], index[(0, 0, 0, 0, 0)]
nuL, nuLc = index[(1, 1, 1, 1, 0)], index[(0, 0, 0, 0, 1)]
links.append(('singlet link |00000><11111| (top form)', unit(empty, full)))
links.append(('doublet link |11110><00001|', unit(nuL, nuLc)))
rowsB = []
for nm, O in links:
    w = weight(O, BLop)
    rowsB.append({'operator': nm, 'B_minus_L_carried': str(w),
                  'conserves_colour_and_charge': all(comm(G, O).is_zero_matrix for G in colour + [Q3])})
assert [r['B_minus_L_carried'] for r in rowsB] == ['0'] * 8 + ['2', '-2']
bil = []
for i, j in itertools.combinations(range(N), 2):
    bil.append((f'a_{LEVELS[i]} a_{LEVELS[j]}', a[i] * a[j]))
    bil.append((f'a*_{LEVELS[i]} a*_{LEVELS[j]}', ad[i] * ad[j]))
for i in range(N):
    for j in range(N):
        bil.append((f'a*_{LEVELS[i]} a_{LEVELS[j]}', ad[i] * a[j]))
bil_rows = {}
for nm, O in bil:
    w = weight(O, BLop)
    cc = all(comm(G, O).is_zero_matrix for G in colour + [Q3])
    bil_rows.setdefault(str(w), []).append(nm + (' (conserves colour and charge)' if cc else ''))
out['B_B_minus_L_against_the_operators_of_the_source'] = {
    'B_minus_L_operator': 'diag(1 - (2/3) n3) on the 32 patterns',
    'commutes_with': ['the twelve responses', 'the five level numbers', 'the toggle a_s2 + a*_s2 (mass option M2)'],
    'untouched_by_construction': ['routing S_fwd, S_rev (the pattern is a passive label)', 'mass options M0, M1, M3 (record and '
                                  'carrier sector only)', 'field step (links only)', 'native tick (-1)^n (diagonal)'],
    'ten_mass_links': rowsB,
    'bilinears_of_the_level_operators_by_B_minus_L': bil_rows,
    'statement': 'Every operator of the source on the patterns commutes with B - L = 1 - (2/3) n3. Among the ten colour- and '
                 'charge-conserving mass links the eight toggles carry B - L = 0; the singlet link (top form) and the doublet link '
                 'carry B - L = +-2. Among the 45 bilinears of the level operators the ones that change B - L move vector levels '
                 '(a_v a_v: 4/3, a_v a_s: 2/3, a*_v a_s: -2/3) and none of them conserves colour and charge.'}

# ---------------------------------------------------------------------------------------------------- C
# left fields of one family with (number of quanta 1, native degree n): Q, u^c, e^c (n = 2), d^c, L (n = 4), N^c (n = 0).
# A vertex sum over (pair of left fields) + (H or its conjugate). Unknown charge q = alpha N + beta n per field, h for H.
even = [s for s in states if sum(s) % 2 == 0]
mult = {}
for s in even:
    key = {(1, 1): 'Q', (2, 0): 'u^c', (0, 2): 'e^c', (2, 2): 'd^c', (3, 1): 'L', (0, 0): 'N^c'}[(n3(s), n2(s))]
    mult.setdefault(key, set()).add(deg(s))
assert all(len(v) == 1 for v in mult.values())
D = {k: next(iter(v)) for k, v in mult.items()}
assert D == {'Q': 2, 'u^c': 2, 'e^c': 2, 'd^c': 4, 'L': 4, 'N^c': 0}
Ym = {'Q': F(1, 6), 'u^c': F(-2, 3), 'e^c': F(1), 'd^c': F(1, 3), 'L': F(-1, 2), 'N^c': F(0)}
dirac = [('up', 'Q', 'u^c', +1), ('down', 'Q', 'd^c', -1), ('lepton', 'L', 'e^c', -1), ('neutrino', 'L', 'N^c', +1)]
for nm, f1, f2, sgn in dirac:          # hypercharge balance fixes H (Y = +1/2) or its conjugate
    assert Ym[f1] + Ym[f2] + sgn * F(1, 2) == 0
al, be, h = sp.symbols('alpha beta h')
eq_dirac = [2 * al + be * (D[f1] + D[f2]) + sgn * h for _, f1, f2, sgn in dirac]
eq_major = [2 * al + be * 2 * D['N^c']]
ker_d = sp.Matrix([[sp.diff(e, x) for x in (al, be, h)] for e in eq_dirac]).nullspace()
ker_dm = sp.Matrix([[sp.diff(e, x) for x in (al, be, h)] for e in eq_dirac + eq_major]).nullspace()
assert len(ker_d) == 1 and len(ker_dm) == 0
kd = ker_d[0] / ker_d[0][1]
assert list(kd) == [sp.Rational(-5, 2), 1, 1]
# the surviving combination is X/2 = n - (5/2) N, odd under the complement; per left field it equals -(5/2)(B - L) + 2 Y
BLm = {'Q': F(1, 3), 'u^c': F(-1, 3), 'e^c': F(1), 'd^c': F(-1, 3), 'L': F(-1), 'N^c': F(1)}
assert all(D[k] - F(5, 2) == -F(5, 2) * BLm[k] + 2 * Ym[k] for k in D)
out['C_conserved_combinations_of_the_native_numbers'] = {
    'left_fields': {k: {'native_degree': D[k], 'Y': str(Ym[k]), 'B_minus_L': str(BLm[k])} for k in D},
    'unknown': 'q = alpha N + beta n on each left field, h on the Higgs doublet (its conjugate carries -h)',
    'four_Dirac_channels': {'equations': [str(e) + ' = 0' for e in eq_dirac], 'kernel': [str(x) for x in kd],
                            'reading': 'one combination survives: (alpha, beta, h) = (-5/2, 1, 1), that is X/2 = n - (5/2) N with '
                                       'the Higgs carrying 1; per left field X/2 = -(5/2)(B - L) + 2 Y. N and n separately are broken.'},
    'four_Dirac_channels_and_the_singlet_pairing': {'equations': [str(e) + ' = 0' for e in eq_dirac + eq_major], 'kernel_dimension': 0,
                                                    'reading': 'nothing survives: the pairing breaks X (B - L) by 10 (2)'},
    'statement': 'A Dirac sector with one Higgs doublet breaks the number of quanta and the native degree separately and keeps '
                 'exactly their odd combination, which is B - L up to hypercharge. The singlet pairing is the one mass term that '
                 'breaks it. No gauge current distinguishes the two cases.'}

# ---------------------------------------------------------------------------------------------------- D
mults = {'Q': (6, 3, 2), 'u^c': (3, 3, 1), 'e^c': (1, 1, 1), 'd^c': (3, 3, 1), 'L': (2, 1, 2), 'N^c': (1, 1, 1)}  # (states, colour dim, weak dim)


def anomalies(fields):
    s = lambda f: sum(mults[k][0] * f(k) for k in fields)
    return {
        'sum (B-L)  [gravitational]': str(s(lambda k: BLm[k])),
        'sum (B-L)^3': str(s(lambda k: BLm[k] ** 3)),
        'sum (B-L)^2 Y': str(s(lambda k: BLm[k] ** 2 * Ym[k])),
        'sum (B-L) Y^2': str(s(lambda k: BLm[k] * Ym[k] ** 2)),
        'SU(2)^2 (B-L) (doublets)': str(sum(mults[k][1] * BLm[k] for k in fields if mults[k][2] == 2)),
        'SU(3)^2 (B-L) (triplets and antitriplets)': str(sum(mults[k][2] * BLm[k] for k in fields if mults[k][1] == 3)),
    }


an16 = anomalies(list(mults))
an15 = anomalies([k for k in mults if k != 'N^c'])
assert all(v == '0' for v in an16.values())
assert an15['sum (B-L)  [gravitational]'] == '-1' and an15['sum (B-L)^3'] == '-1'
out['D_anomalies_of_B_minus_L'] = {'sixteen_left_fields': an16, 'fifteen_left_fields (the audit module)': an15,
                                   'statement': 'B - L is free of every anomaly on the full even module of sixteen states and has '
                                                'gravitational and cubic anomaly -1 per family on the fifteen-state module.'}

# ---------------------------------------------------------------------------------------------------- E
k6 = lambda s: (3 * (n2(s) % 2) - 2 * (n3(s) % 3)) % 6
neutral = {'11110 nu_L': (1, 1, 1, 1, 0), '11111 N': (1, 1, 1, 1, 1), '00000 N^c': (0, 0, 0, 0, 0), '00001 nu_L^c': (0, 0, 0, 0, 1)}
class0 = [''.join(map(str, s)) for s in states if k6(s) == 0]
self_pair = [''.join(map(str, s)) for s in even if k6(s) == 0 and Q(s) == 0 and Y(s) == 0 and T3(s) == 0 and n3(s) % 3 == 0]
out['E_class_zero'] = {'Z6_class_of_the_neutral_patterns': {k: k6(s) for k, s in neutral.items()},
                       'class_zero_patterns': class0,
                       'left_class_zero_fields_with_all_gauge_charges_zero': self_pair,
                       'statement': 'Class 0 is its own conjugate, so the Z6 label never forbids a self-pairing. Among the '
                                    'left class-0 fields only N^c = 00000 carries no gauge charge (e^c = 00011 is class 0 with '
                                    'Q = +1); its self-pairing is limited by B - L alone.'}
assert self_pair == ['00000']

print(json.dumps(out, indent=1, default=str))
if len(sys.argv) > 1:
    json.dump(out, open(sys.argv[1], 'w'), indent=1, default=str)
