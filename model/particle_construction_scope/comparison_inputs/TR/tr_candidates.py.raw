"""Worker TR: values of the candidates registered in CANDIDATES.md section 3 (and the two post hoc rows), from the
exact structure in tr_exact.json. Reads no measured value; the comparison is tr_compare.py.

Mass readout inputs (source branch at P_fwd, as in work/LS/ls_candidates.py, copied): LEW t1_chain.json (v, Q0,
mu_c, gauge couplings, y_t from double criticality), LS exact.json (lambda_k^2 of the native circulant at
delta = 2/9). Running: Standard Model one loop, the lepton Yukawas with the common factor of ls_candidates.py.
  cd /tmp && PYTHONDONTWRITEBYTECODE=1 /tmp/oph-completion-venv/bin/python -B \
      WORKSPACE/repair-law/work/TR/tr_candidates.py
"""
from __future__ import annotations

import json
import math
from fractions import Fraction
from pathlib import Path

HERE = Path(__file__).resolve().parent
RL = Path("WORKSPACE/repair-law")
EX = json.loads((HERE / "tr_exact.json").read_text())
CHAIN = json.loads((RL / "work/SIM/derive/lew/t1_chain.json").read_text())["pixels"]["P_fwd"]
LSX = json.loads((RL / "work/LS/exact.json").read_text())

E_STAR = 1.22089e19
c = CHAIN["chain"]
V = float(c["v_over_E"]) * E_STAR
Q0 = float(c["muZ_over_E"]) * E_STAR
MU_C = float(CHAIN["criticality"]["mu_c_GeV"])
G1, G2, G3 = float(c["g1_GUT"]), float(c["g2"]), float(c["g3"])
YT_Q0 = float(CHAIN["criticality"]["yt_Q0"])
YT_MUC = float(CHAIN["criticality"]["boundary_yt"])
LSQ = [float(x) for x in LSX["X1"]["lambda_sq_sorted"]]
LMAX2 = LSQ[2]
SQ2 = math.sqrt(2.0)
K = 1.0 / (16 * math.pi ** 2)


def rhs(y):
    g1, g2, g3, yt, lnyl = y
    return [K * (41.0 / 10.0) * g1 ** 3, K * (-19.0 / 6.0) * g2 ** 3, K * (-7.0) * g3 ** 3,
            K * yt * (4.5 * yt ** 2 - 8 * g3 ** 2 - 2.25 * g2 ** 2 - 0.85 * g1 ** 2),
            K * (3 * yt ** 2 - 2.25 * g2 ** 2 - 2.25 * g1 ** 2)]


def run(mu_to, n=6000):
    y = [G1, G2, G3, YT_Q0, 0.0]
    t0, t1 = math.log(Q0), math.log(mu_to)
    h = (t1 - t0) / n
    for _ in range(n):
        k1 = rhs(y)
        k2 = rhs([a + 0.5 * h * b for a, b in zip(y, k1)])
        k3 = rhs([a + 0.5 * h * b for a, b in zip(y, k2)])
        k4 = rhs([a + h * b for a, b in zip(y, k3)])
        y = [a + h / 6 * (b1 + 2 * b2 + 2 * b3 + b4) for a, b1, b2, b3, b4 in zip(y, k1, k2, k3, k4)]
    return y


DOWN_MUC = math.exp(-run(MU_C)[4])  # y_l(Q0) / y_l(mu_c)


def structure():
    rows = EX["X2_read_counts"]["rows"]
    per_d = {}
    for r in rows:
        d = r["d"]
        vals = {
            "n": int(r["n_min_flow"]),
            "u": int(r["uphill_def4_cap30"]),
            "nu": int(r["above_start_def4_cap30"]),
            "S_cost_units": int(r["action_def4_cap30"]),
            "B": int(r["bottleneck_def4_cap30"]),
            "U": int(r["uphill_cost_def4_cap30"]),
        }
        if d in per_d:
            assert per_d[d] == vals, (d, per_d[d], vals)  # both d = 3 orbits agree
        per_d[d] = vals
    nq = {int(r["d"]): int(r["n_q_min"]) for r in EX["X2_read_counts"]["quark_rows"]}
    n_adj = int(EX["X2_read_counts"]["adjacent_33_n_min"])
    weights = {int(d): Fraction(w) for d, w in EX["lasting_placements"]["weights"].items()}
    t3sum = Fraction(EX["X3_effective_class3_hop"]["isolated_face"]["sum"])
    assert EX["X3_effective_class3_hop"]["distinct_sums_with_partner"] == [str(t3sum)]
    assert EX["X1_superselection"]["lasting_33_all_proposals_raise_cost"] is True
    return per_d, nq, n_adj, weights, t3sum


def mean(weights, f):
    return sum(float(w) * f(d) for d, w in weights.items())


def readout(r):
    """Lepton junction scale and masses for a ratio r stated at mu_c (primary) and at Q0 (brief's reference)."""
    yj_muc = r * YT_MUC / LMAX2
    yj_q0_from_muc = yj_muc * DOWN_MUC
    yj_q0_direct = r * YT_Q0 / LMAX2
    m_muc = [V / SQ2 * yj_q0_from_muc * l for l in LSQ]
    m_q0 = [V / SQ2 * yj_q0_direct * l for l in LSQ]
    return {"yJe_mu_c": yj_muc, "yJe_Q0_run_from_mu_c": yj_q0_from_muc, "masses_GeV_stated_at_mu_c": m_muc,
            "yJe_Q0_stated_at_Q0": yj_q0_direct, "masses_GeV_stated_at_Q0": m_q0}


def main():
    per_d, nq, n_adj, w, t3sum = structure()
    p = Fraction(1, 12)
    kappa = 5
    cands = {}
    cands["A1"] = (math.exp(-(n_adj - nq[1])), f"e^-(n(1) - n_q(1)) = e^-({n_adj} - {nq[1]})")
    cands["A2"] = (mean(w, lambda d: math.exp(-(per_d[d]["n"] - nq[1]))), "< e^-(n(d) - n_q(1)) >")
    cands["A3"] = (mean(w, lambda d: math.exp(-(per_d[d]["n"] - nq[d]))), "< e^-(n(d) - n_q(d)) >")
    cands["A4"] = (mean(w, lambda d: math.exp(-per_d[d]["nu"])), "< e^-nu(d) >")
    cands["A5"] = (float(p ** (n_adj - nq[1])), f"p^(n(1) - n_q(1)) = (1/12)^{n_adj - nq[1]}")
    cands["A6"] = (mean(w, lambda d: float(p ** per_d[d]["nu"])), "< p^nu(d) >")
    cands["B1"] = (mean(w, lambda d: math.exp(-per_d[d]["S_cost_units"] / kappa)), "< e^-S(d) >, S in nats = cost units / kappa")
    cands["B2"] = (mean(w, lambda d: math.exp(-per_d[d]["B"] / kappa)), "< e^-(B(d)/kappa) >")
    # C: t3 = (t3sum) tau^3 / eps^2; ratio per hop t3/tau = t3sum tau^2 / eps^2
    eps = Fraction(1, kappa)
    x_c1 = t3sum * p / eps ** 2            # tau = sqrt(p): tau^2 = p
    x_c2 = t3sum * p ** 2 / eps ** 2       # tau = p
    cands["C1"] = (mean(w, lambda d: float(x_c1) ** (d - 1)), f"< (t3/tau)^(d-1) >, t3/tau = {x_c1} (tau = sqrt p, eps = 1/kappa)")
    cands["C2"] = (mean(w, lambda d: float(x_c2) ** (d - 1)), f"< (t3/tau)^(d-1) >, t3/tau = {x_c2} (tau = p, eps = 1/kappa)")
    # post hoc rows (no weight)
    det_rho = float(LSX["X1"]["det_rho"])
    post = {
        "PH-TR0": (det_rho ** (1.0 / 3.0), "(det C^2)^(1/3) (POST HOC coincidence)"),
        "PH-TR7": (mean(w, lambda d: math.exp(-(3 if d == 2 else 5))), "uphill cost units read as nats, as estimated before listing with the guess U = 3 (d = 2), 5 (d >= 3) (POST HOC)"),
        "PH-TR7x": (mean(w, lambda d: math.exp(-per_d[d]["U"])), "uphill cost units read as nats with the exact minimal total uphill cost U(d) (POST HOC)"),
    }
    rows = []
    est = {"A1", "A2", "A3", "A4", "A5", "A6", "B1", "B2", "C1", "C2"}
    for k, (r, note) in list(cands.items()) + list(post.items()):
        rows.append({"id": k, "r": r, "formula": note, "weight": "post hoc" if k.startswith("PH") else "structural",
                     "estimated_before_listing": (k in est) or k.startswith("PH"), **readout(r)})
    out = {
        "structure_used": {"per_d": per_d, "n_q": nq, "n_adjacent_33": n_adj,
                           "placement_weights": {d: str(x) for d, x in w.items()},
                           "t3_sum_inverse_denominators": str(t3sum), "p": str(p), "kappa": kappa,
                           "t3_over_tau": {"C1": str(x_c1), "C2": str(x_c2)}},
        "inputs": {"v_source_GeV": V, "Q0_GeV": Q0, "mu_c_GeV": MU_C, "yt_Q0": YT_Q0, "yt_mu_c": YT_MUC,
                   "lambda_sq_e_mu_tau": LSQ, "yl_Q0_over_yl_mu_c": DOWN_MUC, "measured_values_read": "none"},
        "rows": rows,
    }
    (HERE / "tr_candidates.json").write_text(json.dumps(out, indent=1) + "\n")
    print(json.dumps(out["structure_used"], indent=1))
    print(json.dumps(out["inputs"], indent=1))
    for r in rows:
        print(f"{r['id']:7s} r = {r['r']:.6g}   yJe(mu_c) = {r['yJe_mu_c']:.5g}  masses(stated mu_c) = "
              f"({r['masses_GeV_stated_at_mu_c'][0]:.4g}, {r['masses_GeV_stated_at_mu_c'][1]:.4g}, "
              f"{r['masses_GeV_stated_at_mu_c'][2]:.4g}) GeV   {r['formula']}")


if __name__ == "__main__":
    main()
