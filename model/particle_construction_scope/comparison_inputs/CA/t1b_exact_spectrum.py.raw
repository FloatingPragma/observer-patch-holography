"""Exact spectra of the one-quantum twisted transfers for the characters k = 1, 2, 7 (integer arithmetic in
Z[zeta_20]).  P_k = 1 - (5 - A_k)/60 with A_k[b, a] = zeta^(k theta(a -> b)) on the 30 seams.

For each k: the product (A_k - a_1)(A_k - a_2)(A_k - a_3) vanishes identically and the traces of A_k^0, A_k^1, A_k^2
equal sum m_i a_i^j, which fixes eigenvalues and multiplicities.  Usage: python t1b_exact_spectrum.py [out.json]
"""
import json
import sys
import numpy as np
import ca_core as c

out_path = sys.argv[1] if len(sys.argv) > 1 else 't1b_exact_spectrum.json'
ZETA = np.exp(2j * np.pi / 20)


def red(v):
    """integer polynomial in zeta (any length) -> 8 coefficients modulo Phi_20"""
    w = [0] * 10
    for i, x in enumerate(v):
        i %= 20
        if i < 10:
            w[i] += int(x)
        else:
            w[i - 10] -= int(x)
    a8, a9 = w[8], w[9]
    o = w[:8]
    o[6] += a8; o[4] -= a8; o[2] += a8; o[0] -= a8
    o[7] += a9; o[5] -= a9; o[3] += a9; o[1] -= a9
    return np.array(o, dtype=object)


def el(**powers):
    """element sum coeff * zeta^power, written as el(p0=1, p4=2, ...)"""
    v = [0] * 20
    for key, coeff in powers.items():
        v[int(key[1:]) % 20] += coeff
    return red(v)


def emul(x, y):
    v = [0] * 20
    for i in range(8):
        for j in range(8):
            v[(i + j) % 20] += int(x[i]) * int(y[j])
    return red(v)


def val(x):
    return complex(sum(int(x[i]) * ZETA ** i for i in range(8)))


def mat(k):
    A = np.zeros((12, 12, 8), dtype=object)
    for (a, b), (e, s) in c.SIDX.items():
        A[b, a] = el(**{'p%d' % ((k * s * int(c.THETA[e])) % 20): 1})
    return A


def mmul(A, B):
    out = np.zeros((12, 12, 8), dtype=object)
    for i in range(12):
        for j in range(12):
            acc = np.zeros(8, dtype=object)
            for t in range(12):
                if any(A[i, t]) and any(B[t, j]):
                    acc = acc + emul(A[i, t], B[t, j])
            out[i, j] = acc
    return out


def shift(A, x):
    out = A.copy()
    for i in range(12):
        out[i, i] = out[i, i] - x
    return out


def trace(A):
    return sum((A[i, i] for i in range(12)), np.zeros(8, dtype=object))


one = el(p0=1)
r5 = el(p0=1, p4=2, p16=2)                  # sqrt 5 = 1 + 2 (zeta^4 + zeta^-4)
g = el(p4=1, p16=1)                         # (sqrt5 - 1)/2
phi2 = el(p0=2, p4=1, p16=1)                # (3 + sqrt5)/2
iphi2 = el(p0=1, p4=-1, p16=-1)             # (3 - sqrt5)/2
c1 = el(p1=1, p19=1)                        # 2 cos(pi/10) = sqrt((5 + sqrt5)/2)
s3 = el(p3=1, p17=1)                        # 2 sin(pi/5)  = sqrt((5 - sqrt5)/2)
assert abs(val(r5) - 5 ** .5) < 1e-12 and abs(val(c1) - 2 * np.cos(np.pi / 10)) < 1e-12 and abs(val(s3) - 2 * np.sin(np.pi / 5)) < 1e-12
CASES = {
    1: ([emul(r5, c1), emul(iphi2, c1), -c1], [2, 4, 6],
        ['sqrt5 * 2cos(pi/10)', '((3 - sqrt5)/2) * 2cos(pi/10)', '-2cos(pi/10)']),
    2: ([el(p0=3, p4=1, p16=1), -iphi2, -r5], [3, 5, 4], ['(5 + sqrt5)/2', '-(3 - sqrt5)/2', '-sqrt5']),
    7: ([emul(r5, s3), s3, -emul(phi2, s3)], [2, 6, 4],
        ['sqrt5 * 2sin(pi/5)', '2sin(pi/5)', '-((3 + sqrt5)/2) * 2sin(pi/5)']),
}
res = {'schema': 'repair_law.CA.t1b.v1', 'cases': {}}
for k, (eigs, mult, names) in CASES.items():
    A = mat(k)
    prod = mmul(mmul(shift(A, eigs[0]), shift(A, eigs[1])), shift(A, eigs[2]))
    zero = not any(int(x) for x in prod.ravel())
    A2 = mmul(A, A)
    tr_ok = True
    for j, T in enumerate((None, A, A2)):
        lhs = np.array([12, 0, 0, 0, 0, 0, 0, 0], dtype=object) if T is None else trace(T)
        rhs = np.zeros(8, dtype=object)
        for a, m in zip(eigs, mult):
            p = one
            for _ in range(j):
                p = emul(p, a)
            rhs = rhs + m * p
        tr_ok &= all(int(x) == int(y) for x, y in zip(lhs, rhs))
    vals = [val(a).real for a in eigs]
    lam = [1 - (5 - v) / 60 for v in vals]
    assert zero and tr_ok and max(abs(val(a).imag) for a in eigs) < 1e-12 and vals[0] > vals[1] > vals[2]
    res['cases'][k] = {'eigenvalues_of_A': names, 'multiplicities': mult, 'numeric': vals,
                       'lambda1': lam[0], 'lambda2': lam[1], 'q': lam[1] / lam[0],
                       'minimal_polynomial_vanishes_exactly': zero, 'trace_identities_exact': tr_ok}
    print(f'k = {k}: A_k has eigenvalues {names} with multiplicities {mult} (exact in Z[zeta_20]); '
          f'lambda1 = (55 + a1)/60 = {lam[0]:.12f}, lambda2 = (55 + a2)/60 = {lam[1]:.12f}, q = {lam[1]/lam[0]:.12f}')
json.dump(res, open(out_path, 'w'), indent=1)
print('wrote', out_path)
