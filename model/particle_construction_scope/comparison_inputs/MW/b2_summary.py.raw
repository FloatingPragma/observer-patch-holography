"""Block 2: collect b2/fit_*.json into one table (b2_summary.json, b2_summary.md).
    python b2_summary.py"""
import glob, json, math, os, re
import numpy as np

rows = []
for f in sorted(glob.glob('b2/fit_*.json')):
    d = json.load(open(f))
    name = os.path.basename(f)[4:-5]
    sh = d['shells']; meta = d['meta']; info = d.get('run_info', [{}])
    k = np.array([s['k'] for s in sh])
    G = np.array([s['lor']['G'] for s in sh]); Gerr = np.array([s['lor']['G_rel_err'] for s in sh])
    daic = np.array([s['delta_aic_dho_minus_lor'] for s in sh]); Q = np.array([s['dho']['Q'] for s in sh])
    w0 = np.array([s['dho']['w0'] for s in sh]); gam = np.array([s['dho']['gamma'] for s in sh])
    prop = (daic < -10) & (Q > 0.5)
    row = {'name': name, 'rule': meta.get('rule'), 'geometry': meta.get('geometry'), 'filling': meta.get('filling'),
           'schedule': meta.get('schedule', 'n/a'), 'control': meta.get('control'), 'glue': meta.get('glue'), 'collide': meta.get('collide'),
           'runs': d['runs'], 'samples_per_run': d['samples_per_run'], 'every': meta.get('every'),
           'shell_labels': [s['label'] for s in sh], 'k': k.tolist(),
           'variance': [s['variance'] for s in sh],
           'lor_G': G.tolist(), 'lor_G_rel_err': Gerr.tolist(), 'D_G_over_k2': (G / k ** 2).tolist(),
           'lor_deviance_per_dof': [s['lor']['deviance_per_dof'] for s in sh],
           'delta_aic_dho_minus_lor': daic.tolist(), 'dho_Q': Q.tolist(), 'dho_w0_over_k': (w0 / k).tolist(), 'dho_gamma': gam.tolist(),
           'dho_deviance_per_dof': [s['dho']['deviance_per_dof'] for s in sh],
           'gdc_Q': [s['gdc']['Q'] for s in sh], 'delta_aic_gdc_minus_lor': [s['delta_aic_gdc_minus_lor'] for s in sh],
           'propagating_shells': int(prop.sum()), 'shells': len(sh), 'verdict': d['verdict']}
    if 'propagating_bound' in sh[0]:
        row['w95_Q3'] = [s['propagating_bound']['w95_Q3'] for s in sh]
        row['w95_Q10'] = [s['propagating_bound']['w95_Q10'] for s in sh]
        row['w95_Q1'] = [s['propagating_bound']['w95_max_over_w0']['Q=1']['w95'] for s in sh]
        row['bound_gain_2dlnL'] = [s['propagating_bound']['largest_likelihood_gain_2dlnL'] for s in sh]
    if 'exact' in sh[0]:
        row['exact_deviance_per_bin'] = [s['exact']['deviance_per_bin'] for s in sh]
        row['exact_bins'] = [s['exact']['bins'] for s in sh]
        row['variance_over_exact'] = [s['exact']['variance_ratio_measured_over_exact'] for s in sh]
        row['weight_outside_lowest_eigenpairs'] = [s['exact'].get('weight_outside_lowest_eigenpairs') for s in sh]
    if 'per_mode_lor_G' in sh[0]:
        row['per_mode_spread'] = [s.get('per_mode_lor_G', {}).get('relative_spread_std') for s in sh]
        row['per_mode_stat_err'] = [s.get('per_mode_lor_G', {}).get('mean_relative_statistical_error') for s in sh]
    # dispersion: diffusive exponent on the low shells (k below 0.7 rad per mesh edge, at least 3 shells)
    low = np.argsort(k)[:max(3, int((k < 0.7).sum()))]
    if len(low) >= 2:
        cf = np.polyfit(np.log(k[low]), np.log(G[low]), 1, w=1 / np.maximum(Gerr[low], 1e-3))
        row['lor_exponent_low_k'] = float(cf[0]); row['lor_D_low_k_weighted'] = float(np.average(G[low] / k[low] ** 2, weights=1 / np.maximum(Gerr[low], 1e-3) ** 2))
    if prop.sum() >= 2:
        row['speed_w0_over_k_median'] = float(np.median(w0[prop] / k[prop]))
        row['speed_min_max'] = [float((w0[prop] / k[prop]).min()), float((w0[prop] / k[prop]).max())]
        cf = np.polyfit(np.log(k[prop]), np.log(gam[prop]), 1)
        row['gamma_exponent'] = float(cf[0]); row['gamma_prefactor'] = float(math.exp(cf[1]))
        cf = np.polyfit(np.log(k[prop]), np.log(w0[prop]), 1)
        row['w0_exponent'] = float(cf[0])
    mv = [r.get('moves_per_event') for r in info if r.get('moves_per_event') is not None]
    od = [r.get('unequal_seam_per_event') for r in info if r.get('unequal_seam_per_event') is not None]
    if mv:
        row['moves_per_event'] = float(np.mean(mv))
    if od:
        row['unequal_seam_per_event'] = float(np.mean(od)); row['moves_over_unequal'] = float(np.mean(mv) / np.mean(od))
    for key in ('blocked_per_event', 'pair_collisions_per_event', 'triple_collisions_per_event', 'D_known', 'c_known', 'gamma_known', 'hop', 'variance_known'):
        v = [r.get(key) for r in info if r.get(key) is not None]
        if v:
            row[key] = float(np.mean(v))
    rows.append(row)
json.dump(rows, open('b2_summary.json', 'w'), indent=1)

fmt = lambda x, n=4: 'n/a' if x is None else (('%.' + str(n) + 'g') % x)
lines = ['# Block 2 summary (generated by b2_summary.py)', '',
         'G: Lorentzian rate per sweep; D = G/k^2 in mesh edge^2 per sweep; dAIC = AIC(oscillator) - AIC(Lorentzian); Q = w0/gamma of the',
         'oscillator fit; w95: 95 percent upper bound on the weight of an oscillator component with that Q.', '']
for r in rows:
    lines.append(f"## {r['name']}")
    lines.append(f"rule {r['rule']}, geometry {r['geometry']}, filling {r['filling']}, schedule {r['schedule']}, runs {r['runs']} x {r['samples_per_run']} samples every {r['every']} sweeps; verdict: **{r['verdict']}**")
    extra = []
    for key in ('lor_exponent_low_k', 'lor_D_low_k_weighted', 'speed_w0_over_k_median', 'gamma_exponent', 'w0_exponent', 'moves_over_unequal', 'D_known', 'c_known', 'gamma_known'):
        if key in r:
            extra.append(f"{key} = {fmt(r[key])}")
    lines.append(', '.join(extra)); lines.append('')
    head = ['shell', 'k', 'variance', 'G', 'rel err', 'D', 'dev LOR', 'dAIC', 'Q', 'w0/k', 'gamma', 'dev DHO']
    if 'w95_Q3' in r:
        head += ['w95 Q3', 'w95 Q10']
    if 'exact_deviance_per_bin' in r:
        head += ['exact dev/bin', 'var/exact']
    if 'per_mode_spread' in r:
        head += ['mode spread', 'stat err']
    lines.append('| ' + ' | '.join(head) + ' |'); lines.append('|' + ' --- |' * len(head))
    for i in range(r['shells']):
        c = [r['shell_labels'][i], fmt(r['k'][i]), fmt(r['variance'][i]), fmt(r['lor_G'][i]), fmt(r['lor_G_rel_err'][i], 2), fmt(r['D_G_over_k2'][i]),
             fmt(r['lor_deviance_per_dof'][i], 3), fmt(r['delta_aic_dho_minus_lor'][i], 3), fmt(r['dho_Q'][i], 3), fmt(r['dho_w0_over_k'][i]),
             fmt(r['dho_gamma'][i]), fmt(r['dho_deviance_per_dof'][i], 3)]
        if 'w95_Q3' in r:
            c += [fmt(r['w95_Q3'][i], 2), fmt(r['w95_Q10'][i], 2)]
        if 'exact_deviance_per_bin' in r:
            c += [fmt(r['exact_deviance_per_bin'][i], 3), fmt(r['variance_over_exact'][i])]
        if 'per_mode_spread' in r:
            c += [fmt(r['per_mode_spread'][i], 2), fmt(r['per_mode_stat_err'][i], 2)]
        lines.append('| ' + ' | '.join(c) + ' |')
    lines.append('')
open('b2_summary.md', 'w').write('\n'.join(lines) + '\n')
print('configurations', len(rows))
for r in rows:
    print('%-34s %-44s prop %d/%d  D_low %s  exp %s  speed %s' % (r['name'], r['verdict'], r['propagating_shells'], r['shells'],
          fmt(r.get('lor_D_low_k_weighted')), fmt(r.get('lor_exponent_low_k'), 3), fmt(r.get('speed_w0_over_k_median'))))
