            parts.append("trivial")
        if fr["each_of_the_two_conjugate_characters"] != "0":
            parts.append("the two conjugate characters of the third-turn")
        if fr["triplet"] != "0":
            parts.append("triplet")
        kl = b["under_klein_group"]
        kparts = [(c if kl[c] == "1" else f"{c} ({kl[c]} times)") for c in ("trivial", "x", "y", "z")
                  if kl[c] != "0"]
        w(f"| {names[key]} | {b['rank']} | {cell(b['seam_cost'])} | {cell(b['walk_kernel_eigenvalue_blank_record'])} "
          f"| {b['rest_phase_arccos_float']} | {' + '.join(parts)} | {', '.join(kparts)} |")
    w("")
    w("- The frame group acts freely and transitively on the twelve ports (no rotation of the frame fixes a port; "
      "one orbit). The port load space is therefore its regular representation: one trivial line, the two conjugate "
      "characters of the third-turn, and the triplet three times. Commutant dimension of the port space: "
