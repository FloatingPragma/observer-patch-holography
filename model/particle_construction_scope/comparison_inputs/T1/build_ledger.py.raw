def load_register():
    with open(os.path.join(RER, "tracking", "premise_register.json")) as fh:
        reg = json.load(fh)
    groups = {}
    for g in reg["model_supply"]["groups"]:
        for p in g["premises"]:
            groups.setdefault(p, []).append(f'{g["id"]} {g["title"]}')
    sml = {}
    for r in reg["sm_coverage"]["rows"]:
        for p in r["premises"] + r["open_premises"]:
            sml.setdefault(p, []).append(r["id"])
    return reg, groups, sml


def consumers(row):
    roles = row["evidence_roles"]
    cc = [p for p in row["evidence"] if roles.get(p) == "conditional_consumer"]
    lean = [p for p in cc if p.startswith("Lean/")]
    if lean:
        return lean[:3]
    if cc:
        return cc[:2]
    st = [p for p in row["evidence"] if roles.get(p) == "statement"]
    lean_st = [p for p in st if p.startswith("Lean/")]
    return (lean_st or st)[:2]


def short(path):
    return path.replace("Lean/", "").replace(".lean", "")


def main():
    reg, groups, sml = load_register()
    ids = [r["id"] for r in reg["rows"]]
    assert set(ids) == set(H), sorted(set(ids) ^ set(H))
    rows = []
    for r in reg["rows"]:
        st, level, by, rel, supply, cites, status, mass, steps, note = H[r["id"]]
        assert level in LEVELS, (r["id"], level)
        assert mass in ("direct", "criterion", "unit", "none"), r["id"]
        assert (level == "nothing") or cites, r["id"]
        rows.append({
            "id": r["id"], "name": r["name"], "type": r["type"], "disposition": r["disposition"],
            "register_implementation_status": r["discharge"]["status"],
            "statement": st,
            "consumed_by": consumers(r),
            "theorem_group": groups.get(r["id"], []),
            "standard_model_rows": sml.get(r["id"], []),
            "supply_level": level, "supplied_by": by, "relation_to_the_row": rel,
            "supply": supply, "cite": cites,
            "premise_status_for_the_candidate": status,
            "rest_mass_dependence": mass, "mass_steps": steps, "note": note,
        })
    outside = [dict(zip(("id", "source", "statement", "consumed_by", "supply_level", "supplied_by", "supply",
                         "cite", "premise_status_for_the_candidate", "rest_mass_dependence", "mass_steps"), o))
               for o in OUTSIDE]
    for o in outside:
        assert o["supply_level"] in LEVELS, o["id"]
    with open(os.path.join(HERE, "frame_check.json")) as fh:
        check = json.load(fh)

    level_count = collections.Counter(r["supply_level"] for r in rows)
    mass_count = collections.Counter(r["rest_mass_dependence"] for r in rows)
    status_count = collections.Counter(r["premise_status_for_the_candidate"] for r in rows)
    mass_rows = [r for r in rows if r["rest_mass_dependence"] != "none"]
    ledger = {
        "schema": "repair-law.T1.premise-ledger.v1",
        "date": "2026-11-10",
        "paths": {"RL": RL, "RER": RER},
        "register": {"file": "RER/tracking/premise_register.json", "schema": reg["schema"], "rows": len(rows),
                     "ids": "PR-01 to PR-85 without PR-83 (retired)",
                     "caution": "The register is not the whole premise set: A1 to A3 and result-specific "
                                "declarations are in RER/claims/axiom_registry.yaml and "
                                "RER/claims/assumption_dictionary.md; see 'premises_outside_the_register'."},
        "candidate": "CF-1 (RL/candidates/CF1.md, sections 8 to 12) with the audit's coherent packets "
                     "(RER/model/coherent_seam_repair, RER/model/coherent_defect_wave)",
        "reading_rule": "The level says what exists, not that the premise is supplied. Every construction counted "
                        "is a declared program; none is a shadow of the committed rule beyond level 1.",
        "levels": list(LEVELS),
        "summary": {
            "by_supply_level": {k: level_count.get(k, 0) for k in LEVELS},
            "by_rest_mass_dependence": dict(mass_count),
            "by_premise_status": dict(status_count),
            "rows_on_which_a_rest_mass_depends": [r["id"] for r in mass_rows],
            "of_these_at_nothing_or_label_level": [r["id"] for r in mass_rows
                                                   if r["supply_level"] in ("nothing", "label-level shadow")],
        },
        "rows": rows,
        "premises_outside_the_register": outside,
        "gauge_fixings": GAUGE_FIXINGS,
        "frame_fixing_exact": check,
        "violated_or_unmeetable_most_damaging_first": [{"premise": a, "why": b} for a, b in VIOLATIONS],
    }
    with open(os.path.join(HERE, "ledger.json"), "w") as fh:
        json.dump(ledger, fh, indent=1)
        fh.write("\n")

    # ------------------------------------------------------------------ LEDGER.md
    def cell(s):
        return str(s).replace("|", "\\|").replace("\n", " ")

    L = []
    w = L.append
    w("# T1: premise ledger of the finite theorem stack for candidate CF-1\n")
    w("Generated by `build_ledger.py` in this directory; machine form `ledger.json`; exact frame check "
      "`frame_check.json` (`t1_frame_check.py`). RL = `" + RL + "`, RER = `" + RER + "`.\n")
    w("## 1. Scope and reading rules\n")
    w("- Tuple of every statement: candidate CF-1 as bound by sections 8 to 12 of `RL/candidates/CF1.md` (cubic "
      "family of one frame; modes cell, record, spin, pattern; Z2 link bits; alternating schedule; declared "
      "preparations and instruments; clock in ticks), together with the audit's coherent packets in the public "
      "checkout. All are declared programs. Nothing below is a shadow of the committed rule above level 1, and no "
      "cell says that a premise is supplied by the law.")
    w("- The register (`RER/tracking/premise_register.json`, schema " + reg["schema"] + ") has 84 rows with ids "
      "PR-01 to PR-85; PR-83 is retired. The task named PR-01 to PR-84.")
    w("- The register is not the whole premise set. A1 to A3 and the declarations of single results are outside it; "
      "section 5 lists those the mass chain meets.")
    w("- Level: nothing, label-level shadow, executed on one carrier, executed on a family, proof. It says what "
      "exists. 'Relation' says whether that is the row's own object (row), part of its clauses (part) or a "
      "neighbouring construction (analog). 'Status' says whether the premise holds for the candidate.")
    w("- Rest mass: direct (ingredient of the state, clock, charge or mass mechanism), criterion (through clauses "
      "C1 to C4, Q1 to Q3 of the particle criterion or the dispersion test), unit (scale, calibration, "
      "comparison), none. Steps are those of `RL/MASS_STEPS.md`.\n")
    w("## 2. Counts\n")
    w("| Supply level | Rows |\n| --- | --- |")
    for k in LEVELS:
        w(f"| {k} | {level_count.get(k, 0)} |")
    w("")
    w("| Rest mass dependence | Rows |\n| --- | --- |")
    for k in ("direct", "criterion", "unit", "none"):
        w(f"| {k} | {mass_count.get(k, 0)} |")
    w("")
    w(f"A rest mass depends on {len(mass_rows)} rows. Of these, "
      f"{len(ledger['summary']['of_these_at_nothing_or_label_level'])} stand at nothing or label level: "
      + ", ".join(ledger["summary"]["of_these_at_nothing_or_label_level"]) + ".\n")
    w("## 3. Rows on which a rest mass depends\n")
    w("| Row | Premise | Mass | Steps | Level (by; relation) | Status for the candidate |\n| --- | --- | --- | --- | --- | --- |")
    for r in mass_rows:
        w(f"| {r['id']} | {cell(r['name'])} | {r['rest_mass_dependence']} | {', '.join(r['mass_steps'])} | "
          f"{r['supply_level']} ({r['supplied_by']}; {r['relation_to_the_row']}) | "
          f"{cell(r['premise_status_for_the_candidate'])} |")
    w("")
    w("## 4. The ledger, all 84 rows\n")
    w("| Row | Statement | Consumed by | Level (by; relation) | What is supplied | Status | Mass | Files |\n"
      "| --- | --- | --- | --- | --- | --- | --- | --- |")
    for r in rows:
        cons = "; ".join(short(c) for c in r["consumed_by"])
        if r["theorem_group"]:
            cons += " [" + "; ".join(g.split(" ")[0] for g in r["theorem_group"]) + "]"
        sup = r["supply"] + ((" " + r["note"]) if r["note"] else "")
        w(f"| {r['id']} | {cell(r['statement'])} | {cell(cons)} | {r['supply_level']} ({r['supplied_by']}; "
          f"{r['relation_to_the_row']}) | {cell(sup)} | {cell(r['premise_status_for_the_candidate'])} | "
          f"{r['rest_mass_dependence']} | {cell('; '.join(r['cite']))} |")
    w("")
    w("Groups in brackets are those of the model and theorem crosswalk of the register (`model_supply`): "
      + "; ".join(f"{g['id']} {g['title']}" for g in reg["model_supply"]["groups"]) + ".\n")
    w("## 5. Premises of the finite theorems outside the register\n")
    w("Sources: `" + BASIS + "` (A1 to A3), `" + PAPER + "` (propositions and the particle criterion).\n")
    w("| Clause | Statement | Consumed by | Level (by) | What is supplied | Status | Mass | Files |\n"
      "| --- | --- | --- | --- | --- | --- | --- | --- |")
    for o in outside:
        w(f"| {o['id']} | {cell(o['statement'])} | {cell(o['consumed_by'])} | {o['supply_level']} "
          f"({o['supplied_by']}) | {cell(o['supply'])} | {cell(o['premise_status_for_the_candidate'])} | "
          f"{o['rest_mass_dependence']} | {cell('; '.join(o['cite']))} |")
    w("")
    fc = check
    lt = fc["lie_type_theorem_with_the_frame_group"]
    w("## 6. Gauge fixing\n")
    w("### 6.1 Every place where the stack fixes a gauge, a chart or a frame\n")
    w("| Place | What is fixed | Residual group | Threefold label | Against CF-1 |\n| --- | --- | --- | --- | --- |")
    for g in GAUGE_FIXINGS:
        w(f"| {cell(g['place'])} | {cell(g['fixed'])} | {cell(g['residual'])} | {cell(g['threefold_label'])} | "
          f"{cell(g['cf1'])} |")
    w("")
    w("**Answer.** The frame fixing of CF-1 is none of them. The stack never reduces the sixty rechartings: premise "
      "A2 quantifies over all of them and asks for an implementer of each. CF-1 reduces sixty to twelve by the "
      "arrangement of carriers and twelve to four by the axis order of the tick (`RL/reports/R1.md` result 4, "
      "`R4.md` result 4). In the stack's terms this is a breaking of A2 on the family, not a gauge choice: no "
      "implementer exists in the candidate for a rotation that leaves the frame.\n")
    w("### 6.2 What the frame fixing does to the load space (EXACT, `frame_check.json`; level 1)\n")
    w("The first two bullets below and the mixing numbers reproduce lead L38 of this session "
      "(`RL/work/DESIGN/DESIGN.md`, part A) with independent code (band projectors and characters, no shared "
      "file). What is added here is the relation to the theorem stack (6.3, 7.5).\n")
    w("| Band of the sixty rotations | Rank | Seam cost | Walk kernel (blank record) | Rest phase | Under the frame "
      "group (12) | Under its Klein group (4) |\n| --- | --- | --- | --- | --- | --- | --- |")
    names = {"1": "1 (uniform load)", "3": "3 (slow triplet)", "5": "5 (quintet)", "3p": "3' (fast triplet)"}
    for key in ("1", "3", "5", "3p"):
        b = fc["bands"][key]
        fr = b["under_frame_group"]
        parts = []
