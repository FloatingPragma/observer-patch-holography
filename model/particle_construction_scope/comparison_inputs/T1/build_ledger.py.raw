          "nothing", "-", "-", "", [], NOT_USED, "none", [], ""),
"PR-79": ("Bounded waste: one genuine record change within q + 1 attempts.",
          "nothing", "-", "-", "", [], NOT_USED, "none", [], ""),
"PR-80": ("The attempt budget is at least (q + 1) times the initial mismatch count.",
          "nothing", "-", "-", "", [], NOT_USED, "none", [], ""),
"PR-81": ("Every semantic commit declares the register versions it depends on; the support is sound and complete.",
          "nothing", "-", "-", "", [], NOT_USED, "none", [], ""),
"PR-82": ("A rank strictly increasing along authenticated parent edges witnesses acyclicity.",
          "nothing", "-", "-", "", [], NOT_USED, "none", [], ""),
"PR-84": ("Pathwise weak fairness for fixed node attempts.",
          "nothing", "-", "-", "", [], NOT_USED, "none", [], ""),
"PR-85": ("Bounded waste between fixed node changes.",
          "nothing", "-", "-", "", [], NOT_USED, "none", [], ""),
}

