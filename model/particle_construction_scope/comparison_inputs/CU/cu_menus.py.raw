"""CU row C5: the menus of GL's link register at the chain's coupling (worker BF's product-state solver, read only).

For the menus M1, M2, M3 and both plaquette traces the variational product state of BF (`bf_meanfield.Link`) is
solved at two bare couplings: 1/alpha = alpha_U^-1 of the engine (24.3166) and the value after matter-only running
in the window (row C4c). Output: mean link per block, which factors order, mean Casimir, weight of the vacuum sector.
No measured value. Writes cu_menus.json.
"""
import json
import os
import sys
import time

import numpy as np

HERE = os.path.dirname(os.path.abspath(__file__))
RL = os.path.dirname(os.path.dirname(HERE))
BF = os.path.join(RL, 'work', 'BF')
sys.dont_write_bytecode = True
sys.path.insert(0, BF)
import bf_lib as L                 # noqa: E402
from bf_meanfield import Link      # noqa: E402

t0 = time.time()
win = json.load(open(os.path.join(HERE, 'cu_window.json')))
x_chain = win['C4_chain_variants']['a equal at M_U | declared (33/5, 1, -3)']['inv_aU']
x_matter = win['C4_chain_variants']['c matter only in the window | declared (33/5, 1, -3)']['inv_alpha_at_cell']
MEN = L.menus(3)
out = {'couplings': {'chain': x_chain, 'matter-only window': x_matter}, 'rows': {}}
for name, x in (('chain', x_chain), ('matter-only window', x_matter)):
    g2 = 4 * np.pi / x
    for F in ('5', '15'):
        for n in (1, 2, 3):
            lk = Link(sorted(MEN[n]), F)
            s = lk.summary(lk.solve(g2))
            key = f'{name}: 1/alpha = {x:.4f}, F = {F}, M{n}'
            out['rows'][key] = {
                'states': int(sum(L.dim(r) ** 2 for r in MEN[n])), 'sectors': len(MEN[n]),
                'product state with u > 0 wins': s['product_state_with_u_above_zero_wins'],
                'colour ordered': s['colour_blocks_ordered'] and s['product_state_with_u_above_zero_wins'],
                'u per block': s['u_per_block'], 'stiffness per factor': s['stiffness_Z_per_factor'],
                'mean Casimir (SU3, SU2, U1, total)': s['mean_Casimir (SU3, SU2, U1, total)'],
                'weight on the vacuum sector': s['weight_on_vacuum_sector']}
            r = out['rows'][key]
            print(key, '| wins', r['product state with u > 0 wins'], '| colour', r['colour ordered'], '| Z',
                  {k: round(v, 4) for k, v in r['stiffness per factor'].items()}, '| <C>',
                  [round(v, 3) for v in r['mean Casimir (SU3, SU2, U1, total)']], '|', round(time.time() - t0, 1), 's', flush=True)
out['seconds'] = round(time.time() - t0, 1)
json.dump(out, open(os.path.join(HERE, 'cu_menus.json'), 'w'), indent=1, default=L.jsonable)
