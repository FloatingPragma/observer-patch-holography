"""T3 item 1 (MEASURED, float64; exact identities checked separately in t3_exact.py): cone counts and gaps of the
natural family. Runs on box B: python t3_item1.py [nproc]  ->  item1.json

Members (all periods are palindromic: phases exp(-+i Omega), each twice; Omega per period of two ticks):
  W2      CF-1 period (half-step frame)
  B(phi)  Wilson-type lazy sub-steps B_i = M(-phi/2) L_i(phi) M(-phi/2)          (parity mixing; full zone)
  C(tau)  Wilson step from public reflectors N_i = S_i^-1 M(tau) S_i M(-tau)     (parity preserving; reduced zone)
"""
import sys, json, os
import numpy as np
from multiprocessing import Pool
import t3sym as T

HERE = os.path.dirname(os.path.abspath(__file__))


def job(args):
    name, kind, par, theta, zone = args
    if kind == 'W2': word = T.period_W2(theta)
    elif kind == 'B': word = T.period_B(par, theta)
    elif kind == 'C': word = T.period_C(par, theta)
    lo, hi = (-np.pi, np.pi) if zone == 'full' else (-np.pi / 2, np.pi / 2)
    n = 48 if zone == 'full' else 32
    r = T.summary(word, n=n, lo=lo, hi=hi)
    r.update({'name': name, 'member': kind, 'parameter': par, 'theta': theta, 'zone': zone, 'grid_n': n,
              'speeds_per_period': T.speeds(word), 'degeneracy_defect': T.degeneracy_defect(word)})
    return r


if __name__ == '__main__':
    nproc = int(sys.argv[1]) if len(sys.argv) > 1 else 12
    jobs = [('W2 full', 'W2', None, 0.0, 'full'), ('W2 reduced', 'W2', None, 0.0, 'reduced')]
    phis = [0.1, 0.15, np.pi / 16, 0.25, 0.3, 0.35, 0.4, 0.45, 0.5, 0.55, 3 * np.pi / 16, 0.65, 0.7, 0.75, 0.8, 0.85,
            0.9, 0.95, 5 * np.pi / 16, 1.0, 1.05, 1.1, 1.15, 1.2, 1.25, 1.3, 7 * np.pi / 16, 1.45, 1.5]
    jobs += [('B phi=%.6f' % f, 'B', float(f), 0.0, 'full') for f in phis]
    jobs += [('B phi=5pi/16 theta=%.6f' % t, 'B', float(5 * np.pi / 16), float(t), 'full')
             for t in (0.157935, -0.157935, 0.4, -0.4, 0.6)]
    taus = [np.pi / 32, 0.05, np.pi / 16, 0.15, 0.25, 3 * np.pi / 16, np.pi / 4, 0.35]
    jobs += [('C tau=%.6f reduced' % t, 'C', float(t), 0.0, 'reduced') for t in taus]
    jobs += [('C tau=pi/16 full', 'C', float(np.pi / 16), 0.0, 'full')]
    with Pool(nproc) as pool:
        res = pool.map(job, jobs, chunksize=1)
    out = {'note': __doc__, 'results': res}
    json.dump(out, open(os.path.join(HERE, 'item1.json'), 'w'), indent=1)
    for r in res:
        print('%-34s zeros0 %3d  zerospi %3d  lightest %s  gap_pi %s  v100 %.4f' % (
            r['name'], r['count_phase0'], r['count_phasepi'],
            None if r['lightest_nonzero_minimum_of_Omega'] is None else round(r['lightest_nonzero_minimum_of_Omega'], 4),
            None if r['gap_at_pi'] is None else round(r['gap_at_pi'], 4), r['speeds_per_period']['100']))
