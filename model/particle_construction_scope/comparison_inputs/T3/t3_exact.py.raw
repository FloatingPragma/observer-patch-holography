"""T3 exact certificates (sympy, exact arithmetic over Q(i) at rational points of the circles, and exact derivatives).

E1  closed form of the lazy sub-step: B_i(p) = [cos^2 phi cos p + sin^2 phi] - i cos phi sin p alpha_i
                                               - i sin phi cos phi (1 - cos p) beta,  B_i(0) = 1, B_i(pi) = -M(-2 phi)
E2  image identities of the CF-1 period with mass: W2(p + p*) = W2(R p) for the three axis-labelled classes, and
    W2(p + pi c) = W2(p) for the eight corners
E3  parity: every word of equal-weight letters with an even number of moves per axis is pi-periodic in each p_i
    (W2, member C); member B is not (exact counterexample)
E4  node chiralities of both arrow blocks of the massless period at all 64 nodes, from the exact Jacobian
E5  corner phases of member B: P_B(pi c) = M(2 theta - 4 k phi) up to the sign (-1)^0, k = number of pi components
python t3_exact.py -> exact.json (local, < 20 CPU s)
"""
import json, itertools, os
import sympy as sp

HERE = os.path.dirname(os.path.abspath(__file__))
I = sp.I
X = sp.Matrix([[0, 1], [1, 0]]); Y = sp.Matrix([[0, -I], [I, 0]]); Z = sp.Matrix([[1, 0], [0, -1]]); E2 = sp.eye(2)
SIG = [X, Y, Z]
kron = lambda A, B: sp.kronecker_product(A, B)
ALPHA = [kron(X, s) for s in SIG]; BETA = kron(Y, E2); E4 = sp.eye(4)


def iszero(A):
    return all(sp.expand(x) == 0 for x in A)


def circ(t):
    """exact point of the circle: (cos, sin) = ((1 - t^2)/(1 + t^2), 2t/(1 + t^2))"""
    t = sp.Rational(t); return (1 - t ** 2) / (1 + t ** 2), 2 * t / (1 + t ** 2)


def Sg(c, s, i, e=1): return c * E4 - I * e * s * ALPHA[i]
def Mg(c, s): return c * E4 - I * s * BETA


def W2(cs, th):
    """half-step frame period with mass: th = (cos theta/2, sin theta/2); M(theta) = M(theta/2)^2"""
    Mh = Mg(*th); Mf = Mh * Mh
    S = [Sg(cs[i][0], cs[i][1], i) for i in range(3)]
    return Mh * S[0] * S[1] * S[2] * Mf * S[2] * S[1] * S[0] * Mh


def shift(cs, k):
    """(cos, sin) of p + k pi/2 from (cos p, sin p), k integer"""
    c, s = cs
    for _ in range(k % 4): c, s = -s, c
    return (c, s)


if __name__ == '__main__':
    out = {'note': __doc__}
    ts = [sp.Rational(n, d) for n, d in ((1, 3), (2, 7), (-3, 5), (5, 11), (-1, 4), (7, 9))]
    # E1: parametrize phi/2 by a rational point (ch, sh); then cos phi = ch^2 - sh^2, sin phi = 2 ch sh
    res = []
    for tp in ts:
        for th in ts[:4]:
            c, s = circ(tp); ch, sh = circ(th); cf, sf = ch ** 2 - sh ** 2, 2 * ch * sh
            for i in range(3):
                Bi = Mg(ch, -sh) * (cf * Sg(c, s, i) - I * sf * BETA) * Mg(ch, -sh)
                closed = (cf ** 2 * c + sf ** 2) * E4 - I * cf * s * ALPHA[i] - I * sf * cf * (1 - c) * BETA
                res.append(iszero(Bi - closed))
            Bpi = Mg(ch, -sh) * (cf * Sg(-1, 0, 0) - I * sf * BETA) * Mg(ch, -sh)
            res.append(iszero(Bpi + Mg(cf, -sf) * Mg(cf, -sf)))      # -M(-2 phi)
    out['E1_closed_form_and_B(pi)=-M(-2phi)'] = all(res); print('E1', all(res), len(res))
    # E2
    res = {}
    for name, (k, R) in {'A1 (pi/2,0,pi/2)': ((1, 0, 1), (1, -1, -1)), 'A2 (0,pi/2,pi/2)': ((0, 1, 1), (1, 1, -1)),
                         'A3 (pi/2,pi/2,0)': ((1, 1, 0), (1, -1, 1))}.items():
        good = True
        for tri in itertools.combinations(ts, 3):
            cs = [circ(t) for t in tri]; th = circ(ts[1])
            lhs = W2([shift(cs[j], k[j]) for j in range(3)], th)
            rhs = W2([(cs[j][0], R[j] * cs[j][1]) for j in range(3)], th)
            good &= iszero(lhs - rhs)
        res[name] = bool(good)
    good = True
    for tri in itertools.combinations(ts, 3):
        cs = [circ(t) for t in tri]; th = circ(ts[2])
        for c in itertools.product((0, 2), repeat=3):
            good &= iszero(W2([shift(cs[j], c[j]) for j in range(3)], th) - W2(cs, th))
    res['corners'] = bool(good)
    out['E2_image_identities_with_mass'] = res; print('E2', res)
    # E3 parity: B is not pi-periodic (counterexample at p = 0 against p = (pi,0,0)): P_B(0) = 1, P_B(pi,0,0) != 1
    ch, sh = circ(sp.Rational(1, 3)); cf, sf = ch ** 2 - sh ** 2, 2 * ch * sh
    Bfun = lambda c, s, i: Mg(ch, -sh) * (cf * Sg(c, s, i) - I * sf * BETA) * Mg(ch, -sh)
    PB = lambda cs: (Bfun(*cs[0], 0) * Bfun(*cs[1], 1) * Bfun(*cs[2], 2) * Bfun(*cs[2], 2) * Bfun(*cs[1], 1) * Bfun(*cs[0], 0))
    P0 = PB([(1, 0), (1, 0), (1, 0)]).expand(); P1 = PB([(-1, 0), (1, 0), (1, 0)]).expand()
    out['E3_member_B_not_pi_periodic'] = {'P_B(0) == 1': iszero(P0 - E4), 'P_B(pi,0,0) == 1': iszero(P1 - E4),
                                          'P_B(pi,0,0) == M(-4 phi)': iszero(P1 - Mg(cf, -sf) ** 4)}
    print('E3', out['E3_member_B_not_pi_periodic'])
    # E4 exact node chiralities: at p in (pi/2) Z^3 every factor is exact; dU/dp_j by the product rule
    Vp = sp.Matrix([[1, 0], [0, 1], [1, 0], [0, 1]]) / sp.sqrt(2); Vm = sp.Matrix([[1, 0], [0, 1], [-1, 0], [0, -1]]) / sp.sqrt(2)
    cs4 = {0: (1, 0), 1: (0, 1), 2: (-1, 0), 3: (0, -1)}
    table = {}
    for chi, V in ((1, Vp), (-1, Vm)):
        sums = {'0': 0, 'pi': 0}; rows = []
        for k in itertools.product(range(4), repeat=3):
            cs = [cs4[k[j]] for j in range(3)]
            F = [Sg(cs[i][0], cs[i][1], i) for i in range(3)]
            dF = [-cs[i][1] * E4 - I * cs[i][0] * ALPHA[i] for i in range(3)]
            seq = [0, 1, 2, 2, 1, 0]
            Wn = F[0] * F[1] * F[2] * F[2] * F[1] * F[0]
            U = (V.H * Wn * V).expand()
            a0 = sp.nsimplify(sp.re((U.trace() / 2).expand()))
            if abs(a0) != 1 or not iszero(U - a0 * sp.eye(2)): continue
            J = sp.zeros(3, 3)
            for j in range(3):
                dW = sp.zeros(4, 4)
                for pos in range(6):
                    if seq[pos] != j: continue
                    term = sp.eye(4)
                    for q, ax in enumerate(seq):
                        term = term * (dF[ax] if q == pos else F[ax])
                    dW += term
                dU = (V.H * dW * V).expand()
                for r in range(3):
                    J[r, j] = a0 * sp.re(sp.expand(I * (dU * SIG[r]).trace() / 2))
            d = J.det(); ph = '0' if a0 == 1 else 'pi'; sgn = int(sp.sign(d)); sums[ph] += sgn
            rows.append([str([sp.Rational(x, 2) for x in k]), ph, sgn, str(J.tolist())])
        table['block %+d' % chi] = {'net_phase0': sums['0'], 'net_phasepi': sums['pi'], 'n_nodes': len(rows), 'nodes': rows}
        print('E4 block', chi, 'nodes', len(rows), 'net chirality phase 0:', sums['0'], 'phase pi:', sums['pi'])
    out['E4_node_chiralities_exact'] = table
    # E5 corner phases of member B with mass: P_B(pi c) = M(theta) ... = M(2 theta - 4 k phi)
    good = True
    tt = circ(sp.Rational(2, 9))                               # theta/2 point
    Mh = Mg(*tt)
    for c in itertools.product((0, 1), repeat=3):
        k = sum(c)
        cs = [(-1 if c[j] else 1, 0) for j in range(3)]
        B = [Bfun(*cs[j], j) for j in range(3)]
        P = Mh * B[0] * B[1] * B[2] * Mh * Mh * B[2] * B[1] * B[0] * Mh
        target = (Mh ** 4) * (Mg(cf, -sf) ** (4 * k))
        good &= iszero(P - target)
    out['E5_corner_phases_member_B'] = bool(good); print('E5', good)
    json.dump(out, open(os.path.join(HERE, 'exact.json'), 'w'), indent=1, default=str)
