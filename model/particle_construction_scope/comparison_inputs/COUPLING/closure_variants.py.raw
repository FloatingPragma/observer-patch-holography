import numpy as np
from closure_check import chain, solve, ell2, ell3, EP
pi = np.pi; P = 1.6309721
rows = [('paper: (33/5, 1, -3)', (33/5, 1.0, -3.0)),
        ('vector-like, two Higgs doublets: (41/5, 1, -3)', (41/5, 1.0, -3.0)),
        ('vector-like, one Higgs doublet: (81/10, 5/6, -3)', (81/10, 5/6, -3.0)),
        ('vector-like, three Higgs doublets: (83/10, 7/6, -3)', (83/10, 7/6, -3.0)),
        ('Standard Model: (41/10, -19/6, -7)', (41/10, -19/6, -7.0))]
for name, b in rows:
    try:
        f = lambda x: chain(P, 1.0/x, b=b)['lhs'] - P/4
        xs = np.linspace(8, 80, 400); vals = [f(x) for x in xs]
        roots = [ (xs[i], xs[i+1]) for i in range(len(xs)-1) if np.isfinite(vals[i]) and np.isfinite(vals[i+1]) and vals[i]*vals[i+1] < 0]
        if not roots: print(name, ': no root'); continue
        from scipy.optimize import brentq
        for lo, hi in roots:
            x = brentq(f, lo, hi); c = chain(P, 1.0/x, b=b)
            print(f"{name}: 1/aU = {x:.4f} v = {c['v']:.4g} GeV mZ = {c['mz']:.4g} 1/a1 = {1/c['a1']:.3f} 1/a2 = {1/c['a2']:.3f} 1/a3 = {1/c['a3']:.3f} sin2 = {c['s2']:.5f} 1/aem = {c['aem_inv']:.3f}")
    except Exception as e:
        print(name, 'error', e)
