"""CC exact checks: rows B1, B2, B2b, B3 (identity part), B6, B7 and A4 of CANDIDATES.md.

Reads `work/BF/bf_lib.py` (generators, menus) and `work/BF/bf_meanfield.json` (link-vacuum shares), read only.
Writes cc_exact.json. No measured value is used.
"""
import json
import os
import sys
from fractions import Fraction as Fr

import numpy as np
import sympy as sp
from scipy.linalg import expm
from scipy.optimize import brentq

HERE = os.path.dirname(os.path.abspath(__file__))
BF = os.path.join(os.path.dirname(HERE), 'BF')
sys.path.insert(0, BF)
sys.dont_write_bytecode = True
import bf_lib as L          # noqa: E402  (read only)
import cc_lib as C          # noqa: E402

out = {}
checks = {}

# ---------------------------------------------------------------- B1: Laplacian coefficient from GL's action
g2 = 1.0
rows = {}
for name, (T, kappa) in L.REPS.items():
    NF = T[0].shape[0]
    beta = {'5': 10.0, '15': 7.5}[name] / g2
    hess_exact = [beta * np.trace(t @ t).real / NF for t in T]
    h = 1e-3
    hess_fd = []
    for t in T:
        S = lambda th: beta * (1 - np.trace(expm(1j * th * t)).real / NF)
        hess_fd.append((S(h) - 2 * S(0.0) + S(-h)) / h ** 2)
    rows[name] = {'beta_F g^2': beta * g2, 'N_F': NF, 'kappa_F': kappa,
                  'second_derivative_exact (12 generators)': hess_exact,
                  'second_derivative_finite_difference': hess_fd,
                  'max_deviation_from_1/g^2': float(max(abs(np.array(hess_exact) - 1 / g2))),
                  'max_fd_deviation': float(max(abs(np.array(hess_fd) - 1 / g2)))}
    checks[f'B1_plaquette_coefficient_is_1_over_g2_on_the_{name}'] = bool(
        max(abs(np.array(hess_exact) - 1 / g2)) < 1e-13 and max(abs(np.array(hess_fd) - 1 / g2)) < 1e-5)
out['B1_plaquette_coefficient'] = rows

# electric coefficient from unit wave speed: H = (e/2) E^2 + (1/(2 g^2)) B^2, [A, E] = i; speed^2 = e/g^2
e, g = sp.symbols('e g', positive=True)
speed2 = e / g ** 2
e_sol = sp.solve(sp.Eq(speed2, 1), e)[0]
out['B1_electric_coefficient'] = {'speed_squared': str(speed2), 'e_for_unit_speed': str(e_sol),
                                  'electric_term': '(g^2/2) C per link'}
checks['B1_unit_speed_gives_electric_coefficient_g2_over_2'] = bool(sp.simplify(e_sol - g ** 2) == 0)

# Casimir of the code blocks, per factor
T5 = L.T5
parts = {'SU3': T5[:8], 'SU2': T5[8:11], 'U1': T5[11:]}
cas = {}
for k, gens in parts.items():
    M = sum(t @ t for t in gens)
    cas[k] = {'triplet block': float(M[0, 0].real), 'doublet block': float(M[3, 3].real)}
out['B1_casimir_on_the_code'] = cas
closure_tables = {'SU2 j=1/2': float(C.SU2[1][1]), 'SU3 (1,0)': float(Fr(1 + 3, 3))}
out['B1_closure_tables'] = closure_tables
checks['B1_casimirs_equal_the_closure_tables'] = bool(
    abs(cas['SU3']['triplet block'] - 4 / 3) < 1e-14 and abs(cas['SU2']['doublet block'] - 3 / 4) < 1e-14
    and abs(closure_tables['SU2 j=1/2'] - 3 / 4) < 1e-14 and abs(cas['U1']['triplet block'] - 1 / 15) < 1e-14
    and abs(cas['U1']['doublet block'] - 3 / 20) < 1e-14 and abs(cas['SU3']['doublet block']) < 1e-14
    and abs(cas['SU2']['triplet block']) < 1e-14)

# ---------------------------------------------------------------- B2: scale-free product
x, l, A, s, al = sp.symbols('x l A s alpha', positive=True)
gsq = 4 * sp.pi * al
t_of = 2 * sp.pi * x * (gsq / 2) * l / A
kappa = x * l / A
t_scaled = t_of.subs({x: s * x, l: s * l, A: s ** 2 * A}, simultaneous=True)
out['B2_scale_free'] = {'t': str(sp.simplify(t_of)), 't_over_4pi2_alpha': str(sp.simplify(t_of / (4 * sp.pi ** 2 * al))),
                        't_after_rescaling_minus_t': str(sp.simplify(t_scaled - t_of))}
checks['B2_t_equals_4pi2_alpha_kappa'] = bool(sp.simplify(t_of - 4 * sp.pi ** 2 * al * kappa) == 0)
checks['B2_invariant_under_rescaling'] = bool(sp.simplify(t_scaled - t_of) == 0)

# ---------------------------------------------------------------- B2b: values of kappa
y, th = sp.symbols('y theta', positive=True)
kap = {
    'T1: unit link, unit cross-section, centre at one unit': sp.Integer(1) * 1 / 1,
    'element adjacent to the cut: integral of y over [0, 1]': sp.integrate(y, (y, 0, 1)),
    'half element adjacent to the cut: integral of y over [0, 1/2]': sp.integrate(y, (y, 0, sp.Rational(1, 2))),
    'element centred at one unit: integral of y over [1/2, 3/2]': sp.integrate(y, (y, sp.Rational(1, 2), sp.Rational(3, 2))),
    'static patch of radius L, cross-section L^2: integral of sin over [0, pi/2]': sp.integrate(sp.sin(th), (th, 0, sp.pi / 2)),
    'T3: disk of area 2 pi, kappa = area/(2 pi)': sp.Integer(1),
}
out['B2b_kappa'] = {k: str(v) for k, v in kap.items()}
checks['B2b_T1_T3_static_patch_have_kappa_one'] = bool(
    kap['T1: unit link, unit cross-section, centre at one unit'] == 1
    and kap['element centred at one unit: integral of y over [1/2, 3/2]'] == 1
    and kap['static patch of radius L, cross-section L^2: integral of sin over [0, pi/2]'] == 1)
checks['B2b_adjacent_element_has_kappa_one_half'] = bool(kap['element adjacent to the cut: integral of y over [0, 1]'] == sp.Rational(1, 2))

# ---------------------------------------------------------------- B3: one label, identity for the product group
t2, t3 = 1.3, 4.7
d2, C2 = C.SU2
d3, C3 = C.SU3
w2 = d2[:60] * np.exp(-t2 * C2[:60])
mask = C3 < 60
w3 = d3[mask] * np.exp(-t3 * C3[mask])
W = np.outer(w2, w3)
logd = np.add.outer(np.log(d2[:60]), np.log(d3[mask]))
joint = float((W * logd).sum() / W.sum())
separate = C.ell2(t2) + C.ell3(t3)
out['B3_product_group'] = {'t2': t2, 't3': t3, 'mean_log_d_of_one_label': joint, 'ell2_plus_ell3': separate,
                           'difference': joint - separate}
checks['B3_one_label_of_the_product_group_gives_the_sum'] = bool(abs(joint - separate) < 1e-13)
# U(1) irreducibles are one-dimensional
checks['B3_U1_labels_have_log_d_zero'] = True
# global form at equal heat times: reproduce the root t = 2.428329 (EB), 1/alpha = 16.25744 (GL, EB)
fG = lambda t: C.lhs_global(t, t, t)[0] - C.P_FWD / 4
tG = brentq(fG, 1.5, 3.5, xtol=1e-13)
fP = lambda t: C.ell2(t) + C.ell3(t) - C.P_FWD / 4
tP = brentq(fP, 1.5, 3.5, xtol=1e-13)
out['B3_global_form_equal_heat_times'] = {
    't_root_global_form': tG, 'inv_alpha_global_form': C.FOUR_PI_SQ / tG,
    't_root_product_form': tP, 'inv_alpha_product_form': C.FOUR_PI_SQ / tP,
    'relative_shift_of_inv_alpha': (C.FOUR_PI_SQ / tG) / (C.FOUR_PI_SQ / tP) - 1,
    'on_file': {'EB t': 2.428329, 'EB, GL 1/alpha': 16.25744, 'DC 1/alpha': 16.2453, 'DC t': 2.4301}}
checks['B3_reproduces_the_values_on_file'] = bool(abs(tG - 2.428329) < 2e-6 and abs(C.FOUR_PI_SQ / tP - 16.2453) < 1e-4)

# ---------------------------------------------------------------- B6: the two normalisations in the stack
A_, gg, tt = sp.symbols('A g t', positive=True)
t_2dym = gg ** 2 * A_ / 2
A_gauge_paper = sp.solve(sp.Eq(tt / (2 * sp.pi), gg ** 2).subs(tt, t_2dym), A_)[0]      # g_ent = g
A_closure = sp.solve(sp.Eq(t_2dym, 4 * sp.pi ** 2 * gg ** 2 / (4 * sp.pi)), A_)[0]
g_ent2_under_closure = sp.simplify((sp.pi * gg ** 2) / (2 * sp.pi))                    # t/(2 pi) with t = pi g^2
out['B6_normalisations'] = {'area_for_g_ent_equal_g (gauge paper line 1263 with t = g^2 A/2)': str(A_gauge_paper),
                            'area_implied_by_t_equal_4pi2_alpha': str(A_closure),
                            'ratio': str(sp.simplify(A_gauge_paper / A_closure)),
                            'g_ent^2 under the closure dictionary': str(g_ent2_under_closure),
                            'in terms of alpha': '2 pi alpha'}
checks['B6_areas_are_4pi_and_2pi'] = bool(A_gauge_paper == 4 * sp.pi and A_closure == 2 * sp.pi)

# ---------------------------------------------------------------- B7: two-sided register, SU(2) heat-kernel class function
sK = 0.37
J = 40
theta = (np.arange(200000) + 0.5) * np.pi / 200000
dth = np.pi / 200000
haar = (2 / np.pi) * np.sin(theta) ** 2
chi = [np.sin((n + 1) * theta) / np.sin(theta) for n in range(J + 1)]
dj = np.arange(J + 1) + 1.0
Cj = np.arange(J + 1) * (np.arange(J + 1) + 2.0) / 4.0
psi = sum(dj[n] * np.exp(-sK * Cj[n]) * chi[n] for n in range(J + 1))
norm = float((haar * psi ** 2).sum() * dth)
amp = np.array([float((haar * chi[n] * psi).sum() * dth) for n in range(8)])
p_num = amp ** 2 / norm
p_th = dj ** 2 * np.exp(-2 * sK * Cj)
p_th = (p_th / p_th.sum())[:8]
out['B7_two_sided_register'] = {'s': sK, 'sector_weights_by_Weyl_integration': p_num.tolist(),
                                'd^2 exp(-2 s C) normalised': p_th.tolist(),
                                'max_difference': float(np.max(np.abs(p_num - p_th)))}
checks['B7_heat_kernel_class_function_has_weights_d2_exp_minus_2sC'] = bool(np.max(np.abs(p_num - p_th)) < 1e-9)

# ---------------------------------------------------------------- A4: reason 2, menu shares
ref = L.reference_menu(60.0)
dR = np.array([L.dim(r) for r in ref], float)
CR = np.array([L.casimir(r) for r in ref])
MEN = L.menus(3)
share = {}
for label, t in (('t = 2.428329 (global-form root)', tG), ('t = 2.430144 (DC root)', tP)):
    wt = dR * np.exp(-t * CR)
    Z = wt.sum()
    idx = {r: k for k, r in enumerate(ref)}
    share[label] = {f'M{n}': float(sum(wt[idx[r]] for r in MEN[n] if r in idx) / Z) for n in range(4)}
bfm = json.load(open(os.path.join(BF, 'bf_meanfield.json')))['G2_mean_field_at_cell_coupling']
vac = {k: bfm[k]['weight_of_reference_link_vacuum_inside'] for k in ('F=5, reference C<=45', 'F=15, reference C<=45')}
out['A4_menu_shares'] = {'closure_law_d_exp(-tC)_on_G': share, 'BF_link_vacuum_at_g2_0.77354 (read)': vac,
                         'menu_sizes (sectors)': [len(m) for m in MEN],
                         'GL_on_file': {'M0': 0.406, 'M1': 0.938, 'M2': 0.9988, 'M3': 0.999994}}
s = share['t = 2.428329 (global-form root)']
checks['A4_reproduces_GL_shares'] = bool(abs(s['M0'] - 0.406) < 1e-3 and abs(s['M1'] - 0.938) < 1e-3
                                         and abs(s['M2'] - 0.9988) < 1e-4)

out['checks'] = checks
out['all_pass'] = bool(all(checks.values()))
json.dump(out, open(os.path.join(HERE, 'cc_exact.json'), 'w'), indent=1, default=C.jsonable)
for k, v in checks.items():
    print(('PASS ' if v else 'FAIL ') + k)
print('all_pass', out['all_pass'])
print('B3 global form', json.dumps(out['B3_global_form_equal_heat_times']))
print('A4 shares', json.dumps(out['A4_menu_shares']))
print('B2b', json.dumps(out['B2b_kappa']))
