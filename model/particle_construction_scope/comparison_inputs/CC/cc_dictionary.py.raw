"""CC rows B3 (measured part), B4, B5: the dictionary on the collar inside the corrected chain.

The chain is the paper's reading: closure at the anchor mu = m_Z(mu), declared slopes (33/5, 1, -3), P = P_fwd,
solved for the unified value at M_U. Source only: no measured value is read. Writes cc_dictionary.json.
"""
import json
import os
import sys
import time

import numpy as np

sys.dont_write_bytecode = True
import cc_lib as C

t0 = time.time()
HERE = os.path.dirname(os.path.abspath(__file__))
out = {'P': C.P_FWD, 'E_star_GeV': C.E_STAR}

# reference root (f = 1, w = 1)
ref = C.solve_chain()
assert len(ref) == 1, len(ref)
r0 = ref[0]
out['reference'] = C.row(r0)
out['reference']['coordinator_values'] = {'inv_alpha_U': 24.3166, 'v': 246.597, 'mz': 91.588, 'mw': 80.330,
                                          'inv_a1': 59.222, 'inv_a2': 29.605, 'inv_a3': 8.451, 'sin2': 0.23074,
                                          'inv_aem': 128.308, 'alpha_s': 0.11834, 'ell2': 0.39488, 'ell3': 0.01286}
print('reference', json.dumps(out['reference']), flush=True)

# ------------------------------------------------------------------ B3: one label of G at three coupling points
pts = {
    'anchor (chain couplings at m_Z)': (r0['inv_a1'], r0['inv_a2'], r0['inv_a3']),
    'M_U (equal couplings)': (r0['x'],) * 3,
    'retired cell point (16.2453)': (16.245298035421552,) * 3,
}
b3 = {}
for name, inv in pts.items():
    t1, t2, t3 = [C.FOUR_PI_SQ / z for z in inv]
    glob, p0 = C.lhs_global(t1, t2, t3)
    prod = C.ell2(t2) + C.ell3(t3)
    # sensitivity to the hypercharge heat time: change t1 by a factor 2 and 1/2
    g_hi = C.lhs_global(2 * t1, t2, t3)[0]
    g_lo = C.lhs_global(t1 / 2, t2, t3)[0]
    b3[name] = {'heat_times (t1, t2, t3)': [t1, t2, t3], 'one_label_of_G': glob, 'ell2_plus_ell3': prod,
                'difference': glob - prod, 'relative_difference': (glob - prod) / prod,
                'weight_of_the_trivial_label': p0,
                'change_when_t1_is_doubled': g_hi - glob, 'change_when_t1_is_halved': g_lo - glob}
    print('B3', name, json.dumps(b3[name]), flush=True)
out['B3_one_label_of_G'] = b3

# ------------------------------------------------------------------ B4: dictionary factor and weight power
b4 = {}
for f, w in ((1.0, 1), (0.99, 1), (1.01, 1), (0.5, 1), (2.0, 1), (1.0, 2), (2.0, 2), (0.5, 2)):
    roots = C.solve_chain(f=f, w=w)
    key = f'f={f:g}, w={w}'
    if not roots:
        # report the largest left side reachable, to show why no root exists
        best = None
        for xx in np.arange(6.0, 90.0, 0.25):
            c = C.chain(xx, f=f, w=w)
            if c is not None and (best is None or c['lhs'] > best['lhs']):
                best = c
        b4[key] = {'roots': 0, 'largest_left_side_on_the_scan': None if best is None else best['lhs'],
                   'at_x': None if best is None else best['x'], 'P_over_4': C.P_FWD / 4}
    else:
        b4[key] = {'roots': len(roots), 'rows': [C.row(c) for c in roots]}
    print('B4', key, json.dumps(b4[key]), flush=True)
out['B4_factor_and_weight_power'] = b4
lo, hi = b4['f=0.99, w=1']['rows'][0], b4['f=1.01, w=1']['rows'][0]
out['B4_logarithmic_derivatives_at_f=1'] = {
    'd ln v / d ln f': (np.log(hi['v']) - np.log(lo['v'])) / (np.log(1.01) - np.log(0.99)),
    'd (1/alpha_U) / d ln f': (hi['x'] - lo['x']) / (np.log(1.01) - np.log(0.99)),
    'd ln alpha_s / d ln f': (np.log(hi['alpha_s']) - np.log(lo['alpha_s'])) / (np.log(1.01) - np.log(0.99)),
    'd sin2 / d ln f': (hi['sin2'] - lo['sin2']) / (np.log(1.01) - np.log(0.99))}
print('B4 derivatives', json.dumps(out['B4_logarithmic_derivatives_at_f=1']), flush=True)

# ------------------------------------------------------------------ B5: Wilson-form weights on the SU(2) factor
a2 = 1 / r0['inv_a2']
l2_heat = C.ell2(C.FOUR_PI_SQ * a2)
l2_wil = C.ell2_wilson(a2)
g2 = 4 * np.pi * a2
from scipy.special import ive
lam_half = float(ive(2.0, 4 / g2) / ive(1.0, 4 / g2))
roots = C.solve_chain(su2='wilson')
out['B5_wilson_form_on_SU2'] = {
    'g2_squared_at_anchor': g2, 'beta': 4 / g2,
    'character_ratio_j=1/2 per plaquette unit': lam_half, 'heat_kernel_value exp(-(g^2/2)(3/4))': float(np.exp(-g2 / 2 * 0.75)),
    'effective_heat_time_ratio (j=1/2)': float(-np.log(lam_half) / (g2 / 2 * 0.75)),
    'ell2_heat_kernel_at_anchor': l2_heat, 'ell2_wilson_at_anchor': l2_wil,
    'left_side_change_at_the_reference_point': l2_wil - l2_heat,
    'chain_roots': [C.row(c) for c in roots]}
print('B5', json.dumps(out['B5_wilson_form_on_SU2']), flush=True)

out['seconds'] = round(time.time() - t0, 1)
json.dump(out, open(os.path.join(HERE, 'cc_dictionary.json'), 'w'), indent=1, default=C.jsonable)
print('seconds', out['seconds'])
