"""Worker CH, direction 4: the chain's outputs for every registered variant (CANDIDATES.md section 6 and addendum 2).

Run: /tmp/oph-completion-venv/bin/python ch_chain.py [out.json]

Engines: work/COUPLING/closure_check.py (rows V, P, F of section 6) and work/LV/lv_chain.py (rows SA, SA', SB, SD of
addendum 2), both imported read only. For hypercharge normalisations other than the SU(5) value the class Chain of
ch_lib.py runs the same equations with the engine's own ell2, ell3 and EP; it is gated against both engines.
No measured value is read. P = 1.6309721.
"""
import json
import sys
from pathlib import Path

import numpy as np
from scipy.optimize import brentq

from ch_lib import Chain, load_engine, load_lv, clean, P0

OUT = Path(sys.argv[1]) if len(sys.argv) > 1 else Path(__file__).with_name('chain.json')
pi = np.pi
cc, lv = load_engine(), load_lv()
out = {'P': P0}

# ----------------------------------------------------------------------------- gates
gates = {}
xg = cc.solve(P0)
ref = cc.chain(P0, 1 / xg)
mine = Chain(cc).solve()
assert len(mine) == 1
m0 = mine[0]
gates['closure_check declared row'] = dict(
    inv_alpha_U=(xg, m0['inv_alpha_U']), v=(ref['v'], m0['v']), m_Z=(ref['mz'], m0['m_Z']), m_W=(ref['mw'], m0['m_W']),
    sin2=(ref['s2'], m0['sin2']), inv_alpha_em=(ref['aem_inv'], m0['inv_alpha_em']))
for k, (a, b) in gates['closure_check declared row'].items():
    assert abs(a - b) < 2e-9 * abs(a), (k, a, b)
printed = {'(41/5, 1, -3)': ((41 / 5, 1.0, -3.0), 24.3185, 245.9, 67.709, 29.610, 8.444, 0.20785, 142.458),
           '(81/10, 5/6, -3)': ((81 / 10, 5 / 6, -3.0), 24.9510, 91.03, 69.094, 29.492, 8.602, 0.20389, 144.648),
           '(83/10, 7/6, -3)': ((83 / 10, 7 / 6, -3.0), 23.7163, 633.1, 66.385, 29.714, 8.294, 0.21170, 140.356)}
for k, (b, x, v, i1, i2, i3, s2, aem) in printed.items():
    r = Chain(cc, b=b).solve()[0]
    assert abs(r['inv_alpha_U'] - x) < 6e-5 and abs(r['v'] / v - 1) < 6e-4 and abs(r['inv_alpha_1'] - i1) < 6e-4
    assert abs(r['inv_alpha_2'] - i2) < 6e-4 and abs(r['inv_alpha_3'] - i3) < 6e-4 and abs(r['sin2'] - s2) < 6e-6 and abs(r['inv_alpha_em'] - aem) < 6e-4
    gates['closure_variants.out ' + k] = 'reproduced to the printed digits'
g_of = lambda x: np.sqrt(4 * pi / x)
PREF = {'1': 1.0, '2': 2.0, "2 (2 sqrt2/g) tan(g/(2 sqrt2))": lambda x: 2 * 2 * np.sqrt(2) / g_of(x) * np.tan(g_of(x) / (2 * np.sqrt(2)))}
for (b, pf) in (((33 / 5, 1.0, -3.0), '1'), ((81 / 10, 5 / 6, -3.0), '2'), ((81 / 10, 5 / 6, -3.0), "2 (2 sqrt2/g) tan(g/(2 sqrt2))"),
                ((41 / 5, 1.0, -3.0), '1')):
    roots = lv.solve(b=b, pref=PREF[pf])
    assert len(roots) == 1
    x, c = roots[0]
    r = Chain(lv, b=b, pref=PREF[pf]).solve()
    assert len(r) == 1
    r = r[0]
    for a, bb in ((x, r['inv_alpha_U']), (c['v'], r['v']), (c['mz'], r['m_Z']), (c['s2'], r['sin2']), (c['aem_inv'], r['inv_alpha_em']),
                  (1 / c['a1'], r['inv_alpha_1']), (1 / c['a2'], r['inv_alpha_2']), (c['a3'], r['alpha_s'])):
        assert abs(a - bb) < 2e-9 * abs(a), (b, pf, a, bb)
    gates[f'lv_chain {b} prefactor {pf}'] = dict(inv_alpha_U=x, v=c['v'])
out['gates'] = gates

# ----------------------------------------------------------------------------- rows
rows = {}


def add(key, text, engine, b, c_Y=5 / 3, pref=1.0, inv1=None, status='', engine_name=''):
    ch = Chain(engine, b=b, c=(0.6 * c_Y, 1.0, 1.0), pref=pref, inv1=inv1)
    sols = ch.solve()
    if not sols:
        rows[key] = dict(variant=text, slopes=list(b), status=status, engine=engine_name, closure='no root')
        return None
    r = sols[0]
    b1 = b[0]
    r = dict(r)
    r['c_Y_at_M_U'] = r['inv_alpha_Y_MU'] / r['inv_alpha_U']
    r['c_1_at_M_U'] = r['inv_alpha_1_MU'] / r['inv_alpha_U']
    # one-loop pole of the hypercharge coupling above M_U: 1/alpha_1 = 0 at Lambda_Y
    r['ln_pole_over_E_cell'] = 2 * pi * r['inv_alpha_1_MU'] / b1 - np.log(r['E_cell'] / r['M_U'])
    r['inv_alpha_Y_at_E_cell'] = (r['inv_alpha_1_MU'] - b1 / (2 * pi) * np.log(r['E_cell'] / r['M_U'])) / 0.6
    rows[key] = dict(variant=text, slopes=list(b), status=status, engine=engine_name, roots=len(sols), **r)
    return r


B2 = (41 / 5, 1.0, -3.0)
B1 = (81 / 10, 5 / 6, -3.0)
B3 = (83 / 10, 7 / 6, -3.0)
BD = (33 / 5, 1.0, -3.0)
CE = 'closure_check'

add('V0', 'declared chain', cc, BD, status='declared (gate)', engine_name=CE)
add('V1', 'two doublets, trace N1 to N4', cc, B2, status='source content with a second doublet; source trace', engine_name=CE)
add('V2', 'one doublet, trace N1 to N4, prefactor 1', cc, B1, status='source as built, law for v with unit prefactor', engine_name=CE)
add('V3', 'three doublets, trace N1 to N4', cc, B3, status='one doublet per copy', engine_name=CE)
add('V4', 'two doublets, doublet-block normalisation', cc, B2, c_Y=1.0, status='trace N5 (no colour stiffness of its own)', engine_name=CE)
add('V5', 'one doublet, doublet-block normalisation, prefactor 1', cc, B1, c_Y=1.0, status='trace N5', engine_name=CE)
add('V6', 'three doublets, doublet-block normalisation', cc, B3, c_Y=1.0, status='trace N5', engine_name=CE)
add('V7', 'two doublets, port metric', cc, B2, c_Y=1 / 3, status='form N8 (no invariant colour action)', engine_name=CE)
add('V8', 'two doublets, class-0 charged singlets absent', cc, (29 / 5, 1.0, -3.0), status='no source statement removes them', engine_name=CE)
zero_at = lambda scale: (lambda mu, ctx: ctx['b'][0] / (2 * pi) * np.log(scale(ctx) / mu))
add('V9', 'two doublets, hypercharge stiffness zero at E_cell', cc, B2, inv1=zero_at(lambda ctx: ctx['Ecell']),
    status='functional N7 with induced coupling', engine_name=CE)
add('V10', 'two doublets, hypercharge at the SU(5) value at E_cell', cc, B2,
    inv1=lambda mu, ctx: ctx['x'] + ctx['b'][0] / (2 * pi) * np.log(ctx['Ecell'] / mu), status='5-trace at the cell for U(1) only', engine_name=CE)
add('V11', 'two doublets, block relation at E_cell', cc, B2,
    inv1=lambda mu, ctx: 0.6 * ((2 / 3) * ctx['i3'](ctx['Ecell']) + ctx['i2'](ctx['Ecell'])) + ctx['b'][0] / (2 * pi) * np.log(ctx['Ecell'] / mu),
    status='U(3) x U(2) block traces at the cell', engine_name=CE)
for key, b in (('V12 CEN-8', (41 / 10, -19 / 6, -7.0)), ('V12 CEN-5', (61 / 10, -7 / 6, -5.0)), ('V12 CEN-3', (161 / 10, 53 / 6, 5.0))):
    add(key, 'census ' + key[4:] + ' with one doublet', cc, b, status='other census', engine_name=CE)
# post hoc rows (no weight)
add('P1', 'two doublets, c_1 = 2/3', cc, B2, c_Y=10 / 9, status='post hoc', engine_name=CE)
add('P2a', 'two doublets, c_Y = 13/12', cc, B2, c_Y=13 / 12, status='post hoc (coordinator look)', engine_name=CE)
add('P2b', 'two doublets, c_Y = 16/15', cc, B2, c_Y=16 / 15, status='post hoc (coordinator look)', engine_name=CE)
xcut = brentq(lambda x: cc.ell2(4 * pi * pi / x) + cc.ell3(4 * pi * pi / x) - P0 / 4, 5.0, 60.0)
out['cut_value'] = xcut
add('P3', 'two doublets, 1/alpha_1(M_U) = cut value', cc, B2,
    inv1=lambda mu, ctx: xcut + ctx['b'][0] / (2 * pi) * np.log(ctx['MU'] / mu), status='post hoc, retired premise', engine_name=CE)
add('P4', 'two doublets, SU(5) value one modular period below M_U', cc, B2,
    inv1=lambda mu, ctx: ctx['x'] - ctx['b'][0] + ctx['b'][0] / (2 * pi) * np.log(ctx['MU'] / mu), status='post hoc', engine_name=CE)
add('P5', 'c_Y = 1 with b_1 = 42/5', cc, (42 / 5, 1.0, -3.0), c_Y=1.0, status='post hoc; needs a charged scalar singlet', engine_name=CE)

# fits on the declared chain's values (no measured value)
dec = rows['V0']


def fit_cY(engine, b, pref, target_key, target, lo=0.3, hi=2.4):
    f = lambda cy: Chain(engine, b=b, c=(0.6 * cy, 1.0, 1.0), pref=pref).solve()[0][target_key] - target
    return brentq(f, lo, hi, xtol=1e-12)


cy = fit_cY(cc, B2, 1.0, 'inv_alpha_1', dec['inv_alpha_1'])
add('F1', 'two doublets, c_Y fitted on the declared 1/alpha_1(m_Z)', cc, B2, c_Y=cy, status='fit', engine_name=CE)
out['F3_b1_on_declared_value_with_SU5_normalisation'] = 33 / 5

# source variants of addendum 2 (engine lv_chain)
LE = 'lv_chain'
add('SD', 'declared slopes, prefactor 1', lv, BD, status='declared (gate)', engine_name=LE)
SRC = {'SA': ('one doublet, m = 2', B1, PREF['2']), "SA'": ('one doublet, m = 2, theta_0 = g/(2 sqrt2)', B1, PREF["2 (2 sqrt2/g) tan(g/(2 sqrt2))"]),
       'SB': ('two doublets, m = 1', B2, PREF['1'])}
for key, (text, b, pf) in SRC.items():
    add(f'{key} 5/3', f'{text}; trace normalisation 5/3', lv, b, pref=pf, status='source trace N1 to N4', engine_name=LE)
    add(f'{key} 1', f'{text}; doublet-block normalisation 1', lv, b, c_Y=1.0, pref=pf, status='trace N5', engine_name=LE)
    if key != "SA'":
        add(f'{key} 1/3', f'{text}; port metric 1/3', lv, b, c_Y=1 / 3, pref=pf, status='form N8', engine_name=LE)
        add(f'{key} zero at cell', f'{text}; hypercharge stiffness zero at E_cell', lv, b, pref=pf, inv1=zero_at(lambda ctx: ctx['Ecell']),
            status='functional N7 with induced coupling', engine_name=LE)
        add(f'P6 {key}', f'{text}; hypercharge stiffness zero at E_cell exp(2 pi)', lv, b, pref=pf,
            inv1=zero_at(lambda ctx: ctx['Ecell'] * np.exp(2 * pi)), status='post hoc', engine_name=LE)
        cyf = fit_cY(lv, b, pf, 'sin2', dec['sin2'])
        add(f'F{key[1]}', f'{text}; c_Y fitted on the declared sin^2 theta_W', lv, b, c_Y=cyf, pref=pf, status='fit', engine_name=LE)
out['rows'] = rows

OUT.write_text(json.dumps(clean(out), indent=1))
cols = ('inv_alpha_U', 'v', 'm_Z', 'm_W', 'inv_alpha_1', 'inv_alpha_2', 'alpha_s', 'sin2', 'inv_alpha_em', 'c_Y_at_M_U', 'ln_pole_over_E_cell')
print(f"{'row':17s} " + ' '.join(f'{c[:11]:>11s}' for c in cols))
for k, r in rows.items():
    if 'closure' in r:
        print(f'{k:17s} no root   {r["variant"]}')
        continue
    print(f'{k:17s} ' + ' '.join(f'{r[c]:11.5f}' for c in cols) + f'   {r["variant"]} [{r["status"]}]')
print('cut value', xcut)
print('wrote', OUT)
