"""Worker CH: the single comparison with measurement (NOT BLIND). CANDIDATES.md section 7 and addendum 2.

Run once, after chain.json and outer.json are on file:
    /tmp/oph-completion-venv/bin/python ch_compare.py [out.json]

This is the only script of this directory that reads measured values. Reference values: the "Measured" column of
RL/COUPLING_FIX.md section 2; the Thomson value 1/alpha(0) = 137.035999 (IMPORTED from memory, CODATA 2022).
Registered rule: a hypercharge variant passes when sin^2 theta_W(m_Z) and 1/alpha_em(m_Z) both lie within 0.5 percent
of the reference. Rows P and F carry no weight.
"""
import json
import sys
from pathlib import Path

import numpy as np
from scipy.optimize import brentq

from ch_lib import Chain, load_engine, load_lv, clean

OUT = Path(sys.argv[1]) if len(sys.argv) > 1 else Path(__file__).with_name('compare.json')
HERE = Path(__file__).resolve().parent
pi = np.pi
REF = dict(v=246.22, m_Z=91.188, m_W=80.37, inv_alpha_2=29.58, alpha_s=0.1180, sin2=0.23122, inv_alpha_em=127.95)
REF0 = 137.035999
chain = json.loads((HERE / 'chain.json').read_text())
outer = json.loads((HERE / 'outer.json').read_text())
out = {'reference': REF, 'reference_thomson': REF0, 'rows': {}}
for key, r in chain['rows'].items():
    if 'closure' in r:
        out['rows'][key] = dict(variant=r['variant'], status=r['status'], result='no root')
        continue
    dev = {k: 100 * (r[k] / REF[k] - 1) for k in REF}
    passes = abs(dev['sin2']) <= 0.5 and abs(dev['inv_alpha_em']) <= 0.5
    weight = not (key.startswith('P') or key.startswith('F'))
    out['rows'][key] = dict(variant=r['variant'], status=r['status'], percent=dev, passes_registered_rule=bool(passes), carries_weight=weight)
out['passing_rows_with_weight'] = [k for k, v in out['rows'].items() if v.get('passes_registered_rule') and v.get('carries_weight')]
out['passing_rows_without_weight'] = [k for k, v in out['rows'].items() if v.get('passes_registered_rule') and not v.get('carries_weight')]

# fits on the measured sin^2 theta_W (derive nothing)
cc, lv = load_engine(), load_lv()
B1, B2 = (81 / 10, 5 / 6, -3.0), (41 / 5, 1.0, -3.0)


def fit(engine, b, pref, key='sin2'):
    f = lambda cy: Chain(engine, b=b, c=(0.6 * cy, 1.0, 1.0), pref=pref).solve()[0][key] - REF[key]
    cy = brentq(f, 0.3, 2.4, xtol=1e-12)
    r = Chain(engine, b=b, c=(0.6 * cy, 1.0, 1.0), pref=pref).solve()[0]
    pole = 2 * pi * r['inv_alpha_1_MU'] / b[0] - np.log(r['E_cell'] / r['M_U'])
    return dict(c_Y=cy, c_1=0.6 * cy, inv_alpha_em=r['inv_alpha_em'], v=r['v'], ln_pole_over_E_cell=pole,
                inv_alpha_Y_at_E_cell=(r['inv_alpha_1_MU'] - b[0] / (2 * pi) * np.log(r['E_cell'] / r['M_U'])) / 0.6,
                b_Y=5 / 3 * b[0])


out['fits_on_measured_sin2'] = {'F2 two doublets, prefactor 1 (closure_check)': fit(cc, B2, 1.0),
                                'GA one doublet, m = 2 (lv_chain)': fit(lv, B1, 2.0),
                                'GB two doublets, m = 1 (lv_chain)': fit(lv, B2, 1.0)}
# outer map rows
out['outer'] = {}
for key, r in outer['rows'].items():
    f = r['fixed_point']
    if isinstance(f, dict):
        out['outer'][key] = dict(inv_alpha_0=f['inv_alpha_0'], percent_inv_alpha_0=100 * (f['inv_alpha_0'] / REF0 - 1),
                                 v=f['v'], percent_v=100 * (f['v'] / REF['v'] - 1), sin2=f['sin2'], percent_sin2=100 * (f['sin2'] / REF['sin2'] - 1))
out['count'] = dict(comparison_runs=1, rows_compared=len(out['rows']), rows_with_weight=sum(1 for v in out['rows'].values() if v.get('carries_weight')),
                    passing_with_weight=len(out['passing_rows_with_weight']))
OUT.write_text(json.dumps(clean(out), indent=1))
print(f"{'row':17s} {'v':>8s} {'m_Z':>8s} {'m_W':>8s} {'1/a2':>8s} {'a_s':>8s} {'sin2':>8s} {'1/a_em':>8s}  pass  weight")
for k, v in out['rows'].items():
    if 'percent' not in v:
        print(f'{k:17s} no root')
        continue
    p = v['percent']
    print(f"{k:17s} " + ' '.join(f"{p[c]:+8.2f}" for c in ('v', 'm_Z', 'm_W', 'inv_alpha_2', 'alpha_s', 'sin2', 'inv_alpha_em'))
          + f"  {str(v['passes_registered_rule']):5s} {str(v['carries_weight']):5s}  {v['variant']}")
print('passing with weight:', out['passing_rows_with_weight'])
print('passing without weight:', out['passing_rows_without_weight'])
for k, v in out['fits_on_measured_sin2'].items():
    print('fit', k, {a: round(b, 5) for a, b in v.items()})
for k, v in out['outer'].items():
    print('outer', k, {a: round(b, 4) for a, b in v.items()})
print(out['count'])
print('wrote', OUT)
