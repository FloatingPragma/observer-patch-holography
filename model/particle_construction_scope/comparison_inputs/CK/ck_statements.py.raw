rows, bad = [], 0
for grp, rel, line, phrase, tag in S:
    path = os.path.join(RER, rel)
    try:
        lines = open(path, encoding='utf-8', errors='replace').read().split('\n')
    except OSError:
        rows.append({'group': grp, 'file': rel, 'claimed': line, 'found': None, 'phrase': phrase, 'tag': tag, 'ok': False})
        bad += 1
        continue
    hits = [i + 1 for i, t in enumerate(lines) if phrase in t]
    near = [h for h in hits if abs(h - line) <= 6]
    found = near[0] if near else (hits[0] if hits else None)
    ok = found is not None
    bad += 0 if ok else 1
    rows.append({'group': grp, 'file': rel, 'claimed': line, 'found': found, 'phrase': phrase, 'tag': tag, 'ok': ok,
                 'near_claim': bool(near)})
json.dump({'RER': RER, 'entries': rows, 'missing': bad}, open(os.path.join(HERE, 'statements_check.json'), 'w'), indent=1)
for r in rows:
    if not r['ok'] or not r.get('near_claim'):
        print('CHECK', r['group'], r['file'], 'claimed', r['claimed'], 'found', r['found'], '|', r['phrase'][:60])
print('entries', len(rows), 'missing', bad)

# ---- candidate C7: N fitted to the measured mu/e through Z_N and theta_N together (FIT), then tau/e and Q -------------
mp.mp.dps = 40
P = mp.mpf(2) / 9
a0, b0 = 1 / mp.sqrt(6), 1 / mp.sqrt(12)
me, mmu, mtau = mp.mpf('0.51099895069'), mp.mpf('105.6583755'), mp.mpf('1776.93246513409')
sig_te = mp.mpf('0.169')


def masses(N):
    z = (1 - P + P * mp.exp(1j / N)) ** N
    th, Z = mp.arg(z), abs(z)
    return sorted((a0 + 2 * b0 * Z * mp.cos(th + 2 * mp.pi * k / 3)) ** 2 for k in range(3)), th, Z


Nfit = mp.findroot(lambda n: masses(n)[0][1] / masses(n)[0][0] - mmu / me, mp.mpf('4e5'))
ms, th, Z = masses(Nfit)
Q = sum(ms) / sum(mp.sqrt(x) for x in ms) ** 2
c7 = {'N fitted to mu/e (FIT)': mp.nstr(Nfit, 8), '1 - Z_N': mp.nstr(1 - Z, 6), 'theta_N - 2/9': mp.nstr(th - P, 6),
      'tau/e': mp.nstr(ms[2] / ms[0], 10), 'tau/e measured': mp.nstr(mtau / me, 10),
      'tau/e pull (sigma 0.169)': mp.nstr((ms[2] / ms[0] - mtau / me) / sig_te, 4), 'Q - 2/3': mp.nstr(Q - mp.mpf(2) / 3, 6),
      'status': 'FIT of one parameter to one number; tau/e is the remaining check; NOT BLIND'}
json.dump(c7, open(os.path.join(HERE, 'c7.json'), 'w'), indent=1)
print(json.dumps(c7, indent=1))
