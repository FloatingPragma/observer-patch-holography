"""Worker LD (step L5): functions of the two-loop QED relation between the pole mass and short-distance masses.

Sources of every formula are listed in LITERATURE.md. No measured value is used in this file.

X(r)      species term of M/mbar(M) at fixed MSbar mass and coupling (mu = M), per charged lepton species of mass
          r M. Exact two-loop function of Gray, Broadhurst, Grafe, Schilcher 1990 as printed in Bekavac, Grozin,
          Seidel, Steinhauser 2007, equation (delm2), with the sign of the inverse relation.
G(z)      one-loop kernel of a photon of mass sqrt(z) M at fixed short-distance mass (own derivation, see
          READING_RULE.md): G(z) = -(1/2) int_0^1 dx (1 + x) ln(1 + (1 - x) z / x^2).
"""
import math

import mpmath as mp
import numpy as np
from scipy import integrate, interpolate

mp.mp.dps = 40

D3 = -(mp.mpf(71) / 96 + mp.pi ** 2 / 12)      # massless species, MvR d^(2)_3 with the sign of M/mbar
D4 = -(mp.mpf(143) / 96 - mp.pi ** 2 / 6)      # own species, MvR d^(2)_4 with the sign of M/mbar
DELTA1 = mp.pi ** 2 / 8 - mp.mpf(3) / 8         # Delta(1) = (D4 - D3)/2
DEC_CONST = mp.mpf(89) / 288                    # mass decoupling constant, QED normalization (CKS 1997)


def X(r):
    """Species term of M/mbar(M), all r >= 0."""
    r = mp.mpf(r)
    if r == 0:
        return D3
    L = mp.log(r)
    t1 = 48 * r ** 4 * L ** 2 + 48 * r ** 2 * L + 72 * r ** 2 + 8 * mp.pi ** 2 * (r ** 4 - 3 * r ** 3 - 3 * r + 1) + 71
    t2 = -48 * (r + 1) ** 2 * (r ** 2 - r + 1) * (L * mp.log(1 + r) + mp.polylog(2, -r))
    if r == 1:
        t3 = mp.mpf(0)
    else:
        t3 = -48 * (r - 1) ** 2 * (r ** 2 + r + 1) * mp.re(L * mp.log(mp.mpc(1 - r)) + mp.polylog(2, r))
    return -(t1 + t2 + t3) / 96


def Delta(r):
    """Gray et al.'s mass function: X(r) = d_3 + 2 Delta(r)."""
    return (X(r) - D3) / 2


def X_large_r(r):
    """Non-decoupled asymptotic form for a heavy species: (1/2) ln^2 r + (13/12) ln r + 89/288."""
    L = mp.log(mp.mpf(r))
    return L ** 2 / 2 + mp.mpf(13) / 12 * L + DEC_CONST


def h(r):
    """Decoupled remainder of a heavier species (Thomson charge, decoupled short-distance mass)."""
    return X(r) - X_large_r(r)


def P(r):
    """Three times the on-shell vacuum polarization at spacelike Q^2 = M^2 in units of alpha/pi:
    alpha_eff(Q^2 = M^2) = alpha (1 + (alpha/pi) P(r)/3)."""
    r = mp.mpf(r)
    return 6 * mp.quad(lambda x: x * (1 - x) * mp.log(1 + x * (1 - x) / r ** 2), [0, mp.mpf(1) / 2, 1])


def G_quad(z):
    z = mp.mpf(z)
    if z == 0:
        return mp.mpf(0)
    return -mp.quad(lambda x: (1 + x) * mp.log(1 + (1 - x) * z / x ** 2), [0, mp.mpf(1) / 4, mp.mpf(1) / 2, 1]) / 2


def G_closed(z):
    """Closed form of G through the roots of x^2 - z x + z."""
    z = mp.mpf(z)
    if z == 0:
        return mp.mpf(0)
    disc = mp.sqrt(mp.mpc(z * z - 4 * z))
    total = mp.mpc(0)
    for c in ((z + disc) / 2, (z - disc) / 2):
        total += (2 * mp.log(1 - c) - mp.log(-c) / 2 - (1 - 2 * c) / 4 - (1 + c)
                  - (1 + c) ** 2 / 2 * (mp.log(1 - c) - mp.log(-c)))
    return -(mp.re(total) + mp.mpf(5) / 2) / 2


def G_inf(z):
    """Asymptotic form of G for a heavy photon."""
    return -mp.mpf(3) / 4 * mp.log(z) - mp.mpf(3) / 8


# ---------------------------------------------------------------- float table of G for the dispersive integrals
_T = np.linspace(math.log(1e-14), math.log(1e14), 2601)
_GV = np.array([float(G_closed(mp.e ** mp.mpf(float(t)))) for t in _T])
_G_SPLINE = interpolate.CubicSpline(_T, _GV)


def G_float(z):
    z = np.asarray(z, dtype=float)
    t = np.log(np.maximum(z, 1e-300))
    out = np.where(t < _T[0], -(math.pi / 2) * np.sqrt(np.maximum(z, 0.0)),
                   np.where(t > _T[-1], -0.75 * t - 0.375, _G_SPLINE(np.clip(t, _T[0], _T[-1]))))
    return out


def R_lep(z, r):
    """Spectral function of a charged lepton pair of mass r M at s = z M^2."""
    z = np.asarray(z, dtype=float)
    x = 4.0 * r * r / np.maximum(z, 1e-300)
    return np.where(x < 1.0, (1.0 + x / 2.0) * np.sqrt(np.maximum(1.0 - x, 0.0)), 0.0)


def disp_diff(Ra, Rb, breaks=(), kernel=G_float, tmin=-60.0, tmax=60.0):
    """(1/3) int_0^inf (dz/z) (Ra(z) - Rb(z)) kernel(z), integrated in t = ln z."""
    pts = sorted(set([tmin, tmax] + [math.log(b) for b in breaks if b > 0 and tmin < math.log(b) < tmax]))
    total = 0.0
    for lo, hi in zip(pts[:-1], pts[1:]):
        val, _ = integrate.quad(lambda t: float((Ra(math.exp(t)) - Rb(math.exp(t))) * kernel(math.exp(t))), lo, hi,
                                limit=400, epsabs=1e-12, epsrel=1e-10)
        total += val
    return total / 3.0


def disp_X_diff(r, rp):
    """X(r) - X(rp) from the dispersive identity I2 (independent of the closed form)."""
    return disp_diff(lambda z: float(R_lep(z, r)), lambda z: float(R_lep(z, rp)), breaks=(4 * r * r, 4 * rp * rp))


def disp_h(r):
    """Decoupled remainder from the kernel difference: (1/3) int (dz/z) R(z; r) (G(z) - G_inf(z))."""
    return disp_diff(lambda z: float(R_lep(z, r)), lambda z: 0.0, breaks=(4 * r * r,),
                     kernel=lambda z: float(G_float(z)) + 0.75 * math.log(z) + 0.375)


# ---------------------------------------------------------------- the register
def register_rates(theta=mp.mpf(2) / 9):
    """y_k of LEPTON_STEPS.md section 1: tau, electron, muon."""
    y = [(1 + mp.sqrt(2) * mp.cos(theta + 2 * mp.pi * k / 3)) ** 2 / 27 for k in range(3)]
    return {'tau': y[0], 'e': y[1], 'mu': y[2]}


def koide_Q(m):
    s = sum(m.values())
    q = sum(mp.sqrt(v) for v in m.values())
    return s / q ** 2
