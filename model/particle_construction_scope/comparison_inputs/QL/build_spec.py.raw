def main():
    listed = set(TAPE["inhabited_exactly"]) | set(TAPE["inhabited_as_reconstruction"]) | set(TAPE["inhabited_on_the_classical_domain_only"])
    for f in FIELDS:
        if not f["committed_source_tape_reconstruction"]:
            if f["id"] in TAPE["inhabited_exactly"]:
                f["committed_source_tape_reconstruction"] = "inhabited exactly (see the score of candidate i)"
            elif f["id"] in listed:
                f["committed_source_tape_reconstruction"] = "inhabited as a reconstruction or on the classical domain only"
            elif not f["scored"]:
                f["committed_source_tape_reconstruction"] = "no obligation"
            else:
                f["committed_source_tape_reconstruction"] = "not inhabited"
    ids = [f["id"] for f in FIELDS]
    assert len(ids) == len(set(ids)), "duplicate field id"
    known = set(ids)
    for row in PATH:
        for x in row["fields"]:
            assert x in known, x
    for x in TAPE["inhabited_exactly"] + TAPE["inhabited_as_reconstruction"] + TAPE["inhabited_on_the_classical_domain_only"]:
        assert x in known, x
    for x in JOINT["one_carrier_join_of_i_and_iii"]["inhabited_together"]:
        assert x in known, x
    for f in FIELDS:
        for t in f["consumed_by"]:
            assert t in THEOREMS, (f["id"], t)
        for c in ("i", "ii", "iii"):
            m = f["score"][c]
            assert m["mark"] in MARKS, (f["id"], c, m)
            if m["mark"] == "COMP":
                assert m.get("worker"), (f["id"], c)

    order = {"EXACT": 3, "SHADOW": 2, "COMP": 1, "NO": 0}
    fams = OrderedDict((k, v["family"]) for k, v in THEOREMS.items())
    tall = OrderedDict()
    for cand in ("i", "ii", "iii", "join_i_iii", "join_all"):
        per = OrderedDict()
        for fam in "abcdefghi":
            c = Counter()
            for f in FIELDS:
                if not f["scored"] or f["family"] != fam:
                    continue
                if cand == "join_i_iii":
                    mi, mj = f["score"]["i"]["mark"], f["score"]["iii"]["mark"]
                    m = mi if order[mi] >= order[mj] else mj
                elif cand == "join_all":
                    m = max((f["score"][c]["mark"] for c in ("i", "ii", "iii")), key=lambda k: order[k])
                else:
                    m = f["score"][cand]["mark"]
                c[m] += 1
            per[fam] = OrderedDict((k, c.get(k, 0)) for k in MARKS)
        tot = Counter()
        for v in per.values():
            tot.update(v)
        per["all"] = OrderedDict((k, tot.get(k, 0)) for k in MARKS)
        tall[cand] = per
    scored = sum(1 for f in FIELDS if f["scored"])

    consumers = Counter()
    for f in FIELDS:
        if f["scored"]:
            for t in f["consumed_by"]:
                consumers[t] += 1
    open_join = [f["id"] for f in FIELDS if f["scored"] and
                 max(order[f["score"]["i"]["mark"]], order[f["score"]["iii"]["mark"]]) < 3]
    in_path = set(x for row in PATH for x in row["fields"])
    not_in_path = [x for x in open_join if x not in in_path]

    spec = OrderedDict([
        ("schema", "repair-law.QL.spec.v1"),
        ("date", "2026-11-10"),
        ("worker", "QL (simulation session)"),
        ("sources_read_only", [RER + " at 2d5a9d1c0 plus uncommitted model/coherent_seam_repair and model/coherent_defect_wave",
                               "repair-law/reports as of 2026-11-10 18:43 (+07): MC, MF, MG, MU (final), MT (blocks 1 to 4), QF, CX, CA, MW (interim)"]),
        ("marks", MARKS),
        ("theorems", THEOREMS),
        ("candidates", CANDIDATES),
        ("fields", FIELDS),
        ("committed_source_tape_and_reconstruction", TAPE),
        ("compatibility", OrderedDict([("conflicts", CONFLICTS), ("apparent_conflicts", APPARENT), ("joint_inhabitation", JOINT)])),
        ("shortest_path", PATH),
        ("tallies", OrderedDict([("fields_total", len(FIELDS)), ("fields_scored", scored), ("by_candidate", tall),
                                 ("scored_fields_per_theorem", OrderedDict((k, consumers.get(k, 0)) for k in THEOREMS)),
                                 ("open_for_join_i_iii", open_join), ("open_fields_outside_the_path", not_in_path)])),
    ])
    out = HERE / "spec.json"
    out.write_text(json.dumps(spec, indent=1, ensure_ascii=False) + "\n", encoding="utf-8")

    print("fields", len(FIELDS), "scored", scored)
    for cand, per in tall.items():
        print(cand, dict(per["all"]))
    print("per family (EXACT of scored): i, ii, iii, join_i_iii, join_all")
    for fam in "abcdefghi":
        n = sum(tall["i"][fam].values())
        print(" ", fam, n, [tall[c][fam]["EXACT"] for c in ("i", "ii", "iii", "join_i_iii", "join_all")])
    only_ii = [f["id"] for f in FIELDS if f["scored"] and f["score"]["ii"]["mark"] == "EXACT"
               and f["score"]["i"]["mark"] != "EXACT" and f["score"]["iii"]["mark"] != "EXACT"]
    print("EXACT in (ii) only:", only_ii)
    print("open for the join:", len(open_join), "outside the path:", not_in_path)
    print("scored fields per theorem:", dict(consumers))
    return 0


if __name__ == "__main__":
    sys.exit(main())
