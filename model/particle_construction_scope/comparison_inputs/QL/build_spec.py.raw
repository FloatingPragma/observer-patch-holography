])

FIELDS = []


def F(fid, name, lean, files, statement, kind, constrains, consumed, i, ii, iii,
      register=(), requirement=(), toy="", executable="", tape="", scored=True):
    def sc(t):
        d = {"mark": t[0], "note": t[1]}
        if len(t) > 2:
            d["worker"] = t[2]
        return d
    FIELDS.append(OrderedDict([
        ("id", fid), ("family", fid[0]), ("name", name), ("lean", list(lean)), ("files", list(files)),
        ("statement", statement), ("kind", kind), ("constrains", list(constrains)),
        ("register", list(register)), ("requirement", list(requirement)), ("consumed_by", list(consumed)),
        ("toy_inhabitant", toy), ("executable_model", executable), ("committed_source_tape_reconstruction", tape),
        ("scored", scored), ("score", OrderedDict([("i", sc(i)), ("ii", sc(ii)), ("iii", sc(iii))])),
    ]))


