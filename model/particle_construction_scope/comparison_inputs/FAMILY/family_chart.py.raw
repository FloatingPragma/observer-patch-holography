"""Representation-level family chart from the five-level code of the carrier.

Inputs (all from the carrier geometry): the twelve port directions n_p (slow band) and their Galois conjugates n'_p
(fast band); the port responses X_p = (P_p/2) + (-Q_p/2), P_p the spin-one coherent projector along n_p on C^3 and
Q_p the spin-half projector along n'_p on C^2 (the response of model/coherent_seam_repair, audit/gauge/ENCODED_OVERLAP.md).
Declared for this chart: occupation of the five code modes with exclusion (the exterior algebra of C^5).
Output: for every occupation sector its dimension, the Casimirs of the two simple ideals generated by the X_p, the
central charge, and the electric charges for one declared isospin axis. No dynamics, no chirality, no mass.
"""
import itertools, json, sys
from fractions import Fraction as Fr
import numpy as np
from model.common_source import slow_geometry

src = slow_geometry.source()
seams = [tuple(int(v) for v in e) for e in src.seams()]
n = 12
A = np.zeros((n, n))
for a, b in seams: A[a, b] = A[b, a] = 1
w, v = np.linalg.eigh(A)
N1 = v[:, np.abs(w - 5 ** .5) < 1e-9] * 2.0          # port directions
N2 = v[:, np.abs(w + 5 ** .5) < 1e-9] * 2.0          # conjugate directions
assert np.allclose(np.linalg.norm(N1, axis=1), 1) and np.allclose(np.linalg.norm(N2, axis=1), 1)
def cross(u):
    return np.array([[0, -u[2], u[1]], [u[2], 0, -u[0]], [-u[1], u[0], 0]])
sx = np.array([[0, 1], [1, 0]], complex); sy = np.array([[0, -1j], [1j, 0]]); sz = np.diag([1.0, -1.0]).astype(complex)
X = []
for p in range(n):
    P = (np.eye(3) - np.outer(N1[p], N1[p]) + 1j * cross(N1[p])) / 2
    Q = (np.eye(2) + N2[p][0] * sx + N2[p][1] * sy + N2[p][2] * sz) / 2
    Z = np.zeros((5, 5), complex); Z[:3, :3] = P / 2; Z[3:, 3:] = -Q / 2
    X.append(Z)
G = np.array([[np.trace(a @ b).real for b in X] for a in X])
print('rank-one checks: tr P =', round(np.trace(X[0][:3, :3]).real * 2, 9), ' tr Q =', round(-np.trace(X[0][3:, 3:]).real * 2, 9))
print('Gram eigenvalues of the twelve responses (expected 5/2 x1, 1/2 x6, 1/10 x5):', np.round(sorted(np.linalg.eigvalsh(G)), 6))
total = sum(X)
print('sum of the responses = diag', np.round(np.diag(total).real, 9))
Q5 = np.diag([2, 2, 2, -3, -3]).astype(complex)

# the two simple ideals: traceless parts of the blocks (the X_p span them)
def gens(dim, offset):
    out = []
    for i in range(dim):
        for j in range(i + 1, dim):
            S = np.zeros((5, 5), complex); S[offset + i, offset + j] = S[offset + j, offset + i] = .5; out.append(S)
            Aq = np.zeros((5, 5), complex); Aq[offset + i, offset + j] = -.5j; Aq[offset + j, offset + i] = .5j; out.append(Aq)
    for k in range(1, dim):
        D = np.zeros((5, 5), complex)
        for i in range(k): D[offset + i, offset + i] = 1
        D[offset + k, offset + k] = -k
        out.append(D / np.sqrt(2 * k * (k + 1)))
    return out
T3gens, T2gens = gens(3, 0), gens(2, 3)
# every generator lies in the real span of the X_p (exact content of the rank-twelve statement)
B = np.array([np.concatenate([x.real.ravel(), x.imag.ravel()]) for x in X]).T
worst = 0
for g in T3gens + T2gens + [Q5]:
    vec = np.concatenate([g.real.ravel(), g.imag.ravel()])
    coef, *_ = np.linalg.lstsq(B, vec, rcond=None)
    worst = max(worst, np.abs(B @ coef - vec).max())
print('all 8 + 3 + 1 generators lie in the real span of the twelve port responses, residual', f'{worst:.1e}')

# exterior algebra of C^5
subsets = [c for k in range(6) for c in itertools.combinations(range(5), k)]
index = {c: i for i, c in enumerate(subsets)}
def second_quantize(Mx):
    out = np.zeros((32, 32), complex)
    for c in subsets:
        for j in c:
            for i in range(5):
                if Mx[i, j] == 0: continue
                rest = [x for x in c if x != j]
                if i in rest: continue
                sign = (-1) ** c.index(j)
                new = sorted(rest + [i]); sign *= (-1) ** new.index(i)
                out[index[tuple(new)], index[c]] += sign * Mx[i, j]
    return out
C3 = sum(second_quantize(g) @ second_quantize(g) for g in T3gens)
C2 = sum(second_quantize(g) @ second_quantize(g) for g in T2gens)
Y6 = second_quantize(Q5)
T3z = second_quantize(T2gens[-1])                       # declared isospin axis: the diagonal generator of the doublet
names = {(1, 0): 'down antiquark d^c', (0, 1): 'lepton doublet (nu, e)', (3, 0): 'charged antilepton e^c',
         (2, 1): 'quark doublet (u, d)', (1, 2): 'up antiquark u^c', (3, 2): 'neutral singlet nu^c',
         (0, 0): 'vacuum / singlet', (2, 0): 'conjugate of u^c', (1, 1): 'conjugate of the quark doublet',
         (0, 2): 'conjugate of e^c', (3, 1): 'conjugate of the lepton doublet', (2, 2): 'conjugate of d^c'}
rows = []
print('\n n3 n2 | dim | C2[su3]  C2[su2] | 6Y | electric charges T3 + Y | name')
for n3 in range(4):
    for n2 in range(3):
        sel = [index[c] for c in subsets if sum(i < 3 for i in c) == n3 and sum(i >= 3 for i in c) == n2]
        c3 = np.round(np.diag(C3)[sel].real, 9); c2 = np.round(np.diag(C2)[sel].real, 9)
        # Casimirs are scalar on each sector
        e3 = np.linalg.eigvalsh(C3[np.ix_(sel, sel)]); e2 = np.linalg.eigvalsh(C2[np.ix_(sel, sel)])
        y6 = np.round(np.diag(Y6)[sel].real, 9)
        assert np.ptp(e3) < 1e-9 and np.ptp(e2) < 1e-9 and np.ptp(y6) < 1e-9
        charges = sorted({Fr(float(np.round(q, 6))).limit_denominator(6) for q in np.linalg.eigvalsh(T3z[np.ix_(sel, sel)]) + y6[0] / 6}, reverse=True)
        row = dict(n3=n3, n2=n2, dimension=len(sel), casimir_su3=str(Fr(float(e3[0])).limit_denominator(9)),
                   casimir_su2=str(Fr(float(e2[0])).limit_denominator(9)), six_Y=int(round(y6[0])),
                   electric_charges=[str(q) for q in charges], odd=bool((n3 + n2) % 2), name=names[(n3, n2)])
        rows.append(row)
        print(f'  {n3}  {n2} | {len(sel):3d} | {row["casimir_su3"]:>6s}  {row["casimir_su2"]:>6s}  | {row["six_Y"]:3d} | {", ".join(row["electric_charges"]):24s}| {row["name"]}{"   [family]" if row["odd"] else ""}')
odd = [r for r in rows if r['odd']]
Y = lambda r: Fr(r['six_Y'], 6)
d3 = lambda r: 1 if r['casimir_su3'] == '0' else 3
d2 = lambda r: 1 if r['casimir_su2'] == '0' else 2
sums = {
 'sum Y': sum(r['dimension'] * Y(r) for r in odd),
 'sum Y^3': sum(r['dimension'] * Y(r) ** 3 for r in odd),
 'SU(2)^2 Y (doublets)': sum(d3(r) * Y(r) for r in odd if d2(r) == 2),
 'SU(3)^2 Y (triplets)': sum(d2(r) * Y(r) for r in odd if d3(r) == 3),
 'states': sum(r['dimension'] for r in odd),
}
print('\nodd-occupation sector:', {k: str(v) for k, v in sums.items()})
json.dump({'rows': rows, 'odd_sector_checks': {k: str(v) for k, v in sums.items()},
           'declared': ['exclusion on the five code modes', 'odd occupation as the family', 'isospin axis for electric charge',
                        'the five-level code (triplet in the port frame, doublet in the conjugate frame)'],
           'not_supplied': ['chirality', 'three families', 'dynamics of the occupied modes', 'masses']},
          open(sys.argv[1], 'w'), indent=1)
