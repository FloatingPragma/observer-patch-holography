"""MG block 5: premise A2 implementers from closed paths (wiring F, rolling transport R1).

    python b5_implementers.py        (box B, under a minute)

Response (result R4, mixed pair): D_p = i (|chi'_p><chi'_p| + |xi_p><xi_p|) on C^2 + C^3, chi'_p the spin-1/2 coherent
state along the great-icosahedron axis of port p, xi_p the spin-1 helicity-one state along its convex axis; and the
reverse pair. Implementer of a carrier rotation a: U_a = (spin 1/2 of the conjugate rotation) + (spin 1 of a).
For a closed path the implementer is the ordered product of the lifted transports of its glue crossings, i.e. the
transported internal frame of a quantum that walks the path. Checks: Ad_U D_p = D_{a(p)} for every port, U in the
group generated by the responses, centralizer, composition, the central sign.
Writes b5_implementers.json.
"""
import itertools
import json
import math
import sys

import numpy as np
import scipy.sparse as sp
from scipy.linalg import expm, null_space

sys.dont_write_bytecode = True
import s0_lib as S
import mg_lib as M
from lie_tools import lie_closure, centre_dim

out = {}
S5 = math.sqrt(5.0)


# ----------------------------------------------------------------------------- conjugate binary representation
def conj_number(x):
    best = None
    for m in range(-8, 9):
        for n in range(-8, 9):
            if abs((m + n * S5) / 4 - x) < 1e-9:
                best = (m - n * S5) / 4
    assert best is not None, x
    return best


def conj_su2(U):
    a = U[0, 0].real; d = -U[0, 0].imag; c = -U[0, 1].real; b = -U[0, 1].imag      # U = a - i (b sx + c sy + d sz)
    a, b, c, d = (conj_number(t) for t in (a, b, c, d))
    return a * np.eye(2) - 1j * (b * M.SIG[0] + c * M.SIG[1] + d * M.SIG[2])


B2G = [conj_su2(U) for U in M.B2]
hom = max(np.abs(B2G[a] @ B2G[b] - B2G[int(M.BMUL[a, b])]).max() for a in range(120) for b in range(0, 120, 7))
unit = max(np.abs(U @ U.conj().T - np.eye(2)).max() for U in B2G)
cov = max(np.abs(M.so3_of(B2G[2 * i]) - M.galois_rotation(i)).max() for i in range(60))
tr = sorted({round(float(np.trace(B2G[a]).real), 6) for a in range(120)})
out['conjugate_binary_representation'] = {'homomorphism_defect': float(hom), 'unitarity_defect': float(unit),
                                          'covers_the_rotations_of_the_great_axes_defect': float(cov),
                                          'equivalent_to_the_first_doublet': bool(max(abs(np.trace(B2G[a]) - np.trace(M.B2[a])) for a in range(120)) < 1e-9)}
print('conjugate rep', out['conjugate_binary_representation'], flush=True)

SP1 = [M.spin1_of(R) for R in M.ROT_MATS]
SP1G = [M.spin1_of(M.galois_rotation(i)) for i in range(60)]


def projectors(j, m, axes):
    return [np.outer(v, v.conj()) for v in (M.helicity_state(j, m, axes[p]) for p in range(12))]


def response(blocks):
    d = sum(b[0].shape[0] for b in blocks)
    gens = []
    for p in range(12):
        D = np.zeros((d, d), complex); o = 0
        for b in blocks:
            k = b[p].shape[0]; D[o:o + k, o:o + k] = b[p]; o += k
        gens.append(1j * D)
    return gens


def span_closure_centre(gens):
    rk = int(np.linalg.matrix_rank(np.array([np.concatenate([g.real.ravel(), g.imag.ravel()]) for g in gens]), tol=1e-9))
    mats, dims = lie_closure(gens, max_dim=80)
    return rk, int(dims[-1]), int(centre_dim(mats)), mats


PAIRS = {
    'spinor_great_plus_vector_convex': (projectors(0.5, 0.5, M.PORT_GREAT), projectors(1, 1, M.PORT_UNIT),
                                        lambda a: B2G[a], lambda i: SP1[i]),
    'spinor_convex_plus_vector_great': (projectors(0.5, 0.5, M.PORT_UNIT), projectors(1, 1, M.PORT_GREAT),
                                        lambda a: M.B2[a], lambda i: SP1G[i]),
}
# calibration against R4 and a negative control (same realization: span 9)
cal = {}
for name, (P2, P3, _, _) in PAIRS.items():
    rk, cl, ce, mats = span_closure_centre(response([P2, P3]))
    cal[name] = {'span': rk, 'closure': cl, 'centre': ce}
rk, cl, ce, _ = span_closure_centre(response([projectors(0.5, 0.5, M.PORT_UNIT), projectors(1, 1, M.PORT_UNIT)]))
cal['control_same_realization'] = {'span': rk, 'closure': cl, 'centre': ce}
out['calibration_R4'] = cal
print('calibration', cal, flush=True)


def block(U2, U3):
    U = np.zeros((5, 5), complex); U[:2, :2] = U2; U[2:, 2:] = U3
    return U


res = {}
for name, (P2, P3, lift2, rep3) in PAIRS.items():
    D = response([P2, P3])
    rk, cl, ce, mats = span_closure_centre(D)
    basis = np.array([np.concatenate([m.real.ravel(), m.imag.ravel()]) for m in mats])       # orthonormal rows
    # centralizer of the response in u(5)
    ub = []
    for i in range(5):
        X = np.zeros((5, 5), complex); X[i, i] = 1j; ub.append(X)
        for j in range(i + 1, 5):
            X = np.zeros((5, 5), complex); X[i, j] = 1; X[j, i] = -1; ub.append(X)
            X = np.zeros((5, 5), complex); X[i, j] = 1j; X[j, i] = 1j; ub.append(X)
    assert len(ub) == 25
    Mat = np.array([np.concatenate([np.concatenate([(X @ Dp - Dp @ X).real.ravel(), (X @ Dp - Dp @ X).imag.ravel()]) for Dp in D]) for X in ub]).T
    ns = null_space(Mat, rcond=1e-9)
    cen = [sum(c * X for c, X in zip(ns[:, k], ub)) for k in range(ns.shape[1])]
    block_scalar = all(np.abs(C[:2, 2:]).max() < 1e-9 and np.abs(C[:2, :2] - C[0, 0] * np.eye(2)).max() < 1e-9 and np.abs(C[2:, 2:] - C[2, 2] * np.eye(3)).max() < 1e-9 for C in cen)
    # how much of the centralizer lies in the response algebra
    cv = np.array([np.concatenate([C.real.ravel(), C.imag.ravel()]) for C in cen])
    inside = int(np.linalg.matrix_rank(np.vstack([basis, cv]), tol=1e-8))
    cen_in_g = len(cen) - (inside - basis.shape[0])
    # all 60 rotations: implementer through the spin representations
    worst = 0.0; worst_wrong = 0.0; endo = 0.0; endo_exp = 0.0
    log3 = (lambda i: M.spin1_of(M.ROT_MATS[i], log=True)) if name.startswith('spinor_great') else (lambda i: M.spin1_of(M.galois_rotation(i), log=True))
    for i in range(60):
        g = M.ROT60[i]
        for a in (2 * i, 2 * i + 1):
            U = block(lift2(a), rep3(i))
            worst = max(worst, max(np.abs(U @ D[p] @ U.conj().T - D[g[p]]).max() for p in range(12)))
            # endogenous: log U lies in the response algebra (principal logarithm of each block)
            X = block(M.log_su2(lift2(a)), log3(i))
            endo_exp = max(endo_exp, float(np.abs(expm(X) - U).max()))
            v = np.concatenate([X.real.ravel(), X.imag.ravel()])
            endo = max(endo, float(np.linalg.norm(v - basis.T @ (basis @ v))))
        # negative control: the doublet block taken from the other realization
        other = (M.B2 if name.startswith('spinor_great') else B2G)[2 * i]
        Uw = block(other, rep3(i))
        worst_wrong = max(worst_wrong, max(np.abs(Uw @ D[p] @ Uw.conj().T - D[g[p]]).max() for p in range(12)))
    # the central sign
    Z = block(-np.eye(2), np.eye(3))
    zc = max(np.abs(Z @ Dp - Dp @ Z).max() for Dp in D)
    Y = sum(D)                                              # i (6 on the doublet, 4 on the triplet)
    z_in_group = float(np.abs(expm(math.pi / 2 * Y) - Z).max())      # exp(pi/2 * i diag(6,6,4,4,4)) = diag(-1,-1,1,1,1)
    res[name] = {'span': rk, 'closure': cl, 'centre': ce,
                 'sum_of_port_responses_over_i': [round(float(x), 9) for x in np.diag(Y).imag],
                 'max_defect_Ad_U_D_p_minus_D_a(p)_over_60_rotations_both_lifts': float(worst),
                 'negative_control_doublet_from_other_realization_defect': float(worst_wrong),
                 'max_distance_of_log_U_from_the_response_algebra': float(endo), 'exp_of_that_log_equals_U_defect': float(endo_exp),
                 'centralizer_dimension_in_u5': len(cen), 'centralizer_is_block_phases': bool(block_scalar),
                 'centralizer_dimension_inside_response_algebra': int(cen_in_g),
                 'central_sign_commutes_with_every_D_p_defect': float(zc),
                 'central_sign_equals_exp_of_response_element_defect': z_in_group}
    print(name, res[name], flush=True)
out['rotation_implementers'] = res

# ----------------------------------------------------------------------------- implementers from closed paths (F, R1)
b1 = json.load(open('b1_holonomy.json'))
paths = {}
for level in (1, 2, 3):
    mesh = S.build_mesh(level)
    W, base = M.wiring('F', level)
    T = M.transports(mesh, W, base, M.crosswise_rule(base, 1))
    rows = []
    for cls, target6 in (('all_odd_order', +1), ('physical_rolling', -1)):
        TL, unsolved, raw = M.lift_transports(mesh, T, target6=target6)
        assert unsolved == 0
        gens = b1['generators_F']['R1'][str(level)]['generators']
        for gd in gens:
            cells = gd['closed_path_cells']
            a = M.path_holonomy(mesh, T, cells); al = M.path_holonomy(mesh, TL, cells, M.BMUL, M.ONE)
            entry = {'lift_class': cls, 'closed_path_cells': cells, 'rotation': {'class': M.CLASS_NAME[int(M.ANGLE[a])], 'axis_through': M.axis_label(a), 'perm': list(M.ROT60[a])},
                     'lifted_order': int(M.BORD[al])}
            for name, (P2, P3, lift2, rep3) in PAIRS.items():
                D = response([P2, P3])
                # ordered product of the crossings
                U = np.eye(5, dtype=complex)
                for c, d in zip(cells[:-1], cells[1:]):
                    k = int(np.where(mesh.nbr[c] == d)[0][0])
                    U = block(lift2(int(TL[c, k])), rep3(int(T[c, k]))) @ U
                g = M.ROT60[a]
                entry[name] = {'max_defect_Ad_U_D_p_minus_D_a(p)': float(max(np.abs(U @ D[p] @ U.conj().T - D[g[p]]).max() for p in range(12))),
                               'equals_spin_representation_of_the_lifted_holonomy_defect': float(np.abs(U - block(lift2(al), rep3(a))).max()),
                               'implementer': [[[round(float(z.real), 12), round(float(z.imag), 12)] for z in r] for r in U]}
            rows.append(entry)
        # the closed path with identity rotation and sign -1: implementer diag(-1,-1,1,1,1)
        bd, bp = M.cover_bfs(mesh, TL, 0, M.BMUL, 120, M.ONE)
        cells = bp(M.CENTRAL)
        U = np.eye(5, dtype=complex)
        name = 'spinor_great_plus_vector_convex'; P2, P3, lift2, rep3 = PAIRS[name]
        for c, d in zip(cells[:-1], cells[1:]):
            k = int(np.where(mesh.nbr[c] == d)[0][0])
            U = block(lift2(int(TL[c, k])), rep3(int(T[c, k]))) @ U
        rows.append({'lift_class': cls, 'central_sign_path_cells': [int(c) for c in cells], 'glue_crossings': len(cells) - 1,
                     'implementer_diagonal': [round(float(x.real), 9) for x in np.diag(U)], 'offdiagonal_max': float(np.abs(U - np.diag(np.diag(U))).max())})
        # shortest closed path lengths per class in this lift class, for the binary elements
        byord = {}
        for a in range(120):
            if bd[0, a] >= 0:
                key = f'{M.CLASS_NAME[int(M.ANGLE[a // 2])]} / lifted order {int(M.BORD[a])}'
                byord.setdefault(key, []).append(int(bd[0, a]))
        rows.append({'lift_class': cls, 'shortest_closed_path_length_by_binary_class': {k: [min(v), max(v), len(v)] for k, v in sorted(byord.items())}})
    paths[str(level)] = rows
    for r in rows:
        if 'rotation' in r:
            print('level', level, r['lift_class'], len(r['closed_path_cells']) - 1, 'crossings', r['rotation']['class'], r['rotation']['axis_through'], 'lifted order', r['lifted_order'],
                  'defects', r['spinor_great_plus_vector_convex']['max_defect_Ad_U_D_p_minus_D_a(p)'], r['spinor_convex_plus_vector_great']['max_defect_Ad_U_D_p_minus_D_a(p)'], flush=True)
        elif 'central_sign_path_cells' in r:
            print('level', level, r['lift_class'], 'central sign path', r['glue_crossings'], 'crossings, implementer diagonal', r['implementer_diagonal'], flush=True)
        else:
            print('level', level, r['lift_class'], r['shortest_closed_path_length_by_binary_class'], flush=True)
out['closed_path_implementers_F_R1'] = paths

# ----------------------------------------------------------------------------- the same source history: return statistics of the walk
ret = {}
for level in (1, 2):
    mesh = S.build_mesh(level)
    W, base = M.wiring('F', level)
    T = M.transports(mesh, W, base, M.crosswise_rule(base, 1))
    N = mesh.N
    n = 12 * N
    ia, ib = S.intra_seams(N)
    nseams = ia.size + 3 * N // 2
    # chain on (port, accumulated rotation): state index 60 * x + a
    rows, cols = [], []
    for x, y in zip(np.concatenate([ia, ib]), np.concatenate([ib, ia])):
        rows.append(60 * y + np.arange(60)); cols.append(60 * x + np.arange(60))
    for c in range(N):
        for k in range(3):
            d, k2 = int(mesh.nbr[c, k]), int(mesh.nbk[c, k])
            x = 12 * c + int(W[c, k]); y = 12 * d + int(W[d, k2])
            rows.append(60 * y + M.MUL[int(T[c, k]), np.arange(60)]); cols.append(60 * x + np.arange(60))
    rows = np.concatenate(rows); cols = np.concatenate(cols)
    A = sp.coo_matrix((np.ones(rows.size), (rows, cols)), shape=(60 * n, 60 * n)).tocsr()
    deg = np.asarray(A.sum(axis=0)).ravel()
    Lc = sp.diags(deg) - A
    from scipy.sparse.linalg import expm_multiply
    p = np.zeros(60 * n); p[60 * (12 * 0 + int(W[0, 0])) + M.E60] = 1.0
    row = {}
    tprev = 0
    for t in (8, 32, 128, 512, 2048):
        p = expm_multiply(-(t - tprev) / 2 * Lc, p); tprev = t
        home = p[:60 * 12].reshape(12, 60).sum(axis=0)          # carrier 0
        cond = home / home.sum()
        row[str(t)] = {'probability_in_base_carrier': float(home.sum()), 'rotations_with_positive_probability': int((cond > 1e-12).sum()),
                       'conditional_probability_min_max_times_60': [float(60 * cond.min()), float(60 * cond.max())],
                       'identity_times_60': float(60 * cond[M.E60])}
    ret[str(level)] = row
    print('return statistics level', level, row, flush=True)
out['return_statistics_F_R1'] = ret
json.dump(out, open('b5_implementers.json', 'w'), indent=1)
print('written b5_implementers.json')
