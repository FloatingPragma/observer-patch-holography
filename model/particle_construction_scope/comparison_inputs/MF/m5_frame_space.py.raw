"""Block 5: the directed-seam (frame) space of one carrier.

The 60 directed seams are a torsor of the rotation group; with the double cover there are 120 frames (the regular
representation of the binary icosahedral group). Carrier rotations act on the left. The commutant of the left action
is the algebra of right translations. Seam events: 'turn at a port' (the directed seam (a, b) goes to (a, b'), b' the
next neighbour of a) is the right translation by the fifth turn t; 'reverse' ((a, b) to (b, a)) is the right
translation by the half turn r about the seam. This script computes, in float64 from the exact group tables:
the block structure of the commutant, the Lie algebra generated by the Hermitian parts of the two seam events
block by block, the copy of u(3) + u(2) on the multiplicity spaces of the triplet and the doublet, and the rank of
equivariant port maps into the commutant. Output m5_frame_space.json. Run: python m5_frame_space.py
"""
import json, time
import numpy as np
from kfield import *
from xcarrier import Carrier, rotation
from lie_tools import lie_closure, centre_dim

t0 = time.time()
X = Carrier(); Xg = X.great()
out = {}
G = X.group
key = lambda u: tuple(x for row in u for x in row)
index = {key(g[1]): i for i, g in enumerate(G)}
mul = np.zeros((120, 120), int)
for i in range(120):
    for j in range(120):
        mul[i, j] = index[key(mmul(G[i][1], G[j][1]))]
ident = index[key(eye(2))]
inv = [int(np.where(mul[i] == ident)[0][0]) for i in range(120)]
# torsor check: the 60 rotations act simply transitively on the 60 directed seams
q0 = X.nbr[0][0]
images = {(g[2][0], g[2][q0]) for g in G}
dseams = {(a, b) for a in range(12) for b in X.nbr[a]}
out['torsor'] = {'directed_seams': len(dseams), 'images_of_the_base_seam_under_the_rotations': len(images), 'simply_transitive': images == dseams and len({g[2] for g in G}) == 60}
# the two seam events as group elements: t = fifth turn about port 0 (tail of the base seam), r = half turn exchanging 0 and q0
Rt, ut = rotation(X.n[0], ZETA ** 4, ZETA ** 2)
t_idx = index[key(ut)]
r_idx = next(i for i, g in enumerate(G) if g[2][0] == q0 and g[2][q0] == 0)
# turn: (a, b) = g.s0 -> g t . s0 = (a, b') ; reverse: g r . s0 = (b, a)
perm_t = G[t_idx][2]
chk_turn = all((G[mul[i, t_idx]][2][0], G[mul[i, t_idx]][2][q0]) == (G[i][2][0], G[i][2][perm_t[q0]]) for i in range(120))
chk_rev = all((G[mul[i, r_idx]][2][0], G[mul[i, r_idx]][2][q0]) == (G[i][2][q0], G[i][2][0]) for i in range(120))
out['seam_events'] = {'turn_is_right_translation_by_the_fifth_turn': chk_turn and all(G[mul[i, t_idx]][2][0] == G[i][2][0] and (G[i][2][0], G[mul[i, t_idx]][2][q0]) in dseams for i in range(120)),
                      'reverse_is_right_translation_by_the_half_turn': chk_rev}


def right(h):               # |g> -> |g h>
    M = np.zeros((120, 120))
    for g in range(120):
        M[mul[g, h], g] = 1
    return M


def left(h):                # |g> -> |h g>
    M = np.zeros((120, 120))
    for g in range(120):
        M[mul[h, g], g] = 1
    return M


Rt_, Rr_ = right(t_idx), right(r_idx)
assert all(np.allclose(left(h) @ Rt_, Rt_ @ left(h)) and np.allclose(left(h) @ Rr_, Rr_ @ left(h)) for h in range(0, 120, 7))
# characters of the nine irreducibles as class functions
c2 = np.array([complex(trace(g[1])).real for g in G]); c3 = np.array([complex(trace(g[0])).real for g in G])
c2p = np.array([complex(trace(g[1])).real for g in Xg.group]); c3p = np.array([complex(trace(g[0])).real for g in Xg.group])
chars = {'1': np.ones(120), '2': c2, "2'": c2p, '3': c3, "3'": c3p, '4': c2 * c2p, '4s': c2 * c3 - c2, '5': c3 * c3 - c3 - 1}
chars['6'] = c2 * chars['5'] - chars['4s']
dims = {k: int(round(v[ident])) for k, v in chars.items()}
orth = {a + ',' + b: float(np.dot(chars[a], chars[b]) / 120) for a in chars for b in chars if a <= b}
assert all(abs(v - (1 if k.split(',')[0] == k.split(',')[1] else 0)) < 1e-9 for k, v in orth.items())
Rmats = [right(h) for h in range(120)]
proj = {}
for name, ch in chars.items():
    P = sum(ch[h] * Rmats[h] for h in range(120)) * dims[name] / 120
    assert np.allclose(P @ P, P) and abs(np.trace(P) - dims[name] ** 2) < 1e-8
    proj[name] = P
out['commutant'] = {'frames': 120, 'blocks': {k: f'M_{d} (rank of the central projector {d * d})' for k, d in dims.items()},
                    'dimension': sum(d * d for d in dims.values()),
                    'on_the_60_directed_seams': 'the integer-spin blocks 1, 3, 3\', 4, 5: dimension 1 + 9 + 9 + 16 + 25 = 60',
                    'unitary_group': 'U(1) x U(2) x U(2) x U(3) x U(3) x U(4) x U(4) x U(5) x U(6)'}
# Hermitian parts of the seam events
gens = [Rt_ + Rt_.T, 1j * (Rt_ - Rt_.T), Rr_ + Rr_.T, 1j * (Rr_ - Rr_.T)]
gens = [g for g in gens if np.abs(g).max() > 1e-12]
blocks = {}
for name, P in proj.items():
    d = dims[name]
    gb = [P @ g @ P for g in gens]
    gb = [g for g in gb if np.abs(g).max() > 1e-12]
    mats, dl = lie_closure([1j * g for g in gb], max_dim=60)
    cd = centre_dim(mats)
    which = {'turn (sum)': bool(np.abs(P @ gens[0] @ P).max() > 1e-9), 'turn (difference)': bool(np.abs(P @ gens[1] @ P).max() > 1e-9),
             'reverse (sum)': bool(np.abs(P @ gens[2] @ P).max() > 1e-9), 'reverse (difference)': bool(np.abs(P @ gens[3] @ P).max() > 1e-9)}
    # closure of the turn events alone and of the reverse event alone
    mt, dt = lie_closure([1j * (P @ g @ P) for g in gens[:2] if np.abs(P @ g @ P).max() > 1e-9] or [np.zeros((120, 120), complex)], max_dim=60)
    mr, dr = lie_closure([1j * (P @ g @ P) for g in gens[2:] if np.abs(P @ g @ P).max() > 1e-9] or [np.zeros((120, 120), complex)], max_dim=60)
    blocks[name] = {'dimension_of_block_algebra': d * d, 'lie_closure_of_seam_events': dl[-1], 'centre': cd, 'full_u(d)': dl[-1] == d * d,
                    'turn_alone': dt[-1], 'reverse_alone': dr[-1], 'nonzero_generators': which}
    print(f'block {name:3s} (M_{d}): seam events generate dimension {dl[-1]} of {d * d}, centre {cd}; turn alone {dt[-1]}, reverse alone {dr[-1]}', flush=True)
out['lie_algebra_of_seam_events_by_block'] = blocks
# the whole algebra at once on the 60 directed seams (integer blocks) and on a spinor pair of blocks
Pint = sum(proj[k] for k in ('1', '3', "3'", '4', '5'))
mats, dl = lie_closure([1j * (Pint @ g @ Pint) for g in gens if np.abs(Pint @ g @ Pint).max() > 1e-9], max_dim=70)
out['directed_seams_total'] = {'lie_closure_of_seam_events': dl[-1], 'centre': centre_dim(mats), 'sum_of_block_dimensions': 60}
print('60 directed seams: seam events generate dimension', dl[-1], 'centre', out['directed_seams_total']['centre'], flush=True)
# the copy of u(3) + u(2) in the commutant: blocks 3 and 2'
P32 = proj['3'] + proj["2'"]
mats, dl = lie_closure([1j * (P32 @ g @ P32) for g in gens if np.abs(P32 @ g @ P32).max() > 1e-9], max_dim=30)
cd = centre_dim(mats)
commute_left = all(np.abs(left(h) @ m - m @ left(h)).max() < 1e-9 for h in range(0, 120, 5) for m in mats)
out['mirror_copy_on_multiplicity_spaces'] = {'blocks': "3 and 2'", 'lie_closure_of_seam_events': dl[-1], 'centre': cd,
                                             'type': 'u(3) + u(2) (dimension 13); its traceless-per-pair part contains u(1) + su(2) + su(3)',
                                             'every_element_commutes_with_the_carrier_rotations': commute_left}
print("blocks 3 and 2': seam events generate dimension", dl[-1], 'centre', cd, '; commutes with the carrier rotations:', commute_left, flush=True)
# equivariant maps from the port module into the commutant: Ad(L_g) is trivial there, so D(a v) = D(v)
Pperm = np.zeros((12, 12))
for g in G:
    for p in range(12):
        Pperm[g[2][p], p] += 1 / 120
out['equivariant_port_maps_into_the_commutant'] = {'rank_bound': int(round(np.linalg.matrix_rank(Pperm))),
                                                   'reason': 'rotations act trivially on the commutant, so an equivariant D factors through the invariants of the port module (dimension 1)'}
# the A1/A2 response in the same space: port multiplication operators compressed to a left-irreducible subspace
ports_of = np.array([g[2][0] for g in G])
Nmult = [np.diag((ports_of == p).astype(float)) for p in range(12)]
chi0 = np.array([complex(x) for x in X.chi[0]])
Umat = [to_numpy(g[1]) for g in G]
F = np.array([[np.vdot(Umat[g] @ chi0, e) for e in np.eye(2)] for g in range(120)])     # f_psi(g) = <u_g chi_0 | psi>
Qf, _ = np.linalg.qr(F)
comp = [Qf.conj().T @ N @ Qf for N in Nmult]
target = [to_numpy(X.Q[p]) / 6 for p in range(12)]
# same operators up to the unitary change of basis of the two-dimensional space: compare Gram matrices
G1 = np.array([[np.trace(a @ b).real for b in comp] for a in comp]); G2 = np.array([[np.trace(a @ b).real for b in target] for a in target])
left_inv = all(np.linalg.matrix_rank(np.hstack([Qf, left(h) @ Qf]), tol=1e-9) == 2 for h in range(0, 120, 7))
right_inv = [int(np.linalg.matrix_rank(np.hstack([Qf, right(h) @ Qf]), tol=1e-9)) for h in (t_idx, r_idx)]
out['port_response_in_the_frame_space'] = {'subspace': 'functions g -> <u_g chi_0|psi>, psi in C^2: left-irreducible, right character of the port stabilizer',
                                           'compressed_port_multiplications_equal_Q_p_over_6_gram_defect': float(np.abs(G1 - G2).max()),
                                           'invariant_under_left_rotations': left_inv,
                                           'rank_with_image_under_turn_and_under_reverse': right_inv,
                                           'reading': 'the response algebra acts on the left (representation) factor of a block; the commutant acts on the right (multiplicity) factor; '
                                                      'the turn acts on the subspace by a phase (flux), the reverse maps it out of itself'}
print('port response in the frame space: Gram defect', out['port_response_in_the_frame_space']['compressed_port_multiplications_equal_Q_p_over_6_gram_defect'],
      '; left invariant', left_inv, '; rank with turn/reverse image', right_inv, flush=True)
out['seconds'] = round(time.time() - t0, 1)
json.dump(out, open('m5_frame_space.json', 'w'), indent=1)
print('written m5_frame_space.json in', out['seconds'], 's')
