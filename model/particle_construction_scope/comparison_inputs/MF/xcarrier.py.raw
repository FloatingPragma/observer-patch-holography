"""Exact icosahedral carrier over K = Q(zeta_20). Port order, seams, faces and rhombi equal carrier_tools.C.

The internal frame is adapted to port 0 (port 0 is the north pole), so that every normalized coherent spinor has
entries in K. All objects of the great realization are the images under the Galois automorphism G17: zeta -> zeta^17
(it fixes i, sends sqrt5 -> -sqrt5 and c -> c/phi > 0), applied entrywise.

    X = Carrier()      # convex realization
    Xg = X.great()     # great realization (same ports, seams, faces, group elements)

Attributes: n (12 unit axes), Q (spin-1/2 projectors (1 + n.sigma)/2), chi (normalized spinors, Q = |chi><chi|),
P (helicity +1 spin-1 projectors, Cartesian basis), P0 (helicity 0: n n^T), Pm (helicity -1), e (vector frames,
<e|e> = 2, P = |e><e|/2, e = symmetric square of chi), link[(a, b)] (unit phase of <chi_b|chi_a>, the hop a -> b),
group: list of (R, u, perm) with R in SO(3, K), u in SU(2, K) its lift, perm[p] = image port; 120 elements.
"""
from kfield import *

GAL_GREAT = 17


def dot3(a, b): return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
def cross3(a, b): return [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]
def det3(a, b, c): return dot3(a, cross3(b, c))


SIG = [mat([[0, 1], [1, 0]]), [[K(0), -I], [I, K(0)]], mat([[1, 0], [0, -1]])]
I2, I3 = eye(2), eye(3)


def nsigma(n):
    return [[n[2], n[0] - I * n[1]], [n[0] + I * n[1], -n[2]]]


def hat(n):
    """Cross-product matrix: hat(n) v = n x v."""
    return [[K(0), -n[2], n[1]], [n[2], K(0), -n[0]], [-n[1], n[0], K(0)]]


def rotation(n, eith, eihalf):
    """Rotation about the unit axis n by the angle th, given exp(i th) and exp(i th/2) in K. Returns (R, u)."""
    cth = (eith + eith.conj()) * HALF; sth = (eith - eith.conj()) * HALF * (-I)
    ch = (eihalf + eihalf.conj()) * HALF; sh = (eihalf - eihalf.conj()) * HALF * (-I)
    H = hat(n)
    R = [[cth * (1 if i == j else 0) + (1 - cth) * n[i] * n[j] + sth * H[i][j] for j in range(3)] for i in range(3)]
    ns = nsigma(n)
    u = [[ch * (1 if i == j else 0) - I * sh * ns[i][j] for j in range(2)] for i in range(2)]
    return R, u


class Carrier:
    def __init__(self, _great_of=None):
        if _great_of is not None:
            self._from_convex(_great_of); return
        phi = PHI_G
        V = []
        for s1 in (1, -1):
            for s2 in (1, -1):
                V += [[K(0), K(s1), s2 * phi], [K(s1), s2 * phi, K(0)], [s2 * phi, K(0), K(s1)]]
        self.E = [(a, b) for a in range(12) for b in range(a + 1, 12) if dot3(V[a], V[b]) == phi]
        Eset = set(self.E)
        self.adj = lambda a, b: (min(a, b), max(a, b)) in Eset
        self.nbr = [[q for q in range(12) if self.adj(p, q)] for p in range(12)]
        self.anti = [next(q for q in range(12) if all(V[q][i] == -V[p][i] for i in range(3))) for p in range(12)]
        F = []
        for a in range(12):
            for b in range(a + 1, 12):
                for c in range(b + 1, 12):
                    if self.adj(a, b) and self.adj(b, c) and self.adj(a, c):
                        F.append((a, b, c) if det3(V[a], V[b], V[c]).sign() > 0 else (a, c, b))
        self.F = F
        self.rhombi = [[a, b] + [c for c in range(12) if c in self.nbr[a] and c in self.nbr[b]] for a, b in self.E]
        assert len(self.E) == 30 and len(F) == 20 and all(len(r) == 4 for r in self.rhombi)
        self.dist = [[0 if p == q else 1 if self.adj(p, q) else 3 if self.anti[p] == q else 2 for q in range(12)] for p in range(12)]
        # adapted frame: e3 = n_0, e1 towards the first neighbour of port 0
        cinv = C10.inv()
        nstd = [[x * cinv for x in v] for v in V]
        q0 = self.nbr[0][0]
        e3 = nstd[0]
        e1 = [(nstd[q0][i] - nstd[0][i] * S5.inv()) * S5 * HALF for i in range(3)]
        e2 = cross3(e3, e1)
        assert dot3(e1, e1) == 1 and dot3(e2, e2) == 1 and dot3(e1, e2) == 0 and dot3(e1, e3) == 0 and det3(e1, e2, e3) == 1
        self.n = [[dot3(v, e1), dot3(v, e2), dot3(v, e3)] for v in nstd]
        assert self.n[0] == [K(0), K(0), K(1)] and all(dot3(v, v) == 1 for v in self.n)
        self.realization = 'convex'
        self.adj_cos = S5.inv()                               # n_a . n_b on a seam
        self.adj_overlap = C10 * S5.inv()                     # |<chi_b|chi_a>| on a seam
        assert self.adj_overlap.sign() > 0 and self.adj_overlap ** 2 == (1 + self.adj_cos) * HALF
        # normalized spinors
        chi = []
        for (x, y, z) in self.n:
            if z == -1:
                chi.append([K(0), K(1)]); continue
            h = K(1) if z == 1 else (C10 * S5.inv() if z == S5.inv() else C10 * PHI_G.inv() * S5.inv())
            assert h * h == (1 + z) * HALF
            chi.append([h, (x + I * y) * HALF * h.inv()])
        self.chi = chi
        # rotation group with lifts: generated by the fifth turns about port 0 and about its first neighbour
        gens = [rotation(self.n[0], ZETA ** 4, ZETA ** 2), rotation(self.n[q0], ZETA ** 4, ZETA ** 2)]
        key = lambda R, u: (tuple(x for row in R for x in row), tuple(x for row in u for x in row))
        elems = {key(I3, I2): (I3, I2)}
        frontier = [(I3, I2)]
        while frontier:
            new = []
            for (R, u) in frontier:
                for (Rg, ug) in gens:
                    R2, u2 = mmul(Rg, R), mmul(ug, u)
                    k2 = key(R2, u2)
                    if k2 not in elems:
                        elems[k2] = (R2, u2); new.append((R2, u2))
            frontier = new
        assert len(elems) == 120, len(elems)
        self._finish([(R, u) for (R, u) in elems.values()])

    def _from_convex(self, X):
        g = GAL_GREAT
        for name in ('E', 'adj', 'nbr', 'anti', 'F', 'rhombi', 'dist'):
            setattr(self, name, getattr(X, name))
        self.realization = 'great'
        self.n = mgalois(X.n, g)
        self.chi = mgalois(X.chi, g)
        self.adj_cos = X.adj_cos.galois(g)
        self.adj_overlap = -X.adj_overlap.galois(g)
        assert self.adj_overlap.sign() > 0 and self.adj_overlap ** 2 == (1 + self.adj_cos) * HALF
        self._finish([(mgalois(R, g), mgalois(u, g)) for (R, u, _) in X.group], perms=[p for (_, _, p) in X.group])

    def great(self):
        return Carrier(_great_of=self)

    def _finish(self, pairs, perms=None):
        n = self.n
        self.Q = [[[(I2[i][j] + ns[i][j]) * HALF for j in range(2)] for i in range(2)] for ns in map(nsigma, n)]
        for p in range(12):
            assert meq(outer(self.chi[p], self.chi[p]), self.Q[p])
        self.P0 = [[[v[i] * v[j] for j in range(3)] for i in range(3)] for v in n]
        self.P = [[[(I3[i][j] - v[i] * v[j] + I * H[i][j]) * HALF for j in range(3)] for i in range(3)] for v, H in ((v, hat(v)) for v in n)]
        self.Pm = [[[(I3[i][j] - v[i] * v[j] - I * H[i][j]) * HALF for j in range(3)] for i in range(3)] for v, H in ((v, hat(v)) for v in n)]
        self.e = [[b * b - a * a, -I * (a * a + b * b), 2 * a * b] for (a, b) in self.chi]
        for p in range(12):
            assert meq(mscale(HALF, outer(self.e[p], self.e[p])), self.P[p])
            assert meq(mmul(self.P[p], self.P[p]), self.P[p]) and meq(mmul(self.Q[p], self.Q[p]), self.Q[p])
        self.link = {}
        hinv = self.adj_overlap.inv()
        for a, b in self.E:
            z = vdot(self.chi[b], self.chi[a]) * hinv
            assert z * z.conj() == 1
            self.link[(a, b)] = z; self.link[(b, a)] = z.conj()
        group = []
        for idx, (R, u) in enumerate(pairs):
            perm = []
            for p in range(12):
                img = [sum((R[i][j] * n[p][j] for j in range(3)), K(0)) for i in range(3)]
                perm.append(next(q for q in range(12) if n[q] == img))
            if perms is not None:
                assert perm == list(perms[idx])
            # the lift covers R: u (m.sigma) u^dagger = (R m).sigma on the three axes
            for k in range(3):
                lhs = mmulm(u, SIG[k], dagger(u))
                rhs = [[sum((R[i][k] * SIG[i][a][b] for i in range(3)), K(0)) for b in range(2)] for a in range(2)]
                assert meq(lhs, rhs)
            group.append((R, u, tuple(perm)))
        self.group = group
        assert len({g[2] for g in group}) == 60
        # port phases of the monomial representation: theta[g][p] = <chi_{g p}| u_g |chi_p>
        self.theta = []
        for (R, u, perm) in group:
            th = []
            for p in range(12):
                up = [u[0][0] * self.chi[p][0] + u[0][1] * self.chi[p][1], u[1][0] * self.chi[p][0] + u[1][1] * self.chi[p][1]]
                t = vdot(self.chi[perm[p]], up)
                assert t * t.conj() == 1
                th.append(t)
            self.theta.append(th)

    # ---- derived objects
    def sections(self, kind):
        """12 x d matrix W with row p = <frame_p|: 'spinor' (d = 2, norm 1), 'vector' (helicity 1, d = 3, norm^2 2),
        'radial' (helicity 0, d = 3, norm 1)."""
        if kind == 'spinor':
            return [[x.conj() for x in self.chi[p]] for p in range(12)]
        if kind == 'vector':
            return [[x.conj() for x in self.e[p]] for p in range(12)]
        if kind == 'radial':
            return [list(self.n[p]) for p in range(12)]
        raise ValueError(kind)

    def adjacency(self, k=0):
        """Twisted adjacency of flux k in the spinor gauge: A[b][a] = link(a -> b)^k."""
        A = zeros(12)
        for (a, b), z in self.link.items():
            A[b][a] = z ** k if k >= 0 else z.conj() ** (-k)
        return A

    def monomial(self, gi, k=1):
        """Monomial matrix of group element gi in the flux-k sector: M|p> = theta_p^k |g p>."""
        R, u, perm = self.group[gi]
        M = zeros(12)
        for p in range(12):
            M[perm[p]][p] = self.theta[gi][p] ** k
        return M

    def face_holonomy(self, f, k=1):
        a, b, c = f
        return (self.link[(a, b)] * self.link[(b, c)] * self.link[(c, a)]) ** k


if __name__ == '__main__':
    import time
    t = time.time()
    X = Carrier(); Xg = X.great()
    print('exact carrier built in', round(time.time() - t, 2), 's; group order', len(X.group))
    print('seam cosine convex/great:', X.adj_cos, '/', Xg.adj_cos, '; seam overlap convex/great:', X.adj_overlap, '/', Xg.adj_overlap)
    hol = {X.face_holonomy(f) for f in X.F}; holg = {Xg.face_holonomy(f) for f in X.F}
    print('face holonomy of the spinor link, convex:', hol, ' = zeta^-1:', hol == {ZETA ** 19}, '; great:', holg, ' = zeta^-7:', holg == {ZETA ** 13})
    for k in (1, 2, 7):
        A = X.adjacency(k)
        assert is_hermitian(A)
        assert all(meq(mmul(X.monomial(g, k), A), mmul(A, X.monomial(g, k))) for g in range(0, 120, 7))
    W = X.sections('spinor')
    AW = mmul(X.adjacency(1), W)
    lam = S5 * C10
    print('spinor sections are the band of the flux-1 adjacency with eigenvalue sqrt5*c =', float(lam), ':', meq(AW, mscale(lam, W)))
    Wg = Xg.sections('spinor')
    Ag = Xg.adjacency(1)
    lamg = -(S5 * C10).galois(17)
    print('great spinor sections: eigenvalue', float(lamg), ':', meq(mmul(Ag, Wg), mscale(lamg, Wg)))
    try:
        import numpy as np
        from carrier_tools import C
        G1 = np.array([[float((1 + dot3(X.n[p], X.n[q])) * HALF) for q in range(12)] for p in range(12)])
        G2 = (1 + C.N @ C.N.T) / 2
        G3 = np.array([[float((1 + dot3(Xg.n[p], Xg.n[q])) * HALF) for q in range(12)] for p in range(12)])
        G4 = (1 + C.Ng @ C.Ng.T) / 2
        print('agreement with carrier_tools (axis Gram, convex and great):', float(abs(G1 - G2).max()), float(abs(G3 - G4).max()),
              '; seams equal:', X.E == C.E, '; faces equal:', X.F == C.F, '; rhombi equal:', X.rhombi == C.rhombi,
              '; rotation permutations equal as sets:', {g[2] for g in X.group} == {tuple(p) for _, p in C.rot})
    except ImportError as ex:
        print('carrier_tools not importable here:', ex)
