"""Block 3: the port response as a law-owned object, for three laws, by the same method.

Generator per attempt: (Phi - 1) + eta * L1, L1 = -i [N_p, .] (eta = epsilon / Gamma, probe strength over attempt
rate). Effective generator on the fixed space of Phi: eta P L1 P - eta^2 P L1 (Phi - 1)^-1 (1 - P) L1 P, P the
asymptotic projection. Exact arithmetic in K on the 144-dimensional operator space of one load.

(i)   face-check pump on spinors (the theory session's face repair: a violated face is reset to the maximally mixed
      state of its consistent space);
(ii)  CAP at flux 1 (unique stationary state): first and second order response of the stationary state, the
      doublet level, the slowest sector (floating point for the eigenoperators);
(iii) framed quanta: exact fundamental matrix of the load chain, the second-order dephasing coefficients, and a
      floating-point check of the formula on the joint chain.
Output m3_response.json. Run: python m3_response.py
"""
import json, time
import numpy as np
from kfield import *
from capx import *
from xcarrier import dot3

t0 = time.time()
out = {}
W = X.sections('spinor')
Wd = dagger(W)
P2 = mscale(Kq(1, 6), mmul(W, Wd))                 # projector on the doublet
assert meq(mmul(P2, P2), P2) and trace(P2) == 2
N0 = zeros(12); N0[0][0] = K(1)


def vec(Xm): return [x for row in Xm for x in row]
def unvec(v): return [list(v[12 * i:12 * i + 12]) for i in range(12)]
def code(A): return mscale(Kq(1, 6), mmulm(W, A, Wd))            # V A V^dagger
def compress(Xm): return mscale(Kq(1, 6), mmulm(Wd, Xm, W))      # V^dagger X V
def L1(Xm): return mscale(-I, comm(N0, Xm))


class Pert:
    """Exact first and second order perturbation theory around the fixed space of a channel on M_12."""
    def __init__(self, phi, fixed):
        self.phi = phi; self.fixed = fixed; nf = len(fixed)
        cols = []
        for i in range(12):
            for j in range(12):
                E = zeros(12); E[i][j] = K(1)
                cols.append(vec(msub(phi(E), E)))
        S1 = [[cols[c][r] for c in range(144)] for r in range(144)]         # matrix of Phi - 1
        self.S1 = S1
        Mx = [[vec(f)[r] for f in fixed] + S1[r] + [K(1) if r == c else K(0) for c in range(144)] for r in range(144)]
        R, piv = rref(Mx, ncols=nf + 144)
        assert len(piv) == 144, ('fixed space is larger than given', len(piv))
        assert piv[:nf] == list(range(nf))
        self.piv = piv; self.T = [row[nf + 144:] for row in R]; self.nf = nf
        self.kernel_dim = nf + 144 - len(piv)

    def split(self, Xm):
        """X = sum_mu c_mu fixed_mu + (Phi - 1) Z. Returns (c, Z)."""
        b = vec(Xm)
        sol = mmul(self.T, col(b))
        full = [K(0)] * (self.nf + 144)
        for r, pc in enumerate(self.piv):
            full[pc] = sol[r][0]
        return full[:self.nf], unvec(full[self.nf:])

    def proj(self, Xm):
        c, _ = self.split(Xm)
        out_ = zeros(12)
        for cm, f in zip(c, self.fixed):
            out_ = madd(out_, mscale(cm, f))
        return out_, c

    def second_order(self, Rm):
        """-P L1 (Phi-1)^-1 (1-P) L1 R, in coordinates of the fixed basis."""
        Y = L1(Rm)
        c1, Z = self.split(Y)                     # (Phi-1) Z = Y - P Y
        PZ, _ = self.proj(Z)
        Zp = msub(Z, PZ)                          # the solution with P Z = 0
        _, c2 = self.proj(L1(Zp))
        return c1, [-x for x in c2], Zp


# ====================================================================== (i) face-check pump on spinors
print('(i) face-check pump on spinors', flush=True)
faces = [list(f) for f in X.F]
Pif, Ef = [], []
for f in faces:
    r = nullspace(transpose([W[p] for p in f]))[0]
    nrm = sum((x * x.conj() for x in r), K(0))
    Pi = zeros(12)
    for i, p in enumerate(f):
        for j, q in enumerate(f):
            Pi[p][q] = r[i].conj() * r[j] * nrm.inv()
    E = zeros(12)
    for p in f:
        E[p][p] = K(1)
    Pif.append(Pi); Ef.append(msub(E, Pi))
    assert is_zero_mat(mmul(Pi, P2)) and meq(mmul(Pi, Pi), Pi)
INV20 = Kq(1, 20)


def phi_face(Xm):
    acc = zeros(12)
    for Pi, E in zip(Pif, Ef):
        K0 = msub(eye(12), Pi)
        t = trace(mmul(Pi, Xm))
        term = mmulm(K0, Xm, K0)
        if not t.is_zero():
            term = madd(term, mscale(t * HALF, E))
        acc = madd(acc, term)
    return mscale(INV20, acc)


E2 = [[[K(1) if (i, j) == (a, b) else K(0) for j in range(2)] for i in range(2)] for a in range(2) for b in range(2)]
fixed = [code(A) for A in E2]
assert all(meq(phi_face(f), f) for f in fixed)
pf = Pert(phi_face, fixed)
resi = {'fixed_space_dimension': 4, 'fixed_algebra': 'M_2 on the doublet (exact: rank of Phi - 1 is 140)',
        'trace_preserving': all(trace(phi_face([[K(1) if (i, j) == (a, b) else K(0) for j in range(12)] for i in range(12)])) == (1 if a == b else 0)
                                for a in range(12) for b in range(0, 12, 5))}
# classical shadow of one face event on a load at a port of the face
f = faces[0]
E00 = zeros(12); E00[f[0]][f[0]] = K(1)
K0 = msub(eye(12), Pif[0])
one = madd(mmulm(K0, E00, K0), mscale(trace(mmul(Pif[0], E00)) * HALF, Ef[0]))
resi['one_face_event_populations_from_a_port_of_the_face'] = [str(one[p][p]) for p in f]
# stationary populations are not uniform: population shadow lost. Start from port 0 and project.
st, _ = pf.proj(E00)
resi['asymptotic_populations_from_port_0'] = sorted({str(st[p][p]) for p in range(12)})
resi['population_shadow'] = 'lost (one event from a port of the face gives ' + ', '.join(resi['one_face_event_populations_from_a_port_of_the_face']) + ')'
# first order
Q0 = X.Q[0]
ok1 = True
for A in E2:
    lhs, _ = pf.proj(L1(code(A)))
    rhs = code(mscale(-I * Kq(1, 6), comm(Q0, A)))
    ok1 = ok1 and meq(lhs, rhs)
resi['first_order_generator_is_commutator_with_P_N_p_P'] = ok1
resi['first_order_response'] = 'X_p = P N_p P = Q_p / 6 on the doublet'
# second order
hc4, hc6 = (5 - S5) * HALF, (5 + S5) * Kq(1, 3)
g = 20 * (Kq(4, 12) * hc4.inv() + Kq(6, 12) * hc6.inv())
D2 = []
for A in E2:
    c1, c2, Zp = pf.second_order(code(A))
    D2.append(c2)                                  # coordinates of L2(R_A) in the basis R_{E2}
# model: D(A) = (g/6) [2 <chi|A|chi> tau - {Q0, A}], tau = a Q0 + (1-a)(1-Q0); find a from A = Q0
def Dmodel(A, a):
    chi = X.chi[0]
    ev = sum((chi[i].conj() * A[i][j] * chi[j] for i in range(2) for j in range(2)), K(0))
    tau = madd(mscale(a, Q0), mscale(1 - a, msub(eye(2), Q0)))
    return mscale(g * Kq(1, 6), msub(mscale(2 * ev, tau), madd(mmul(Q0, A), mmul(A, Q0))))
def from_coords(c):
    M = zeros(2)
    for cm, A in zip(c, E2):
        M = madd(M, mscale(cm, A))
    return M
DQ = zeros(2)
for cm_, A in zip([Q0[i][j] for i in range(2) for j in range(2)], D2):
    DQ = madd(DQ, mscale(cm_, from_coords(A)))
# D(Q0) = (g/6)[2 tau - 2 Q0] = (g/3)(1-a)(1 - 2 Q0): read a from the trace against Q0: tr(Q0 D(Q0)) = -(g/3)(1-a)
a = 1 + trace(mmul(Q0, DQ)) * 3 * g.inv()
ok2 = all(meq(from_coords(c2), Dmodel(A, a)) for A, c2 in zip(E2, D2))
resi['second_order'] = {'form': 'L2(rho) = (g/6) [ 2 <chi_p|rho|chi_p> tau_p - {Q_p, rho} ], tau_p = a Q_p + (1 - a)(1 - Q_p), per attempt, times (epsilon/Gamma)^2',
                        'g': str(g), 'g_float': float(g), 'a': str(a), 'a_float': float(a), 'formula_exact_on_all_of_M2': ok2,
                        'leak_rate_from_chi_p': str(g * Kq(1, 3)), 'leak_rate_float': float(g) / 3,
                        'coherence_decay_rate': str(g * Kq(1, 6)), 'population_transfer_rate_to_orthogonal_state': str(g * Kq(1, 3) * (1 - a)),
                        'population_transfer_rate_float': float(g * Kq(1, 3) * (1 - a))}
resi['leakage_amplitude_squared'] = '5/36 (audit: (d/12)(1 - d/12))'
print('   fixed space 4; first order = -i[Q_p/6, .]:', ok1, '; second order formula exact:', ok2)
print('   g =', g, '=', float(g), '; a =', a, '=', float(a), '; one face event populations:', resi['one_face_event_populations_from_a_port_of_the_face'], flush=True)
out['i_face_check_pump'] = resi
json.dump(out, open('m3_response.json', 'w'), indent=1)

# ====================================================================== (ii) CAP at flux 1
print('(ii) CAP, flux 1', flush=True)
krs = kraus_one(1)
phi_cap = lambda Xm: channel(krs, Xm)
A1 = X.adjacency(1)
lam, dims = bands(1)
Pi = band_projectors(A1, lam)
Lc = msub(mscale(K(5), eye(12)), A1)
Linv = inverse(Lc)
rho0 = mscale(trace(Linv).inv(), Linv)
assert meq(phi_cap(rho0), rho0)
pc = Pert(phi_cap, [rho0])
resii = {'fixed_space_dimension': 1}
# first-order response of the stationary state: (Phi - 1) rho1 = i [N_p, rho0], traceless
c1, c2, Zp = pc.second_order(rho0)
rho1 = mneg(Zp)                                   # (Phi-1) Zp = L1 rho0  =>  rho1 = -(Phi-1)^-1 L1 rho0 = -Zp
assert meq(msub(phi_cap(rho1), rho1), mneg(L1(rho0))) and trace(rho1) == 0 and is_hermitian(rho1)
blocks1 = {f'{dims[i]}x{dims[j]}': not is_zero_mat(mmulm(Pi[i], rho1, Pi[j])) for i in range(3) for j in range(3)}
resii['first_order_response_of_stationary_state'] = {
    'first_order_coefficient_of_P_L1_rho0': str(c1[0]),
    'nonzero_band_blocks': blocks1,
    'doublet_block_is_zero': is_zero_mat(mmulm(Pi[0], rho1, Pi[0])),
    'quartet_block_is_zero': is_zero_mat(mmulm(Pi[1], rho1, Pi[1])),
    'sextet_block_is_zero': is_zero_mat(mmulm(Pi[2], rho1, Pi[2])),
    'diagonal_is_zero': all(rho1[p][p].is_zero() for p in range(12)),
    'hilbert_schmidt_norm_squared': str(trace(mmul(rho1, rho1))), 'hilbert_schmidt_norm': float(trace(mmul(rho1, rho1))) ** 0.5,
    'span_of_the_twelve_responses': None}
# the twelve responses rho1^(p) by covariance; their real span
resp = []
for p in range(12):
    gi = next(g for g in range(120) if X.group[g][2][0] == p)
    perm, ph = action_one(gi, 1)
    resp.append(conj_action(rho1, perm, ph))
resii['first_order_response_of_stationary_state']['span_of_the_twelve_responses'] = rank([herm_real_coords(r) for r in resp])
# antiunitary symmetry: a reflection fixing port 0 composed with complex conjugation
# second-order response and the doublet block
Y2 = L1(rho1)
_, Z2 = pc.split(Y2)
PZ2, _ = pc.proj(Z2)
rho2 = mneg(msub(Z2, PZ2))
assert meq(msub(phi_cap(rho2), rho2), mneg(msub(Y2, pc.proj(Y2)[0])))
blk = compress(mmulm(Pi[0], rho2, Pi[0]))          # 2 x 2 in the internal coordinates
# blk = alpha 1 + beta Q0
beta = (blk[0][0] - blk[1][1]) * (Q0[0][0] - Q0[1][1]).inv() if not (Q0[0][0] - Q0[1][1]).is_zero() else None
alpha = blk[0][0] - beta * Q0[0][0]
assert meq(blk, madd(mscale(alpha, eye(2)), mscale(beta, Q0)))
lev2 = trace(mmul(Pi[0], rho0)) * HALF
resii['second_order_doublet_block'] = {'form': 'Pi_2 rho2 Pi_2 = alpha 1 + beta Q_p (internal coordinates), times (epsilon/Gamma)^2',
                                       'alpha': str(alpha), 'beta': str(beta), 'alpha_float': float(alpha), 'beta_float': float(beta),
                                       'doublet_level': float(lev2), 'relative_splitting_beta_over_level': float(beta) / float(lev2)}
print('   first-order response: doublet block zero:', resii['first_order_response_of_stationary_state']['doublet_block_is_zero'],
      ' quartet:', resii['first_order_response_of_stationary_state']['quartet_block_is_zero'],
      ' sextet:', resii['first_order_response_of_stationary_state']['sextet_block_is_zero'],
      ' diagonal zero:', resii['first_order_response_of_stationary_state']['diagonal_is_zero'],
      ' span of the twelve:', resii['first_order_response_of_stationary_state']['span_of_the_twelve_responses'],
      ' norm:', resii['first_order_response_of_stationary_state']['hilbert_schmidt_norm'])
print('   second order doublet block: alpha', float(alpha), 'beta', float(beta), flush=True)

# pinched port loads (modular-time average of N_p): span and Lie closure
import importlib
m1 = None
class Span:
    def __init__(self):
        self.rows = []; self.piv = []; self.mats = []
    def add(self, H):
        v = [x.p for x in herm_real_coords(H)]
        for r, pcx in zip(self.rows, self.piv):
            f = v[pcx]
            if not f.is_zero():
                v = [(a_ - f * b_) % PHI for a_, b_ in zip(v, r)]
        pcx = next((j for j, x in enumerate(v) if not x.is_zero()), None)
        if pcx is None: return False
        inv = K(v[pcx]).inv().p
        v = [(a_ * inv) % PHI for a_ in v]
        self.rows.append(v); self.piv.append(pcx); self.mats.append(H)
        return True
pinched = []
for p in range(12):
    Np = zeros(12); Np[p][p] = K(1)
    acc = zeros(12)
    for Pj in Pi:
        acc = madd(acc, mmulm(Pj, Np, Pj))
    pinched.append(acc)
sp = Span()
for H in pinched: sp.add(H)
span_p = len(sp.rows)
resii['pinched_port_loads'] = {'definition': 'sum_j Pi_j N_p Pi_j = time average of N_p under the modular flow of the stationary state', 'real_span': span_p}
# Lie closure numerically (float) with the shared tool
try:
    from lie_tools import lie_closure, centre_dim
    mats, dimsl = lie_closure([1j * to_numpy(H) for H in pinched], max_dim=80)
    resii['pinched_port_loads']['lie_closure_float'] = dimsl[-1]
    resii['pinched_port_loads']['centre_float'] = centre_dim(mats) if dimsl[-1] <= 80 else None
except Exception as ex:
    resii['pinched_port_loads']['lie_closure_float'] = 'not computed: ' + str(ex)
print('   pinched port loads: span', span_p, ' closure', resii['pinched_port_loads'].get('lie_closure_float'), ' centre', resii['pinched_port_loads'].get('centre_float'), flush=True)

# slowest sector (float from the exact superoperator)
S = np.eye(144, dtype=complex) + to_numpy(pc.S1)
ev, R = np.linalg.eig(S)
order = np.argsort(-np.abs(ev))
lam2 = ev[order[1]]
sel = [i for i in range(144) if abs(ev[i] - lam2) < 1e-9]
Rinv = np.linalg.inv(R)
Rs, Ls = R[:, sel], Rinv[sel, :]
L1m = np.zeros((144, 144), complex)
for i in range(12):
    for j in range(12):
        # -i [N0, E_ij] = -i (delta_{i0} - delta_{j0}) E_ij
        L1m[12 * i + j, 12 * i + j] = -1j * ((1 if i == 0 else 0) - (1 if j == 0 else 0))
Om = Ls @ L1m @ Rs
om = np.linalg.eigvals(Om)
P2n = to_numpy(P2)
wts = []
for c in range(len(sel)):
    Rm = Rs[:, c].reshape(12, 12)
    wts.append(float(np.linalg.norm(P2n @ Rm @ P2n) ** 2 / np.linalg.norm(Rm) ** 2))
# the ideal: Bloch vector of the doublet under H = P N_p P = Q_p/6 precesses with angular frequency 1/6
resii['slowest_sector'] = {'eigenvalue': float(lam2.real), 'multiplicity': len(sel), 'decay_per_attempt': float(1 - lam2.real),
                           'first_order_shift_matrix_eigenvalues': [[float(x.real), float(x.imag)] for x in om],
                           'precession_frequency_per_unit_probe': float(max(abs(om.imag))), 'ideal_P_N_p_P_frequency': 1 / 6,
                           'ratio_to_ideal': float(max(abs(om.imag)) * 6), 'weight_of_eigenoperators_in_the_doublet_block': wts}
print('   slowest sector: eigenvalue', float(lam2.real), 'x', len(sel), '; first-order shift eigenvalues', np.round(om, 6), '; ratio to the ideal 1/6:', resii['slowest_sector']['ratio_to_ideal'],
      '; weight in the doublet block', np.round(wts, 4), flush=True)
out['ii_cap'] = resii
json.dump(out, open('m3_response.json', 'w'), indent=1)

# ====================================================================== (iii) framed quanta
print('(iii) framed quanta', flush=True)
A0 = X.adjacency(0)
# fundamental matrix of the load chain per attempt: g = 60 (5 - A0)^+ on mean-zero vectors
J = [[Kq(1, 12)] * 12 for _ in range(12)]
Mx = madd(msub(mscale(K(5), eye(12)), A0), mscale(K(12), J))          # (5 - A0) + 12 J is invertible: eigenvalue 12 on constants
gmat = mscale(K(60), msub(inverse(Mx), mscale(Kq(1, 12), J)))
gd = {}
for p in range(12):
    for q in range(12):
        d = X.dist[p][q]
        gd.setdefault(d, gmat[p][q]); assert gmat[p][q] == gd[d]
assert all(sum((gmat[p][q] for q in range(12)), K(0)).is_zero() for p in range(12))
resiii = {'first_order_response': 'X_p = Pi_p / 12 on the internal factor, for every internal dimension (exact: Tr of N_p in the uniform state)',
          'fundamental_matrix_by_port_distance': {str(d): str(v) for d, v in sorted(gd.items())},
          'second_order': 'L2(rho) = -(1/12) sum_pq v_p v_q g_pq [Pi_q, [Pi_p, rho]] per attempt, times (epsilon/Gamma)^2; one port: -(35/36) [Pi_p, [Pi_p, rho]]',
          'single_port_dephasing_rate': str(gd[0] * Kq(1, 12)), 'leakage': 'none: the internal factor never leaves; the term is dephasing in the basis of Pi_p',
          'with_position_record': 'the conditional evolution is exp(-i epsilon tau_p Pi_p) exactly, tau_p the recorded occupation time of port p; no second-order term'}
# floating-point check on the joint chain (position classical): spinor (great frame) and vector (convex)
Xg = X.great()
T = np.eye(12) - (5 * np.eye(12) - np.real(to_numpy(A0))) / 60
chk = {}
for name, Pis in (('spinor_great', [to_numpy(Xg.Q[p]) for p in range(12)]), ('vector_convex', [to_numpy(X.P[p]) for p in range(12)])):
    d = Pis[0].shape[0]
    rngv = np.random.default_rng(3).normal(size=12)
    rngv[1:] *= 0.0                                   # one port first
    for label, v in (('one_port', rngv / rngv[0]), ('all_ports', np.random.default_rng(4).normal(size=12))):
        # generator on (position, internal operator): G0 = (T - 1) x 1, G1 = -i v_p [Pi_p, .] at position p
        dd = d * d
        G0 = np.kron(T - np.eye(12), np.eye(dd))
        G1 = np.zeros((12 * dd, 12 * dd), complex)
        for p in range(12):
            adp = -1j * v[p] * (np.kron(Pis[p], np.eye(d)) - np.kron(np.eye(d), Pis[p].T))
            G1[p * dd:(p + 1) * dd, p * dd:(p + 1) * dd] = adp
        # slow manifold: uniform position x internal operator. Effective generator to second order, numerically
        Pm = np.kron(np.full((12, 12), 1 / 12), np.eye(dd))
        Qm = np.eye(12 * dd) - Pm
        G0inv = np.kron(np.linalg.pinv(T - np.eye(12), rcond=1e-10), np.eye(dd))
        eff1 = Pm @ G1 @ Pm
        eff2 = -Pm @ G1 @ G0inv @ Qm @ G1 @ Pm
        emb = np.kron(np.ones((12, 1)) / 12, np.eye(dd)); red = np.kron(np.ones((1, 12)), np.eye(dd))
        e1 = red @ eff1 @ emb; e2 = red @ eff2 @ emb
        X1 = sum(v[p] * Pis[p] for p in range(12)) / 12
        f1 = -1j * (np.kron(X1, np.eye(d)) - np.kron(np.eye(d), X1.T))
        gm = np.real(to_numpy(gmat))
        f2 = np.zeros((dd, dd), complex)
        for p in range(12):
            for q in range(12):
                if v[p] == 0 or v[q] == 0: continue
                adp = np.kron(Pis[p], np.eye(d)) - np.kron(np.eye(d), Pis[p].T)
                adq = np.kron(Pis[q], np.eye(d)) - np.kron(np.eye(d), Pis[q].T)
                f2 -= v[p] * v[q] * gm[p, q] / 12 * (adq @ adp)
        # exact slow eigenvalues at small eta against the second-order prediction
        eta = 1e-3
        evs = np.linalg.eigvals(G0 + eta * G1)
        slow = sorted(evs[np.argsort(-evs.real)[:dd]], key=lambda z: (round(z.imag, 12), round(z.real, 12)))
        pred = sorted(np.linalg.eigvals(eta * f1 + eta ** 2 * f2), key=lambda z: (round(z.imag, 12), round(z.real, 12)))
        chk[f'{name}/{label}'] = {'first_order_defect': float(np.abs(e1 - f1).max()), 'second_order_defect': float(np.abs(e2 - f2).max()),
                                  'slow_eigenvalue_defect_at_eta_1e-3': float(max(abs(a_ - b_) for a_, b_ in zip(slow, pred)))}
resiii['float_check_on_the_joint_chain'] = chk
print('   fundamental matrix by distance:', resiii['fundamental_matrix_by_port_distance'])
print('   float check of first and second order on the joint chain:', chk, flush=True)
out['iii_framed_quanta'] = resiii
out['seconds'] = round(time.time() - t0, 1)
json.dump(out, open('m3_response.json', 'w'), indent=1)
print('written m3_response.json in', out['seconds'], 's')
