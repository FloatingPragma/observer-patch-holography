"""FR round 3 supplement to fr9_hexagon.py (registered items H1, E2, E3): spectral weights of the E-kept dimer on the
closed sector, and the embedded amplitudes <A x| W^n |A start> = <x| T_n(D) |start> of the double-load states (frame FN).
EXACT (Fractions) except the float spectrum. Writes fr9b_supplement.json."""
import json
from fractions import Fraction as Fr

import numpy as np

import fr9_hexagon as X

n = len(X.CFG) * 4
D = [[Fr(0)] * n for _ in range(n)]
for ci, cfg in enumerate(X.CFG):
    for rec in range(4):
        for k in range(12):
            s, o = divmod(k, 2)
            a, b = X.ref_pair('FN', s, o)
            for c2, r2, u in X.local(cfg, rec, a, b):
                D[X.CI[c2] * 4 + r2][ci * 4 + rec] += u / 12


def apply(v):
    return [sum(D[i][j] * v[j] for j in range(n) if v[j]) for i in range(n)]


def idx(ports, rec):
    return X.CI[X.cfg_of(*ports)] * 4 + rec


out = {}
ids = [X.CI[c] * 4 + r for c in X.CFG if max(c) == 1 for r in (0, 1)]
Ds = np.array([[float(D[i][j]) for j in ids] for i in ids])
ev, V = np.linalg.eigh((Ds + Ds.T) / 2)
d0 = ids.index(idx((10, 2), 0))
wts = {}
for e, w in zip(ev, V[d0] ** 2):
    wts[round(float(e), 9)] = wts.get(round(float(e), 9), 0.0) + float(w)
out['closed_sector_FN'] = {
    'eigenvalue: multiplicity (float)': {str(e): int(sum(abs(ev - e) < 1e-9)) for e in sorted(set(np.round(ev, 9)))},
    'spectral_weights_of_the_E_kept_dimer': {str(k): round(v, 9) for k, v in sorted(wts.items())}}
# invariant subspace of the double load at port 2 (exact): D on span{double, forward rec 2, in-dimer rec 2}
tri = [idx((2, 2), 0), idx((2, 3), 2), idx((2, 10), 2)]
block = [[str(D[i][j]) for j in tri] for i in tri]
leak = all(D[i][j] == 0 for j in tri for i in range(n) if i not in tri)
out['double_load_invariant_subspace'] = {'D on (double, forward, in-dimer)': block, 'invariant (no leak, exact)': leak,
                                         'eigenvalues': '1, 1/2 (symmetric part), 5/6 (antisymmetric part): cos w = 1/2, period six'}
targets = {'double at 2, blank': idx((2, 2), 0), 'double at 10, blank': idx((10, 10), 0),
           'forward {2,3} rec 2': idx((2, 3), 2), 'in-dimer {2,10} rec 2': idx((2, 10), 2),
           'in-dimer {2,10} rec 3': idx((2, 10), 3), 'backward {0,10} rec 3': idx((0, 10), 3)}
for name, start in (('double load at port 2', {idx((2, 2), 0): Fr(1)}),
                    ('symmetric double state times sqrt2', {idx((2, 2), 0): Fr(1), idx((10, 10), 0): Fr(1)})):
    e0 = [Fr(0)] * n
    for i, c in start.items():
        e0[i] = c
    xp, x = e0, apply(e0)
    rows = {}
    for step in range(1, 13):
        rows[step] = {k: str(x[i]) for k, i in targets.items()}
        xp, x = x, [2 * a - b for a, b in zip(apply(x), xp)]
    out[name] = rows
json.dump(out, open('fr9b_supplement.json', 'w'), indent=1)
print(json.dumps(out['double_load_invariant_subspace'], indent=1))
print({k: v['double at 2, blank'] + ' | ' + v['forward {2,3} rec 2'] for k, v in out['double load at port 2'].items()})
