86,0.25557]},"mass_stat_syst":{"pion":[0.23173,0.032208,0.0007324],"rho":[0.58166,0.018831,0.015805],"nucleon":[0.5186,0.21797,0.13344]},"fit_window":{"pion":[5,12],"rho":[5,10],"nucleon":[5,9]},"mN_over_mrho":[0.89158,0.37631,0.21091],"mpi_over_mrho":[0.3984,0.054083,0.0098337]}],"hadron_lattice":{"size":[12,12,12,24],"configurations":128,"streams":32,"correlator":"smeared source, point sink","error":"jackknife over streams; second number adds the window and sink systematic"},"chiral":{"mq":[0.16973,0.075035,0.051346,0.029807],"m_pi2":[0.47568,0.21013,0.14512,0.0537],"m_rho":[0.81087,0.66255,0.62305,0.58166],"m_N":[1.3065,1.027,0.93583,0.5186],"m_rho_err":[0.00262,0.00404,0.00643,0.0188],"m_N_err":[0.00914,0.0117,0.0159,0.218],"kappa_c":[0.169189,6.63926e-05],"limit":{"m_rho":[0.54404,0.0075624],"m_N":[0.7886,0.072131]},"physical":{"m_rho":[0.54941,0.0075767],"m_N":[0.79903,0.068555],"input_m_pi_over_m_rho":0.178,"note":"the measured ratio m_pi/m_rho fixes the light quark mass (IMPORTED input)"},"slopes":{"m_rho":0.56097,"m_N":1.0913},"form":"m = m0 + c m_pi^2, four hopping parameters"},"ratios":[{"name":"m_N/m_rho (chiral limit)","value":1.4495,"err":0.132,"err_stat":0.0344,"err_syst":0.127,"measured":1.211},{"name":"m_N/m_rho (physical m_pi/m_rho)","value":1.4544,"err":0.124,"err_stat":0.0335,"err_syst":0.12,"measured":1.211},{"name":"m_rho/sqrt(sigma) (chiral limit)","value":1.3326,"err":0.0183,"err_stat":0.0169,"err_syst":0.00711},{"name":"m_N/sqrt(sigma) (chiral limit)","value":1.9317,"err":0.177,"err_stat":0.0407,"err_syst":0.172},{"name":"m_rho/sqrt(sigma) (physical m_pi/m_rho)","value":1.3458,"err":0.0184,"err_stat":0.0169,"err_syst":0.00712},{"name":"m_N/sqrt(sigma) (physical m_pi/m_rho)","value":1.9572,"err":0.168,"err_stat":0.0402,"err_syst":0.163}],"ratios_note":"NOT BLIND. Measured values: PDG 2024 masses; the string tension root 440 MeV is a convention.","statements":[{"text":"The energy of a separated static colour pair grows linearly with distance: a^2 sigma = 0.1667 +- 0.0136 at beta = 5.7.","label":"MEASURED"},{"text":"Quark-antiquark and three-quark states have definite masses. In lattice units, at kappa = 0.1600: pion 0.690, rho 0.811, nucleon 1.306. The nucleon is the heaviest at every quark mass.","label":"MEASURED"},{"text":"The pion mass squared falls linearly with the quark mass and vanishes at kappa_c = 0.16919(6): the behaviour of a light pseudoscalar bound state.","label":"MEASURED"},{"text":"In the chiral limit m_N/m_rho = 1.45(13), against 1.211 measured. A gap of this size is expected from the coarse lattice (about 0.18 fm), the small box and the dropped quark loops.","label":"MEASURED"},{"text":"Above the transition the binding melts: the free energy of a separated colour pair rises with slope 0.99 per lattice unit below it and 0.001 above it.","label":"MEASURED"},{"text":"Gauge group SU(3), plaquette action and colour triplet are the source's. The law that writes continuous link phases is a declared step.","label":"DECLARED"},{"text":"Quark loops are dropped (quenched approximation). The Wilson fermion is a standard discretisation chosen here.","label":"DECLARED"}],"references":[{"cite":"K. G. Wilson, Confinement of quarks, Phys. Rev. D 10, 2445 (1974)","url":"https://doi.org/10.1103/PhysRevD.10.2445"},{"cite":"F. Butler et al. (GF11), Hadron masses from the valence approximation to lattice QCD, Nucl. Phys. B 430, 179 (1994)","url":"https://arxiv.org/abs/hep-lat/9405003"},{"cite":"M. Albanese et al. (APE), Phys. Lett. B 192, 163 (1987)","url":"https://doi.org/10.1016/0370-2693(87)91160-9"},{"cite":"R. Sommer, A new way to set the energy scale in lattice gauge theories, Nucl. Phys. B 411, 839 (1994)","url":"https://arxiv.org/abs/hep-lat/9310022"},{"cite":"S. Necco and R. Sommer, The N_f = 0 heavy quark potential, Nucl. Phys. B 622, 328 (2002)","url":"https://arxiv.org/abs/hep-lat/0108008"},{"cite":"R. G. Edwards, U. M. Heller, T. R. Klassen, Accurate scale determinations for the Wilson gauge action, Nucl. Phys. B 517, 377 (1998)","url":"https://arxiv.org/abs/hep-lat/9711003"},{"cite":"S. Aoki et al. (CP-PACS), Quenched light hadron spectrum, Phys. Rev. Lett. 84, 238 (2000)","url":"https://arxiv.org/abs/hep-lat/9904012"},{"cite":"G. Boyd et al., Thermodynamics of SU(3) lattice gauge theory, Nucl. Phys. B 469, 419 (1996)","url":"https://arxiv.org/abs/hep-lat/9602007"},{"cite":"Particle Data Group, Review of Particle Physics, Phys. Rev. D 110, 030001 (2024)","url":"https://pdg.lbl.gov/"}]}