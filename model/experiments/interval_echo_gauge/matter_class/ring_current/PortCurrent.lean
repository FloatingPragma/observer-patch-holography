import Mathlib.Data.Complex.Basic
import Mathlib.Tactic.Ring

namespace OPH.PentagonContinuity

/-- A native positive half-exchange has output numerators
    a + i b and i a + b. Right minus left includes every start. -/
theorem signed_work (a b : ℂ) :
    (Complex.normSq (Complex.I * a + b) -
      Complex.normSq (a + Complex.I * b)) / 2 =
        2 * (a.re * b.im - a.im * b.re) := by
  simp [Complex.normSq_apply, Complex.mul_re, Complex.mul_im]
  ring

/-- For endpoint velocity i*a/2-i*v*b generated by the native hopping
    -1/2 and any real on-site term v, the infinitesimal population change
    at b is exactly half the signed terminal reading. -/
theorem bond_continuity (a b : ℂ) (v : ℝ) :
    let db := (((1/2 : ℝ) : ℂ) * Complex.I) * a - (v : ℂ) * Complex.I * b
    2 * (b.re * db.re + b.im * db.im) =
      a.re * b.im - a.im * b.re := by
  simp [Complex.mul_re, Complex.mul_im]
  ring

/-- Forming a signed antipodal difference before or after a free propagator
    agrees whenever it intertwines the marked involution. -/
theorem source_detector_transfer {V : Type*} [AddGroup V] (U : V →+ V)
    (J : V → V) (x : V) (h : U (J x) = J (U x)) :
    U (x - J x) = U x - J (U x) := by rw [map_sub, h]

end OPH.PentagonContinuity
