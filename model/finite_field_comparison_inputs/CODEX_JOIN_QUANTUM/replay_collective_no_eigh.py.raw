"""Fresh-process exact replay with every common eigensolver disabled."""
import json
from pathlib import Path
import numpy.linalg
import scipy.linalg
import scipy.sparse.linalg
from sympy.matrices.matrixbase import MatrixBase


def forbidden(*args, **kwargs):
    raise AssertionError('eigensolver called during the exact collective replay')


for module in (numpy.linalg, scipy.linalg, scipy.sparse.linalg):
    for name in ('eig', 'eigh', 'eigvals', 'eigvalsh', 'eigs', 'eigsh', 'lobpcg', 'schur'):
        if hasattr(module,name):
            setattr(module,name,forbidden)
for name in ('eigenvals', 'eigenvects', 'diagonalize', 'jordan_form'):
    setattr(MatrixBase,name,forbidden)

from model.coherent_defect_wave.chiral_joint.collective_spin_response.certificate import certificate
from model.coherent_defect_wave.chiral_joint.collective_spin_response import __file__ as package_file
expected = json.loads(Path(package_file).with_name('results.json').read_text())
assert certificate() == expected
print('PASS: fresh no-eigh replay, actual full-source operators, exact residues and complete records')
