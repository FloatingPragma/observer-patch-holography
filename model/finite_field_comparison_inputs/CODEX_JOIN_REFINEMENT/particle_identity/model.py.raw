def receipt():
    names=('model/interacting_block_propagation/results.json','model/interacting_block_quadrature/results.json',
        'model/coherent_defect_wave/chiral_particle_map/PROOF.md','model/particle_common_contract/PROOF.md',
        'model/particle_transport/algebra.py','Lean/ObserverPatchHolography/CoreAxioms.lean',
        'Lean/Screen/SeamCurrentCarrierQuotient.lean','Lean/Screen/SeamCurrentEdge30Moment.lean')
    result={'actual_source_classification':classification(),'cone_representation':actual_transverse_irreps(),
        'spin_ambiguity_controls':spin_restriction_controls(),'mass_label_nonselection_control':exact_number_shift(),
        'RER_input_sha256':{name:hashlib.sha256((RER/name).read_bytes()).hexdigest() for name in names},
        'worker_source_receipt_sha256':{name:hashlib.sha256((WORK/name).read_bytes()).hexdigest() for name in ('CODEX_JOIN_QUANTUM/coulomb_source/results.json','CODEX_JOIN_QUANTUM/coulomb_mobile/results.json')},
        'independent_geometry_audit_sha256':hashlib.sha256(AUDIT.read_bytes()).hexdigest(),
        'own_source_sha256':{p.name:hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(HERE.iterdir()) if p.suffix in ('.py','.md')}}
    return result


if __name__=='__main__':
    import argparse
    parser=argparse.ArgumentParser();parser.add_argument('--check',action='store_true');args=parser.parse_args()
    value=receipt();path=HERE/'results.json'
    if args.check:assert json.loads(path.read_text())==value
    else:path.write_text(json.dumps(value,indent=2,sort_keys=True)+'\n')
    print('PASS: actual-source particle labels and finite representation controls')
