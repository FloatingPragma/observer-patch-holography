"""Focused independent checks; no candidate source mutation."""
from pathlib import Path
import importlib.util

spec=importlib.util.spec_from_file_location('coulomb_independent_audit_tests',Path(__file__).with_name('audit.py'))
audit=importlib.util.module_from_spec(spec)
spec.loader.exec_module(audit)


def test_incidence_spectrum_and_all_spatial_residues():
    result=audit.spectral_check()
    assert result['all_42_edge_and_50_face_projector_sum_rules']


def test_full_register_gauss_and_ground_gaps():
    result=audit.gauss_and_energy_check()
    assert result['full_kinematic_unique_ground_gap']=='26/217'
    assert result['zero_Gauss_sector_dimension']==44695552


def test_total_cutoff_completion_and_gaussian_boundary():
    result=audit.cutoff_and_weyl_check()
    assert result['cross_mode_unrestricted_CCR_false']
    assert result['frequency_one_finite_vacuum_q8']=='81/16'


def test_all_complete_static_joint_records():
    assert audit.records_check()['complete_twelve_record_experiments_checked']==26
