"""Worker HR: series at fixed kappa_H from a symmetric and from a Higgs start (CANDIDATES.md, Addendum 2).

Reads scan_T*up.json and scan_T*dn.json (written by hr_scan2.py with equal start and stop values). Readout:
  (i) means of rho^2 of the two starts over the second half of each series, with blocked errors;
  (ii) pooled histogram of the lattice-averaged rho^2 (second halves): bimodality coefficient
       b = (skewness^2 + 1)/kurtosis (5/9 for a uniform distribution, 1/3 for a Gaussian) and Ashman's D of a
       two-cluster split (2.65 for one Gaussian peak split at its centre; two separated peaks lie well above it);
  (iii) crossings of the midpoint between the two cluster centres by the series smoothed over ten sweeps.
Writes series_summary.json and SERIES_TABLE.md. Reads no measured value.
"""
import glob
import json

import numpy as np

import hr_lib as H


def load(tag):
    try:
        d = json.load(open(f"scan_{tag}.json"))
    except FileNotFoundError:
        return None
    s = np.concatenate([np.array(p["series_rho2"]) for p in d["points"]]) if d["points"] else np.array([])
    return d, s


def two_clusters(x):
    c = np.array([np.percentile(x, 10), np.percentile(x, 90)])
    for _ in range(50):
        lab = np.abs(x[:, None] - c[None, :]).argmin(1)
        new = np.array([x[lab == j].mean() if (lab == j).any() else c[j] for j in (0, 1)])
        if np.allclose(new, c):
            break
        c = new
    s = [x[lab == j].std() if (lab == j).sum() > 1 else 0.0 for j in (0, 1)]
    D = abs(c[1] - c[0]) / max(1e-12, np.sqrt((s[0] ** 2 + s[1] ** 2) / 2))
    return c, s, float(D), [float((lab == j).mean()) for j in (0, 1)]


rows = []
tags = sorted({f[len("scan_"):-len("up.json")] for f in glob.glob("scan_T*up.json")})
for tag in tags:
    up, dn = load(tag + "up"), load(tag + "dn")
    if up is None or dn is None or len(up[1]) < 40 or len(dn[1]) < 40:
        continue
    d = up[0]
    su, sd = up[1], dn[1]
    hu, hd = su[len(su) // 2:], sd[len(sd) // 2:]
    eu, ed = H.blocked_error(hu, 8), H.blocked_error(hd, 8)
    pooled = np.concatenate([hu, hd])
    m, sdev = pooled.mean(), pooled.std()
    skew = float(((pooled - m) ** 3).mean() / sdev ** 3)
    kurt = float(((pooled - m) ** 4).mean() / sdev ** 4)
    c, s, D, frac = two_clusters(pooled)
    mid = 0.5 * (c[0] + c[1])
    cross = 0
    for ser in (hu, hd):
        sm = np.convolve(ser, np.ones(10) / 10, mode="valid")
        cross += int((np.diff(np.sign(sm - mid)) != 0).sum())
    rows.append({"tag": tag, "beta_G": d["beta_G"], "lambda_L": d["lambda_L"], "L": d["L"], "kappa_H": d["points"][0]["kappa_H"],
                 "sweeps_per_start": [int(len(su)), int(len(sd))],
                 "rho2_symmetric_start_second_half": float(hu.mean()), "err_sym": eu,
                 "rho2_higgs_start_second_half": float(hd.mean()), "err_higgs": ed,
                 "difference_in_errors": float((hd.mean() - hu.mean()) / max(1e-12, np.hypot(eu, ed))),
                 "rho2_first_tenth_sym_start": float(su[:len(su) // 10].mean()),
                 "rho2_first_tenth_higgs_start": float(sd[:len(sd) // 10].mean()),
                 "bimodality_coefficient": (skew ** 2 + 1) / kurt, "skewness": skew, "kurtosis": kurt,
                 "cluster_centres": [float(c[0]), float(c[1])], "cluster_widths": [float(s[0]), float(s[1])],
                 "cluster_weights": frac, "ashman_D": D, "midpoint_crossings": cross,
                 "pooled_percentiles_5_25_50_75_95": [float(np.percentile(pooled, q)) for q in (5, 25, 50, 75, 95)]})
json.dump(rows, open("series_summary.json", "w"), indent=1)
md = ["# HR series at fixed kappa_H (generated by hr_series.py)", "",
      "Two starts per row: symmetric (random doublet, unit links) and Higgs (uniform doublet at the tree-level minimum).",
      "Means over the second half of each series. b is the bimodality coefficient (1/3 Gaussian, 5/9 uniform); D is",
      "Ashman's separation of a two-cluster split of the pooled second halves (2.65 for one Gaussian peak).", "",
      "| tag | lambda_L | L | kappa_H | sweeps per start | rho^2, symmetric start | rho^2, Higgs start | difference in errors | b | D | cluster centres | crossings |",
      "| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |"]
for r in rows:
    md.append(f"| {r['tag']} | {r['lambda_L']} | {r['L']} | {r['kappa_H']:.4f} | {r['sweeps_per_start'][0]}, {r['sweeps_per_start'][1]} | "
              f"{r['rho2_symmetric_start_second_half']:.3f} ({r['err_sym']:.3f}) | {r['rho2_higgs_start_second_half']:.3f} ({r['err_higgs']:.3f}) | "
              f"{r['difference_in_errors']:+.1f} | {r['bimodality_coefficient']:.3f} | {r['ashman_D']:.2f} | "
              f"{r['cluster_centres'][0]:.2f}, {r['cluster_centres'][1]:.2f} | {r['midpoint_crossings']} |")
open("SERIES_TABLE.md", "w").write("\n".join(md) + "\n")
print("\n".join(md))
