"""Worker HR: the source's coefficients in the standard lattice parameters (CANDIDATES.md, group S).

Reads GL's cell coupling (1/alpha = 16.2453, g^2 = 0.77354) and UH's zero-point constants
(work/UH/constants.json, constants_b4t.json; read only). Reads no measured value. Writes source_points.json.

Map: canonical doublet Phi (kinetic term |Phi_x - V Phi_y|^2 per link), on-site m0^2 |Phi|^2 + lambda0 |Phi|^4;
Phi = sqrt(kappa_H) Phi_L; m0^2 = (1 - 2 lambda_L - 8 kappa_H)/kappa_H; lambda0 = lambda_L / kappa_H^2.
"""
import json
import math

import numpy as np

UH = "WORKSPACE/repair-law/work/UH/"
c = json.load(open(UH + "constants.json"))
ct = json.load(open(UH + "constants_b4t.json"))
A_f = c["B4_fermion_CF1_cone_cell"]["A2"]
c_f = c["B4_fermion_CF1_cone_cell"]["c_cell"]
A_V = {"B4 (GL link waves, continuous time)": c["B4_vector_GL_links_full_zone"]["A2"],
       "B4t (two field steps per tick)": ct["A2"]}

INV_ALPHA = 16.2453
g2 = 4 * math.pi / INV_ALPHA
gY2 = 0.6 * g2
beta_G = 4 / g2


def kappa_of(m0sq, lam0=0.0):
    """root of 2 lam0 k^2 + (8 + m0^2) k - 1 = 0"""
    b = 8.0 + m0sq
    if lam0 == 0.0:
        return 1.0 / b
    return (-b + math.sqrt(b * b + 8.0 * lam0)) / (4.0 * lam0)


def point(label, m0sq, lam0=0.0, standing=""):
    k = kappa_of(m0sq, lam0)
    return {"label": label, "m0_squared_cell_units": m0sq, "lambda0": lam0, "kappa_H": k, "lambda_L": lam0 * k * k,
            "standing": standing}


# Euclidean isotropic tadpole J = int d^4k/(2 pi)^4 1/khat^2 (midpoint grid, extrapolated in 1/n^2)
def J_grid(n):
    k = (np.arange(n) + 0.5) * 2 * np.pi / n
    s = 4 * np.sin(k / 2) ** 2
    tot = s[:, None, None, None] + s[None, :, None, None] + s[None, None, :, None] + s[None, None, None, :]
    return float(np.mean(1.0 / tot))


J32, J48 = J_grid(32), J_grid(48)
J = J48 + (J48 - J32) * (32 ** 2) / (48 ** 2 - 32 ** 2)

out = {"inputs": {"inverse_alpha_cell (GL B1, DC cut closure)": INV_ALPHA, "g_squared": g2, "gY_squared = 3 g^2/5": gY2,
                  "beta_G = 4/g^2": beta_G, "beta_lat = 8/g^2 (pattern carrier)": 8 / g2,
                  "hop coefficient on theta, 4/g^2": 4 / g2, "A_f (UH, CF-1 cone cell)": A_f, "c_f": c_f, "A_V (UH)": A_V,
                  "J_Euclidean_isotropic": J, "J_grid_32_48": [J32, J48]}}

pts = []
pts.append(point("S1 functional only, tree level", 0.0, 0.0, "DERIVED (YC F1, UH S2, S3) under the declared construction"))
for s in (0.9, 0.5, 0.1):
    p = point(f"S2 functional plus oscillator energy omega = 1, share s = {s}", (1 - s) * 1.0, 0.0,
              "omega and s DECLARED; isotropized (the doublet's speed squared is s)")
    p["speed_squared_of_the_doublet"] = s
    pts.append(p)
per_cone_family = -8.0 * A_f * g2
for nc, nf in ((1, 1), (1, 3), (4, 1), (4, 3), (32, 1), (32, 3)):
    lab = "S3" if nc == 1 else "S4"
    pts.append(point(f"{lab} functional plus fermion zero-point term, cones {nc}, families {nf}", per_cone_family * nc * nf, 0.0,
                     "one loop (UH's A_f), y = g/2 on every leg (YC); cone multiplicity DECLARED"))
out["source_points"] = pts
out["fermion_term_per_cone_and_family"] = per_cone_family

# S5: one-loop vector terms: the mass shift the links give the doublet, and the line they predict at lambda_L -> 0
s5 = {"Euclidean isotropic, weak factor: (9/4) g^2 J": 2.25 * g2 * J,
      "Euclidean isotropic, with hypercharge: (3/4)(3 g^2 + gY^2) J": 0.75 * (3 * g2 + gY2) * J}
for name, av in A_V.items():
    s5[f"Hamiltonian clock, weak factor: (9/2) A_V g^2, {name}"] = 4.5 * av * g2
    s5[f"Hamiltonian clock, with hypercharge: (3/2) A_V (3 g^2 + gY^2), {name}"] = 1.5 * av * (3 * g2 + gY2)
out["S5_vector_mass_shift"] = {k: {"delta_m_squared": v, "predicted_kappa_c_at_lambda_to_zero": 1.0 / (8.0 - v),
                                   "cones_times_families_that_cancel_it": v / (-per_cone_family)} for k, v in s5.items()}
for bg in (4.0, 6.5):
    gg = 4.0 / bg
    out["S5_vector_mass_shift"][f"Euclidean isotropic, weak factor, beta_G = {bg}"] = {
        "delta_m_squared": 2.25 * gg * J, "predicted_kappa_c_at_lambda_to_zero": 1.0 / (8.0 - 2.25 * gg * J)}

# one-loop line with a stabilizer: m0^2_c = -[(9/4) g^2 + 6 lambda0] J, solved for kappa_c at fixed lambda_L
line = {}
for bg in (4.0, beta_G, 6.5):
    gg = 4.0 / bg
    row = {}
    for lamL in (0.0002, 0.002, 0.02):
        k = 0.13
        for _ in range(200):
            lam0 = lamL / k ** 2
            m0c = -(2.25 * gg + 6.0 * lam0) * J
            k = (1.0 - 2.0 * lamL) / (8.0 + m0c)
        row[str(lamL)] = {"kappa_c_one_loop": k, "lambda0": lamL / k ** 2}
    line[f"beta_G = {bg:.4f}"] = row
out["one_loop_line_with_stabilizer"] = line

# S6: induced quartic (UH, equal legs, source frame) in lattice units at kappa = 1/8
s6 = {}
for name, lam0 in (("B1", -1.3343e-3), ("B4t", -9.9008e-3), ("B4", -1.49162e-2), ("B6t", -1.94981e-2)):
    s6[name] = {"lambda0": lam0, "lambda_L_at_kappa_1_over_8": lam0 / 64.0}
S4f = g2 * g2 / 2
s6["fermion part alone, one cone, equal legs"] = {"lambda0": -S4f * (1.5 - c_f) / (16 * math.pi ** 2),
                                                  "lambda_L_at_kappa_1_over_8": -S4f * (1.5 - c_f) / (16 * math.pi ** 2) / 64.0}
out["S6_induced_quartic"] = s6
out["yukawa"] = {"y = g/2": math.sqrt(g2) / 2, "mass angle per unit of |Phi_L|: (g/2) sqrt(kappa_H) at kappa_H = 1/8":
                 math.sqrt(g2) / 2 * math.sqrt(0.125),
                 "W mass squared per rho_v^2: g^2 kappa_H / 2 at kappa_H = 1/8": g2 * 0.125 / 2,
                 "Z over W mass ratio at the cell, sqrt(8/5)": math.sqrt(8 / 5)}
json.dump(out, open("source_points.json", "w"), indent=1)
print(json.dumps(out, indent=1))
