"""Worker HR: the Higgs line on thermal lattices 8^3 x N_t against the vacuum lattice 8^4 (CANDIDATES.md, Addendum 3).

Reads scan_TH*.json (N_t = 2, 4) and scan_A_L8*.json (N_t = 8). Readout per (lambda_L, N_t, branch): the kappa_H at
which L_alpha crosses 0.40 (linear interpolation between neighbouring points), and the values of L_alpha and rho^2
at the common kappa_H. Writes thermal_summary.json and THERMAL_TABLE.md. Reads no measured value.
"""
import glob
import json
from collections import defaultdict

import numpy as np

data = defaultdict(dict)        # (lambda, N_t, branch) -> {kappa: point}
for f in sorted(glob.glob("scan_TH*.json")) + sorted(glob.glob("scan_A_L8*.json")) + sorted(glob.glob("scan_Ab_L8*.json")):
    d = json.load(open(f))
    for p in d["points"]:
        data[(d["lambda_L"], d.get("T", d["L"]), p["branch"])][round(p["kappa_H"], 6)] = p


def crossing(pts, level=0.40):
    ks = sorted(pts)
    la = [pts[k]["L_alpha"] for k in ks]
    for i in range(len(ks) - 1):
        if (la[i] - level) * (la[i + 1] - level) <= 0 and la[i] != la[i + 1]:
            return ks[i] + (level - la[i]) * (ks[i + 1] - ks[i]) / (la[i + 1] - la[i])
    return None


rows = []
for (lam, nt, br), pts in sorted(data.items()):
    rows.append({"lambda_L": lam, "N_t": nt, "temperature_in_E_cell": 1.0 / nt, "branch": br,
                 "kappa_range": [min(pts), max(pts)], "kappa_at_L_alpha_0.40": crossing(pts),
                 "points": [{"kappa_H": k, "L_alpha": pts[k]["L_alpha"], "rho2": pts[k]["rho2"], "plaq": pts[k]["plaq"],
                             "chi_L_alpha": pts[k]["chi_L_alpha"], "nmeas": pts[k]["nmeas"]} for k in sorted(pts)]})
json.dump(rows, open("thermal_summary.json", "w"), indent=1)
md = ["# HR thermal lattices 8^3 x N_t (generated by hr_thermal.py)", "",
      "Temperature of the ensemble: 1/N_t in units of E_cell. N_t = 8 is the vacuum lattice of the main scans.", "",
      "| lambda_L | N_t | branch | kappa_H range | kappa_H at L_alpha = 0.40 |", "| --- | --- | --- | --- | --- |"]
for r in rows:
    c = r["kappa_at_L_alpha_0.40"]
    md.append(f"| {r['lambda_L']} | {r['N_t']} | {r['branch']} | {r['kappa_range'][0]:.4f} to {r['kappa_range'][1]:.4f} | "
              f"{('%.5f' % c) if c else 'no crossing in range'} |")
for lam in sorted({r["lambda_L"] for r in rows}):
    ks = sorted({p["kappa_H"] for r in rows if r["lambda_L"] == lam for p in r["points"]})
    cols = [(r["N_t"], r["branch"]) for r in rows if r["lambda_L"] == lam]
    md += ["", f"## L_alpha (rho^2) at lambda_L = {lam}", "",
           "| kappa_H | " + " | ".join(f"N_t = {nt}, {br}" for nt, br in cols) + " |", "| --- |" + " --- |" * len(cols)]
    for k in ks:
        cells = []
        for nt, br in cols:
            p = data[(lam, nt, br)].get(k)
            cells.append(f"{p['L_alpha']:.3f} ({p['rho2']:.2f})" if p else "")
        md.append(f"| {k:.4f} | " + " | ".join(cells) + " |")
open("THERMAL_TABLE.md", "w").write("\n".join(md) + "\n")
print("\n".join(md))
