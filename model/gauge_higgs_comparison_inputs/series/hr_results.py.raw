"""Worker HR: tables of the compact form and of the screening masses, and one file with the headline numbers.

Reads compact_*.json, corr_*.json, scan_summary.json, series_summary.json, thermal_summary.json, source_points.json.
Writes COMPACT_TABLE.md, CORR_TABLE.md, results.json. Reads no measured value.
"""
import glob
import json
import math
from collections import defaultdict

res = {}

# ------------------------------------------------------------------ compact form
comp = defaultdict(dict)
for f in sorted(glob.glob("compact_*.json")):
    d = json.load(open(f))
    for p in d["points"]:
        comp[(d["scan"], d["L"], p["branch"])][round(p["value"], 6)] = p
md = ["# HR compact form (generated by hr_results.py)", "",
      "`S_C = beta_G sum_P (1 - tr V_P/2) + beta_H sum_links [1 - n0 n0' - Re q^dag V q'] - h sum_x |q_x|^2`, beta_G = 5.171.",
      "sin^2 theta = |q|^2; L_alpha is the doublet link with unit doublets; theta is the mean mass angle (0 to pi).", ""]
summ = []
for (scan, L, br), pts in sorted(comp.items()):
    md += [f"## scan of {scan}, {L}^4, branch {br}" + (" (beta_H = 10.342)" if scan == "h" else " (h = 0)"), "",
           f"| {scan} | plaquette | L_n | L_q | L_alpha | sin^2 theta | cos theta | theta | chi(sin^2) | sweeps |",
           "| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |"]
    vals = sorted(pts) if br == "up" else sorted(pts, reverse=True)
    for v in vals:
        p = pts[v]
        md.append(f"| {v:.3f} | {p['plaq']:.5f} | {p['L_n']:.4f} | {p['L_q']:.4f} | {p['L_alpha']:.4f} | {p['sin2']:.4f} | "
                  f"{p['cos']:+.4f} | {p['theta']:.4f} | {p['chi_sin2']:.3f} | {p.get('nmeas', '')} |")
    md.append("")
    if scan == "h":
        vs = sorted(pts)
        hi = [v for v in vs if pts[v]["sin2"] > 0.5]
        lo = [v for v in vs if pts[v]["sin2"] <= 0.5]
        summ.append({"L": L, "branch": br, "largest_h_aligned_at_the_pole": max(lo) if lo else None,
                     "smallest_h_on_the_equator": min(hi) if hi else None,
                     "sin2_at_h_0": pts[vs[0]]["sin2"] if vs[0] == 0 else None,
                     "L_alpha_at_h_0": pts[vs[0]]["L_alpha"] if vs[0] == 0 else None,
                     "sin2_on_the_equator": pts[max(hi)]["sin2"] if hi else None,
                     "L_alpha_on_the_equator": pts[max(hi)]["L_alpha"] if hi else None})
    else:
        summ.append({"L": L, "branch": br, "scan": "beta_H", "max_L_alpha": max(p["L_alpha"] for p in pts.values()),
                     "range": [min(pts), max(pts)],
                     "sin2_at_largest_beta_H": pts[max(pts)]["sin2"], "sin2_at_smallest_beta_H": pts[min(pts)]["sin2"]})
open("COMPACT_TABLE.md", "w").write("\n".join(md) + "\n")
res["compact"] = summ
res["compact_h_per_cone_and_family"] = 32 * 0.0057097330883762246

# ------------------------------------------------------------------ screening masses
md = ["# HR screening masses (generated by hr_results.py)", "",
      "beta_G = 5.171. Effective masses m(t) from C(t)/C(t+1) with the cosh form; jackknife errors over blocks.",
      "Tree level: `M_W^2 = g^2 kappa_H rho_v^2 / 2`; the two columns take rho_v^2 = rho^2 - 2.4 and rho_v^2 = rho^2.", "",
      "| tag | model | lattice | lambda_L | kappa_H | start | sweeps | rho^2 | L_alpha | vector channel m(1), m(2), m(3) | scalar channel m(0), m(1) | tree M_W (two readings) |",
      "| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |"]
import numpy as np
from scipy.optimize import least_squares


def cosh_fit(C, E, T, tmin, const):
    t = np.arange(tmin, T // 2 + 1)

    def r(p):
        return (p[0] * np.cosh(p[1] * (t - T / 2)) + (p[2] if const else 0.0) - C[t]) / E[t]

    sol = least_squares(r, [C[tmin] / np.cosh(0.5 * (tmin - T / 2)), 0.5] + ([0.0] if const else []))
    return float(abs(sol.x[1])), float((sol.fun ** 2).sum())


def fits(d, key, tmin):
    """cosh fits over t = tmin .. T/2 with and without a constant; jackknife errors when the blocks are stored"""
    C = np.array(d[key]["C"]); E = np.array(d[key]["C_err"]); T = len(C)
    out = {}
    for const in (False, True):
        m, chi2 = cosh_fit(C, E, T, tmin, const)
        err = None
        if "vector_channel_blocks" in d:
            cb = np.array(d["vector_channel_blocks"]); nb = len(cb)
            mj = [cosh_fit(cb[np.arange(nb) != b].mean(0), E, T, tmin, const)[0] for b in range(nb)]
            err = float(np.sqrt((nb - 1) / nb * ((np.array(mj) - np.mean(mj)) ** 2).sum()))
        out["with_constant" if const else "no_constant"] = {"M": m, "err": err, "chi2": chi2}
    return out


md_fit = ["", "## Cosh fits of the vector channel, t from tmin to T/2", "",
          "| tag | lattice | tmin | M, no constant | chi^2 | M, with a constant | chi^2 |", "| --- | --- | --- | --- | --- | --- | --- |"]
corr = []
for f in sorted(glob.glob("corr_*.json")):
    d = json.load(open(f))
    key = "channel_Z_(neutral_component)" if d["model"] == "u1" else "channel_W_(all_nine_components)"
    em = {m["t"]: m for m in d[key]["effective_masses"]}
    es = {m["t"]: m for m in d["channel_scalar_rho2_connected"]["effective_masses"]}

    def fmt(m):
        if m is None or m["m_eff"] is None:
            return "none"
        return f"{m['m_eff']:.3f} ({m['err']:.3f})" if m["err"] is not None else f"{m['m_eff']:.3f}"

    tl = d["tree_level"]
    t2 = tl.get("M_W_tree_with_rho_v2 = rho2", math.sqrt(max(0.0, (4.0 / d["beta_G"]) * d["kappa_H"] * d["rho2"] / 2)))
    md.append(f"| {d['tag']} | {d['model']} | {d['L']}^3 x {d['T']} | {d['lambda_L']} | {d['kappa_H']} | {d['start']} | {d['nmeas']} | {d['rho2']:.3f} | "
              f"{d['L_alpha']:.3f} | {fmt(em.get(1))}, {fmt(em.get(2))}, {fmt(em.get(3))} | {fmt(es.get(0))}, {fmt(es.get(1))} | "
              f"{tl['M_W_tree_with_rho_v2 = rho2 - 2.4']:.3f}, {t2:.3f} |")
    tmin = 2 if d["T"] >= 16 else 1
    ft = fits(d, key, tmin)
    md_fit.append(f"| {d['tag']} | {d['L']}^3 x {d['T']} | {tmin} | {ft['no_constant']['M']:.3f}"
                  + (f" ({ft['no_constant']['err']:.3f})" if ft['no_constant']['err'] is not None else "")
                  + f" | {ft['no_constant']['chi2']:.2f} | {ft['with_constant']['M']:.3f}"
                  + (f" ({ft['with_constant']['err']:.3f})" if ft['with_constant']['err'] is not None else "")
                  + f" | {ft['with_constant']['chi2']:.2f} |")
    corr.append({"tag": d["tag"], "model": d["model"], "lambda_L": d["lambda_L"], "kappa_H": d["kappa_H"], "nmeas": d["nmeas"],
                 "L": d["L"], "T": d["T"], "cosh_fits_vector_channel": ft,
                 "rho2": d["rho2"], "L_alpha": d["L_alpha"],
                 "vector_m_eff_t1": em.get(1, {}).get("m_eff"), "vector_m_eff_t1_err": em.get(1, {}).get("err"),
                 "vector_m_eff_t2": em.get(2, {}).get("m_eff"), "vector_m_eff_t2_err": em.get(2, {}).get("err"),
                 "scalar_m_eff_t0": es.get(0, {}).get("m_eff"), "scalar_m_eff_t1": es.get(1, {}).get("m_eff"),
                 "tree_M_W_rho2_minus_2.4": tl["M_W_tree_with_rho_v2 = rho2 - 2.4"], "tree_M_W_rho2": t2})
open("CORR_TABLE.md", "w").write("\n".join(md + md_fit) + "\n")
res["screening"] = corr

for name in ("scan_summary", "series_summary", "thermal_summary"):
    try:
        d = json.load(open(name + ".json"))
    except FileNotFoundError:
        continue
    if name == "scan_summary":
        res["line"] = d["line"]
        res["source_verdicts"] = d.get("source_verdicts")
        res["schwinger_dyson_pulls"] = d["schwinger_dyson_pulls"]
    elif name == "series_summary":
        res["series"] = d
    else:
        res["thermal"] = [{k: v for k, v in r.items() if k != "points"} for r in d]
json.dump(res, open("results.json", "w"), indent=1)
print(open("CORR_TABLE.md").read())
print(json.dumps(res["compact"], indent=1))
