"""Lane AV: analysis of the runs with two electric steps per tick (an_out). Written and run after the comparison of
av_compare.py: every v value here is NOT BLIND. Reads an_out/*.json and clock2.json, writes an_fits.json and AN_TABLE.md."""
import glob
import json
import math
import os

import numpy as np

pi = math.pi
X_U = 24.3166
S_U = (pi / 2) * X_U
E_CELL = 9.5599e18
V_MEASURED = 246.22          # PDG 2024, from G_F. NOT BLIND.
R = {os.path.basename(f)[:-5]: json.load(open(f)) for f in sorted(glob.glob("an_out/*.json"))}
CK = json.load(open("clock2.json"))["cub4_L4_T8_steps2"]
out = {"lattice": "4^3 x 8 half ticks, two electric steps per tick", "exact_cartan": CK, "S_U": S_U, "label_of_v_values": "NOT BLIND"}


def wls(X, y, e):
    W = 1.0 / e ** 2
    cov = np.linalg.inv(X.T @ (X * W[:, None]))
    par = cov @ (X.T @ (W * y))
    return par, cov, float((W * (y - X @ par) ** 2).sum()), len(y) - X.shape[1]


def fit(S, y, e, p_fixed):
    if p_fixed is None:
        X = np.stack([np.ones_like(S), np.log(S), -S], 1)
        par, cov, chi2, dof = wls(X, y, e)
        sc = max(1.0, math.sqrt(chi2 / dof)) if dof > 0 else 1.0
        return {"c": float(par[2]), "c_err": float(sc * math.sqrt(cov[2, 2])), "p": float(par[1]), "p_err": float(sc * math.sqrt(cov[1, 1])),
                "chi2": chi2, "dof": dof}
    X = np.stack([np.ones_like(S), -S], 1)
    par, cov, chi2, dof = wls(X, y - p_fixed * np.log(S), e)
    sc = max(1.0, math.sqrt(chi2 / dof)) if dof > 0 else 1.0
    return {"c": float(par[1]), "c_err": float(sc * math.sqrt(cov[1, 1])), "p": p_fixed, "p_err": 0.0, "ln_M0": float(par[0]),
            "chi2": chi2, "dof": dof}


gates = {}
for k, key in (("an2g_el_ab_b5", "c_electric_step"), ("an2g_fm_ab_b5", "c_face_step")):
    if k in R:
        r = R[k]
        ex = math.log(2.0) - CK[key] * r["S"]
        gates[k] = {"lnA": r["lnA"], "lnA_err": r["lnA_err"], "gaussian_form": ex, "pull": (r["lnA"] - ex) / r["lnA_err"]}
out["gates"] = gates
scans = {}
for mode, key in (("el", "c_electric_step"), ("fm", "c_face_step")):
    rows = sorted([r for k, r in R.items() if k.startswith("an2_%s_hk_b" % mode)], key=lambda r: r["S"])
    if len(rows) >= 3:
        S = np.array([r["S"] for r in rows]); y = np.array([r["lnA"] for r in rows]); e = np.array([r["lnA_err"] for r in rows])
        ent = {"reading": {"el": "electric step", "fm": "face step"}[mode], "c_gaussian": CK[key],
               "points": [{"beta": r["task"]["beta_equiv"], "S": r["S"], "lnA": r["lnA"], "lnA_err": r["lnA_err"], "lnA_forward": r["lnA_forward"],
                           "lnA_backward": r["lnA_backward"], "lnA_TI": r["lnA_TI"]} for r in rows],
               "fit_p1": fit(S, y, e, 1.0), "fit_pfree": fit(S, y, e, None) if len(rows) >= 4 else None}
        m = ent["fit_p1"]
        ent["relative_to_gaussian"] = m["c"] / CK[key] - 1
        ent["relative_to_1"] = m["c"] - 1
        ent["pull_from_1"] = (m["c"] - 1) / m["c_err"]
        ent["agrees_with_working_law"] = bool(abs(m["c"] - 1) <= 3 * m["c_err"] and abs(m["c"] - 1) <= 0.05)
        at = [r for r in rows if abs(r["S"] - S_U) < 1e-3]
        if at:
            ent["lnA_at_S_U"] = at[0]["lnA"]; ent["lnA_at_S_U_err"] = at[0]["lnA_err"]
            ent["M_U_fit_c"] = math.exp(at[0]["lnA"] + m["c"] * S_U)
            ent["v_GeV_b=1_NOT_BLIND"] = E_CELL * math.exp(at[0]["lnA"])
            ent["v_b=1_over_measured_NOT_BLIND"] = E_CELL * math.exp(at[0]["lnA"]) / V_MEASURED
        ent["v_GeV_bM=1_NOT_BLIND"] = E_CELL * math.exp(-m["c"] * S_U)
        ent["v_bM=1_over_measured_NOT_BLIND"] = E_CELL * math.exp(-m["c"] * S_U) / V_MEASURED
        scans[mode] = ent
out["scans"] = scans
json.dump(out, open("an_fits.json", "w"), indent=1)
L = ["# Lane AV: two electric steps per tick, 4^3 x 8 half ticks (generated by av_fit_an.py, after the comparison)", "",
     "Exact Cartan values on this lattice: c = %.5f (electric step), %.5f (face step). Infinite volume: 0.6731, 0.9436." % (
         CK["c_electric_step"], CK["c_face_step"]), ""]
for k, g in gates.items():
    L.append("- gate %s: ln <A> = %.4f (%.4f), Gaussian form %.4f, pull %.2f" % (k, g["lnA"], g["lnA_err"], g["gaussian_form"], g["pull"]))
L += ["", "| Reading | beta | S | ln <A> | error | forward | backward | TI |", "| --- | --- | --- | --- | --- | --- | --- | --- |"]
for mode, e in scans.items():
    for q in e["points"]:
        L.append("| %s | %.4f | %.3f | %.4f | %.4f | %.4f | %.4f | %.4f |" % (e["reading"], q["beta"], q["S"], q["lnA"], q["lnA_err"], q["lnA_forward"],
                                                                 q["lnA_backward"], q["lnA_TI"]))
L += ["", "| Reading | c (p = 1) | chi2/dof | c (p free) | p | Gaussian c | c - 1 | v at b M = 1 (GeV, NOT BLIND) | v at b = 1 (GeV, NOT BLIND) |",
      "| --- | --- | --- | --- | --- | --- | --- | --- | --- |"]
for mode, e in scans.items():
    m, f_ = e["fit_p1"], e["fit_pfree"]
    L.append("| %s | %.4f (%.4f) | %.1f/%d | %s | %s | %.4f | %+.4f | %.4g | %s |" % (
        e["reading"], m["c"], m["c_err"], m["chi2"], m["dof"], ("%.4f (%.4f)" % (f_["c"], f_["c_err"])) if f_ else "",
        ("%.2f (%.2f)" % (f_["p"], f_["p_err"])) if f_ else "", e["c_gaussian"], e["relative_to_1"], e["v_GeV_bM=1_NOT_BLIND"],
        ("%.4g" % e["v_GeV_b=1_NOT_BLIND"]) if "v_GeV_b=1_NOT_BLIND" in e else ""))
open("AN_TABLE.md", "w").write("\n".join(L) + "\n")
print("\n".join(L))
