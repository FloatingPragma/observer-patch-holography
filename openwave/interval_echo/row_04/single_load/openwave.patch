+"""Reconstruct the M10.5 pilot from the immutable public board. Run with --board FILE."""
+
+import argparse
+import hashlib
+import io
+import json
+from pathlib import Path
+
+import numpy as np
+from scipy.linalg import expm
+
+BOARD_SHA256 = "99870398e3d516f899c600e9bf25ba53c7f513142ba8facbe1cedd94b23f915b"
+RESEARCH = Path(__file__).resolve().parents[1]
+
+
+def replay(board, home, start, direction, duration):
+    raw = board.read_bytes()
+    if hashlib.sha256(raw).hexdigest() != BOARD_SHA256:
+        raise ValueError("Wrong native federation")
+    with np.load(io.BytesIO(raw), allow_pickle=False) as data:
+        left, right = data["edges"].T
+    a = np.zeros((240, 240))
+    a[left, right] = a[right, left] = 1
+    ids = np.arange(12 * home, 12 * home + 12)
+    interior = a[np.ix_(ids, ids)]
+    gateway = (a[ids].sum(axis=1) - interior.sum(axis=1)) == 1
+    if gateway.sum() != 3 or not np.all(interior.sum(axis=1) == 5):
+        raise ValueError("Changed layout")
+    clear = expm(-0.5j * (5 * np.eye(12) - interior))
+    clear[gateway] = 0
+    accepted = np.linalg.matrix_power(clear, 1024)
+    acceptance = np.sum(abs(accepted) ** 2, axis=0)
+    rho = np.zeros((12, 12), dtype=complex)
+    reach = 1.0
+    for attempt in range(48):
+        j = (start + direction * attempt) % 12
+        col = accepted[:, j]
+        rho += reach * np.outer(col, col.conj())
+        reach *= 1 - acceptance[j]
+    # The discarded global 6*kappa phase cancels from the probabilities.
+    lap = np.diag(a.sum(axis=1)) - a
+    u = expm(-0.5j * duration * lap)[:, ids]
+    markov = expm(-0.5 * duration * lap)[:, ids]
+    outcomes = {}
+    for arm, mass, fail in (
+        ("coherent", ((u @ rho) * u.conj()).sum(axis=1).real, reach),
+        ("dephased", abs(u) ** 2 @ rho.diagonal().real, reach),
+        ("unfiltered_uniform", np.mean(abs(u) ** 2, axis=1), 0.0),
+        ("stochastic_swap", markov @ rho.diagonal().real, reach),
+    ):
+        bins = np.r_[mass[ids], np.delete(mass, ids).sum(), fail]
+        if not np.all(np.isfinite(bins)) or min(bins) < 0 or abs(bins.sum() - 1) > 2e-10:
+            raise ArithmeticError("Invalid complete receiver")
+        outcomes[arm] = bins
+    return outcomes
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--board", required=True, type=Path)
+    args = parser.parse_args()
+    record = json.loads((RESEARCH / "data/m10_5_pilot.json").read_text())
+    fixed = dict(home=13, start=0, direction=1, exposure=37)
+    if (
+        record["settings"] != fixed
+        or record["kind"] != "historical pilot"
+        or record["anchor"] is not None
+    ):
+        raise ValueError("Expected the disclosed pilot appointment")
+    observed = replay(args.board, 13, 0, 1, 37)
+    if set(observed) != set(record["bins"]):
+        raise ValueError("Missing archived arm")
+    for arm, bins in observed.items():
+        np.testing.assert_allclose(bins, record["bins"][arm], atol=1e-9, rtol=0)
+    home = {arm: float(bins[:12].sum()) for arm, bins in observed.items()}
+    if not (
+        home["coherent"] > 0.94
+        and home["stochastic_swap"] < 0.80
+        and home["coherent"] - home["dephased"] >= 0.05
+    ):
+        raise ArithmeticError("Pilot control failed")
+    print(json.dumps(home, indent=2))
+
+
+if __name__ == "__main__":
+    main()
