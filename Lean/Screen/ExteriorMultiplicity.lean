import ExteriorSelection

namespace OPH.ExteriorMultiplicity

open OPH.ExteriorSelection (colorDim weakDim charge isColored isDoublet)

/-- Chiral counts in the order Q, uᶜ, dᶜ, L, eᶜ, each minus its conjugate. -/
structure Net where
  q : ℤ
  u : ℤ
  d : ℤ
  l : ℤ
  e : ℤ

def net (m : Fin 10 → ℤ) : Net :=
  ⟨m 3 - m 6, m 2 - m 5, m 8 - m 0, m 9 - m 1, m 4 - m 7⟩

def weighted (m w : Fin 10 → ℤ) : ℤ :=
  m 0*w 0+m 1*w 1+m 2*w 2+m 3*w 3+m 4*w 4+
  m 5*w 5+m 6*w 6+m 7*w 7+m 8*w 8+m 9*w 9

def anomalyFree (m : Fin 10 → ℤ) : Prop :=
  weighted m (fun i => colorDim i * weakDim i * charge i) = 0 ∧
  weighted m (fun i => if isColored i then weakDim i * charge i else 0) = 0 ∧
  weighted m (fun i => if isDoublet i then colorDim i * charge i else 0) = 0 ∧
  weighted m (fun i => colorDim i * weakDim i * charge i ^ 3) = 0

def equations (z : Net) : Prop :=
  6*z.q - 12*z.u + 6*z.d - 6*z.l + 6*z.e = 0 ∧
  2*z.q - 4*z.u + 2*z.d = 0 ∧
  3*z.q - 3*z.l = 0 ∧
  6*z.q - 192*z.u + 24*z.d - 54*z.l + 216*z.e = 0

private theorem gravity_row (m : Fin 10 → ℤ) :
    weighted m (fun i => colorDim i * weakDim i * charge i) =
      6*(net m).q - 12*(net m).u + 6*(net m).d - 6*(net m).l + 6*(net m).e := by
  change m 0 * (-6) + m 1 * (6) + m 2 * (-12) + m 3 * (6) + m 4 * (6) + m 5 * (12) + m 6 * (-6) + m 7 * (-6) + m 8 * (6) + m 9 * (-6) = _
  unfold net
  dsimp only
  ring

private theorem colour_row (m : Fin 10 → ℤ) :
    weighted m (fun i => if isColored i then weakDim i * charge i else 0) =
      2*(net m).q - 4*(net m).u + 2*(net m).d := by
  change m 0 * (-2) + m 1 * (0) + m 2 * (-4) + m 3 * (2) + m 4 * (0) + m 5 * (4) + m 6 * (-2) + m 7 * (0) + m 8 * (2) + m 9 * (0) = _
  unfold net
  dsimp only
  ring

private theorem weak_row (m : Fin 10 → ℤ) :
    weighted m (fun i => if isDoublet i then colorDim i * charge i else 0) =
      3*(net m).q - 3*(net m).l := by
  change m 0 * (0) + m 1 * (3) + m 2 * (0) + m 3 * (3) + m 4 * (0) + m 5 * (0) + m 6 * (-3) + m 7 * (0) + m 8 * (0) + m 9 * (-3) = _
  unfold net
  dsimp only
  ring

private theorem cubic_row (m : Fin 10 → ℤ) :
    weighted m (fun i => colorDim i * weakDim i * charge i ^ 3) =
      6*(net m).q - 192*(net m).u + 24*(net m).d - 54*(net m).l + 216*(net m).e := by
  change m 0 * (-24) + m 1 * (54) + m 2 * (-192) + m 3 * (6) + m 4 * (216) + m 5 * (192) + m 6 * (-6) + m 7 * (-216) + m 8 * (24) + m 9 * (-54) = _
  unfold net
  dsimp only
  ring

/-- Recompute all four rows from the imported ten exterior slots. -/
theorem source_rows (m : Fin 10 → ℤ) : anomalyFree m ↔ equations (net m) := by
  simp only [anomalyFree, equations, gravity_row, colour_row, weak_row, cubic_row]

/-- The integer kernel on the five net counts is generated by (1,1,1,1,1).
The ten original components may each have arbitrary nonnegative multiplicity. -/
theorem kernel (m : Fin 10 → ℤ) : anomalyFree m ↔
    ∃ k : ℤ, (net m).q = k ∧ (net m).u = k ∧ (net m).d = k ∧
      (net m).l = k ∧ (net m).e = k := by
  rw [source_rows]
  generalize net m = z
  rcases z with ⟨q, u, d, l, e⟩
  simp only [equations]
  constructor
  · intro h
    exact ⟨q, by omega⟩
  · rintro ⟨k, h⟩
    omega

/-- Remove the maximal vectorlike pair from either side; the remainder
is the positive/negative part of the unique signed chiral count. -/
theorem pairs (a b : ℤ) :
    a = min a b + max (a-b) 0 ∧ b = min a b + max (b-a) 0 := by
  omega

/-- The pure-colour anomaly vanishes on every such multiplicity assignment. -/
theorem color_cube (m : Fin 10 → ℤ) (hm : anomalyFree m) :
    2*(net m).q - (net m).u - (net m).d = 0 := by
  obtain ⟨k, h⟩ := (kernel m).mp hm
  omega

/-- Inclusive weak raising strength counts all lower doublet components,
including the mirrors and colour multiplicities. -/
def weakStrength (m : Fin 10 → ℤ) : ℤ :=
  weighted m (fun i => if isDoublet i then colorDim i else 0)

theorem weak_strength (m : Fin 10 → ℤ) (hm : anomalyFree m) :
    weakStrength m = 4*(net m).q + 6*m 6 + 2*m 1 := by
  obtain ⟨k, hq, _, _, hl, _⟩ := (kernel m).mp hm
  change m 0*0 + m 1*1 + m 2*0 + m 3*3 + m 4*0 + m 5*0 + m 6*3 +
    m 7*0 + m 8*0 + m 9*1 = _
  simp only [net] at hq hl ⊢
  omega

/-- The usual weak doublet mod-two test holds even with arbitrary pairs. -/
theorem witten (m : Fin 10 → ℤ) (hm : anomalyFree m) : Even (weakStrength m) := by
  refine ⟨2*(net m).q + 3*m 6 + m 1, ?_⟩
  rw [weak_strength m hm]
  ring

/-- Once the table is complete and the two mirror-doublet rows are
excluded, an independently calibrated strength of twelve fixes the index. -/
theorem twelve_counts_three (m : Fin 10 → ℤ) (hm : anomalyFree m)
    (noMirrorQ : m 6 = 0) (noMirrorL : m 1 = 0) (read : weakStrength m = 12) :
    (net m).l = 3 ∧ (net m).e = 3 := by
  obtain ⟨k,hq,_,_,hl,he⟩ := (kernel m).mp hm
  rw [weak_strength m hm, noMirrorQ, noMirrorL] at read
  omega

end OPH.ExteriorMultiplicity
