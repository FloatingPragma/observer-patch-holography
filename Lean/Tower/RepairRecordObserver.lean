def sourceNext (s : Fin 66) (b : Fin 60) : Fin 66 :=
  Fin.ofNat 66 (nextTable[s.val]![b.val]!)
def eventRecord (s : Fin 66) (b : Fin 60) : Fin 120 :=
  Fin.ofNat 120 (letterTable[s.val]![b.val]!)
def control (s : Fin 66) (r : Fin 120) : Option (Fin 66) :=
  let n := controlTable[s.val]![r.val]!
  if h : n < 66 then some ⟨n,h⟩ else none

theorem source_control_binding : ∀ s : Fin 66, ∀ b : Fin 60,
    control s (eventRecord s b) = some (sourceNext s b) := by native_decide

structure Trace where
  state : Fin 66
  tape : List (Fin 120)
  deriving DecidableEq

def continuation (t : Trace) (b : Fin 60) : Trace :=
  ⟨sourceNext t.state b, t.tape ++ [eventRecord t.state b]⟩
def readback (t : Trace) := t.tape

theorem continuation_control (t : Trace) (b : Fin 60) :
    control t.state (eventRecord t.state b) = some (continuation t b).state :=
  source_control_binding t.state b

theorem durable_prefix (t : Trace) (b : Fin 60) :
    (readback (continuation t b)).take t.tape.length = readback t := by
  simp [readback, continuation]

theorem actual_shared_event (t : Trace) (b : Fin 60) :
    readback (continuation t b) = t.tape ++ [eventRecord t.state b] := rfl

def generator (f : Fin 66 → ℚ) (s : Fin 66) : ℚ :=
  (∑ b : Fin 60, f (sourceNext s b) - f s) / 60

theorem actual_generator_nonzero :
    generator (fun s => if s.val = 0 then 1 else 0) 0 ≠ 0 := by native_decide

end OPH.Tower.RepairRecordObserver
