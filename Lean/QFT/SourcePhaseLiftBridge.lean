#print axioms sourcePhaseLift_mem_complexSourceAlgebra
#print axioms realSourceEffectClosure_symmetric
#print axioms rhoY_bornWeight_equal_on_real_symmetric
#print axioms realSourceEffectClosure_Y_blind
#print axioms realSourceEffectClosure_not_tomographically_complete
#print axioms sourcePhaseLift_not_complexification
#print axioms sourcePhaseLift_not_in_realSourceEffectClosure
#print axioms sourcePhaseTomography_injective_on_equalTrace
#print axioms sourcePhaseTomography_injective_on_states
#print axioms sourcePhaseLift_boundary_summary

end OPH.QFT
