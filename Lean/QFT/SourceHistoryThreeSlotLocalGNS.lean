#print axioms OPH.QFT.SourceHistoryThreeSlotLocalGNS.sourceHistoryGenerator_maps_algebra0_to_algebra01
#print axioms OPH.QFT.SourceHistoryThreeSlotLocalGNS.represented_endpoint_locality
