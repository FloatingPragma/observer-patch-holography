import Mathlib.LinearAlgebra.Matrix.Reindex
import Mathlib.LinearAlgebra.Matrix.Hermitian
import Mathlib.Algebra.Star.Subalgebra
import Mathlib.Tactic

/-! A complete exchange of guarded registers reindexes the full material matrix
algebra. Region membership and its generators move with the same register.
The native experiment certifies the exchange and two noncommuting local reads. -/
namespace OPH.QFT.MaterialRelease

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι]
abbrev Word (ι : Type*) := ι → Bool
abbrev Obs (ι : Type*) := Matrix (Word ι) (Word ι) ℂ

def words (e : Equiv.Perm ι) : Equiv.Perm (Word ι) where
  toFun x := fun j => x (e.symm j)
  invFun x := fun i => x (e i)
  left_inv := by intro x; funext i; simp
  right_inv := by intro x; funext i; simp

def evolve (e : Equiv.Perm ι) : Obs ι ≃⋆ₐ[ℂ] Obs ι :=
  StarAlgEquiv.ofAlgEquiv (Matrix.reindexAlgEquiv ℂ ℂ (words e))
    (fun M => by ext x y; rfl)

def site (i : ι) (A : Matrix Bool Bool ℂ) : Obs ι :=
  fun x y => if ∀ j, j ≠ i → x j = y j then A (x i) (y i) else 0

theorem evolve_site (e : Equiv.Perm ι) (i : ι) (A : Matrix Bool Bool ℂ) :
    evolve e (site i A) = site (e i) A := by
  ext x y
  change (if ∀ j, j ≠ i → x (e j) = y (e j) then _ else _) = _
  unfold site
  have eqv : (∀ j, j ≠ i → x (e j) = y (e j)) ↔
      (∀ j, j ≠ e i → x j = y j) := by
    constructor
    · intro h j hj
      obtain ⟨k, rfl⟩ := e.surjective j
      exact h k (fun hk => hj (congrArg e hk))
    · intro h j hj
      exact h (e j) (fun he => hj (e.injective he))
  exact if_congr eqv rfl rfl

/-- Position and decoded energy read differences in the sharp rail basis. -/
def railZ : Matrix Bool Bool ℂ :=
  fun i j => if i = j then (if i then -1 else 1) else 0

def railX : Matrix Bool Bool ℂ := fun i j => if i = j then 0 else 1

/-- Every admitted one-slot matrix is in the algebra generated by the two
actual read differences. -/
theorem local_read_span (A : Matrix Bool Bool ℂ) :
    A = ((A false false + A true true)/2) • (1 : Matrix Bool Bool ℂ)
      + ((A false true + A true false)/2) • railX
      + ((A false false - A true true)/2) • railZ
      + ((A false true - A true false)/2) • (railZ * railX) := by
  ext i j
  cases i <;> cases j <;>
    simp [railX, railZ, Matrix.add_apply, Matrix.smul_apply,
      Matrix.mul_apply, smul_eq_mul] <;> ring

def admitted (R : Set ι) : Set (Obs ι) :=
  {M | ∃ i ∈ R, ∃ A : Matrix Bool Bool ℂ, site i A = M}

theorem image_admitted (e : Equiv.Perm ι) (R : Set ι) :
    evolve e '' admitted R = admitted (e '' R) := by
  ext M
  constructor
  · rintro ⟨_, ⟨i, hi, A, rfl⟩, rfl⟩
    exact ⟨e i, ⟨i, hi, rfl⟩, A, (evolve_site e i A).symm⟩
  · rintro ⟨_, ⟨i, hi, rfl⟩, A, rfl⟩
    exact ⟨site i A, ⟨i, hi, A, rfl⟩, evolve_site e i A⟩

def region (R : Set ι) : StarSubalgebra ℂ (Obs ι) := StarAlgebra.adjoin ℂ (admitted R)

theorem region_isotone {R S : Set ι} (h : R ⊆ S) : region R ≤ region S := by
  apply StarAlgebra.adjoin_mono
  rintro _ ⟨i, hi, A, rfl⟩
  exact ⟨i, h hi, A, rfl⟩

theorem slice_generation (e : Equiv.Perm ι) (R : Set ι) :
    StarAlgebra.adjoin ℂ (evolve e '' admitted R) = region (e '' R) := by
  rw [image_admitted]; rfl

theorem net_compatible (e : Equiv.Perm ι) (R : Set ι) :
    (region R).map (evolve e : Obs ι →⋆ₐ[ℂ] Obs ι) = region (e '' R) := by
  unfold region
  rw [StarAlgHom.map_adjoin]
  exact slice_generation e R

theorem cocycle (e f : Equiv.Perm ι) (M : Obs ι) :
    evolve f (evolve e M) = evolve (e.trans f) M := by
  ext x y
  rfl

theorem equal_exchange_response (cold warm a b : ℚ) :
    (cold + (warm-cold)*a) + (warm + (cold-warm)*a) = cold + warm ∧
    (cold + (warm-cold)*a) - (cold + (warm-cold)*b) = (warm-cold)*(a-b) := by
  constructor <;> ring

end
end OPH.QFT.MaterialRelease
