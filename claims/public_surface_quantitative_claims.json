{
  "schema": "oph.public_surface_quantitative_claims.v1",
  "scope_policy": {
    "governed_content": "Generated quantitative comparison blocks and every Markdown table that presents an OPH value against an external reference.",
    "governed_surfaces": [
      "README.md and README_FR.md, through the generated quantitative claim block",
      "every published README.md comparison table outside dot directories and vendored trees"
    ],
    "comparison_table_surface_rule": "every_published_readme_comparison_table_is_declared_row_for_row",
    "readme_table_condition": "render_only_when_physical_establishment_count_is_positive",
    "nonclaim_numeric_contexts": [
      "calendar dates",
      "GitHub issue numbers",
      "machine-generated theorem and lemma declaration counts: the README lower bound is the largest multiple of 100 strictly below the tracked public declaration count, checked by tools/check_lean_theorem_count.py; this count asserts neither physical establishment nor derivation of M1",
      "file paths and URLs",
      "equation labels and representation dimensions",
      "numbers in prose that do not present an OPH-versus-external quantitative comparison"
    ],
    "unmanaged_oph_comparison_tables_allowed": false
  },
