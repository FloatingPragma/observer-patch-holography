# Normalize committed text to LF in the working tree on every platform.
# The scientific receipt suite verifies JSON artifacts by sha256/byte equality;
# without this, a Windows checkout (core.autocrlf=true) gets CRLF and every
# byte/hash check fails. Committed text blobs use LF in the index. This rule
# stabilizes checkout without changing committed content.
* text=auto eol=lf

# Canonical book diagram renderings are byte-hashed build inputs.
assets/book_pdf_renderings/*.pdf -text -eol
assets/book_pdf_renderings/**/*.pdf -text -eol

# Preserve the source-run CSV byte-for-byte; its archive manifest binds the
# producer's original CRLF serialization.
evidence/e6_64k_dense_20260820/mismatch_trace.csv -text -eol -diff

# Frozen-prediction custody artifacts are byte-exact copies whose hashes and
# OpenTimestamps proofs are verified; never normalize them.
evidence/custody/** -text -eol -diff

# Full routed histories use explicit binary event rows and lossless deltas.
code/source_read_routing/controls/*.tape -text -eol -diff
code/source_read_routing/controls/*.input -text -eol -diff
evidence/source_net_causal_poset/routed_read_law/*.tape -text -eol -diff
evidence/source_net_causal_poset/routed_read_law/*.input -text -eol -diff
