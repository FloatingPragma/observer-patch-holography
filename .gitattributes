# Normalize committed text to LF in the working tree on every platform.
# The scientific receipt suite verifies JSON artifacts by sha256/byte equality;
# without this, a Windows checkout (core.autocrlf=true) gets CRLF and every
# byte/hash check fails. Committed text blobs use LF in the index. This rule
# stabilizes checkout without changing committed content.
* text=auto eol=lf

# Canonical book diagram renderings are byte-hashed build inputs.
assets/book_pdf_renderings/*.pdf -text -eol
assets/book_pdf_renderings/**/*.pdf -text -eol


# Frozen-prediction custody artifacts are byte-exact copies whose hashes and
# OpenTimestamps proofs are verified; never normalize them.
evidence/custody/** -text -eol -diff

# Preserved simulation producers, data and receipts retain their original bytes.
evidence/observer_dynamics_20260925/sim-analysis/** -text -eol -diff
evidence/observer_dynamics_20260925/oph-physics-sim/** -text -eol -diff
evidence/source_net_causal_poset/manifold_sampled/oph_exact/*.py -text -eol -diff
evidence/source_net_causal_poset/manifold_sampled/tests/test_exact_source_net_manifold_sampled.py -text -eol -diff

# Issue 776 exact provenance chunks and geometry are byte-hashed binary inputs.
code/support_wiring/geometry/*.npz -text -eol -diff
evidence/support_wiring_776/*.npz -text -eol -diff
evidence/support_wiring_776/trace/*.npz -text -eol -diff
# Full routed histories use explicit binary event rows and lossless deltas.
code/source_read_routing/controls/*.tape -text -eol -diff
code/source_read_routing/controls/*.input -text -eol -diff
code/source_routing_refinement/controls/*.tape -text -eol -diff

# Published detector data retain their original bytes, including CRLF and
# whitespace, so Zenodo's checksums verify on every checkout platform.
model/anharmonic_observations/data/** -text -eol -diff
model/anharmonic_transfer/data/** -text -eol -diff
